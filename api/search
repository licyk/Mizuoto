velopment-performance#gpu-baseline-g0","content":"Fish Speech S2 Pro LoRA, 2 steps","locale":"en"},"13243":{"id":"/en/docs/development-performance-563","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-baseline-g0","content":"59.6 → 48.7","locale":"en"},"13244":{"id":"/en/docs/development-performance-564","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-baseline-g0","content":"0.57 → 0.57","locale":"en"},"13245":{"id":"/en/docs/development-performance-565","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-baseline-g0","content":"9,978 → 9,978","locale":"en"},"13246":{"id":"/en/docs/development-performance-566","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-baseline-g0","content":"does not repeat on the GPU","locale":"en"},"13247":{"id":"/en/docs/development-performance-567","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-baseline-g0","content":"Five trainers repeat run to run and give identical losses and weights under `low`. GPT-SoVITS's SoVITS stage repeats for its first seven steps and then drifts, run to run; with deterministic algorithms in its stages (an experiment) two runs are identical, so the drift comes from operations that have deterministic versions (atomics in backward passes). Fish Speech's losses repeat but its exported weights differ run to run; the cause is open. Peak MB is `memory/peak_mb`, the stage's peak allocation.","locale":"en"},"13248":{"id":"/en/docs/development-performance-568","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"The code and settings proven only on the CPU, checked on the free GPUs of the GPU baseline (2026-10-18).","locale":"en"},"13249":{"id":"/en/docs/development-performance-569","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"**Every change since before round 1, step by step.** The G0 set ran with the code of each step on one GPU (frozen worktrees, each with its own harness), and each step's audio was compared with the step before:","locale":"en"},"13250":{"id":"/en/docs/development-performance-570","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"From → to","locale":"en"},"13251":{"id":"/en/docs/development-performance-571","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"Identical on the GPU","locale":"en"},"13252":{"id":"/en/docs/development-performance-572","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"before round 1 → round 1 (`8a021de`)","locale":"en"},"13253":{"id":"/en/docs/development-performance-573","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"every engine but VoxCPM (its attention span: below)","locale":"en"},"13254":{"id":"/en/docs/development-performance-574","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"round 1 → round 2 (`60776a4`)","locale":"en"},"13255":{"id":"/en/docs/development-performance-575","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"every engine but Fish Speech (its in-place Snake: below)","locale":"en"},"13256":{"id":"/en/docs/development-performance-576","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"round 2 → the attention dispatcher (`7600f61`)","locale":"en"},"13257":{"id":"/en/docs/development-performance-577","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"all","locale":"en"},"13258":{"id":"/en/docs/development-performance-578","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"→ the memory fixes (`d65c482`)","locale":"en"},"13259":{"id":"/en/docs/development-performance-579","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"all","locale":"en"},"13260":{"id":"/en/docs/development-performance-580","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"→ CUDA graphs for every engine (`0b70d0f`)","locale":"en"},"13261":{"id":"/en/docs/development-performance-581","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"all (CosyVoice failed on `cuda:1`: below)","locale":"en"},"13262":{"id":"/en/docs/development-performance-582","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"→ 0.2.5 (`4e6fe35`)","locale":"en"},"13263":{"id":"/en/docs/development-performance-583","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"all; and on `cuda:1` identical to G0's `cuda:0`","locale":"en"},"13264":{"id":"/en/docs/development-performance-584","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"Fixed, so the GPU's audio is again the code before's:","locale":"en"},"13265":{"id":"/en/docs/development-performance-585","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"**VoxCPM's attention span.** On CUDA a step takes SDPA's math path, whose matrix-vector product and softmax split their sums by the key length: a cut at the next multiple of 256 (or 512 … 4096) differs from the whole 8192-position cache at most positions in bf16, fp16 and fp32. The span is now used on the CPU only (`minicpm.attend_span`); on a GPU a step attends over the whole cache, as upstream. Identical to the code before round 1 again, at a cost: warm requests 1.24 → 2.13 s (VoxCPM 2) and 0.68 → 0.96 s (1.5).","locale":"en"},"13266":{"id":"/en/docs/development-performance-586","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"**Fish Speech's in-place Snake.** On a GPU the codec runs under bf16 autocast, which computes `pow` and `reciprocal` in float32; upstream's Snake therefore ends in float32 while the in-place form, which keeps its buffer's dtype, stayed in bf16 (up to 0.1 apart). The in-place form now runs only without autocast; identical to round 1 again, at the same speed. The unit test covers autocast. (Later, against upstream itself, it turned out that its TorchScript Snake runs in float32 throughout under autocast. Since mizuoto-fishspeech 0.3.3 the port does too, and the decoded audio on a GPU changed: Fish Speech.)","locale":"en"},"13267":{"id":"/en/docs/development-performance-587","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"**CosyVoice on `cuda:1`** faulted with an illegal memory access: its decoder-step graphs were captured and replayed while `cuda:0` was current, and a replay runs on the current device's stream. Captured and replayed under `torch.cuda.device(graphs.device)` now, as the other engines do (Acceleration).","locale":"en"},"13268":{"id":"/en/docs/development-performance-588","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"The rotary tables, IndexTTS's in-place GELU and Fish Speech's Snake give their reference's bits on CUDA in fp32, fp16 and bf16 (the exactness tests now run on CUDA when a GPU is visible); CosyVoice's U-Net mask is the same tensor made once. Fish Speech's GPU training replays upstream's initialisation on the CPU generator, as upstream builds its model on the CPU.","locale":"en"},"13269":{"id":"/en/docs/development-performance-589","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"**The memory plan's mechanisms on CUDA** (G0's set, each compared with G0's audio): every model loaded partly under `compute.vram_limit_mb` at about half its size, the rest streaming, with prefetch on 2, 1 and 0 side streams; out-of-memory errors injected into every phase, each phase run again with half its weights streamed and its generators put back; `compute.kv_cache = static`. All 56 runs identical.","locale":"en"},"13270":{"id":"/en/docs/development-performance-590","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"Case (whole: warm s)","locale":"en"},"13271":{"id":"/en/docs/development-performance-591","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"Partly loaded, 2 side streams","locale":"en"},"13272":{"id":"/en/docs/development-performance-592","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"1","locale":"en"},"13273":{"id":"/en/docs/development-performance-593","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"0","locale":"en"},"13274":{"id":"/en/docs/development-performance-594","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"Qwen3-TTS base-clone-en (1.28)","locale":"en"},"13275":{"id":"/en/docs/development-performance-595","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"24.6 s, 171 GB streamed","locale":"en"},"13276":{"id":"/en/docs/development-performance-596","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"20.0 s","locale":"en"},"13277":{"id":"/en/docs/development-performance-597","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"18.6 s, 156 GB","locale":"en"},"13278":{"id":"/en/docs/development-performance-598","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"VoxCPM v2-clone-en (1.24)","locale":"en"},"13279":{"id":"/en/docs/development-performance-599","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-checks-of-the-cpu-rounds-g1","content":"29.0 s, 325 GB","locale":"en"},"13280