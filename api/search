ning-54","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`full`, `lora`","locale":"en"},"14826":{"id":"/en/docs/development-training-55","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`prepare`, `train`, `export`","locale":"en"},"14827":{"id":"/en/docs/development-training-56","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`model`","locale":"en"},"14828":{"id":"/en/docs/development-training-57","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"CosyVoice","locale":"en"},"14829":{"id":"/en/docs/development-training-58","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`llm`, `llm_flow`","locale":"en"},"14830":{"id":"/en/docs/development-training-59","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`features`, `llm`, (`flow`), `export`","locale":"en"},"14831":{"id":"/en/docs/development-training-60","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`model`","locale":"en"},"14832":{"id":"/en/docs/development-training-61","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"Fish Speech","locale":"en"},"14833":{"id":"/en/docs/development-training-62","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`lora`","locale":"en"},"14834":{"id":"/en/docs/development-training-63","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`tokens`, `train`, `export`","locale":"en"},"14835":{"id":"/en/docs/development-training-64","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`model`","locale":"en"},"14836":{"id":"/en/docs/development-training-65","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"dummy","locale":"en"},"14837":{"id":"/en/docs/development-training-66","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`speaker`, `full`","locale":"en"},"14838":{"id":"/en/docs/development-training-67","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`prepare`, `train`, `export`","locale":"en"},"14839":{"id":"/en/docs/development-training-68","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`voice_weights`, `model`","locale":"en"},"14840":{"id":"/en/docs/development-training-69","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#datasets","content":"Training starts from a dataset. A dataset is `datasets/<slug>/`: `dataset.json`, `manifest.jsonl` (one row per clip: `id`, `audio`, `text`, `speaker`, `language`, `duration`, the rate, `excluded`, the source and `licence_tags`) and `audio/<id>.flac` (at most 48 kHz). The dataset's fingerprint is the SHA-256 of `manifest.jsonl`.","locale":"en"},"14841":{"id":"/en/docs/development-training-70","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#datasets","content":"**Adding.** Clips come from files (a `.lab` or `.txt` beside one is its text), uploads, a voice's references, earlier outputs (their licence tags kept), or a folder in a known layout (GPT-SoVITS `.list`, LJSpeech, CSV, plain).","locale":"en"},"14842":{"id":"/en/docs/development-training-71","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#datasets","content":"**Preparing.** `prepare` (the `dataset_prepare` job, resource `cpu`) cuts at silences with slicer2 at GPT-SoVITS's defaults, transcribes through ASR and peak-normalises.","locale":"en"},"14843":{"id":"/en/docs/development-training-72","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#datasets","content":"**Checking.** `check` gives a `DatasetReport`: a duration histogram, clips too short or too long, empty texts, clipping, sample rates and licence tags; rows can be filtered by the report's issues and excluded or deleted one by one.","locale":"en"},"14844":{"id":"/en/docs/development-training-73","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#datasets","content":"**Licences.** A trainer gets `training_rows(dataset, target engine)`: excluded rows and rows without text are left out, and when some rows' licence tags forbid training the target engine (a manifest's `trains_others = false`) the request is refused as a whole.","locale":"en"},"14845":{"id":"/en/docs/development-training-74","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#experiments-fingerprints-and-stale-stages","content":"An experiment is `experiments/<engine>/<name>/`: `experiment.json` (base model, dataset, method, hyperparameters, stage states), the trainer's work folder `work/`, and `metrics.jsonl`.","locale":"en"},"14846":{"id":"/en/docs/development-training-75","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#experiments-fingerprints-and-stale-stages","content":"Each finished stage records a fingerprint, computed by `fingerprints()` and chained in stage order:","locale":"en"},"14847":{"id":"/en/docs/development-training-76","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#experiments-fingerprints-and-stale-stages","content":"The dataset's fingerprint is the SHA-256 of its `manifest.jsonl`; `hp` is the method's defaults merged with the experiment's values. When states are read (`_with_status`), a finished stage whose fingerprint differs from the current one is `stale`, and so is every finished stage after it. Changing the learning rate therefore makes only the training stage that reads it, and what follows, stale; feature extraction before it stays done.","locale":"en"},"14848":{"id":"/en/docs/development-training-77","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#experiments-fingerprints-and-stale-stages","content":"One more rule: when a stage is **run again**, the finished stages after it that were not part of the same run lose their fingerprints. They read the old stage's files, so they are stale even when the inputs (and fingerprints) are the same.","locale":"en"},"14849":{"id":"/en/docs/development-training-78","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#experiments-fingerprints-and-stale-stages","content":"`run()` picks the stages: all of them with `restart`; the given `stages`, provided every stage before them is done; otherwise from the first unfinished stage to the end. When all are done it refuses with the hint `mizuoto train run <exp> --restart`.","locale":"en"},"14850":{"id":"/en/docs/development-training-79","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#the-train-job","content":"A run is one `train` job whose steps are the selected stages:","locale":"en"},"14851":{"id":"/en/docs/development-training-80","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#the-train-job","content":"**Resources**: `engine:<engine>:<dev>` and `gpu:<dev>` (`cpu` on a CPU), so it waits for the engine's own inference and other jobs on the GPU. The device is `training.devices[0]`, else the engine's. A GPU run takes `gpu:<dev>` whole (`JobSpec.exclusive`, whatever `compute.gpu_jobs` allows); before it starts, the engine's loaded models are unloaded (`runtime.unload_engine`) and every other idle model's weights on that device move to RAM (`runtime.release_device`), and no model comes back while it runs. The run's peak memory is then estimated; when it exceeds the free memory the log warns, naming the preset that would fit.","locale":"en"},"14852":{"id":"/en/docs/development-training-81","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#the-train-job","content":"**One process per stage**: `host_target(\"mizuoto.training.stage\", cwd=work)` runs `python -m mizuoto.training.stage <request.json>` with the server's own interpreter, through `JobContext.run_worker`. The stage sees every device under its own name. The heartbeat timeout is 30 minutes (`STAGE_HEARTBEAT_TIMEOUT`); any output line resets it, and the stage beats every 10 s anyway.","locale":"en"},"14853":{"id":"/en/docs/development-training-82","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#the-train-job","content":"**The request**: `trainer`, `stage`, `engine`, `method`, `experiment`, `workdir`, `dataset_dir`, `rows` (absolute audio paths, text, speaker, language, duration, rate; already filtered by licence in `training_rows`), `base_model` (`id`, `dir`, `variant`), `assets`, `device`, `precision` (`training.precision`), `hyperparams`, `language`, `results` (what finished stages returned), the settings `training.previews` and `training.keep_checkpoints`, and for the preview `compute` (the settings that place weights, `PLACEMENT_SETTINGS`: the reserve, `vram_limit_mb`, the pinned budget, OOM retry, `vram_mode`…) and `calibration` (the host's calibration file).","locale":"en"},"14854":{"id":"/en/docs/development-training-83","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#the-train-job","content":"**Events**: `MetricEvent`s are batched each second into `metrics.jsonl` and published as `train_metrics` (the UI's loss chart follows them live); `ProgressEvent` becomes the step's progress and message; `OutputEvent(kind=\"sample\")` is copied into an output of kind `sample`. A stage run again first drops its earlier points from `metrics.jsonl`.","locale":"en"},"14855":{"id":"/en/docs/development-training-84","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"Stages run in their own process, not in the server's: a run gives all its memory back when it ends, a crash in a stage cannot take the server down, and a stage may seed the process-wide generators (dropout masks and data shuffling draw from them in the upstream recipes) without touching anyone else's randomness.","locale":"en"},"14856":{"id":"/en/docs/development-training-85","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"`mizuoto/training/stage.py` is that process:","locale":"en"},"14857":{"id":"/en/docs/development-training-86","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"It moves the real stdout aside for events and points file descriptor 1 at stderr, so whatever libraries print goes to the log, not into the event stream. Events are JSON lines prefixed with `@mizuoto ` (`mizuoto/core/jobs/jsonl.py`), and records of the `mizuoto` loggers become `LogEvent`s.","locale":"en"},"14858":{"id":"/en/docs/development-training-87","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"A thread emits a `HeartbeatEvent` every 10 s (`HEARTBEAT_SECONDS`).","locale":"en"},"14859":{"id":"/en/docs/development-training-88","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"`stage_main` seeds Python's, NumPy's and torch's generators (`seed_everything`, with the request's `seed`, 1234 when it has none; the training service sends none today, so every run is seeded with 1234 and repeats), with `training.deterministic` turns on deterministic kernels (`features.deterministic`, with `CUBLAS_WORKSPACE_CONFIG` from the host; torch's fill of uninitialised memory stays off, since native code writes all it allocates and the fill made never-used allocations resident: 17 GB in Fish Speech's LoRA stage) and, on a GPU under `training.attention = auto`, the math attention kernel, builds the `StageContext`, loads the trainer with `load_trainer(request[\"trainer\"])` and calls `run_stage(stage, ctx)`; the result must be JSON-serialisable and goes back as a `ResultEvent`.","locale":"en"},"14860":{"id":"/en/docs/development-training-89","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"Failures map to events and exit codes (`mizuoto.core.codes`): `Cancelled` or SIGTERM → `EXIT_CANCELLED` (130); `EngineError` → an `ErrorEvent` with its code; running out of memory → `compute_unavailable`; anything else → the traceback as a log line and `engine_error`.","locale":"en"},"14861":{"id":"/en/docs/development-training-90","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"`python -m mizuoto.training.stage --entry module:function <request.json>` runs another job function the same way.","locale":"en"},"14862":{"id":"/en/docs/development-training-91","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#why-a-child-process","content":"A job worker's stdout (events) and stderr (libraries) reach the host on one pipe, so an event can arrive glued to a progress bar's unfinished `\\r` line. The host splits lines at the event prefix (`parse_lines` in `mizuoto/core/jobs/jsonl.py`); before that, every metric after a progress-bar redraw was lost.","locale":"en"},"14863":{"id":"/en/docs/development-training-92","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"A trainer is a `mizuoto.training.Trainer` subclass with one `stage_<id>(ctx)` method per stage id its methods declare; `ctx.request[\"method\"]` says which method runs. The trainer's module imports no torch at the top: the host imports it to read `REQUIRES` and `DEVICES` (`InferenceService.trainer_needs`) and to ask `refuses(method, model_dir)`, which says, without torch, why a method cannot start from a model (Qwen3-TTS: the 0.6B Base for `speaker`; the method then shows as unavailable, and a run cannot start), so the maths lives in modules it imports inside the stage methods. CosyVoice's trainer, for example, sets `DEVICES = (\"cuda\", \"cpu\")`: upstream trains under torchrun on CUDA only, and nothing in the native port needs CUDA.","locale":"en"},"14864":{"id":"/en/docs/development-training-93","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"A stage method returns a JSON-serialisable dict, stored as the stage's `result`; later stages read it from `ctx.results`. `StageContext` (`mizuoto/training/context.py`) offers:","locale":"en"},"14865":{"id":"/en/docs/development-training-94","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"Member","locale":"en"},"14866":{"id":"/en/docs/development-training-95","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"Purpose","locale":"en"},"14867":{"id":"/en/docs/development-training-96","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"`workdir`, `rows`, `base_model`, `assets`, `device`, `precision`, `results`, `hyperparams`, `name`, `engine`, `request`","locale":"en"},"14868":{"id":"/en/docs/development-training-97","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"The parsed request; `rows` are `Row`s (`id`, `audio`, `text`, `speaker`, `language`, `duration`, `sample_rate`); dataset clips are FLAC (`mizuoto.nn.dsp.flac.read_audio` reads them)","locale":"en"},"14869":{"id":"/en/docs/development-training-98","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"`hp(name, default)`","locale":"en"},"14870":{"id":"/en/docs/development-training-99","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"An effective hyperparameter, `default` when `None`","locale":"en"},"14871":{"id":"/en/docs/development-training-100","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"`progress(value, message)`","locale":"en"},"14872":{"id":"/en/docs/development-training-101","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"0–1, or `None` (indeterminate)","locale":"en"},"14873":{"id":"/en/docs/development-training-102","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"`metric(epoch, step, values, lr)`","locale":"en"},"14874":{"id":"/en/docs/development-training-103","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"One loss point","locale":"en"},"14875":{"id":"/en/docs/development-training-104","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"`output(path, label, kind)`","locale":"en"},"14876":{"id":"/en/docs/development-training-105","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"A file the stage made: `sample` for a preview, `checkpoint` for weights","locale":"en"},"14877":{"id":"/en/docs/development-training-106","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"`log(message, level)`","locale":"en"},"14878":{"id":"/en/docs/development-training-107","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"A log line","locale":"en"},"14879":{"id":"/en/docs/development-training-108","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"`preview(text, reference, label, weights=…, model_dir=…, variant=…, preset=…)`","locale":"en"},"14880":{"id":"/en/docs/development-training-109","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"Loads the engine's own implementation in the stage process (a private `Runtime` whose manager places weights as the host's would: the host's `compute` settings from the request, and its calibrated working-memory estimates, read but not written back; each preview runs in an export stage, a process of its own, so no optimizer state or gradients are on the device) and speaks `text` with the new weights (`weights` on the base model) or the new model (`model_dir`) under seed 1234, kept as a sample. A failure is only a warning, never a failed stage; skipped when `training.previews` is off","locale":"en"},"14881":{"id":"/en/docs/development-training-110","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#trainer-and-stagecontext","content":"Stages must be re-runnable: each clears its own output folder first.","locale":"en"},"14882":{"id":"/en/docs/development-training-111","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#memory","content":"Training's memory presets (`training.memory`: `standard`, `low`, `lowest`) and tools are in `mizuoto/training/memory.py`: gradient checkpointing puts back the global generators and the trainer's own during the backward recomputation, so losses and weights do not change; `low` adds only tools that keep results, `lowest` also those that change them slightly; a method's own hyperparameters win. A stage on a GPU adds `memory/peak_mb` to its metrics, and `MethodInfo.memory_mb` estimates a run's peak per preset. Details in Memory management.","locale":"en"},"14883":{"id":"/en/docs/development-training-112","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#exports","content":"The `export` stage returns `{\"artifacts\": [...]}`, which the host's `_register` takes in:","locale":"en"},"14884":{"id":"/en/docs/development-training-113","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#exports","content":"`{\"kind\": \"voice_weights\", \"files\": {\"gpt\": …, \"sovits\": …}}`: moved into `Voice.weights[engine]` of the experiment's voice; without one, a new voice is made from up to three dataset clips of 3–10 s with text, closest to 6 s.","locale":"en"},"14885":{"id":"/en/docs/development-training-114","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#exports","content":"`{\"kind\": \"model\", \"folder\": …, \"variant\": …, \"title\": …, \"speakers\": …}`: becomes a user model through `register_user_model`, whose `model.json` records `trained_from` and the experiment (and Qwen3's `speakers`).","locale":"en"},"14886":{"id":"/en/docs/development-training-115","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#exports","content":"A voice or model exported again is listed once, at its latest export. `mizuoto train export <exp>` runs the `export` stage alone. The exports keep the upstream recipes' formats and weight names, so upstream's implementation (and Mizuoto 0.1) loads them too, and the other way round.","locale":"en"},"14887":{"id":"/en/docs/development-training-116","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#omnivoices-trainer-as-an-example","content":"`mizuoto/engines/omnivoice/train.py`, methods `full` and `lora`, export `model`, after upstream's `examples/run_finetune.sh` and `run_finetune_lora.sh`, with no transformers, peft, accelerate or webdataset:","locale":"en"},"14888":{"id":"/en/docs/development-training-117","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#omnivoices-trainer-as-an-example","content":"`tokens`: the clips shuffled with seed 42, each read, made mono, resampled to 24 kHz, peak-normalised and encoded by the model's own HiggsAudio tokenizer (loaded with the inference engine's `load_audio_tokenizer`), into WebDataset-style shards listed by `data.lst`.","locale":"en"},"14889":{"id":"/en/docs/development-training-118","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#omnivoices-trainer-as-an-example","content":"`train`: upstream's fine-tune loop with its SDPA configs: the shards read by data-loader workers seeded as upstream seeds them, length-grouped batches under a 4-D mask, the masked cross-entropy, AdamW with the cosine schedule, gradient clipping and accumulation. LoRA is peft's, written without peft. Each update's loss is a `ctx.metric`. It ends with `out/checkpoint-<steps>` in upstream's layout.","locale":"en"},"14890":{"id":"/en/docs/development-training-119","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#omnivoices-trainer-as-an-example","content":"`export`: `merge_lora`: the adapter merged into the base weights (or the fine-tuned weights as they are), saved as `model.safetensors` beside the base model's config, tokenizers and chat template, then a `ctx.preview` cloning one of the dataset's clips.","locale":"en"},"14891":{"id":"/en/docs/development-training-120","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#omnivoices-trainer-as-an-example","content":"Upstream reseeds everything with its config's seed after building the model; the native trainer makes those later draws on private generators seeded the same way (the data-loader workers' seeds, the LoRA dropout masks), while the LoRA initialisation draws from the stage process's global generator in module order, as upstream does; so a seeded run gives upstream's losses and weights.","locale":"en"},"14892":{"id":"/en/docs/development-training-121","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#adding-a-trainer","content":"In the manifest, `[training.<id>]`: the stages and what they `use`, the hyperparameters, `export`, and `assets` and `devices` when needed. On the engine class, `TRAINER = \"mizuoto.engines.<id>.train:<Class>\"`.","locale":"en"},"14893":{"id":"/en/docs/development-training-122","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#adding-a-trainer","content":"A `Trainer` subclass with a `stage_<id>(ctx)` per stage, its heavy imports inside the methods. Draw from the process-wide generators in upstream's order, or from private generators where upstream reseeded; report with `ctx.progress`, `ctx.metric` and `ctx.log`. Packages training needs beyond inference go in `REQUIRES`.","locale":"en"},"14894":{"id":"/en/docs/development-training-123","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#adding-a-trainer","content":"`export` returns `artifacts` and speaks a `ctx.preview`. Add `tests/engines_native/test_<id>_train_tiny.py` (a tiny random model, a few clips, every stage), then train a small dataset end to end (the UI's Train page, or `mizuoto train new` / `mizuoto train run`), and compare it with upstream (`scripts/parity/train.py`, see Testing). Record which upstream behaviours it reproduces to give the same results in the design record `AGENTS.md` and the engine's notes.","locale":"en"},"14895":{"id":"/en/docs/development-webui","page_id":"/en/docs/development-webui","type":"page","content":"Web UI","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-webui","locale":"en"},"14896":{"id":"/en/docs/development-webui-0","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui","content":"How the Vue 3 + Material 3 interface is built: Material Design 3's token and component layers, the ui/ wrapper layer and its rule tests, the API client and queries, socket events, engine availability gates, stores, kept-alive views and i18n, and adding a screen with Projects as the example.","locale":"en"},"14897":{"id":"/en/docs/development-webui-1","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#material-design-3-layers","content":"Material Design 3 layers","locale":"en"},"14898":{"id":"/en/docs/development-webui-2","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#the-token-layer-srctheme","content":"The token layer: `src/theme/`","locale":"en"},"14899":{"id":"/en/docs/development-webui-3","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#the-component-layer-srcui","content":"The component layer: `src/ui/`","locale":"en"},"14900":{"id":"/en/docs/development-webui-4","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#the-ui-wrapper-layer","content":"The `ui/` wrapper layer","locale":"en"},"14901":{"id":"/en/docs/development-webui-5","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#rule-tests","content":"Rule tests","locale":"en"},"14902":{"id":"/en/docs/development-webui-6","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#api-client-and-queries","content":"API client and queries","locale":"en"},"14903":{"id":"/en/docs/development-webui-7","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#socket-events","content":"Socket events","locale":"en"},"14904":{"id":"/en/docs/development-webui-8","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#engine-availability","content":"Engine availability","locale":"en"},"14905":{"id":"/en/docs/development-webui-9","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#forms-that-follow-the-model","content":"Forms that follow the model","locale":"en"},"14906":{"id":"/en/docs/development-webui-10","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#stores","content":"Stores","locale":"en"},"14907":{"id":"/en/docs/development-webui-11","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#kept-alive-views","content":"Kept-alive views","locale":"en"},"14908":{"id":"/en/docs/development-webui-12","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#i18n","content":"i18n","locale":"en"},"14909":{"id":"/en/docs/development-webui-13","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#adding-a-screen-projects","content":"Adding a screen: Projects","locale":"en"},"14910":{"id":"/en/docs/development-webui-14","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui","content":"The web UI is a Vue 3 project in `mizuoto/webui/`. Its components are Material Web (`@material/web`), its icons Lucide (`@lucide/vue`), its data layer TanStack Query (`@tanstack/vue-query`) with `openapi-fetch`, its state Pinia. The build, `mizuoto/webui/dist/`, ships in the wheel as package data and is served by the API's `SPAStaticFiles` (see HTTP API and command line). The base (`theme/`, `ui/`, motion, layers, the shell, stores, i18n, rule tests) is rvc-next's; where it comes from is in Design references and decisions.","locale":"en"},"14911":{"id":"/en/docs/development-webui-15","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui","content":"While developing, `python scripts/dev.py dev` runs the API server and Vite together (`http://localhost:5173`); Vite proxies `/api` and `/ws` to `MIZUOTO_BACKEND` (default `http://127.0.0.1:7869`). When the API server restarts, the proxy's connection errors become one short line (`vite.config.ts`, tested in `devProxy.test.ts`). Setting up is in Development setup.","locale":"en"},"14912":{"id":"/en/docs/development-webui-16","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#material-design-3-layers","content":"The UI is built on Material Design 3 (M3) in two layers: a **token layer** that everything reads, and a **component layer** on top of it. The token layer depends on no component library; the component layer can be replaced piece by piece.","locale":"en"},"14913":{"id":"/en/docs/development-webui-17","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"File","locale":"en"},"14914":{"id":"/en/docs/development-webui-18","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"Holds","locale":"en"},"14915":{"id":"/en/docs/development-webui-19","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"`scheme.ts`","locale":"en"},"14916":{"id":"/en/docs/development-webui-20","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"Every colour role (`primary`, `on-primary`, `surface-container`, `outline`…) generated from one seed colour with `@material/material-color-utilities`' Tonal Spot scheme, light and dark, at contrast 0 (standard), 0.5 (medium) and 1 (high)","locale":"en"},"14917":{"id":"/en/docs/development-webui-21","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"`applyTheme.ts`","locale":"en"},"14918":{"id":"/en/docs/development-webui-22","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"Writes the roles as `--md-sys-color-*` on `:root` and sets `data-theme`","locale":"en"},"14919":{"id":"/en/docs/development-webui-23","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"`tokens.css`","locale":"en"},"14920":{"id":"/en/docs/development-webui-24","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"The static tokens: the 15 type styles (`--md-sys-typescale-*`, on the Roboto Flex variable font), corner shapes (`--md-sys-shape-corner-*`), motion easings and durations (`--md-sys-motion-*`), state-layer opacities (hover 8 %, focus 10 %, pressed 10 %, dragged 16 %, from `@material/web` 2.5.0's token file; disabled content 38 %, container 12 %, from its component tokens), shadows, spacing (on a 4px unit), in-page z-order and widths that grow with the window; and fallback colours for the first paint","locale":"en"},"14921":{"id":"/en/docs/development-webui-25","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"`breakpoints.ts`","locale":"en"},"14922":{"id":"/en/docs/development-webui-26","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"M3's window size classes: compact (\\< 600px), medium (\\< 840px), expanded (\\< 1200px), large (\\< 1600px), extra-large","locale":"en"},"14923":{"id":"/en/docs/development-webui-27","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"**Colours come from the seed only.** The default seed is `#4f6b3a`; users pick any colour, contrast, light or dark (system, light, dark) and motion in Settings › Appearance. Preferences live in localStorage and are synced to the server through `/api/v1/client-state/{key}`. A small script in `index.html` reads them and sets `data-theme` before the bundle runs, so the first paint does not flash the wrong theme.","locale":"en"},"14924":{"id":"/en/docs/development-webui-28","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"**Tokens use Google's official names** (`--md-sys-*`), so `@material/web`'s components read them with no mapping; the project's own tokens start with `--app-`.","locale":"en"},"14925":{"id":"/en/docs/development-webui-29","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"**Elevation is shown by surface tone first** (`surface`, `surface-container-low` … `surface-container-highest`), shadows second.","locale":"en"},"14926":{"id":"/en/docs/development-webui-30","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"**Colour roles are used in pairs**: content on a `primary` container uses `on-primary`, on `surface-container` `on-surface`; the generated pairs guarantee contrast.","locale":"en"},"14927":{"id":"/en/docs/development-webui-31","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"**Motion**: named transitions (`fade-through`, `shared-axis-x`, `container`, `sheet`, `scrim`, `list`…, in `ui/motion/`), and a container transform from a list to an item through View Transitions where the browser has them. With reduced motion chosen by the system or in the app, every transition becomes a 100 ms fade and there is no ripple.","locale":"en"},"14928":{"id":"/en/docs/development-webui-32","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"**Layout**: a bottom navigation bar on compact windows, a navigation rail on wider ones (`AppShell`). The bar keeps Material 3's three to five destinations: past five, the first four and **More**, an `AppMenu` with the rest (current while one of them is; with the rail's dot while one has a badge); its destinations shrink with the window, so it never widens the page (with all eight it made every page 512 px wide on a 390 px phone).","locale":"en"},"14929":{"id":"/en/docs/development-webui-33","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-token-layer-srctheme","content":"The font (`@fontsource-variable/roboto-flex`) and the icons are bundled into `dist/`: the UI loads nothing from outside and works offline.","locale":"en"},"14930":{"id":"/en/docs/development-webui-34","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-component-layer-srcui","content":"The components `@material/web` has are wrapped in project Vue components: buttons (`AppButton`: filled, tonal, outlined, text), icon buttons, FAB, checkbox, filter chip, divider, text field and text area, slider, linear and circular progress, switch, tabs. The wrapper owns the props, the event names and the types; `vite.config.ts` declares `md-*` tags as custom elements.","locale":"en"},"14931":{"id":"/en/docs/development-webui-35","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-component-layer-srcui","content":"What `@material/web` lacks is built from tokens in the same folder: the shell, navigation bar and rail, top app bar, card, dialog, side sheet, menus and picker menu, snackbar, tooltip, segmented button, select, expansion panel, stepper, data list, line chart, waveform, spectrogram, level meter and more.","locale":"en"},"14932":{"id":"/en/docs/development-webui-36","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-component-layer-srcui","content":"Both kinds read the same tokens and look alike. `@material/web` is in maintenance mode and gains no components; should one break with a future browser or Vue version, it is replaced inside `src/ui/` and feature code does not change.","locale":"en"},"14933":{"id":"/en/docs/development-webui-37","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-component-layer-srcui","content":"Icons are Lucide (`@lucide/vue`), not Material Symbols, imported only in `ui/icons.ts`.","locale":"en"},"14934":{"id":"/en/docs/development-webui-38","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-component-layer-srcui","content":"Button emphasis: at most one filled button per region (a view's main action, such as Speak or Train), tonal for secondary actions, outlined or text for the rest. Interactive elements have a visible focus indicator and, as a rule, a target of at least 48×48px (`dense` controls in compact rows and cards excepted).","locale":"en"},"14935":{"id":"/en/docs/development-webui-39","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-component-layer-srcui","content":"MUI is not used (it implements Material Design 2), nor is M3 Expressive; the token layer keeps shape and motion values in one place, so they can change by tokens alone.","locale":"en"},"14936":{"id":"/en/docs/development-webui-40","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-ui-wrapper-layer","content":"`src/ui/index.ts` is the only way to the shared components:","locale":"en"},"14937":{"id":"/en/docs/development-webui-41","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-ui-wrapper-layer","content":"Only components under `ui/` (plus `theme/tokens.css` and the tests' `test/setup.ts`) import `@material/web`. Views and feature components import `AppButton`, `TextField`, `AppDialog`, `SegmentedButton`, `Stepper`, `LineChart`… from `@/ui`.","locale":"en"},"14938":{"id":"/en/docs/development-webui-42","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-ui-wrapper-layer","content":"Icons are re-exported through `ui/icons.ts` too; `ui/` is the only place that imports `@lucide/vue`. Add a new icon there first, then use it as `icons.X`. `AppIcon` sets `fill: none`: Material buttons fill slotted icons, which turned Lucide's strokes into blobs.","locale":"en"},"14939":{"id":"/en/docs/development-webui-43","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-ui-wrapper-layer","content":"Styles use tokens only: the colour roles `--md-sys-color-*` (generated from the seed colour by `applyTheme.ts`), spacing `--app-space-*`, in-page stacking `--app-z-*`, type classes such as `type-title-large`.","locale":"en"},"14940":{"id":"/en/docs/development-webui-44","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-ui-wrapper-layer","content":"`ui/layers.ts` is the one record of everything open over the page (dialogs, sheets, menus, pickers), in the order it opened: a later layer paints above earlier ones, Escape and outside clicks close only the topmost, everything under a modal layer is `inert`, and focus moves into a layer and back when it closes. A new overlay component registers there instead of setting its own z-index. A tooltip (`Tooltip`) takes no place in the stack: it is rendered at the end of the document, fixed against its content and kept inside the window, at `tooltipZ` (over every open layer and the snackbar), so a sticky footer or a pane beside the navigation rail cannot clip or cover it.","locale":"en"},"14941":{"id":"/en/docs/development-webui-45","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#the-ui-wrapper-layer","content":"The `/dev` route (`DevComponentsView.vue`) shows every `ui/` component, for checking them by eye.","locale":"en"},"14942":{"id":"/en/docs/development-webui-46","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"Several conventions are vitest tests; breaking one fails `dev.py test-web`:","locale":"en"},"14943":{"id":"/en/docs/development-webui-47","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"Test","locale":"en"},"14944":{"id":"/en/docs/development-webui-48","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"Rule","locale":"en"},"14945":{"id":"/en/docs/development-webui-49","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"`src/imports.test.ts`","locale":"en"},"14946":{"id":"/en/docs/development-webui-50","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"Modules under `src/` import each other through the `@/` alias, never by a relative path","locale":"en"},"14947":{"id":"/en/docs/development-webui-51","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"`src/tokens.test.ts`","locale":"en"},"14948":{"id":"/en/docs/development-webui-52","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"No hex colours in `.vue` and `.css` files (outside `<script>`) except under `src/theme/`","locale":"en"},"14949":{"id":"/en/docs/development-webui-53","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"`src/layout.test.ts`","locale":"en"},"14950":{"id":"/en/docs/development-webui-54","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"In rows that hold a file name the text element has `min-width: 0` (a long name must not push the buttons out of view); Speak and a voice's page are one column of sections with their actions in `PageFooter`; a button beside a field is centred on it; sections are never side by side","locale":"en"},"14951":{"id":"/en/docs/development-webui-55","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"`src/ui/layers.test.ts`","locale":"en"},"14952":{"id":"/en/docs/development-webui-56","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"The layers' keyboard, painting, outside-click, modality and focus rules","locale":"en"},"14953":{"id":"/en/docs/development-webui-57","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"`src/i18n/i18n.test.ts`","locale":"en"},"14954":{"id":"/en/docs/development-webui-58","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"`zh-CN` has exactly `en`'s keys and the same placeholders; the fixed vocabulary (\"音色\", \"合成\", \"克隆\") holds; every server error code has a title","locale":"en"},"14955":{"id":"/en/docs/development-webui-59","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"`src/ui/ui.test.ts` and others","locale":"en"},"14956":{"id":"/en/docs/development-webui-60","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"Single components, motion helpers, theme generation, window size classes, navigation","locale":"en"},"14957":{"id":"/en/docs/development-webui-61","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#rule-tests","content":"\"Views import components only from `@/ui`\" is a convention; no test enforces it yet.","locale":"en"},"14958":{"id":"/en/docs/development-webui-62","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#api-client-and-queries","content":"`api/client.ts` makes one `openapi-fetch` client from the generated `paths` type:","locale":"en"},"14959":{"id":"/en/docs/development-webui-63","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#api-client-and-queries","content":"`BASE_URL` (`api/baseUrl.ts`) is derived from the running script's URL: everything before the last `/assets/` is the deployment root. No API address is compiled in, so the UI works under `api_prefix` unchanged. Routing uses hash history, so any sub-path works without server-side rewrites.","locale":"en"},"14960":{"id":"/en/docs/development-webui-64","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#api-client-and-queries","content":"`unwrap(call)` returns the data or throws `ApiError(status, code, message, detail)`; FastAPI's own 422 validation errors become `invalid_input`. `components/errors.ts` turns it into a title (`errors.<code>`), a hint (`detail.hint`) and details on screen.","locale":"en"},"14961":{"id":"/en/docs/development-webui-65","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#api-client-and-queries","content":"Media URLs (`urls.output()`, `urls.audioFile()`) are fetched by `<audio>` directly and authenticated by the `mizuoto_token` cookie; uploads use `uploadRaw()` (XMLHttpRequest, for progress; the body is raw bytes).","locale":"en"},"14962":{"id":"/en/docs/development-webui-66","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#api-client-and-queries","content":"Types come from `api/types.ts`: `S = components['schemas']` plus aliases for the common models. Models used both as request and response are split, e.g. send `S['SpeakRequest-Input']`, read `S['SpeakRequest-Output']`.","locale":"en"},"14963":{"id":"/en/docs/development-webui-67","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#api-client-and-queries","content":"`api/queries/<resource>.ts` wraps endpoints as composables: `useQuery` to read, `useMutation` to write. Query keys live in `api/queries/keys.ts`, shared by the query modules and the socket handlers:","locale":"en"},"14964":{"id":"/en/docs/development-webui-68","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#api-client-and-queries","content":"Keys are hierarchical, so invalidating `keys.projects` invalidates the list and every project. The `QueryClient` in `main.ts` does not refetch on window focus and does not retry 4xx errors.","locale":"en"},"14965":{"id":"/en/docs/development-webui-69","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#socket-events","content":"`connectSocket(qc)` in `api/socket.ts` connects once (when `App.vue` mounts), at `${BASE_PATH}/ws/socket.io`, with the token in the handshake's `auth`. Its listeners are typed from the schema's `ServerEvents`:","locale":"en"},"14966":{"id":"/en/docs/development-webui-70","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#socket-events","content":"REST is the source of truth; events only patch or invalidate queries:","locale":"en"},"14967":{"id":"/en/docs/development-webui-71","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#socket-events","content":"`job_updated` goes into the jobs store (`upsert` drops a snapshot older than the state it holds) and into `keys.job(id)`; when a job finishes, the `AFFECTS` table invalidates the lists its kind changes, e.g. `project_render` → `keys.projects`, `train` → experiments, voices, models and outputs.","locale":"en"},"14968":{"id":"/en/docs/development-webui-72","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#socket-events","content":"`runtime_changed` (the loaded models, for the **Models in memory** sheet, `LoadedModelsSheet`) and `compute_changed` are written into the query data directly (`keys.runtime`, `keys.computeUsage`); `train_metrics` appends its points to the experiment's metrics.","locale":"en"},"14969":{"id":"/en/docs/development-webui-73","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#socket-events","content":"The other `*_changed` events invalidate their keys through `createInvalidator()`, so a burst within 300 ms causes one refetch.","locale":"en"},"14970":{"id":"/en/docs/development-webui-74","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#socket-events","content":"On connect and reconnect the active jobs are fetched again (`resync()`); a reconnect also invalidates the usual lists on screen.","locale":"en"},"14971":{"id":"/en/docs/development-webui-75","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#socket-events","content":"`job_log` goes to the open log viewers (`onJobLog(jobId, listener)`); an event holds at most 50 lines, the rest come over REST.","locale":"en"},"14972":{"id":"/en/docs/development-webui-76","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#engine-availability","content":"Every engine is installed with Mizuoto, but one can still be *missing* something: torch, or a licence-gated engine's own distribution. The engine list (`EngineStatus.available`, `missing`) and the doctor's report (`useDoctor(engine)` in `api/queries/engines.ts`: `GET /api/v1/engines/{id}/doctor`, or `GET /api/v1/runtime/doctor` for all) drive what the UI offers:","locale":"en"},"14973":{"id":"/en/docs/development-webui-77","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#engine-availability","content":"**`ModelGate`** (`components/ModelGate.vue`) replaces Speak's main button with the one action a model still needs, checked in this order: enable the engine, accept its licence, install what is missing, download the model. For a missing package it shows the command: the doctor's `install_command` for torch (the build for this machine), else `pip install <package>`; for an engine on a remote host it says the host lacks it.","locale":"en"},"14974":{"id":"/en/docs/development-webui-78","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#engine-availability","content":"**`EngineCard`** shows **Available** or **Not available** with the missing packages, and a doctor panel with the findings for that engine (torch, extras, training).","locale":"en"},"14975":{"id":"/en/docs/development-webui-79","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#engine-availability","content":"**`ModelsView`** marks each engine group whose engine is unavailable and says what it needs.","locale":"en"},"14976":{"id":"/en/docs/development-webui-80","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#engine-availability","content":"**`SettingsView`** shows the torch check under **Compute** (the doctor's `torch` finding): the installed version and build, and the command that installs the recommended build when they differ.","locale":"en"},"14977":{"id":"/en/docs/development-webui-81","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#forms-that-follow-the-model","content":"Speak and a project's cast show only what the chosen model takes, and keep what was set for another model so that choosing it again brings it back. The server refuses what a model does not take (an explicit request is never trimmed), so a hidden value that was sent would fail the synthesis. Hence one rule: **a value the form does not show is never sent.**","locale":"en"},"14978":{"id":"/en/docs/development-webui-82","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#forms-that-follow-the-model","content":"**Speak** builds its request only in `components/speakForm.ts` (`speakRequest(spec, form)`), from the model's spec (`ModelParamSpecs`), with the same functions the template uses to decide what to show: `emotionWays`/`shownWay`, `instructFit` (the instruction and `instruct_requires`, the voice modes it needs), `designFor`, `speaks`, `fieldsFor`, `takesSeed`. A new field on the form gets its rule there and a case in `speakForm.test.ts`; a rule the server checks a request against belongs in the spec, so the UI can follow it.","locale":"en"},"14979":{"id":"/en/docs/development-webui-83","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#forms-that-follow-the-model","content":"Form state lives in the view, not in child components: `EmotionPanel` holds no values of its own. A child's state cannot be reset reliably on a model change, because the child may be unmounted in the same update (its section hidden, or the new spec still loading), and its watchers go with it.","locale":"en"},"14980":{"id":"/en/docs/development-webui-84","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#forms-that-follow-the-model","content":"Parameters and engine options are a model's own: a new model starts from its defaults or its default preset. \"Run again\" sets them for the new model in the same watcher that resets them.","locale":"en"},"14981":{"id":"/en/docs/development-webui-85","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#forms-that-follow-the-model","content":"**Projects** keep a speaker's settings on disk across changes of model, made from any screen or the CLI, so the server applies the rule: `ProjectService._request` sends a line's model only the instruction, parameters and options it takes (`TtsService.settings_fit`), and `Project.instruct_unused` (computed when read, never stored) names the speakers whose instruction is kept but not used. The voice and the language are sent as they are and fail clearly.","locale":"en"},"14982":{"id":"/en/docs/development-webui-86","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"Store","locale":"en"},"14983":{"id":"/en/docs/development-webui-87","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"Holds","locale":"en"},"14984":{"id":"/en/docs/development-webui-88","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"`auth`","locale":"en"},"14985":{"id":"/en/docs/development-webui-89","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"The token (localStorage and the `mizuoto_token` cookie), whether one is needed","locale":"en"},"14986":{"id":"/en/docs/development-webui-90","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"`jobs`","locale":"en"},"14987":{"id":"/en/docs/development-webui-91","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"The jobs this session knows: every active job, and those that finished while the page was open; the screen each was started from (`upsert(job, from)`, `fromScreen()`); `onFinished()` for \"a job started on another screen finished\" notices. Progress updates are frequent, so they land here rather than in the query cache","locale":"en"},"14988":{"id":"/en/docs/development-webui-92","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"`preferences`","locale":"en"},"14989":{"id":"/en/docs/development-webui-93","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"Theme, seed colour, contrast, language, motion, last screen, Speak's last choices; kept in localStorage and synced to the server through `/api/v1/client-state/{key}`, so they follow the user across browsers","locale":"en"},"14990":{"id":"/en/docs/development-webui-94","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"`player`","locale":"en"},"14991":{"id":"/en/docs/development-webui-95","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"The page's one player (`audio/player.ts`)","locale":"en"},"14992":{"id":"/en/docs/development-webui-96","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"`handoff`","locale":"en"},"14993":{"id":"/en/docs/development-webui-97","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stores","content":"Hand-offs between screens: \"Re-run with these settings\", \"Use this voice\", \"Use as reference\"; Speak takes them when it opens","locale":"en"},"14994":{"id":"/en/docs/development-webui-98","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#kept-alive-views","content":"`App.vue` wraps `RouterView` in `KeepAlive :max=\"12\"`, so each page keeps its state while another is shown. The cache key is:","locale":"en"},"14995":{"id":"/en/docs/development-webui-99","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#kept-alive-views","content":"List pages get one instance per route; the detail pages of voices, datasets, experiments and projects one per path. The shell's scroller is shared, so each page's scroll offset is kept in `offsets` and put back inside the view transition's update. A kept-alive page is not unmounted: whatever must be saved on leaving hooks both `onDeactivated` and `onBeforeUnmount` (as `ProjectView.vue`'s draft does).","locale":"en"},"14996":{"id":"/en/docs/development-webui-100","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#kept-alive-views","content":"Each route's `meta.screen` in `router.ts` names the navigation destination it belongs to; `addressOf(screen)` remembers each destination's last address, so the navigation goes back to the voice or project it left rather than to the list.","locale":"en"},"14997":{"id":"/en/docs/development-webui-101","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#i18n","content":"`i18n/en.ts` is the message tree; `zh-CN.ts` must have exactly the same keys (tested). `useI18n()` gives `t(key, params)` with placeholders written `{n}`; the locale comes from the preferences, `auto` following the system language. Keys built from a server value (an error code, a stage id) use `tOr(key, fallback)`, which shows a readable fallback when there is no message. Add new text to both files at once.","locale":"en"},"14998":{"id":"/en/docs/development-webui-102","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"The Projects screen (long-form scripts read line by line by a cast of voices) is the most recent complete screen and makes a good template. Its API is `mizuoto/api/routers/projects.py`; its event is `projects_changed`.","locale":"en"},"14999":{"id":"/en/docs/development-webui-103","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"**Generate the types.** With the routes in place, run `python scripts/dev.py typegen`; `schema.d.ts` gains `/api/v1/projects` and friends and the `Project`, `ProjectInput`… models. Alias them in `api/types.ts`:","locale":"en"},"15000":{"id":"/en/docs/development-webui-104","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"**Keys and queries.** Add `projects` and `project(id)` to `api/queries/keys.ts` and create `api/queries/projects.ts`:","locale":"en"},"15001":{"id":"/en/docs/development-webui-105","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"**The socket.** Handle the new event in `api/socket.ts` and list the keys the new job kinds affect in `AFFECTS`:","locale":"en"},"15002":{"id":"/en/docs/development-webui-106","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"Add `keys.projects` to the lists invalidated on reconnect.","locale":"en"},"15003":{"id":"/en/docs/development-webui-107","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"**The views.** `views/ProjectsView.vue` is the list: `useProjects()`, `EmptyState`, a grid of `AppCard`s and `NewProjectDialog`. `views/ProjectView.vue` is the detail page, taking the route's `id` as a prop: edits live in a local draft saved with `PUT` 800 ms after typing stops, and on `onDeactivated` and `onBeforeUnmount`; a running render is found in the jobs store by `kind` and `request.project` and shown with `JobCard`; the main actions sit in `PageFooter`. \"Try in Speak\" on a line hands the request to Speak through `handoff.sendRequest()`. Components come from `@/ui` only; styles use tokens only.","locale":"en"},"15004":{"id":"/en/docs/development-webui-108","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"**The routes.** Add them to `router.ts` with `meta.screen` naming the destination; if it can be the remembered last screen, add it to `SCREENS`:","locale":"en"},"15005":{"id":"/en/docs/development-webui-109","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"**Navigation and keep-alive.** Add an entry to `nav` in `App.vue` (the icon first goes into `ui/icons.ts`); add the detail prefix to `viewKey` when each item needs its own instance, and the screen to the `lastScreen` watcher when it should be remembered:","locale":"en"},"15006":{"id":"/en/docs/development-webui-110","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"**Text and tests.** Add `nav.projects` and `projects.*` to `en.ts` and `zh-CN.ts`; rows that may hold a long name get `min-width: 0` (listed in `layout.test.ts` where it matters). Run `python scripts/dev.py test-web` (vitest and `vue-tsc`).","locale":"en"},"15007":{"id":"/en/docs/development-webui-111","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#adding-a-screen-projects","content":"How tests are written and what CI runs is in Testing.","locale":"en"},"15008":{"id":"/en/docs/development","page_id":"/en/docs/development","type":"page","content":"Development","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development","locale":"en"},"15009":{"id":"/en/docs/development-0","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development","content":"The entry point for contributors: what Mizuoto is made of, what is authoritative, and what each development page covers.","locale":"en"},"15010":{"id":"/en/docs/development-1","page_id":"/en/docs/development","type":"heading","tags":[],"url":"/en/docs/development#what-is-authoritative","content":"What is authoritative","locale":"en"},"15011":{"id":"/en/docs/development-2","page_id":"/en/docs/development","type":"heading","tags":[],"url":"/en/docs/development#one-environment-one-process","content":"One environment, one process","locale":"en"},"15012":{"id":"/en/docs/development-3","page_id":"/en/docs/development","type":"heading","tags":[],"url":"/en/docs/development#pages","content":"Pages","locale":"en"},"15013":{"id":"/en/docs/development-4","page_id":"/en/docs/development","type":"heading","tags":[],"url":"/en/docs/development#conventions-that-hold-everywhere","content":"Conventions that hold everywhere","locale":"en"},"15014":{"id":"/en/docs/development-5","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development","content":"This section is for people who want to change Mizuoto: fix a bug, add an engine, a training method, a screen or an API route. It describes what the code **is** now, the rules it keeps and why, not how to use it (for that, see the guides and the command line).","locale":"en"},"15015":{"id":"/en/docs/development-6","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#what-is-authoritative","content":"**The code** and its tests: when anything else disagrees with them, they win.","locale":"en"},"15016":{"id":"/en/docs/development-7","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#what-is-authoritative","content":"**This site's development pages**: the design as built, the rules and why, one page per area, and one page per\nengine in the engine reference (the upstream behaviour each engine reproduces, its deviations, its\ntrainer and its parity result). Read the page for the area you change; a change of design updates it, in both\nlanguages.","locale":"en"},"15017":{"id":"/en/docs/development-8","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#what-is-authoritative","content":"**`AGENTS.md`** (repository root; `CLAUDE.md` points to it): the short working record for contributors and coding\nagents: a map of the code, the rules that must not break, the workflow, and which page covers what.","locale":"en"},"15018":{"id":"/en/docs/development-9","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"Mizuoto 0.2 is one Python distribution installed into one environment. Every engine (Qwen3-TTS, F5-TTS, OmniVoice, CosyVoice, GPT-SoVITS, VoxCPM, Fish Speech, IndexTTS and the internal Whisper ASR) is implemented in Mizuoto on its own runtime and runs **in the server's own process**. There is no upstream code, no transformers, no environment per engine and no worker process.","locale":"en"},"15019":{"id":"/en/docs/development-10","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"Distribution","locale":"en"},"15020":{"id":"/en/docs/development-11","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"Where","locale":"en"},"15021":{"id":"/en/docs/development-12","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"What","locale":"en"},"15022":{"id":"/en/docs/development-13","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"`mizuoto`","locale":"en"},"15023":{"id":"/en/docs/development-14","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"`mizuoto/`","locale":"en"},"15024":{"id":"/en/docs/development-15","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"The core, the API, the command line, the web UI (its built `dist/` ships in the wheel), the runtime, the building blocks and every engine under a permissive licence","locale":"en"},"15025":{"id":"/en/docs/development-16","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"`mizuoto-fishspeech`","locale":"en"},"15026":{"id":"/en/docs/development-17","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"`packages/native/fishspeech/`","locale":"en"},"15027":{"id":"/en/docs/development-18","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"Fish Speech, under the Fish Audio Research License","locale":"en"},"15028":{"id":"/en/docs/development-19","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"`mizuoto-indextts`","locale":"en"},"15029":{"id":"/en/docs/development-20","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"`packages/native/indextts/`","locale":"en"},"15030":{"id":"/en/docs/development-21","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"IndexTTS, under the bilibili Model Use License","locale":"en"},"15031":{"id":"/en/docs/development-22","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"The two licence-gated engines are separate distributions only because of their licences. They install into the same environment and register themselves under the Python entry-point group `mizuoto.engines`.","locale":"en"},"15032":{"id":"/en/docs/development-23","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#one-environment-one-process","content":"The boundary that decides where code goes is now inside the package: **`mizuoto/core` never imports torch at module level**, and `mizuoto/core/inference` is its only door to model code (`mizuoto.runtime`, `mizuoto.nn`, `mizuoto.engines`, `mizuoto.training`), always imported inside functions. So `mizuoto version`, `mizuoto --help` and the core's own tests load no torch, and a command that never loads a model never imports the runtime. Architecture starts from that rule.","locale":"en"},"15033":{"id":"/en/docs/development-24","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Development setup\" href=\"/docs/development-setup\" description=\"The .venv with a CPU torch, the gated engines, bun, every scripts/dev.py task.\" />","locale":"en"},"15034":{"id":"/en/docs/development-25","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Conventions\" href=\"/docs/development-conventions\" description=\"Code style, the layer rules, the rules for native code, exactness, tests, documentation and commits.\" />","locale":"en"},"15035":{"id":"/en/docs/development-26","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Architecture\" href=\"/docs/development-architecture\" description=\"Layout and the layer rules, how Services are built, one synthesis request end to end, settings, events, jobs, errors.\" />","locale":"en"},"15036":{"id":"/en/docs/development-27","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Design references and decisions\" href=\"/docs/development-design\" description=\"Where the design comes from (ComfyUI, InvokeAI, SD Model Hub, Material Design 3) and the decisions taken, with their reasons.\" />","locale":"en"},"15037":{"id":"/en/docs/development-28","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Runtime\" href=\"/docs/development-runtime\" description=\"Devices, the model manager and handles, the request context, global-state rules, LocalEngine, cancel, streams, remote engines.\" />","locale":"en"},"15038":{"id":"/en/docs/development-29","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Memory\" href=\"/docs/development-memory\" description=\"Phases, the budget, partial loading and weight streaming, the exact out-of-memory retry, estimates and calibration.\" />","locale":"en"},"15039":{"id":"/en/docs/development-30","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Acceleration\" href=\"/docs/development-acceleration\" description=\"Attention backends, CUDA graphs, sync-free sampling, torch.compile and the CPU settings, and what stays exact.\" />","locale":"en"},"15040":{"id":"/en/docs/development-31","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Performance record\" href=\"/docs/development-performance\" description=\"How speed is measured without changing results, and the measured record.\" />","locale":"en"},"15041":{"id":"/en/docs/development-32","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Adding an engine\" href=\"/docs/development-engine\" description=\"The manifest and files manifest, the Engine and LoadedEngine contract, registration, tests and parity, with OmniVoice as the example.\" />","locale":"en"},"15042":{"id":"/en/docs/development-33","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Trainers\" href=\"/docs/development-training\" description=\"Trainer and StageContext, stages as child processes, fingerprints and stale stages, exports.\" />","locale":"en"},"15043":{"id":"/en/docs/development-34","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"API and CLI\" href=\"/docs/development-api\" description=\"The FastAPI app, security middleware, errors to HTTP, OpenAPI with events, typegen, adding a route and a command.\" />","locale":"en"},"15044":{"id":"/en/docs/development-35","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Web UI\" href=\"/docs/development-webui\" description=\"Vue 3 + Material 3: the ui/ layer and its rule tests, queries, socket events, availability gates, i18n, and adding a screen.\" />","locale":"en"},"15045":{"id":"/en/docs/development-36","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Testing\" href=\"/docs/development-testing\" description=\"Test layout, the dummy engine, tiny random models, the contract suite, the parity harness, web tests and CI.\" />","locale":"en"},"15046":{"id":"/en/docs/development-37","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Release\" href=\"/docs/development-release\" description=\"Versions in lockstep, wheels, the smoke test, CI and the release workflow, Docker, the model mirror and this site.\" />","locale":"en"},"15047":{"id":"/en/docs/development-38","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#pages","content":"<Card title=\"Engine reference\" href=\"/docs/engines\" description=\"One page per engine: what it reproduces from upstream, its deviations, memory and speed, training and parity.\" />","locale":"en"},"15048":{"id":"/en/docs/development-39","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#conventions-that-hold-everywhere","content":"In short (the full list is Conventions):","locale":"en"},"15049":{"id":"/en/docs/development-40","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#conventions-that-hold-everywhere","content":"Python ≥ 3.10; ruff and ty unpinned, with `lint.select` written out; line length 180; every function annotated (tests and scripts exempt).","locale":"en"},"15050":{"id":"/en/docs/development-41","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#conventions-that-hold-everywhere","content":"Models that cross the API boundary derive from `Record` in `mizuoto/core/record.py` (pydantic v2, `json_schema_serialization_defaults_required`).","locale":"en"},"15051":{"id":"/en/docs/development-42","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#conventions-that-hold-everywhere","content":"Heavy imports go inside functions; a class that annotates with `list[...]` has no method named `list`.","locale":"en"},"15052":{"id":"/en/docs/development-43","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#conventions-that-hold-everywhere","content":"Native code changes no process-wide state: randomness comes from the request's generators (see Runtime).","locale":"en"},"15053":{"id":"/en/docs/development-44","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#conventions-that-hold-everywhere","content":"A new CLI command is also added to `EXPECTED_TREE` in `tests/cli/test_cli.py`.","locale":"en"},"15054":{"id":"/en/docs/development-45","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#conventions-that-hold-everywhere","content":"Commit and open PRs only when asked.","locale":"en"},"15055":{"id":"/en/docs/engines-asr","page_id":"/en/docs/engines-asr","type":"page","content":"Speech recognition (Whisper, Paraformer)","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-asr","locale":"en"},"15056":{"id":"/en/docs/engines-asr-0","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr","content":"The internal speech recognition engine: Whisper large-v3-turbo, reproducing the transformers pipeline Mizuoto 0.1 used, and for Chinese FunASR's Paraformer-large with FSMN-VAD and CT-Transformer punctuation, as GPT-SoVITS transcribes; their memory notes and parity results.","locale":"en"},"15057":{"id":"/en/docs/engines-asr-1","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#variant-and-files","content":"Variant and files","locale":"en"},"15058":{"id":"/en/docs/engines-asr-2","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#how-it-works","content":"How it works","locale":"en"},"15059":{"id":"/en/docs/engines-asr-3","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15060":{"id":"/en/docs/engines-asr-4","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#deviations","content":"Deviations","locale":"en"},"15061":{"id":"/en/docs/engines-asr-5","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#memory","content":"Memory","locale":"en"},"15062":{"id":"/en/docs/engines-asr-6","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#parity","content":"Parity","locale":"en"},"15063":{"id":"/en/docs/engines-asr-7","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#paraformer-chinese","content":"Paraformer (Chinese)","locale":"en"},"15064":{"id":"/en/docs/engines-asr-8","page_id":"/en/docs/engines-asr","type":"heading","tags":[],"url":"/en/docs/engines-asr#limitations","content":"Limitations","locale":"en"},"15065":{"id":"/en/docs/engines-asr-9","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr","content":"Mizuoto's own speech recognition: Whisper large-v3-turbo (openai/whisper; weights MIT), used for the transcripts of reference clips and voices, for dataset preparation and for the contract suite's word error rate. Code: `mizuoto/engines/asr`. It is not offered for synthesis. It reproduces exactly what Mizuoto 0.1 ran, transformers 4.57.3's `pipeline(\"automatic-speech-recognition\")`, and gives 0.1's transcripts token for token, in about half the time on a CPU. User-facing details: Engines in depth.","locale":"en"},"15066":{"id":"/en/docs/engines-asr-10","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#variant-and-files","content":"One variant, `whisper` (catalogue model `asr/whisper-large-v3-turbo`); the model is built from `config.json`, so other Whisper sizes in the same format load too. The folder holds `config.json`, `generation_config.json`, `model.safetensors` (or `pytorch_model.bin`), `preprocessor_config.json`, `tokenizer.json` and `tokenizer_config.json`.","locale":"en"},"15067":{"id":"/en/docs/engines-asr-11","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#variant-and-files","content":"The engine answers one operation, `call(\"transcribe\", {\"path\", \"language\", \"options\"})`, which returns `{text, language, segments, duration}`. `AsrService` holds one lock for it, passes the setting `tts.asr_beams` (default 5) as `beam_size`, and caches transcripts by the audio's SHA-256, the model and that width.","locale":"en"},"15068":{"id":"/en/docs/engines-asr-12","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#variant-and-files","content":"Precision: bf16 on a CUDA GPU that has it (else fp16), fp32 elsewhere; `engines.asr.dtype` overrides.","locale":"en"},"15069":{"id":"/en/docs/engines-asr-13","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"0.1 called the pipeline with `chunk_length_s=30, batch_size=4, return_timestamps=True` and the task and language as generation arguments. The engine does the same:","locale":"en"},"15070":{"id":"/en/docs/engines-asr-14","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"The WAV is read as soundfile reads it (channels averaged) and resampled to 16 kHz by soxr (its HQ default).","locale":"en"},"15071":{"id":"/en/docs/engines-asr-15","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"Without a language, the language is detected on the first 30 s (one decoder step over the language tokens).","locale":"en"},"15072":{"id":"/en/docs/engines-asr-16","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"The audio is cut into 30 s windows overlapping by 5 s on each side, each window's features computed as `WhisperFeatureExtractor` computes them, four windows per `generate` call.","locale":"en"},"15073":{"id":"/en/docs/engines-asr-17","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"`generate` decodes each window with timestamps, by beam search with 5 beams, running Whisper's seek loop inside the window.","locale":"en"},"15074":{"id":"/en/docs/engines-asr-18","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"The windows' tokens are merged into text and timestamped segments by the pipeline's `_decode_asr`.","locale":"en"},"15075":{"id":"/en/docs/engines-asr-19","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"Module","locale":"en"},"15076":{"id":"/en/docs/engines-asr-20","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"What it is","locale":"en"},"15077":{"id":"/en/docs/engines-asr-21","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"`engine.py`","locale":"en"},"15078":{"id":"/en/docs/engines-asr-22","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"0.1's pipeline: reading, resampling, language detection, windows, `generate`, merging","locale":"en"},"15079":{"id":"/en/docs/engines-asr-23","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"`model.py`","locale":"en"},"15080":{"id":"/en/docs/engines-asr-24","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"`WhisperForConditionalGeneration` as transformers 4.57.3 computes it (the SDPA path, the encoder's clamping, the cross-attention cache)","locale":"en"},"15081":{"id":"/en/docs/engines-asr-25","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"`decoding.py`","locale":"en"},"15082":{"id":"/en/docs/engines-asr-26","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"Generation settings, the logits processors in transformers' order, the vectorised beam search, greedy decoding, the seek loop","locale":"en"},"15083":{"id":"/en/docs/engines-asr-27","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"`text.py`","locale":"en"},"15084":{"id":"/en/docs/engines-asr-28","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"Decoding as `WhisperTokenizerFast`, language ids, window bounds, `decode_asr`","locale":"en"},"15085":{"id":"/en/docs/engines-asr-29","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#how-it-works","content":"Shared: `nn/dsp/mel.py` (`hf_whisper_filters`, `hf_whisper_log_mel`), `nn/dsp/wav.py`.","locale":"en"},"15086":{"id":"/en/docs/engines-asr-30","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#what-reproduces-upstream","content":"**Five beams.** The pipeline's default generation config (`num_beams=5`) wins over the model's greedy default, so 0.1 always decoded with 5 beams, whatever `beam_size` said; the option `beam_size` 1 keeps those 5 beams, and a larger value sets the number. 0.1 never passed the option at all; Mizuoto passes `tts.asr_beams`, whose default 5 gives 0.1's transcripts. The beam search is transformers 4.57's vectorised `_beam_search` (log-softmax, then the processors, `2 × beams` candidates).","locale":"en"},"15087":{"id":"/en/docs/engines-asr-31","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#what-reproduces-upstream","content":"**The seek loop inside each window.** Every window is padded to 30 s; a decoding that ends on a timestamp pair is decoded again from that timestamp (the features shifted, zeros after), and the tokens after the pair are dropped. `_decode_asr` re-bases the restarted timestamps and merges the overlapping windows.","locale":"en"},"15088":{"id":"/en/docs/engines-asr-32","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#what-reproduces-upstream","content":"**Features** are transformers' `WhisperFeatureExtractor`, with its own float64 slaney filterbank and a transposed product, not openai-whisper's log-mel. Turbo's `tokenizer_config.json` sets `clean_up_tokenization_spaces` (\" .\" becomes \".\"), applied per segment.","locale":"en"},"15089":{"id":"/en/docs/engines-asr-33","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#what-reproduces-upstream","content":"**Attention**: the query projected then scaled by `head_dim ** -0.5`, SDPA with `scale=1` on contiguous q, k and v; the decoder causal without a mask for a multi-token prompt and unmasked per new token, its cache grown by concatenation.","locale":"en"},"15090":{"id":"/en/docs/engines-asr-34","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#deviations","content":"**The model is its own.** CosyVoice's speech tokenizers also contain a Whisper encoder, but openai's attention there (q and k each scaled by d^-¼, masked) is another computation, so the two are not shared.","locale":"en"},"15091":{"id":"/en/docs/engines-asr-35","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#deviations","content":"**Exact shortcuts**: language detection's encoder output is reused when there is a single window, and the cross-attention cache is not reordered when every beam's rows are bit-identical. Neither changes a token.","locale":"en"},"15092":{"id":"/en/docs/engines-asr-36","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#memory","content":"One phase per transcription: the whole model, the decoder marked `hot` (it runs per token and beam), `kind=\"sequence\"`. With `compute.oom_fallback`, a transcription that runs out of memory decodes one 30 s window at a time instead of four; that is another batch shape, so in rare ties a transcript may differ.","locale":"en"},"15093":{"id":"/en/docs/engines-asr-37","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#parity","content":"0.1's transcripts exactly on the CPU in fp32: text, segments, language and every window's tokens on 57 corpus clips (language detected or given) and 6 clips of 50–124 s; at module level also the features and `_decode_asr` (3000 fuzzed windows). The stack's parity cases that transcribe their reference (a Qwen3-TTS clone and a CosyVoice 2 clone) are identical as well, so the contract suite's word error rates are unchanged.","locale":"en"},"15094":{"id":"/en/docs/engines-asr-38","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#parity","content":"Through the stack, `scripts/parity/cases/asr.jsonl` (seven clips, 4–120 s, English, Chinese and mixed, language detected or given) gives 0.1's transcripts exactly on the CPU in fp32 and on a GPU (an RTX 3090, 2026-10-19): language, text and every segment's timestamps.","locale":"en"},"15095":{"id":"/en/docs/engines-asr-39","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"The `paraformer` variant (catalogue model `asr/paraformer-zh`, weights Apache-2.0) is FunASR's `AutoModel(model=paraformer-large, vad_model=fsmn-vad, punc_model=ct-punc).generate(input=path)`, the \"达摩 ASR\" GPT-SoVITS's `tools/asr/funasr_asr.py` uses for Chinese: Mandarin with English words, punctuated, numbers in characters. Code: `mizuoto/engines/asr/paraformer`, ported from FunASR 1.4.21 (MIT). `tts.asr_model_zh = \"asr/paraformer-zh\"` makes it the recogniser for clips whose language is Chinese once it is downloaded (`AsrService.model_for`); Whisper keeps every other language.","locale":"en"},"15096":{"id":"/en/docs/engines-asr-40","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"**Files.** The model's folder is the recogniser's ModelScope repository (`model.pt`, `config.yaml`, `am.mvn`, `tokens.json`), with the VAD's in `vad/` and the punctuation model's in `punc/`, each pinned to its commit; all three are on the `mizuoto-model` mirror. `AsrEngine` tells the variants apart by the folder (`config.yaml` naming `Paraformer`, `vad/` and `punc/` beside it).","locale":"en"},"15097":{"id":"/en/docs/engines-asr-41","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"Module","locale":"en"},"15098":{"id":"/en/docs/engines-asr-42","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"What it is","locale":"en"},"15099":{"id":"/en/docs/engines-asr-43","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`paraformer/engine.py`","locale":"en"},"15100":{"id":"/en/docs/engines-asr-44","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`inference_with_vad` as it runs on the CPU: reading, resampling, VAD, a segment at a time, joining, punctuation","locale":"en"},"15101":{"id":"/en/docs/engines-asr-45","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`paraformer/model.py`","locale":"en"},"15102":{"id":"/en/docs/engines-asr-46","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`WavFrontend` (Kaldi fbank, LFR 7/6, CMVN), `SANMEncoder` (50 layers), `CifPredictorV2`, `ParaformerSANMDecoder`, greedy decoding","locale":"en"},"15103":{"id":"/en/docs/engines-asr-47","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`paraformer/sanm.py`","locale":"en"},"15104":{"id":"/en/docs/engines-asr-48","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"SAN-M layers (attention with an FSMN memory block), shared by the recogniser and the punctuation model","locale":"en"},"15105":{"id":"/en/docs/engines-asr-49","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`paraformer/vad.py`","locale":"en"},"15106":{"id":"/en/docs/engines-asr-50","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"FSMN-VAD: `WavFrontendOnline`, the FSMN, and the streaming state machine as file inference drives it","locale":"en"},"15107":{"id":"/en/docs/engines-asr-51","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`paraformer/punc.py`","locale":"en"},"15108":{"id":"/en/docs/engines-asr-52","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"CT-Transformer: word splitting, mini-sentences with their carry-over, the punctuation rules","locale":"en"},"15109":{"id":"/en/docs/engines-asr-53","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`paraformer/text.py`","locale":"en"},"15110":{"id":"/en/docs/engines-asr-54","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"`sentence_postprocess` (tokens to text, English words, abbreviations) and `_join_vad_texts`","locale":"en"},"15111":{"id":"/en/docs/engines-asr-55","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"**What reproduces upstream.**","locale":"en"},"15112":{"id":"/en/docs/engines-asr-56","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"The clip read as `torchaudio.load` reads it and resampled by `torchaudio.transforms.Resample` (`nn/dsp/resample.Resample`).","locale":"en"},"15113":{"id":"/en/docs/engines-asr-57","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"FSMN-VAD's segments as FunASR 1.4.21 makes them: 60 s chunks with the frontend's held-back samples, the LFR context, the FSMN's memory and the state machine carried across them, and the dynamic silence schedule that replaces the config's end silence (2 s, then 0.2 s after a chunk boundary inside speech) and speech threshold (0.5); speech longer than 60 s cut there.","locale":"en"},"15114":{"id":"/en/docs/engines-asr-58","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"Each segment recognised alone, shortest first, as FunASR does on a CPU (`batch_size = 0`); its features with `dither` 1.0 (Paraformer's frontend default).","locale":"en"},"15115":{"id":"/en/docs/engines-asr-59","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"The randomness: upstream draws the dither from torch's global generator, and its layer stacks (`MultiSequential`) draw one uniform number per layer at every forward for a layer drop that does nothing at inference. Both move the generator the next segment's dither draws from; the port draws both from one generator in the same order.","locale":"en"},"15116":{"id":"/en/docs/engines-asr-60","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"Text: special tokens dropped, English sub-words joined, runs of single letters made one upper-case word; the segments' texts joined without a space between Chinese characters; CT-Transformer over 20-word mini-sentences, carrying the words after each mini-sentence's last stop into the next, and its rules (a space before an ASCII word at a mini-sentence's start, capitalisation after a full stop, a final `。` added).","locale":"en"},"15117":{"id":"/en/docs/engines-asr-61","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"**Deviations.**","locale":"en"},"15118":{"id":"/en/docs/engines-asr-62","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"**The dither's generator is seeded 0 for each transcription.** Upstream's global generator stands wherever its process left it (FunASR seeds it once while building the models, which then draw from it), so upstream transcribes the same clip differently from call to call. Here a transcript is upstream's when its generator stands at seed 0 before `generate`, and the same every time (transcripts are cached by the audio).","locale":"en"},"15119":{"id":"/en/docs/engines-asr-63","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"**On a GPU a segment at a time too.** Upstream batches segments of up to 300 s on a GPU, padded, which changes its results; here the GPU runs the CPU's order. Results on a GPU are not bit-identical to the CPU's (on an RTX 3060, 14 of 16 clips identical, two noisy synthetic ones a few characters apart).","locale":"en"},"15120":{"id":"/en/docs/engines-asr-64","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"**Memory.** Three handles, one phase each: the VAD (2 MB) over the clip, the recogniser (880 MB) per segment, the punctuation model (290 MB, mostly its 272,727-word embedding) over the text; float32 on every device. On an RTX 3060 a transcription peaked at 1.1 GB of torch allocations (the catalogue's `vram_mb`, 1,200).","locale":"en"},"15121":{"id":"/en/docs/engines-asr-65","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#paraformer-chinese","content":"**Parity.** Against FunASR 1.4.21 on the CPU in fp32 (8 threads), on 16 clips (12 of 3–7 s from eight engines, four of 60–124 s, two of them mixed Chinese and English): every transcript and VAD segment identical, and at module level the features, encoder, predictor, decoder, the VAD's scores per chunk (also 11 edge cases: silence, noise, clips under 0.5 s, exact and near multiples of 60 s) and the punctuation model's logits (32 texts, mini-sentence carry-over included) bit-identical; the text post-processing on 14,000 fuzzed token lists. The workspace is `experiment/paraformer`.","locale":"en"},"15122":{"id":"/en/docs/engines-asr-66","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#limitations","content":"Speech recognition is used inside Mizuoto, not offered as a synthesis model or through `GET /v1/models`.","locale":"en"},"15123":{"id":"/en/docs/engines-asr-67","page_id":"/en/docs/engines-asr","tags":[],"type":"text","url":"/en/docs/engines-asr#limitations","content":"The out-of-memory fallback can change a transcript in rare ties.","locale":"en"},"15124":{"id":"/en/docs/engines-cosyvoice","page_id":"/en/docs/engines-cosyvoice","type":"page","content":"CosyVoice","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-cosyvoice","locale":"en"},"15125":{"id":"/en/docs/engines-cosyvoice-0","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice","content":"The CosyVoice engine as implemented in Mizuoto: CosyVoice 1, 2 and 3, speech tokenizers and CAM++ from their ONNX files, the language models, flows and HiFT, what reproduces upstream exactly and why the whole stack is not bit-identical, the GPU decoding path, the LLM and flow fine-tunes, and its parity results.","locale":"en"},"15126":{"id":"/en/docs/engines-cosyvoice-1","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Variants and files","locale":"en"},"15127":{"id":"/en/docs/engines-cosyvoice-2","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#how-it-works","content":"How it works","locale":"en"},"15128":{"id":"/en/docs/engines-cosyvoice-3","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15129":{"id":"/en/docs/engines-cosyvoice-4","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#deviations","content":"Deviations","locale":"en"},"15130":{"id":"/en/docs/engines-cosyvoice-5","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#why-the-whole-stack-is-not-bit-identical","content":"Why the whole stack is not bit-identical","locale":"en"},"15131":{"id":"/en/docs/engines-cosyvoice-6","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#memory-and-speed","content":"Memory and speed","locale":"en"},"15132":{"id":"/en/docs/engines-cosyvoice-7","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#training","content":"Training","locale":"en"},"15133":{"id":"/en/docs/engines-cosyvoice-8","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#parity","content":"Parity","locale":"en"},"15134":{"id":"/en/docs/engines-cosyvoice-9","page_id":"/en/docs/engines-cosyvoice","type":"heading","tags":[],"url":"/en/docs/engines-cosyvoice#limitations","content":"Limitations","locale":"en"},"15135":{"id":"/en/docs/engines-cosyvoice-10","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice","content":"Alibaba Tongyi's LLM + flow-matching TTS (QwenAudio/CosyVoice, Apache-2.0). Code: `mizuoto/engines/cosyvoice`. Given the same voice prompt it is identical to upstream (on torch 2.8) sample for sample on the CPU, for every model and mode; through the whole stack, where each side makes its own voice prompt, it agrees to 23–68 dB SNR, for reasons explained below. Its trainers give upstream's checkpoints byte for byte. User-facing details: Engines in depth.","locale":"en"},"15136":{"id":"/en/docs/engines-cosyvoice-11","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Variant","locale":"en"},"15137":{"id":"/en/docs/engines-cosyvoice-12","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Catalogue model","locale":"en"},"15138":{"id":"/en/docs/engines-cosyvoice-13","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Rate","locale":"en"},"15139":{"id":"/en/docs/engines-cosyvoice-14","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Language model","locale":"en"},"15140":{"id":"/en/docs/engines-cosyvoice-15","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Flow","locale":"en"},"15141":{"id":"/en/docs/engines-cosyvoice-16","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Vocoder","locale":"en"},"15142":{"id":"/en/docs/engines-cosyvoice-17","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`v1_base`","locale":"en"},"15143":{"id":"/en/docs/engines-cosyvoice-18","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`cosyvoice/cosyvoice-300m`","locale":"en"},"15144":{"id":"/en/docs/engines-cosyvoice-19","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"22.05 kHz","locale":"en"},"15145":{"id":"/en/docs/engines-cosyvoice-20","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`TransformerLM`: Conformer text encoder + transformer, Whisper's vocabulary","locale":"en"},"15146":{"id":"/en/docs/engines-cosyvoice-21","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`MaskedDiffWithXvec`: Conformer, length regulator, Matcha U-Net","locale":"en"},"15147":{"id":"/en/docs/engines-cosyvoice-22","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"HiFT","locale":"en"},"15148":{"id":"/en/docs/engines-cosyvoice-23","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`v1_sft`","locale":"en"},"15149":{"id":"/en/docs/engines-cosyvoice-24","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`cosyvoice/cosyvoice-300m-sft`","locale":"en"},"15150":{"id":"/en/docs/engines-cosyvoice-25","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"22.05 kHz","locale":"en"},"15151":{"id":"/en/docs/engines-cosyvoice-26","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"as `v1_base`, with preset speakers","locale":"en"},"15152":{"id":"/en/docs/engines-cosyvoice-27","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"as `v1_base`","locale":"en"},"15153":{"id":"/en/docs/engines-cosyvoice-28","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"HiFT","locale":"en"},"15154":{"id":"/en/docs/engines-cosyvoice-29","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`v1_instruct`","locale":"en"},"15155":{"id":"/en/docs/engines-cosyvoice-30","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`cosyvoice/cosyvoice-300m-instruct`","locale":"en"},"15156":{"id":"/en/docs/engines-cosyvoice-31","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"22.05 kHz","locale":"en"},"15157":{"id":"/en/docs/engines-cosyvoice-32","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"as `v1_base`, with instructions","locale":"en"},"15158":{"id":"/en/docs/engines-cosyvoice-33","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"as `v1_base`","locale":"en"},"15159":{"id":"/en/docs/engines-cosyvoice-34","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"HiFT","locale":"en"},"15160":{"id":"/en/docs/engines-cosyvoice-35","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`v2`","locale":"en"},"15161":{"id":"/en/docs/engines-cosyvoice-36","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`cosyvoice/cosyvoice2-0.5b`","locale":"en"},"15162":{"id":"/en/docs/engines-cosyvoice-37","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"24 kHz","locale":"en"},"15163":{"id":"/en/docs/engines-cosyvoice-38","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`Qwen2LM` on Qwen2-0.5B","locale":"en"},"15164":{"id":"/en/docs/engines-cosyvoice-39","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`CausalMaskedDiffWithXvec`: causal U-Net","locale":"en"},"15165":{"id":"/en/docs/engines-cosyvoice-40","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"HiFT","locale":"en"},"15166":{"id":"/en/docs/engines-cosyvoice-41","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`v3`","locale":"en"},"15167":{"id":"/en/docs/engines-cosyvoice-42","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`cosyvoice/cosyvoice3-0.5b`","locale":"en"},"15168":{"id":"/en/docs/engines-cosyvoice-43","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"24 kHz","locale":"en"},"15169":{"id":"/en/docs/engines-cosyvoice-44","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`CosyVoice3LM`","locale":"en"},"15170":{"id":"/en/docs/engines-cosyvoice-45","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"`CausalMaskedDiffWithDiT`: a 22-layer DiT","locale":"en"},"15171":{"id":"/en/docs/engines-cosyvoice-46","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"causal HiFT with a float64 F0 predictor","locale":"en"},"15172":{"id":"/en/docs/engines-cosyvoice-47","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"The variant comes from the yaml in the folder (`cosyvoice.yaml`, `cosyvoice2.yaml`, `cosyvoice3.yaml`); a CosyVoice 1 folder with `spk2info.pt` is SFT or Instruct. The folder holds the yaml, `llm.pt`, `flow.pt`, `hift.pt`, `campplus.onnx`, `speech_tokenizer_v1.onnx` / `v2` / `v3`, `spk2info.pt`, and for v2/v3 the `CosyVoice-BlankEN` config and tokenizer (not its weights, which `llm.pt` replaces). The shared asset `cosyvoice/wetext` holds the text normaliser's FSTs. The ONNX models are converted once and cached as `<model>/.mizuoto/converted-<key>.safetensors` (a `<name>.safetensors` beside the ONNX file wins).","locale":"en"},"15173":{"id":"/en/docs/engines-cosyvoice-48","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#variants-and-files","content":"Capabilities: preset speakers, instructions, cloning and cross-lingual cloning, voice conversion, streamed audio, and for v2/v3 streamed text input. Precision: fp32; the load option `fp16` runs the language model and the flow under CUDA autocast, as upstream's `fp16` does. Upstream holds one autocast region over a whole generation; here each token runs in its own (the engine runs only inside `next()`), and autocast keeps its float16 copies of the weights only for a region, so every token cast all of the language model's weights again: `fp16` ran up to twice as slow as fp32, and with CUDA graphs the first request's audio differed from the later ones' and from the eager path's. The language model's linear layers now hold their weights in float16 under `fp16`, the values autocast computes them with (`_half_linears`, at load; embeddings and norms stay float32, as autocast computes them): the eager path's audio on every request, with or without graphs, 1.7–1.8× faster than fp32 (Performance). Fast mode (load option `fused_projections`, CosyVoice 2 and 3): the Qwen2 language model's q/k/v and gate/up projections as one product each (`QwenDecoder.fuse`, as Qwen3-TTS's), labelled in the output; identical on the CPU, on an RTX 3060 identical in fp32 and 1 % faster per second of audio, 2–5 % faster under `fp16`, where the audio changes.","locale":"en"},"15174":{"id":"/en/docs/engines-cosyvoice-49","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"The voice prompt is made from the reference three times over: 16 kHz audio to a Whisper log-mel to the **speech tokenizer**'s tokens; 16 kHz audio to a kaldi fbank to **CAM++**'s 192-dim speaker embedding; and always a 24 kHz Matcha mel, even for the 22.05 kHz CosyVoice 1. The **language model** turns text (and the prompt's text and tokens) into speech tokens; the **flow** turns tokens into a mel in 10 Euler steps with guidance 0.7; **HiFT** (a HiFi-GAN with a neural source filter and an inverse STFT) turns the mel into audio.","locale":"en"},"15175":{"id":"/en/docs/engines-cosyvoice-50","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"Module","locale":"en"},"15176":{"id":"/en/docs/engines-cosyvoice-51","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"What it is","locale":"en"},"15177":{"id":"/en/docs/engines-cosyvoice-52","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`engine.py`","locale":"en"},"15178":{"id":"/en/docs/engines-cosyvoice-53","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"Frontend, `CosyVoiceModel.tts` (tokens, mel, waveform), streaming chunks, voice conversion, streamed text, voice caches","locale":"en"},"15179":{"id":"/en/docs/engines-cosyvoice-54","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`config.py`","locale":"en"},"15180":{"id":"/en/docs/engines-cosyvoice-55","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"The HyperPyYAML file read as data (`!new:`/`!name:` as dicts, `!ref` expressions resolved)","locale":"en"},"15181":{"id":"/en/docs/engines-cosyvoice-56","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`frontend.py`","locale":"en"},"15182":{"id":"/en/docs/engines-cosyvoice-57","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`text_normalize` with wetext, cleaning and splitting","locale":"en"},"15183":{"id":"/en/docs/engines-cosyvoice-58","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`tokenizer.py`","locale":"en"},"15184":{"id":"/en/docs/engines-cosyvoice-59","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"v2/v3: BlankEN's Qwen2 BPE with CosyVoice's added tokens; v1: Whisper's tiktoken vocabulary","locale":"en"},"15185":{"id":"/en/docs/engines-cosyvoice-60","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`llm.py`","locale":"en"},"15186":{"id":"/en/docs/engines-cosyvoice-61","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"The three language models, repetition-aware sampling (RAS), the streamed-text interleave (5 text : 15 speech)","locale":"en"},"15187":{"id":"/en/docs/engines-cosyvoice-62","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`flow.py`, `dit.py`","locale":"en"},"15188":{"id":"/en/docs/engines-cosyvoice-63","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"The three flows; CosyVoice 3's DiT estimator","locale":"en"},"15189":{"id":"/en/docs/engines-cosyvoice-64","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`train.py`, `sft.py`","locale":"en"},"15190":{"id":"/en/docs/engines-cosyvoice-65","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"`CosyVoiceTrainer` (methods `llm`, `llm_flow`) and its maths","locale":"en"},"15191":{"id":"/en/docs/engines-cosyvoice-66","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#how-it-works","content":"Shared: `nn/codecs/s3tokenizer.py` (speech tokenizers v1–v3 from their ONNX files), `nn/speaker/campplus.py` (CAM++ as the ONNX graph has it), `nn/transformer/wenet.py`, `nn/flow/unet1d.py`, `nn/transformer/dit.py`, `nn/vocoders/hift.py`, `nn/dsp/` (`mel`, `kaldi`, `resample`, `wav`, `flac`), `runtime/convert/onnx.py`, `runtime/lm/qwen.py`, `runtime/graphs.py`, `text/normalize/wetext.py`, `text/tokenize/`.","locale":"en"},"15192":{"id":"/en/docs/engines-cosyvoice-67","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**Sizes from the yaml.** Module sizes come from the model's own yaml (HyperPyYAML's tags read as data), not from code.","locale":"en"},"15193":{"id":"/en/docs/engines-cosyvoice-68","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**Speech tokens and CAM++ without onnxruntime.** The speech tokenizers are s3tokenizer's torch models with the weights read from the ONNX file; their codes equal onnxruntime's on the test corpus for v1, v2 and v3. CAM++ mirrors the exported graph (batch norms after convolutions folded, as the export folded them) and agrees with onnxruntime to about 1e-6 relative, not bit for bit. CAM++ runs on the CPU whatever the device, as upstream runs it (onnxruntime's CPU provider only): on a GPU its convolutions moved the embedding by 2.4e-4 instead of 5e-7. The speech tokenizer runs on the device, as upstream's (CUDA provider).","locale":"en"},"15194":{"id":"/en/docs/engines-cosyvoice-69","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**The prompt mel** is Matcha's at 24 kHz for every version; v2/v3 keep exactly two mel frames per prompt token. v3 drops runs of more than five silent tokens and gets its system prompt (`You are a helpful assistant.<|endofprompt|>`).","locale":"en"},"15195":{"id":"/en/docs/engines-cosyvoice-70","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**Qwen2 as transformers 4.51 ran it.** CosyVoice 2/3's language model ran on transformers 4.51, whose SDPA path always repeats the KV heads and makes q, k and v contiguous (`QwenConfig.sdpa_gqa=False`).","locale":"en"},"15196":{"id":"/en/docs/engines-cosyvoice-71","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**Noise.** v2/v3's flow noise is upstream's seed-0 buffer (the first 1×80×15000 normal draws). `randn_like(x)` keeps `x`'s strides, so its draws land in another element order than `randn(shape)` when `x` is transposed (HiFT's sine source): `nn.vocoders.hift.randn_like` fills `empty_like(x)` from the generator.","locale":"en"},"15197":{"id":"/en/docs/engines-cosyvoice-72","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**CosyVoice 3's vocoder noise** is drawn once when upstream builds the model, after the flow's seed-0 noise and the default initialisations of the flow and the F0 predictor. `cosyvoice3_noise` replays those draws on a private generator, so the values are upstream's and the 259 MB buffer is never materialised. Its F0 predictor runs in float64, so its weight norm is folded in float64.","locale":"en"},"15198":{"id":"/en/docs/engines-cosyvoice-73","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**Draw order.** Unstreamed, the draws come in upstream's order (language model, v1's flow noise, vocoder noise). Streaming uses upstream's chunking: v1 100 tokens with 20 of overlap and Hamming cross-fades; v2/v3 25 tokens doubling up to 100, with three tokens of lookahead.","locale":"en"},"15199":{"id":"/en/docs/engines-cosyvoice-74","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#what-reproduces-upstream","content":"**Text normalisation** is wetext's normaliser ported over kaldifst, identical on the corpus; its FSTs are the asset `cosyvoice/wetext` (ModelScope `pengzhendong/wetext` at a pinned commit). Text containing `<|…|>` is not normalised, as upstream skips it.","locale":"en"},"15200":{"id":"/en/docs/engines-cosyvoice-75","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#deviations","content":"**No language-model thread.** Upstream runs the language model on a thread beside the vocoder; here it runs in the request's thread and chunks are made as its tokens arrive. Upstream's streamed v1/v2 draw vocoder noise on the main thread while the language model samples on its own, so their streamed audio depends on timing; Mizuoto's vocoder draws from its own generator (seed + 1) and the tokens are those of the unstreamed request. CosyVoice 3, whose noise is fixed, streams identically.","locale":"en"},"15201":{"id":"/en/docs/engines-cosyvoice-76","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#deviations","content":"**Normalisation that 0.1 lacked.** Upstream's frontend downloads the FSTs at run time; in 0.1's worker that download failed and upstream silently skipped normalisation. With the FSTs an asset, Chinese text with digits now has its numbers read out, so such text sounds different from 0.1.","locale":"en"},"15202":{"id":"/en/docs/engines-cosyvoice-77","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#deviations","content":"**On a device without float64** (Apple MPS, Intel Arc), CosyVoice 3's F0 predictor stays on the CPU while the rest of the model moves; the vocoder feeds it on its own device.","locale":"en"},"15203":{"id":"/en/docs/engines-cosyvoice-78","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#deviations","content":"**TensorRT, vLLM and JIT** (0.1's load options `load_trt`, `trt_concurrent`, `load_vllm`) are not available.","locale":"en"},"15204":{"id":"/en/docs/engines-cosyvoice-79","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#deviations","content":"Kept from upstream: in streamed-text mode with a long reference (7 s) the speech can begin with the reference's last words; plain synthesis with the same reference does not. Streamed text needs the reference's transcript.","locale":"en"},"15205":{"id":"/en/docs/engines-cosyvoice-80","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#why-the-whole-stack-is-not-bit-identical","content":"Through the stack each side computes its own voice prompt, and CAM++'s embedding is the one part not bit-exact: it differs from onnxruntime's by at most 7e-6 (cosine 0.999999999997). The flow turns that into a mel change of at most 2.7e-3, and HiFT's sine source integrates the F0 into phase (a float32 cumulative sum over the whole utterance, nine harmonics), so the error grows along the utterance: on a CosyVoice 3 English clone the SNR per half second falls from 66 to 20 dB. Upstream is just as sensitive. Its own vocoder chain fed Mizuoto's embedding gives exactly Mizuoto's audio; its own onnxruntime CAM++ with 8 threads instead of 1 gives 31 dB; random perturbations of that size give 20–33 dB. CosyVoice 2/3's language model never uses the speaker embedding, so the speech tokens are the same.","locale":"en"},"15206":{"id":"/en/docs/engines-cosyvoice-81","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#memory-and-speed","content":"Phases: the frontend (speech tokenizer and CAM++) only for a voice that is not cached and for conversion; the language model (`kind=\"sequence\"`) makes the tokens; the flow and HiFT speak them. Streaming holds the language model and the flow together. HiFT's F0 predictor is marked `fixed` (HiFT reads its device). The language model's working memory is its cache for upstream's bound (20 speech tokens a text token after a 300-position prompt), at the KV width the model has (Qwen2's two KV heads), with one layer's copy repeated per head group, plus 512 MB. `compute.kv_cache = static` gives the Qwen2 model preallocated caches (identical on the CPU).","locale":"en"},"15207":{"id":"/en/docs/engines-cosyvoice-82","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#memory-and-speed","content":"**Decoding on CUDA (CosyVoice 2/3).** Upstream's samplers run a Python loop over the sorted probabilities, reading the running sum back at each kept token, copying probabilities to the host and back and checking the repetition window on the host: some 50–80 waits for the device per token, on top of 24 layers launched eagerly. On CUDA `llm._Steps` draws the same tokens with one wait per token: the nucleus loop is replayed on the device over the first 25 sorted tokens (the same 0-d additions in the scores' dtype; the draw is `multinomial`'s own `argmax(p / Exp(1))`, whose first *n* exponentials are those an *n*-element draw uses), the same token and generator state as upstream's loop for every *n* from 1 to 25, in fp32, fp16 and bf16. The resample after a repetition stays eager. With `compute.cuda_graphs` (NVIDIA, the language model wholly on its device) the one-token steps run as graphs around their attention calls and the draw as one graph; the graphs' generator is synced with the request's at each token, since CosyVoice 3's streamed flow draws from it between tokens. The real CosyVoice 2 model gives the same tokens with and without graphs, about seven times faster per token. Other devices keep upstream's loop.","locale":"en"},"15208":{"id":"/en/docs/engines-cosyvoice-83","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#memory-and-speed","content":"`compute.compile` wraps the flow estimator. On the CPU it gains nothing (the U-Net's convolutions and products are already library kernels); the mel stays within 5.7e-6 of eager, which HiFT's F0-driven source amplifies to about 1e-2 in the audio (47 dB), as eager with another thread count also does.","locale":"en"},"15209":{"id":"/en/docs/engines-cosyvoice-84","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"Methods `llm` and `llm_flow` (stages `features`, `llm`, `flow`, `export`; from CosyVoice 1, 2 or 3): upstream's LibriTTS recipe and `bin/train.py`, without onnxruntime, pyarrow, pyworld, transformers, deepspeed or torchrun. It gives upstream's losses, accuracies, learning rates and `epoch_<N>_whole.pt` byte for byte on the CPU (gloo, world size 1), for all three generations, with zero or two loader workers and an accumulation left over at an epoch's end; the features (speech tokens and CAM++) give onnxruntime's tokens and its embeddings within 6e-6. Upstream trains on CUDA only; the trainer runs on every device kind.","locale":"en"},"15210":{"id":"/en/docs/engines-cosyvoice-85","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"**The reference** is upstream with its generators seeded with the stage's seed once its model is built: upstream seeds 1986 in its yaml (its v2/v3 flow reseeds 0 while it is built) and then draws its random initialisation, while nothing draws here before training.","locale":"en"},"15211":{"id":"/en/docs/engines-cosyvoice-86","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"**Data loading.** Each loader worker runs the whole pipeline on its shards; with fewer shards (1000 clips each) than workers every worker reads every shard, so with the default two workers each clip is seen twice an epoch, as upstream. Shuffles draw from `Random(base_seed + k)`; batches come round-robin; features are made on one thread, as in a worker.","locale":"en"},"15212":{"id":"/en/docs/engines-cosyvoice-87","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"**A validation pass** on the training list ends each epoch, as in upstream, and it draws too (Qwen2LM's bistream choice, the flow's streaming choice, conditions and noise). Its losses are logged, not metrics.","locale":"en"},"15213":{"id":"/en/docs/engines-cosyvoice-88","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"**Clipping order.** Parameters are clipped in upstream's order (`sft._ORDER`), since the total norm is summed in it; checkpoints keep upstream's key order, with Qwen's tied `lm_head` sharing the embedding's storage.","locale":"en"},"15214":{"id":"/en/docs/engines-cosyvoice-89","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"**Qwen2 trains under transformers 4.51's additive mask** (`causal_mask_451`); the logged `loss` is divided by the accumulation steps, as upstream logs it; CosyVoice 1 keeps the recipe's `WarmupLR` (2500 steps).","locale":"en"},"15215":{"id":"/en/docs/engines-cosyvoice-90","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"0.1 could not train CosyVoice 2 or 3 (upstream asks for a `speech_tokenizer_v*.batch.onnx` no model ships). Mizuoto's export loads in both implementations and speaks identically in both given the same voice prompt.","locale":"en"},"15216":{"id":"/en/docs/engines-cosyvoice-91","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#training","content":"`training.memory`: gradient checkpointing over the language model's or the flow's blocks gives identical losses and weights.","locale":"en"},"15217":{"id":"/en/docs/engines-cosyvoice-92","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#parity","content":"The reference is upstream on torch 2.8 (on its own torch 2.3.1 it disagrees with itself on 2.8). With upstream's voice prompt fed to both, cloning (English, Chinese with numbers), cross-lingual cloning, instructions, preset speakers, streamed audio and voice conversion are identical sample for sample for v1, v2 and v3. Through the stack, each side making its own prompt:","locale":"en"},"15218":{"id":"/en/docs/engines-cosyvoice-93","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#parity","content":"most v2 cases: 45.5–68.3 dB SNR;","locale":"en"},"15219":{"id":"/en/docs/engines-cosyvoice-94","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#parity","content":"the CosyVoice 3 English clone: about 23 dB (CAM++'s float noise, above);","locale":"en"},"15220":{"id":"/en/docs/engines-cosyvoice-95","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#parity","content":"the SFT Chinese case and the v2 Chinese clone differ in length, from normalisation; with normalisation off on both sides the first is identical and the second differs only by CAM++'s noise;","locale":"en"},"15221":{"id":"/en/docs/engines-cosyvoice-96","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#parity","content":"the training cross-load cases (one implementation's export spoken by the other): 57.4 and 38.1 dB.","locale":"en"},"15222":{"id":"/en/docs/engines-cosyvoice-97","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#parity","content":"The contract suite passes (18 tests).","locale":"en"},"15223":{"id":"/en/docs/engines-cosyvoice-98","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#parity","content":"On a GPU (an RTX 3090, 2026-10-19, stage by stage against upstream on torch 2.8): with upstream's CAM++ embedding fed to Mizuoto, the v2 and v3 English clones are identical sample for sample; that took HiFT's weight norm folded on the device in the F0 predictor's dtype (upstream computes it there at every call). Each side making its own embedding, the v2 clone is identical too (its flow absorbs CAM++'s 5e-7) and v3 is at 14.2 dB, which is CAM++'s noise as on the CPU. Upstream on its own torch 2.3.1 (cuDNN 8.9) differs from itself on torch 2.8 at the first convolution, so the comparison takes 2.8.","locale":"en"},"15224":{"id":"/en/docs/engines-cosyvoice-99","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#limitations","content":"Through the whole stack, results agree closely but not bit for bit with upstream, because CAM++ is not bit-exact with onnxruntime.","locale":"en"},"15225":{"id":"/en/docs/engines-cosyvoice-100","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#limitations","content":"Streamed CosyVoice 1/2 audio is not upstream's streamed audio, which depends on thread timing; it is reproducible here.","locale":"en"},"15226":{"id":"/en/docs/engines-cosyvoice-101","page_id":"/en/docs/engines-cosyvoice","tags":[],"type":"text","url":"/en/docs/engines-cosyvoice#limitations","content":"The fast decoding path is CUDA only.","locale":"en"},"15227":{"id":"/en/docs/engines-f5tts","page_id":"/en/docs/engines-f5tts","type":"page","content":"F5-TTS","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-f5tts","locale":"en"},"15228":{"id":"/en/docs/engines-f5tts-0","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts","content":"The F5-TTS engine as implemented in Mizuoto: v1 Base, v0 Base and E2, the DiT and UNetT, the CFM sampler and Vocos, what reproduces upstream exactly, memory and compile notes, the full fine-tune, and its parity results.","locale":"en"},"15229":{"id":"/en/docs/engines-f5tts-1","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#variants-and-files","content":"Variants and files","locale":"en"},"15230":{"id":"/en/docs/engines-f5tts-2","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#how-it-works","content":"How it works","locale":"en"},"15231":{"id":"/en/docs/engines-f5tts-3","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15232":{"id":"/en/docs/engines-f5tts-4","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#deviations","content":"Deviations","locale":"en"},"15233":{"id":"/en/docs/engines-f5tts-5","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#memory-and-speed","content":"Memory and speed","locale":"en"},"15234":{"id":"/en/docs/engines-f5tts-6","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#training","content":"Training","locale":"en"},"15235":{"id":"/en/docs/engines-f5tts-7","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#parity","content":"Parity","locale":"en"},"15236":{"id":"/en/docs/engines-f5tts-8","page_id":"/en/docs/engines-f5tts","type":"heading","tags":[],"url":"/en/docs/engines-f5tts#limitations","content":"Limitations","locale":"en"},"15237":{"id":"/en/docs/engines-f5tts-9","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts","content":"A flow-matching TTS that fills in a mel spectrogram after the reference's and turns it into audio with Vocos (SWivid/F5-TTS; code MIT, pretrained weights CC-BY-NC-4.0). Code: `mizuoto/engines/f5tts`. On the CPU in fp32 with the same seed it is identical to Mizuoto 0.1 for all three models, cloning and speech editing, and its trainer gives 0.1's exported weights byte for byte. User-facing details: Engines in depth.","locale":"en"},"15238":{"id":"/en/docs/engines-f5tts-10","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"Variant","locale":"en"},"15239":{"id":"/en/docs/engines-f5tts-11","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"Catalogue model","locale":"en"},"15240":{"id":"/en/docs/engines-f5tts-12","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"Backbone","locale":"en"},"15241":{"id":"/en/docs/engines-f5tts-13","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"`v1_base`","locale":"en"},"15242":{"id":"/en/docs/engines-f5tts-14","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"`f5tts/v1-base`","locale":"en"},"15243":{"id":"/en/docs/engines-f5tts-15","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"DiT (1024 wide, 22 layers), text padding masked","locale":"en"},"15244":{"id":"/en/docs/engines-f5tts-16","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"`base`","locale":"en"},"15245":{"id":"/en/docs/engines-f5tts-17","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"`f5tts/base`","locale":"en"},"15246":{"id":"/en/docs/engines-f5tts-18","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"DiT with rotary embedding on one head only (`pe_attn_head = 1`)","locale":"en"},"15247":{"id":"/en/docs/engines-f5tts-19","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"`e2_base`","locale":"en"},"15248":{"id":"/en/docs/engines-f5tts-20","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"`f5tts/e2-base`","locale":"en"},"15249":{"id":"/en/docs/engines-f5tts-21","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"E2-TTS's UNetT: a flat transformer with skip connections, x-transformers' RMSNorm","locale":"en"},"15250":{"id":"/en/docs/engines-f5tts-22","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"All three clone (the reference's transcript is required) and edit speech. The model folder holds the checkpoint (`*.safetensors`, else `*.pt`), `vocab.txt` and `vocos/config.yaml` + `vocos/pytorch_model.bin`. E2's repository has no vocabulary, so upstream's bundled `vocab.txt` ships with the engine as package data and serves it.","locale":"en"},"15251":{"id":"/en/docs/engines-f5tts-23","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#variants-and-files","content":"Precision: fp16 on a CUDA GPU of compute capability 7 or more, as upstream's `load_checkpoint` decides; fp32 elsewhere.","locale":"en"},"15252":{"id":"/en/docs/engines-f5tts-24","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"The text (reference transcript plus the new text, Chinese characters turned into pinyin with tones) is embedded by ConvNeXtV2 blocks; the transformer predicts the flow from noise to mel frames, conditioned on the reference's mel; an ODE solver integrates it over a fixed time grid, with classifier-free guidance as a batch of two; Vocos turns the mel into 24 kHz audio. There is no duration model: the length comes from the reference's speaking rate, or from `duration`.","locale":"en"},"15253":{"id":"/en/docs/engines-f5tts-25","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"Module","locale":"en"},"15254":{"id":"/en/docs/engines-f5tts-26","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"What it is","locale":"en"},"15255":{"id":"/en/docs/engines-f5tts-27","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"`engine.py`","locale":"en"},"15256":{"id":"/en/docs/engines-f5tts-28","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"Reference preparation, chunking, `CFM.sample` (seeded noise, the EPSS or sway time grid, Euler or midpoint steps, guidance), Vocos, cross-fades; `edit` as upstream's `speech_edit.py`","locale":"en"},"15257":{"id":"/en/docs/engines-f5tts-29","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"`text.py`","locale":"en"},"15258":{"id":"/en/docs/engines-f5tts-30","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"Characters and pinyin (`f5_tts.model.utils`), upstream's chunking","locale":"en"},"15259":{"id":"/en/docs/engines-f5tts-31","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"`vocab.txt`","locale":"en"},"15260":{"id":"/en/docs/engines-f5tts-32","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"Upstream's bundled vocabulary","locale":"en"},"15261":{"id":"/en/docs/engines-f5tts-33","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"`train.py`","locale":"en"},"15262":{"id":"/en/docs/engines-f5tts-34","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"`F5Trainer` (method `full`)","locale":"en"},"15263":{"id":"/en/docs/engines-f5tts-35","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#how-it-works","content":"Shared: `nn/transformer/dit.py` (AdaLN-zero, ConvNeXtV2 text blocks, interleaved rotary embedding), `nn/transformer/unett.py`, `nn/flow/cfm.py` (`odeint_fixed`, `epss_timesteps`, `sway`), `nn/vocoders/vocos.py`, `nn/dsp/mel.py`, `nn/dsp/resample.py`, `nn/dsp/tiles.py`, `runtime/compile.py`.","locale":"en"},"15264":{"id":"/en/docs/engines-f5tts-36","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#what-reproduces-upstream","content":"**The reference** is trimmed and padded as `preprocess_ref_audio_text` does, levelled to `target_rms` and resampled with torchaudio's `Resample`. pydub's 50 ms pad is reproduced from `audioop.ratecv`'s frame count (`edge_pad`: 1198 samples at 24 kHz, not 1200), since `audioop` is gone in Python 3.13.","locale":"en"},"15265":{"id":"/en/docs/engines-f5tts-37","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#what-reproduces-upstream","content":"**The text.** A reference text ending in a one-byte character gets a trailing space, as `infer_batch_process` adds one.","locale":"en"},"15266":{"id":"/en/docs/engines-f5tts-38","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#what-reproduces-upstream","content":"**Chunks** are cut as upstream cuts them, generated in order and joined with upstream's cross-fade; `duration` is spread over the chunks as upstream spreads it.","locale":"en"},"15267":{"id":"/en/docs/engines-f5tts-39","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#what-reproduces-upstream","content":"**The ODE.** torchdiffeq's fixed-grid Euler and midpoint steps are `nn.flow.cfm.odeint_fixed`; the grid is upstream's Empirically Pruned Step Sampling for 5, 6, 7, 10, 12 or 16 steps, otherwise a linear grid with sway sampling. Noise is drawn as upstream draws it, per item in the model's dtype.","locale":"en"},"15268":{"id":"/en/docs/engines-f5tts-40","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#what-reproduces-upstream","content":"**x-transformers' interleaved rotary embedding and RMSNorm** are ported as they are.","locale":"en"},"15269":{"id":"/en/docs/engines-f5tts-41","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#what-reproduces-upstream","content":"**Precision on a GPU.** The model is cast to its dtype *before* the checkpoint is copied in, as upstream does, so on a GPU the rotary embedding's `inv_freq` is fp16 too and the angles are computed in fp16.","locale":"en"},"15270":{"id":"/en/docs/engines-f5tts-42","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#deviations","content":"**Chunks in order.** Upstream generates a long text's chunks on a thread pool that shares the global random generator, so its own output depends on thread timing; 0.1's adapter generated them in order, and so does Mizuoto.","locale":"en"},"15271":{"id":"/en/docs/engines-f5tts-43","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#deviations","content":"Only the Vocos vocoder is offered; upstream's BigVGAN variant of the v0 model is not in the catalogue.","locale":"en"},"15272":{"id":"/en/docs/engines-f5tts-44","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#memory-and-speed","content":"Two phases: the transformer with the mel (every ODE step; guidance doubles the batch) and Vocos. If Vocos runs out of memory with `compute.oom_fallback` on, it decodes in tiles of 256 frames, each with the 29 frames its samples depend on each side (its kernels and the inverse STFT's window): the whole's samples up to the sums' rounding (`applied.fallbacks` says so).","locale":"en"},"15273":{"id":"/en/docs/engines-f5tts-45","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#memory-and-speed","content":"`compute.compile` wraps the DiT or UNetT in `torch.compile(dynamic=True)`. On a CPU in fp32 with 8 threads the transformer's warm time drops 23 % (a request from 60 to 45 s); the first request pays about 30 s of compilation; the audio stays within 9.2e-5 of eager (89 dB). The CPU allocator and thread placement of `compute.cpu_allocator` and `compute.cpu_threads` make F5-TTS 10–20 % faster on Linux without changing a result.","locale":"en"},"15274":{"id":"/en/docs/engines-f5tts-46","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#training","content":"Method `full` (stages `prepare`, `train`, `export`): upstream's `finetune_cli` recipe, without accelerate, datasets, wandb or ema_pytorch. Seeded alike, it gives 0.1's losses, learning rates and exported `model_<update>.safetensors` byte for byte on the CPU. (0.1 itself never seeded: its condition drops came from an unseeded `random`.)","locale":"en"},"15275":{"id":"/en/docs/engines-f5tts-47","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#training","content":"**Draws in upstream's order**: the model's random initialisation in upstream's construction order (UNetT makes a layer's skip projection last), one data-loader worker seed in each of the first two epochs (persistent loaders; accelerate's `skip_first_batches` copy iterates epoch 0), then per batch the span, noise, time, two `random()` calls and the dropout masks.","locale":"en"},"15276":{"id":"/en/docs/engines-f5tts-48","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#training","content":"**Epoch *e* ≥ 1 shuffles with seed 666 + *e* − 1**: accelerate's loader resets the sampler's epoch to its own iteration count.","locale":"en"},"15277":{"id":"/en/docs/engines-f5tts-49","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#training","content":"**Mels on one thread**, as in upstream's loader workers; more threads change the filterbank product's sums.","locale":"en"},"15278":{"id":"/en/docs/engines-f5tts-50","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#training","content":"**The export** keeps the EMA weights with upstream's keys, the vocabulary and the vocoder, so both 0.1 and Mizuoto load it.","locale":"en"},"15279":{"id":"/en/docs/engines-f5tts-51","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#training","content":"`training.memory`: gradient checkpointing over the transformer's blocks gives identical results; `low` keeps the EMA copy in RAM; `lowest` also AdamW's state (identical on the CPU).","locale":"en"},"15280":{"id":"/en/docs/engines-f5tts-52","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#parity","content":"Identical sample for sample to 0.1 on the CPU in fp32 in all six stack cases: English and Chinese cloning on v1 Base, v0 Base and E2, the fine-tuned model and speech editing. Two more cases speak each implementation's training export with the other implementation; identical too. The contract suite passes (12 tests).","locale":"en"},"15281":{"id":"/en/docs/engines-f5tts-53","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#limitations","content":"The pretrained weights are CC-BY-NC-4.0 and so is a fine-tune of them; outputs are tagged.","locale":"en"},"15282":{"id":"/en/docs/engines-f5tts-54","page_id":"/en/docs/engines-f5tts","tags":[],"type":"text","url":"/en/docs/engines-f5tts#limitations","content":"On a GPU the model runs in fp16 as upstream does; Mizuoto offers no fp32 rotary embedding there.","locale":"en"},"15283":{"id":"/en/docs/engines-fishspeech","page_id":"/en/docs/engines-fishspeech","type":"page","content":"Fish Speech","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-fishspeech","locale":"en"},"15284":{"id":"/en/docs/engines-fishspeech-0","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech","content":"The Fish Speech engine as implemented in Mizuoto's separate mizuoto-fishspeech distribution: S2 Pro's dual-AR transformer and the 44.1 kHz codec, Drama 3's mixture-of-experts backbone and codebook tower, what reproduces upstream exactly, one wait per frame and CUDA graphs, experts streamed by the row, the LoRA fine-tune, and parity results.","locale":"en"},"15285":{"id":"/en/docs/engines-fishspeech-1","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#variants-and-files","content":"Variants and files","locale":"en"},"15286":{"id":"/en/docs/engines-fishspeech-2","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#how-it-works","content":"How it works","locale":"en"},"15287":{"id":"/en/docs/engines-fishspeech-3","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15288":{"id":"/en/docs/engines-fishspeech-4","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#deviations","content":"Deviations","locale":"en"},"15289":{"id":"/en/docs/engines-fishspeech-5","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#memory-and-speed","content":"Memory and speed","locale":"en"},"15290":{"id":"/en/docs/engines-fishspeech-6","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#training","content":"Training","locale":"en"},"15291":{"id":"/en/docs/engines-fishspeech-7","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#parity","content":"Parity","locale":"en"},"15292":{"id":"/en/docs/engines-fishspeech-8","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#limitations","content":"Limitations","locale":"en"},"15293":{"id":"/en/docs/engines-fishspeech-9","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#drama-3","content":"Drama 3","locale":"en"},"15294":{"id":"/en/docs/engines-fishspeech-10","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#how-it-works-1","content":"How it works","locale":"en"},"15295":{"id":"/en/docs/engines-fishspeech-11","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"What reproduces upstream","locale":"en"},"15296":{"id":"/en/docs/engines-fishspeech-12","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#cuda-graphs","content":"CUDA graphs","locale":"en"},"15297":{"id":"/en/docs/engines-fishspeech-13","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#deviations-1","content":"Deviations","locale":"en"},"15298":{"id":"/en/docs/engines-fishspeech-14","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#memory-and-speed-1","content":"Memory and speed","locale":"en"},"15299":{"id":"/en/docs/engines-fishspeech-15","page_id":"/en/docs/engines-fishspeech","type":"heading","tags":[],"url":"/en/docs/engines-fishspeech#parity-1","content":"Parity","locale":"en"},"15300":{"id":"/en/docs/engines-fishspeech-16","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech","content":"Fish Audio S2 Pro and Drama 3 (fishaudio/fish-speech). S2 Pro and its port are under the Fish Audio Research License; Drama 3 and its port (`mizuoto_fishspeech/drama3`, ported from fish-speech 0f8a12e8) under the Fish Audio Community License 1.0 (see Drama 3). The ports are under these licences, so they ship as a distribution of its own, `mizuoto-fishspeech` (`packages/native/fishspeech`, package `mizuoto_fishspeech`, with `LICENSE.md` and `drama3/LICENSE.md`), registered under the entry-point group `mizuoto.engines` (`fishspeech = mizuoto_fishspeech:FishSpeechEngine`). Downloading the model and speaking need the licence accepted. On the CPU in fp32 with the same seed its codes and audio are identical to upstream's seeded `generate_long` as Mizuoto 0.1 ran it, and its trainer gives 0.1's exported model bit for bit. User-facing details: Engines in depth.","locale":"en"},"15301":{"id":"/en/docs/engines-fishspeech-17","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#variants-and-files","content":"Two variants. `s2_pro` (catalogue model `fishspeech/s2-pro`, this page up to Drama 3): cloning from one to four clips, each with its transcript; inline tags; dialogue between speakers (`<|speaker:i|>`). The model folder holds `config.json`, the weights (`model.safetensors.index.json` and its shards, `model.safetensors`, or `model.pth`), `codec.pth` and the BPE tokenizer files. A voice's cache is `codes.pt`, each reference's codes.","locale":"en"},"15302":{"id":"/en/docs/engines-fishspeech-18","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#variants-and-files","content":"Precision: bf16 on a CUDA GPU, as upstream; fp32 elsewhere (bf16 is emulated on a CPU and far slower); `engines.fishspeech.dtype` overrides.","locale":"en"},"15303":{"id":"/en/docs/engines-fishspeech-19","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"The prompt is a ChatML conversation: a system turn holding each reference's text and its codes, then the text to speak. The **slow transformer** (Qwen3-4B-shaped: 36 layers, q/k RMSNorm, one fused `wqkv`) generates a frame's semantic token; the **fast transformer** (4 layers) generates the other nine codebooks from the slow model's normed hidden state. The **codec** (a modified DAC at 44.1 kHz: causal convolutions, a windowed transformer, a downsampling residual quantiser with one semantic codebook of 4096 and nine of 1024; about 21.5 frames a second) encodes references and decodes frames into audio. Text is generated in batches of speaker turns, each batch decoded as it finishes.","locale":"en"},"15304":{"id":"/en/docs/engines-fishspeech-20","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"Module","locale":"en"},"15305":{"id":"/en/docs/engines-fishspeech-21","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"What it is","locale":"en"},"15306":{"id":"/en/docs/engines-fishspeech-22","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`engine.py`","locale":"en"},"15307":{"id":"/en/docs/engines-fishspeech-23","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"References read, resampled to 44.1 kHz and encoded; generation by batches of speaker turns; codec decoding; the `codec_encode` and `codec_decode` operations","locale":"en"},"15308":{"id":"/en/docs/engines-fishspeech-24","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`model.py`","locale":"en"},"15309":{"id":"/en/docs/engines-fishspeech-25","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"The dual-AR transformer","locale":"en"},"15310":{"id":"/en/docs/engines-fishspeech-26","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`generate.py`","locale":"en"},"15311":{"id":"/en/docs/engines-fishspeech-27","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"The conversation prompt, sampling in upstream's order, turn grouping, the decoder (`Decoder`) with its CUDA graphs","locale":"en"},"15312":{"id":"/en/docs/engines-fishspeech-28","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`fused.py`","locale":"en"},"15313":{"id":"/en/docs/engines-fishspeech-29","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`compute.compile`: the decoding step's pieces under `torch.compile` (`Fused`)","locale":"en"},"15314":{"id":"/en/docs/engines-fishspeech-30","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`codec.py`","locale":"en"},"15315":{"id":"/en/docs/engines-fishspeech-31","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"The 44.1 kHz codec","locale":"en"},"15316":{"id":"/en/docs/engines-fishspeech-32","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`train.py`, `finetune.py`","locale":"en"},"15317":{"id":"/en/docs/engines-fishspeech-33","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"`FishSpeechTrainer` (method `lora`) and its maths","locale":"en"},"15318":{"id":"/en/docs/engines-fishspeech-34","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works","content":"Shared: `text/tokenize/bpe.py`, `runtime/lm/cache.py`, `runtime/graphs.py`, `nn/dsp/` (`resample`, `wav`, `flac`).","locale":"en"},"15319":{"id":"/en/docs/engines-fishspeech-35","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream","content":"**The prompt** is upstream's conversation, each text part tokenised alone; a frame's main token is `semantic_begin_id + code`.","locale":"en"},"15320":{"id":"/en/docs/engines-fishspeech-36","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream","content":"**Sampling** draws from the request's generator in upstream's order: the main token twice (with the request's temperature and top-p, then with 1.0 and 0.9 for repetition-aware sampling), then nine fast-transformer draws. A draw is `argmax(probs / -log(u))`. Top-k is fixed at 30, as upstream fixes it.","locale":"en"},"15321":{"id":"/en/docs/engines-fishspeech-37","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream","content":"**Numerics**: Fish's RMSNorm in float32; RoPE over adjacent pairs with the frequency table rounded to bfloat16; the prefill on SDPA with a boolean causal mask, decoding steps on SDPA's math kernel (called directly, no process-wide setting, with the boolean mask made additive first as `F.scaled_dot_product_attention` does: given a bool mask, the kernel itself adds it as numbers; until 0.2.6 every step's scores were shifted by 1, the same codes on the CPU but other bits, and on a GPU in bfloat16 another take); the fast transformer's hand-written softmax. Weight norm is kept in both checkpoint formats and recomputed every forward, as upstream does.","locale":"en"},"15322":{"id":"/en/docs/engines-fishspeech-38","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream","content":"**References** are resampled with torchaudio's kernel to 44.1 kHz.","locale":"en"},"15323":{"id":"/en/docs/engines-fishspeech-39","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream","content":"**WAV output.** `codec_decode` writes WAV with `nn.dsp.wav.write_wav`, byte-identical to `soundfile.write`: libsndfile 1.2 stores `lrint(x × 2³¹) >> 16`, clipped, which is `floor(x × 32768)` except for values just below a step. `codec_encode` reads WAV only.","locale":"en"},"15324":{"id":"/en/docs/engines-fishspeech-40","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**No daemon thread and no 32 768-position preallocated cache.** The cache grows by concatenation; after `repeat_interleave` the keys and values are the tensors upstream builds. Attention masks are made per call instead of upstream's 4 GiB of mask buffers.","locale":"en"},"15325":{"id":"/en/docs/engines-fishspeech-41","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**A codec module upstream never runs is not built.** Upstream's codec builds a transformer for the decoder's first block but never attaches it (no weights, never run). `codec.pth` also holds RoPE tables and masks an older upstream saved, which upstream no longer loads; they are ignored.","locale":"en"},"15326":{"id":"/en/docs/engines-fishspeech-42","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**Accepted, with no effect**: `normalize` and `repetition_penalty` reach nothing in upstream's inference path, so they do nothing here either.","locale":"en"},"15327":{"id":"/en/docs/engines-fishspeech-43","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**References encode on a GPU.** Upstream loads the codec in bf16 on a GPU and `encode_reference` passes it float32 audio, so cloning there fails (`Input type (float) and bias type (c10::BFloat16) should be the same`; reproduced with 0.1 on an RTX 3090). The port casts the reference audio to the codec's precision; on the CPU, in fp32, nothing changes.","locale":"en"},"15328":{"id":"/en/docs/engines-fishspeech-44","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**Snake on a GPU** is upstream's TorchScript function, computed as TorchScript computes it rather than as the same code run eagerly:","locale":"en"},"15329":{"id":"/en/docs/engines-fishspeech-45","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**Under autocast** (decoding in bf16 or fp16) it runs in float32 throughout. Eager autocast keeps `alpha · x` and the sine in the low precision; the port did so until mizuoto-fishspeech 0.3.3, and its decoded audio differed from upstream's by up to 0.036 on an RTX 3060.","locale":"en"},"15330":{"id":"/en/docs/engines-fishspeech-46","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**Without autocast** (encoding references) the operations run in place, with the same result.","locale":"en"},"15331":{"id":"/en/docs/engines-fishspeech-47","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**Against upstream:** with TorchScript's fuser off, the port's codec gives upstream's reference codes and decoded audio bit for bit on an RTX 3060 in bf16 (Drama 3's `codec.pth`, which S2 Pro shares; three clips).","locale":"en"},"15332":{"id":"/en/docs/engines-fishspeech-48","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations","content":"**Upstream's fused kernel:** from a shape's second call, upstream's TorchScript fuses Snake, which changes rounding and depends on what the process has already run. Against that, the decoded audio is within 0.01 and about a fifth of the reference codes differ. Computing Snake in float32 and rounding once, as the fused kernel does, still left 8–14 % of the codes different, so no fixed computation can follow it.","locale":"en"},"15333":{"id":"/en/docs/engines-fishspeech-49","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed","content":"Phases: the codec encodes references and decodes each batch of frames; the language model (`kind=\"sequence\"`, the fast transformer `hot`) generates each batch, placed again as generation resumes. Each batch's working memory is the slow model's cache for its true bound: the references' codes, every text token, the frames of the batches before it and `max_new_tokens`, within `max_seq_len`. S2 Pro took 10.2 GB of GPU memory at most with the defaults (bf16; G13 on Performance); with less, the runtime streams part of its weights. If the codec's decoding runs out of memory with `compute.oom_fallback` on, its convolution decoder runs in tiles of 256 latent frames (about 3 s), each after the 20 frames its first sample depends on (the decoder is causal), and the quantizer's side whole: the whole's samples up to the sums' rounding (40 dB SNR in bf16 on a GPU, where bf16 against float32 is 37.9 dB), in 275 MB instead of 5 GB for 60 s.","locale":"en"},"15334":{"id":"/en/docs/engines-fishspeech-50","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed","content":"A frame is one slow-transformer step and ten codebooks. The plain loop waited for the device about 22 times a frame: the end-of-turn check; a masked assignment zeroing the codebook embeddings of non-semantic tokens (`vq_sum[~mask] = 0` reads the mask back); the fast transformer's mask and rotary rows taken with list indices (two copies to the device per codebook); a Python boolean stored into a device tensor in the sampler, twice per draw. Each became an exact equivalent (`torch.where`, slices, `fill_`), and the decoding step's mask is made as the one all-true row it is. One wait per frame remains.","locale":"en"},"15335":{"id":"/en/docs/engines-fishspeech-51","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed","content":"With `compute.cuda_graphs` (NVIDIA, the model wholly on its device) `generate.Decoder` keeps fixed tensors per loaded model: the slow step runs as one graph per stretch between attention calls (`LayerSteps`), and the frame's draws, repetition-aware sampling and the fast transformer as one graph. The sampling settings are device tensors filled per request, so one set of graphs serves every request. The codes are identical, 2.2–2.5 times faster per frame on the decode loop.","locale":"en"},"15336":{"id":"/en/docs/engines-fishspeech-52","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed","content":"On a free RTX 3060 the whole model's frame takes about 64 ms with graphs. About 50 ms of that is reading 16 GB of weights at close to the card's bandwidth; most of the rest is thousands of small kernels. `compute.compile` (opt-in, not exact; `fused.py`) fuses them: it compiles each layer's halves around its attention, the attention over the cache, the step's embeddings and heads, and the draws' probabilities, inside the same graphs, with the eager code untouched when it is off. Each frame is then 1.15 times faster. The draws are unchanged, but the probabilities differ in their last bits, so the speech is another take of the same text and voice, which still repeats under a seed and passes the contract suite. It runs only while the model is wholly on its device, and the output lists it (`applied[\"compile\"]`). Details: Acceleration.","locale":"en"},"15337":{"id":"/en/docs/engines-fishspeech-53","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#training","content":"Method `lora` (stages `tokens`, `train`, `export`): upstream's `extract_vq`, `build_dataset`, its Lightning + Hydra `train.py` with loralib and `merge_lora`, without any of those libraries or protobuf. Seeded alike, it gives 0.1's codes, losses, LoRA weights and exported `model.pth` bit for bit on the CPU, and every other exported file byte for byte. (0.1 never seeded, so only its first step repeats.) It runs on every device kind.","locale":"en"},"15338":{"id":"/en/docs/engines-fishspeech-54","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#training","content":"**Initialisation draws, jumped over.** Upstream builds the model with random weights before loading the checkpoint, and initialises each loralib layer twice before drawing `A`: some 18 G draws. `initial_lora` computes how far those draws advance the generator from the shapes alone (a float32 `normal_` or `uniform_` advances it by its size, `normal_` by 16 more when the size is not a multiple of 16) and jumps MT19937 ahead in GF(2) (`mizuoto.training.rng`): the same state in 2 s instead of 40 s of drawing, computed in a thread while the weights load. Then come the loader's base seed and each step's LoRA dropout masks.","locale":"en"},"15339":{"id":"/en/docs/engines-fishspeech-55","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#training","content":"**Mixed precision as upstream's.** The checkpoint's tensors are assigned as upstream assigns them, so S2's norms stay bfloat16 while the LoRA layers hold float32 copies.","locale":"en"},"15340":{"id":"/en/docs/engines-fishspeech-56","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#training","content":"**Kept**: upstream's training forward does not scale the codebook embeddings by 1/√11 as inference does; the warm-up makes the first step's learning rate 0 and `B` starts at zero, so the first two steps give the same loss.","locale":"en"},"15341":{"id":"/en/docs/engines-fishspeech-57","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#training","content":"**Padding.** The collator pads with `<|end_of_text|>`, which S2's vocabulary lacks: upstream pads with 0, and so does Mizuoto.","locale":"en"},"15342":{"id":"/en/docs/engines-fishspeech-58","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#training","content":"**The export** is upstream's flat `dual_ar` form (`config.json` + `model.pth`), which both 0.1 and Mizuoto load. The final validation pass is skipped (it changes nothing that is kept).","locale":"en"},"15343":{"id":"/en/docs/engines-fishspeech-59","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#training","content":"`training.memory`: upstream's per-layer checkpointing stays as it is; under `bf16-true` the LoRA layers keep the checkpoint's own bfloat16 tensors as their frozen weights (memory-mapped from the safetensors files, no copy: the same values), and the export's key order is read from a model built on the meta device. Measured on S2 Pro (2026-10-19, an RTX 3090): the training stage's process holds 0.4 GB of its own memory while loading (8.9 GB with bfloat16 copies, 17 GB with float32 ones) and peaks at 5 GB resident; the export holds the merged weights, 9 GB, beside the mapped checkpoint (page cache). Under `lowest` the LoRA linear layers' frozen weights stay in page-locked RAM and are copied to the GPU for each product (`streamed_linear`, the model placed without them): identical (the tiny trainer's losses and LoRA weights on the CPU); S2 Pro's LoRA at batch 2 then peaks at 7.9 GB instead of 15.6 (an RTX 3060, 15.6 s a step there over its PCIe x4 link), and the default batch 4 is estimated at 12.6 GB.","locale":"en"},"15344":{"id":"/en/docs/engines-fishspeech-60","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#parity","content":"Codes identical to upstream's seeded `generate_long` on the CPU in fp32; the tokenizer, the references' resampling and codes and the codec's decoding are identical too. Both stack cases (English and Chinese cloning) are identical sample for sample; two more cases load each implementation's export in the other, identical too. The contract suite passes (6 tests).","locale":"en"},"15345":{"id":"/en/docs/engines-fishspeech-61","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#limitations","content":"About 10 GB of GPU memory to run the model whole (S2 Pro); on a CPU it runs in fp32 and is slow.","locale":"en"},"15346":{"id":"/en/docs/engines-fishspeech-62","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#limitations","content":"`normalize` and `repetition_penalty` have no effect (as upstream), and top-k cannot be changed.","locale":"en"},"15347":{"id":"/en/docs/engines-fishspeech-63","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#limitations","content":"Results are under the Fish Audio Research License: not for commercial use, and not for training other engines.","locale":"en"},"15348":{"id":"/en/docs/engines-fishspeech-64","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#drama-3","content":"Variant `drama3`, catalogue model `fishspeech/drama-3` (fishaudio/drama-3 at 78e5ab79, 41.5 GB: the weights with the experts in block FP8, and S2's `codec.pth`, byte for byte the same file). Ported from fish-speech 0f8a12e8 (`fish_speech/models/text2semantic/fish_omni` and `generate_long_drama3`), as `mizuoto_fishspeech/drama3`. It clones from one to four clips (each with its transcript), speaks without a reference in a voice of its own, takes inline directions (`[whispering]`, `[laughing]`, `<whisper>…</whisper>`) and up to sixteen speakers (`<|speaker:0|>`…`<|speaker:15|>`; a reference's transcript may start with its speaker's tag). Licence: the Fish Audio Community License 1.0, the variant's own (`variants.drama3.licence`); the engine's acceptance covers both licences, and its outputs are tagged `fish-audio-community`.","locale":"en"},"15349":{"id":"/en/docs/engines-fishspeech-65","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"Module","locale":"en"},"15350":{"id":"/en/docs/engines-fishspeech-66","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"What it is","locale":"en"},"15351":{"id":"/en/docs/engines-fishspeech-67","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/config.py`","locale":"en"},"15352":{"id":"/en/docs/engines-fishspeech-68","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`config.json`: the backbone's text config, the tower's, the semantic band, checked as upstream checks them","locale":"en"},"15353":{"id":"/en/docs/engines-fishspeech-69","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/layers.py`","locale":"en"},"15354":{"id":"/en/docs/engines-fishspeech-70","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"Zero-centred RMSNorm, partial RoPE (halves), gated softmax attention, Gated DeltaNet (a causal depthwise convolution, then the gated delta rule: by chunks of 64 for a prompt, token by token after)","locale":"en"},"15355":{"id":"/en/docs/engines-fishspeech-71","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/moe.py`","locale":"en"},"15356":{"id":"/en/docs/engines-fishspeech-72","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"256 routed experts a layer (8 per token) and a gated shared expert; the experts stacked, kept in FP8, streamed by the row","locale":"en"},"15357":{"id":"/en/docs/engines-fishspeech-73","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/backbone.py`","locale":"en"},"15358":{"id":"/en/docs/engines-fishspeech-74","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"Qwen3.5-MoE's hybrid text model (40 layers, every fourth softmax attention) and its `lm_head`; loading the per-expert FP8 tensors","locale":"en"},"15359":{"id":"/en/docs/engines-fishspeech-75","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/tower.py`","locale":"en"},"15360":{"id":"/en/docs/engines-fishspeech-76","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"The codebook tower: 4 shared and 9 residual layers attending over the frames, each residual layer's head drawing the next code; both samplers","locale":"en"},"15361":{"id":"/en/docs/engines-fishspeech-77","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/prompt.py`","locale":"en"},"15362":{"id":"/en/docs/engines-fishspeech-78","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"The prompt (a chat: system turn with `[Reference i]` blocks, earlier chunks as finished turns, the open voice turn), text checks, long-text chunks and their history","locale":"en"},"15363":{"id":"/en/docs/engines-fishspeech-79","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/generate.py`","locale":"en"},"15364":{"id":"/en/docs/engines-fishspeech-80","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"Prefill in blocks of 128 rows (teacher-forcing the tower's caches), the decoding loop (`Decoder`), chunk after chunk","locale":"en"},"15365":{"id":"/en/docs/engines-fishspeech-81","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/steps.py`","locale":"en"},"15366":{"id":"/en/docs/engines-fishspeech-82","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"The decoding step as CUDA graphs around its attention calls (`Stretches`), its fixed tensors","locale":"en"},"15367":{"id":"/en/docs/engines-fishspeech-83","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`drama3/engine.py`","locale":"en"},"15368":{"id":"/en/docs/engines-fishspeech-84","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"`LoadedDrama3`: S2's codec, references and operations (it subclasses `LoadedFishSpeech`) with the backbone and tower","locale":"en"},"15369":{"id":"/en/docs/engines-fishspeech-85","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#how-it-works-1","content":"A frame is ten codes: the backbone predicts its main token (the end of the turn or a semantic token, whose place in the band is code 0) from the frames so far, each prompt row's embedding being its token's plus, for audio rows, its code 1 (scaled by 1/√2). The tower then takes the backbone's hidden state and draws codes 1–9, one residual layer per code, its first shared layer also seeing the previous frame's codes 2–9. Text is cut into chunks of about 300 UTF-8 bytes with at most three speakers each (sentence ends, then clause marks, then spaces; never inside a tag or bracket), each generated with the first chunk and the latest one in its prompt as history; `single_chunk` generates the whole text at once.","locale":"en"},"15370":{"id":"/en/docs/engines-fishspeech-86","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"On the CPU, upstream's modules and the port give the same hidden states, logits, frames and audio, bit for bit and sample for sample (see Parity). In particular:","locale":"en"},"15371":{"id":"/en/docs/engines-fishspeech-87","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"**Every operation in upstream's order**: the norms in float32, the rotary tables computed per call, the delta rule's chunked form for prompts (`solve_triangular` per chunk) and its recurrence for steps, the GQA attention (a single query row folds each key head's query heads into rows; more rows repeat the key heads) through `mizuoto.runtime.accel.attention` with SDPA and a boolean mask, the tower's interleaved RoPE, its float32-output down projection for float16; in float16 the experts are dequantized in float32 and saturated to float16's range before the cast, as upstream's dense experts are.","locale":"en"},"15372":{"id":"/en/docs/engines-fishspeech-88","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"**The experts**: up to 64 (token, expert) pairs in one batched matmul over the gathered experts (a decoding step), more expert by expert, summed in float32 by `index_add_` in the experts' order (a prompt): the two paths give different bits, so both are kept. The router's softmax and top-k in float32, the weights renormalised.","locale":"en"},"15373":{"id":"/en/docs/engines-fishspeech-89","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"**The prompt**, each literal tokenised alone, references checked and tagged as upstream tags them; the chunking (upstream's tests' cases are the package's tests) and the history (the first chunk pinned, the latest one, dropped oldest first when the prompt passes 8192 rows).","locale":"en"},"15374":{"id":"/en/docs/engines-fishspeech-90","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"**Sampling** draws from the request's generator in upstream's order: per frame, the main token twice (at the request's settings over the end and the semantic band, then at 1.0, top-k 30, top-p 0.95; the second replaces the first when the first is an audio token among the last 16 main tokens), then the nine codes. A draw is `argmax(p / E)` with `E ~ Exp(1)`. The `sampler` option selects Fish Audio's reference sampler (`reference_argmax` / `reference_ras`, upstream's `--reference-sampling`): an epsilon cutoff for the main token (`epsilon_cutoff`, 0.001 by default), every repeated main token replaced (the end included), the codes drawn only from the codec's 1024.","locale":"en"},"15375":{"id":"/en/docs/engines-fishspeech-91","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"**Upstream's limits**: at most 8192 prompt rows and 10 240 rows in all (its CUDA graphs' capacity; a chunk's frames are clamped to what is left), the defaults of Fish Audio's SDK (temperature 0.7, top-p 0.7, top-k 30, 1024 frames per chunk; `max_new_tokens = 0`: 600, or 2048 with `single_chunk`).","locale":"en"},"15376":{"id":"/en/docs/engines-fishspeech-92","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#what-reproduces-upstream-1","content":"**The codec**: S2's, its weight norm folded once in float32 before the cast to the model's precision (upstream's `load_codec_model` for Drama 3), decoding under autocast in that precision; references encoded in it.","locale":"en"},"15377":{"id":"/en/docs/engines-fishspeech-93","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#cuda-graphs","content":"With `compute.cuda_graphs` (an NVIDIA GPU holding the backbone and the tower whole: about 44 GB in bfloat16) the decoding step runs as CUDA graphs that replay the eager kernels (`drama3/steps.py`, `generate.Decoder`). A step is the tower's graphs (the output head, the frame's draws, one graph between each two of its 13 layers' attention calls), then the backbone's on that frame (one graph between each two of its 10 softmax attention layers, the Gated DeltaNet layers, the router and the experts inside them). The attention calls run eagerly between the graphs, over caches that grow by one each step, so the caches and the attention kernels are the eager code's. The step waits for the device once, for the frame's main token and whether its logits were finite.","locale":"en"},"15378":{"id":"/en/docs/engines-fishspeech-94","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#cuda-graphs","content":"**Fixed tensors**, kept with the loaded model: the step's inputs and outputs (the last hidden state, the position, the previous frame, the last 16 main tokens padded with −1, the frame and its flags) and the Gated DeltaNet layers' states, which the graphs update in place and each request starts at zero. The attention layers' caches stay each request's own.","locale":"en"},"15379":{"id":"/en/docs/engines-fishspeech-95","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#cuda-graphs","content":"**The sampling settings are captured as the eager code passes them**, as Python numbers: CUDA divides by a number as a multiplication by its reciprocal and by a device tensor as a true division, so tensors would change bits. The tower's graphs (14 captures) are captured again when a request's temperature, top-p, top-k, sampler or cutoff differs; the backbone's are kept.","locale":"en"},"15380":{"id":"/en/docs/engines-fishspeech-96","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#cuda-graphs","content":"**Upstream's own graphs are not ported**: they capture the whole step for a few cache lengths (1024, 2048, 4096, 10 240), attending over a padded, masked cache with the settings as device tensors, which changes bits against its eager decoding.","locale":"en"},"15381":{"id":"/en/docs/engines-fishspeech-97","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#cuda-graphs","content":"**Streamed experts decode eagerly**: on a GPU smaller than the model the experts stream by the row, and which rows a step copies is learnt from the device, which a graph cannot wait for.","locale":"en"},"15382":{"id":"/en/docs/engines-fishspeech-98","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#cuda-graphs","content":"Checked on the CPU through `Graphs`' contract (each stretch warmed up and captured with its state put back, then replayed): the eager audio for both samplers, several chunks, later requests and changed settings (`test_the_step_as_graph_stretches_decodes_exactly_as_eagerly`). On an NVIDIA GPU, `test_cuda_graphs_decode_exactly_as_eagerly_on_a_gpu` (bfloat16 and float16) and `test_a_failed_capture_falls_back_to_the_same_audio_on_a_gpu` compare graphs with eager decoding on the tiny model; they skip without one.","locale":"en"},"15383":{"id":"/en/docs/engines-fishspeech-99","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations-1","content":"**Devices and precision.** Upstream runs Drama 3 only on NVIDIA GPUs, in bfloat16 (float16 before SM80, with a float32 residual stream); its entry points refuse the CPU and float32. The port runs on every device kind, in float32 on the CPU (as S2 Pro): the reference it is checked against is upstream's modules run there in float32, unchanged.","locale":"en"},"15384":{"id":"/en/docs/engines-fishspeech-100","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations-1","content":"**The experts stay in FP8**, the experts a call uses dequantized as it runs, as upstream does wherever its FP8 kernel does not run; upstream's other path dequantizes them all at load. Both give the same values (the tiny parity checks both against the port): 32 GB of experts instead of 64 GB in bfloat16 or 129 GB in float32. **Upstream's W8A8 kernel** (Triton, SM89 and newer, which also quantizes the activations to FP8) is not ported: its results differ, so it could only come as an opt-in, and it cannot be measured here.","locale":"en"},"15385":{"id":"/en/docs/engines-fishspeech-101","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations-1","content":"**No multi-GPU layer split and no cache kept between requests.** Upstream spreads the layers over up to four GPUs and keeps caches sized for the largest request so far; here the model manager places the layers (streaming what does not fit) and each request has its own caches. Attention reads only the attended prefix either way.","locale":"en"},"15386":{"id":"/en/docs/engines-fishspeech-102","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations-1","content":"**Non-finite logits** are refused, as upstream refuses them, but checked once per frame (at the frame's one wait for the device) rather than before each draw.","locale":"en"},"15387":{"id":"/en/docs/engines-fishspeech-103","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations-1","content":"**The audio is the chunks' audio joined**, unclipped, as upstream's; S2 Pro's engine clips each batch. The variant declares `long_text`, so Mizuoto hands the engine the whole text and upstream's chunking and history apply (cut by Mizuoto into separate requests, the history would never cross them).","locale":"en"},"15388":{"id":"/en/docs/engines-fishspeech-104","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations-1","content":"**What Mizuoto does before any engine** applies here too: the text and each reference's transcript are stripped of surrounding white space; a reference is stored in the voice library as mono 16-bit WAV (a float, 24-bit or stereo clip is converted, so its codes can differ from upstream reading the original file); one longer than 30 s is trimmed under `tts.reference_policy`; seeds are not negative (upstream takes the absolute value).","locale":"en"},"15389":{"id":"/en/docs/engines-fishspeech-105","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#deviations-1","content":"**Not ported**: upstream's CUDA graphs for Drama 3 (they change bits; Mizuoto's replay the eager kernels, see CUDA graphs), its fine-tuning (upstream removed its training code with Drama 3, so the LoRA method is S2 Pro's only), and \"director revision\" across turns (not in the open code).","locale":"en"},"15390":{"id":"/en/docs/engines-fishspeech-106","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed-1","content":"Handles: the backbone (`kind=\"sequence\"`; each layer two units, its attention `hot` and its MoE, and the output head `hot`), the tower (`sequence`) and the codec. The experts stream **by the row** (Development: memory): a layer whose MoE unit is not resident keeps its 256 experts in pinned host memory and each call copies the experts its tokens are routed to (a decoding step: 8 a layer, about 25 MB; a prompt block: expert by expert), so a GPU far smaller than the model runs it. Whole, the model needs about 44 GB; its dense part (attention, shared experts, embeddings and head, the tower) is about 7.5 GB in bfloat16. Working memory per request: the softmax layers' and the tower's caches for the request's rows (at most 10 240), the DeltaNet states, a prompt block's activations and the experts a step dequantizes.","locale":"en"},"15391":{"id":"/en/docs/engines-fishspeech-107","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed-1","content":"On the CPU, in float32 with 16 threads, a frame takes about 2.1 s, upstream's modules as long (a second of speech is 21.5 frames: some 45 s of compute); a prompt of 230 rows about 35 s. On a GPU it needs about 44 GB to hold the whole model, or its experts (30 GiB) stream from RAM; where RAM cannot hold them either, the layers' experts that do not fit are kept in files (`runtime.filemap`, Memory). First run on a GPU, 2026-11-05: an RTX 3060 (12 GB, PCIe x4) in a machine with 31 GB of RAM, bf16: 9.1 GB on the GPU, 17.0 GB of experts in page-locked RAM, 20.7 GB in files; a warm request of 5.5–8.3 s of speech took 128–162 s (176–226 GB copied to the GPU a request, 1.4 GB/s), its two runs identical; 15–32 GiB of it read from the disk, the rest of the file-backed experts from the page cache (72–87 %); RAM never fell below 7.9 GB available.","locale":"en"},"15392":{"id":"/en/docs/engines-fishspeech-108","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed-1","content":"A random model with the real one's shapes but 8 experts did run, on an RTX 3060 (2026-11-03, torch 2.8, bf16, 8.5 GB on the device). Every token still uses 8 experts, so a decoding step does the real model's work.","locale":"en"},"15393":{"id":"/en/docs/engines-fishspeech-109","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed-1","content":"**Speed:** 150 frames took 19.2 s eagerly and 16.3 s with CUDA graphs, ×1.18 (128 → 109 ms a frame), identical audio.","locale":"en"},"15394":{"id":"/en/docs/engines-fishspeech-110","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed-1","content":"**Graphed frames:** about 7,250 kernels each, the device busy 97 % of the time.","locale":"en"},"15395":{"id":"/en/docs/engines-fishspeech-111","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#memory-and-speed-1","content":"**The tiny test model:** ×2.1 (1.56 → 0.74 s a request), identical too.","locale":"en"},"15396":{"id":"/en/docs/engines-fishspeech-112","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#parity-1","content":"Against upstream's own modules (fish-speech 0f8a12e8) on the CPU in float32, the same seed and thread count, with the real model (2026-11-01; workspace `experiment/fish-drama3`, `scripts/real_upstream.py`, `real_native.py`, `real_compare.py`): seven cases, the reference clips' codes, every chunk's codes and the audio **identical** sample for sample: English and Chinese cloning, no reference, inline tags (`[laughing]`, `[whispering]`), a two-speaker dialogue with two references, the reference sampler (`reference_ras`, cutoff 0.002), and a long text generated as two chunks with history (542 frames, 25 s). Upstream repeated itself exactly before being compared. Upstream ran as its `TTSInferenceEngine` runs a request (references through its loader and codec, `set_seed`, `generate_long_drama3`, its codec's decoding), the port as the server runs it (`synthesize`). On a tiny random model (`scripts/tiny_parity.py`) twelve cases more (no cap on top-k, top-k 10 at temperature 1.2, single chunk, `max_new_tokens = 0`, Chinese with paired tags…) are identical in float32 and bfloat16, against upstream's FP8 experts and its dequantized ones, with the backbone's hidden states and logits bit for bit.","locale":"en"},"15397":{"id":"/en/docs/engines-fishspeech-113","page_id":"/en/docs/engines-fishspeech","tags":[],"type":"text","url":"/en/docs/engines-fishspeech#parity-1","content":"A source review against upstream found Mizuoto cutting Drama 3's long text itself (fixed: the variant declares `long_text`) and float16's experts unclamped (fixed), and the request-level differences listed under Deviations.","locale":"en"},"15398":{"id":"/en/docs/engines-gptsovits","page_id":"/en/docs/engines-gptsovits","type":"page","content":"GPT-SoVITS","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-gptsovits","locale":"en"},"15399":{"id":"/en/docs/engines-gptsovits-0","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits","content":"The GPT-SoVITS engine as implemented in Mizuoto: v2, v2Pro, v2ProPlus, v4 and v5 Turbo, the text front end with its ported converters and models, the T2S model, SoVITS and the flow, what reproduces upstream exactly, GPU decoding, the speaker fine-tune that writes upstream's files, and its parity results.","locale":"en"},"15400":{"id":"/en/docs/engines-gptsovits-1","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#variants-and-files","content":"Variants and files","locale":"en"},"15401":{"id":"/en/docs/engines-gptsovits-2","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#how-it-works","content":"How it works","locale":"en"},"15402":{"id":"/en/docs/engines-gptsovits-3","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15403":{"id":"/en/docs/engines-gptsovits-4","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#deviations","content":"Deviations","locale":"en"},"15404":{"id":"/en/docs/engines-gptsovits-5","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#memory-and-speed","content":"Memory and speed","locale":"en"},"15405":{"id":"/en/docs/engines-gptsovits-6","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#training","content":"Training","locale":"en"},"15406":{"id":"/en/docs/engines-gptsovits-7","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#parity","content":"Parity","locale":"en"},"15407":{"id":"/en/docs/engines-gptsovits-8","page_id":"/en/docs/engines-gptsovits","type":"heading","tags":[],"url":"/en/docs/engines-gptsovits#limitations","content":"Limitations","locale":"en"},"15408":{"id":"/en/docs/engines-gptsovits-9","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits","content":"Few-shot cloning and voice fine-tuning (RVC-Boss/GPT-SoVITS, MIT). Code: `mizuoto/engines/gptsovits`. On the CPU in fp32 with the same seed it is identical to Mizuoto 0.1 (upstream's `TTS_infer_pack.TTS` behind its adapter) in all 15 parity cases, and its trainer writes upstream's preparation files and weights identically. User-facing details: Engines in depth.","locale":"en"},"15409":{"id":"/en/docs/engines-gptsovits-10","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"Variant","locale":"en"},"15410":{"id":"/en/docs/engines-gptsovits-11","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"Catalogue model","locale":"en"},"15411":{"id":"/en/docs/engines-gptsovits-12","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"Rate","locale":"en"},"15412":{"id":"/en/docs/engines-gptsovits-13","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"Second stage","locale":"en"},"15413":{"id":"/en/docs/engines-gptsovits-14","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`v2`","locale":"en"},"15414":{"id":"/en/docs/engines-gptsovits-15","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`gptsovits/v2-base`","locale":"en"},"15415":{"id":"/en/docs/engines-gptsovits-16","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"32 kHz","locale":"en"},"15416":{"id":"/en/docs/engines-gptsovits-17","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"SoVITS: a VITS decoder (coupling flow, HiFi-GAN)","locale":"en"},"15417":{"id":"/en/docs/engines-gptsovits-18","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`v2pro`","locale":"en"},"15418":{"id":"/en/docs/engines-gptsovits-19","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`gptsovits/v2pro-base`","locale":"en"},"15419":{"id":"/en/docs/engines-gptsovits-20","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"32 kHz","locale":"en"},"15420":{"id":"/en/docs/engines-gptsovits-21","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"as v2, plus a speaker-verification embedding (ERes2NetV2)","locale":"en"},"15421":{"id":"/en/docs/engines-gptsovits-22","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`v2proplus`","locale":"en"},"15422":{"id":"/en/docs/engines-gptsovits-23","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`gptsovits/v2proplus-base`","locale":"en"},"15423":{"id":"/en/docs/engines-gptsovits-24","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"32 kHz","locale":"en"},"15424":{"id":"/en/docs/engines-gptsovits-25","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"a larger v2Pro SoVITS","locale":"en"},"15425":{"id":"/en/docs/engines-gptsovits-26","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`v4`","locale":"en"},"15426":{"id":"/en/docs/engines-gptsovits-27","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`gptsovits/v4-base`","locale":"en"},"15427":{"id":"/en/docs/engines-gptsovits-28","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"48 kHz","locale":"en"},"15428":{"id":"/en/docs/engines-gptsovits-29","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`SynthesizerTrnV3`, a CFM with a DiT, a 48 kHz HiFi-GAN vocoder","locale":"en"},"15429":{"id":"/en/docs/engines-gptsovits-30","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`v5turbo`","locale":"en"},"15430":{"id":"/en/docs/engines-gptsovits-31","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"`gptsovits/v5turbo-base`","locale":"en"},"15431":{"id":"/en/docs/engines-gptsovits-32","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"48 kHz","locale":"en"},"15432":{"id":"/en/docs/engines-gptsovits-33","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"as v4 with `CFMV5` in four steps","locale":"en"},"15433":{"id":"/en/docs/engines-gptsovits-34","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"The variant comes from the base GPT and SoVITS pair in the model folder, laid out as upstream lays it out: `gsv-v2final-pretrained/…`, `s1v3.ckpt`, `v2Pro/s2Gv2Pro.pth` / `s2Gv2ProPlus.pth`, `gsv-v4-pretrained/{s2Gv4,vocoder}.pth`, `gsv-v5-pretrained/{s2Gv5turbo,vocoder}.pth`. A voice's own weights (`Voice.weights[\"gptsovits\"]`: a GPT `.ckpt` and a SoVITS `.pth`, version read from the file) replace the base pair for that voice.","locale":"en"},"15434":{"id":"/en/docs/engines-gptsovits-35","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"Shared assets: `gptsovits/encoders` (chinese-hubert-base, chinese-roberta-wwm-ext-large, the speaker-verification checkpoint), `gptsovits/g2pw`, `gptsovits/nltk-data`, `gptsovits/open-jtalk`; for training v2, v2Pro and v2ProPlus also the pretrained discriminators `gptsovits/s2d-v2`, `s2d-v2pro`, `s2d-v2proplus`.","locale":"en"},"15435":{"id":"/en/docs/engines-gptsovits-36","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#variants-and-files","content":"Precision: fp16 on a CUDA GPU when `engines.gptsovits.dtype` is `auto` or `fp16`, fp32 otherwise.","locale":"en"},"15436":{"id":"/en/docs/engines-gptsovits-37","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"**Text front end**: language segmentation, then each language's grapheme-to-phoneme conversion into phone ids; Chinese also gets BERT features (chinese-roberta's third-last layer, repeated per phone).","locale":"en"},"15437":{"id":"/en/docs/engines-gptsovits-38","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"**Reference**: the clip at 16 kHz with 0.3 s of silence appended; HuBERT's features quantised by SoVITS into the prompt's semantic tokens; the linear spectrogram for the style encoder; for v2Pro the speaker-verification embedding. v4/v5 also take the mel of the last clip read at 32 kHz as the flow's prompt.","locale":"en"},"15438":{"id":"/en/docs/engines-gptsovits-39","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"**GPT (T2S)**: a 24-layer autoregressive transformer predicts 25 Hz semantic tokens from the prompt's phones and tokens plus the target's phones, batched with left padding, or row by row when streaming.","locale":"en"},"15439":{"id":"/en/docs/engines-gptsovits-40","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"**SoVITS** (v2 family) decodes tokens, phones and the style into 32 kHz audio; v4/v5 make a mel with the flow, then the vocoder makes 48 kHz audio.","locale":"en"},"15440":{"id":"/en/docs/engines-gptsovits-41","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"**Post-processing**: each fragment limited to a peak of 1, followed by the fragment pause, and the whole truncated to 16 bits.","locale":"en"},"15441":{"id":"/en/docs/engines-gptsovits-42","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"Module","locale":"en"},"15442":{"id":"/en/docs/engines-gptsovits-43","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"What it is","locale":"en"},"15443":{"id":"/en/docs/engines-gptsovits-44","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`engine.py`","locale":"en"},"15444":{"id":"/en/docs/engines-gptsovits-45","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`TTS.run` as 0.1's adapter drove it: reference, text, length buckets, T2S, SoVITS or flow and vocoder, fragments, streaming","locale":"en"},"15445":{"id":"/en/docs/engines-gptsovits-46","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`audio.py`","locale":"en"},"15446":{"id":"/en/docs/engines-gptsovits-47","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"Reference reading; resampling with torchaudio's kernel or upstream's port of resampy's `kaiser_best`","locale":"en"},"15447":{"id":"/en/docs/engines-gptsovits-48","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`checkpoints.py`","locale":"en"},"15448":{"id":"/en/docs/engines-gptsovits-49","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`.pth` reading (the version tag written over the zip magic, the MD5 and size rules), a restricted unpickler for `HParams`","locale":"en"},"15449":{"id":"/en/docs/engines-gptsovits-50","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`t2s.py`","locale":"en"},"15450":{"id":"/en/docs/engines-gptsovits-51","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"The text-to-semantic model: batched and row-by-row decoding, upstream's sampler","locale":"en"},"15451":{"id":"/en/docs/engines-gptsovits-52","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`sovits.py`","locale":"en"},"15452":{"id":"/en/docs/engines-gptsovits-53","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`SynthesizerTrn` decoding for v2/v2Pro/v2ProPlus (the posterior encoder `enc_q` is not built)","locale":"en"},"15453":{"id":"/en/docs/engines-gptsovits-54","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`sovits_v3.py`","locale":"en"},"15454":{"id":"/en/docs/engines-gptsovits-55","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`SynthesizerTrnV3`, `CFM`/`CFMV5`, GPT-SoVITS's DiT variant, the vocoder paths, LoRA merging","locale":"en"},"15455":{"id":"/en/docs/engines-gptsovits-56","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`vocoder.py`, `sv.py`","locale":"en"},"15456":{"id":"/en/docs/engines-gptsovits-57","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"The v4/v5 48 kHz HiFi-GAN; the ERes2NetV2 speaker-verification embedding","locale":"en"},"15457":{"id":"/en/docs/engines-gptsovits-58","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`text/`","locale":"en"},"15458":{"id":"/en/docs/engines-gptsovits-59","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"The front end: `frontend.py` (cleaner, `TextPreprocessor`), segmentation, language detection (split-lang, fast-langdetect), Chinese (tone sandhi, normalisation, G2PW), English (normalisation, tagger, g2p_en), Japanese, Korean (g2pk2), Cantonese, symbols and data","locale":"en"},"15459":{"id":"/en/docs/engines-gptsovits-60","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`train.py`, `train_s1.py`, `train_s2.py`, `s2_modules.py`, `s2_lora.py`","locale":"en"},"15460":{"id":"/en/docs/engines-gptsovits-61","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"`GptSovitsTrainer` (method `speaker`)","locale":"en"},"15461":{"id":"/en/docs/engines-gptsovits-62","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#how-it-works","content":"Shared: `nn/ssl/hubert.py`, `nn/transformer/` (`bert`, `vits`, `dit`), `nn/flow/coupling.py`, `nn/speaker/melstyle.py`, `nn/vocoders/hifigan.py`, `nn/dsp/` (`kaldi`, `mel`, `resample`, `swresample`, `wav`, `flac`), `runtime/convert/onnx.py` (G2PW), `runtime/graphs.py`, `runtime/compile.py`.","locale":"en"},"15462":{"id":"/en/docs/engines-gptsovits-63","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"**Draws.** One generator, reseeded per segment, draws the T2S sampling and then the SoVITS (or flow) noise, as upstream's `set_seed` and the global stream did. Preparing the reference draws nothing (HuBERT's layer drop is not replayed; 0.1 prepared the reference before seeding for the same reason).","locale":"en"},"15463":{"id":"/en/docs/engines-gptsovits-64","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"**Pauses and output.** The pause after each fragment is counted at 32 kHz whatever the output rate, and the audio is truncated to 16 bits (`(x × 32768).astype(int16)`), as upstream returns it.","locale":"en"},"15464":{"id":"/en/docs/engines-gptsovits-65","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"**The text front end owns everything it uses**, built from asset paths: no `nltk.data.path`, fastText globals or `logging.basicConfig`.","locale":"en"},"15465":{"id":"/en/docs/engines-gptsovits-66","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"jieba replaces jieba_fast (the same dictionary; identical on 20 446 texts);","locale":"en"},"15466":{"id":"/en/docs/engines-gptsovits-67","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"OpenCC is the C++ `opencc==1.4.2` (the pure-Python port differs on 321 of 182 814 conversions, which feed G2PW);","locale":"en"},"15467":{"id":"/en/docs/engines-gptsovits-68","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"G2PW runs in torch from its ONNX weights (identical pinyin);","locale":"en"},"15468":{"id":"/en/docs/engines-gptsovits-69","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"NLTK's tagger and tokenizer, g2p_en, g2pk2, split-lang and fast-langdetect are ported, their data shipped;","locale":"en"},"15469":{"id":"/en/docs/engines-gptsovits-70","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"Japanese needs `pyopenjtalk==0.4.1` (extra `mizuoto[gptsovits-ja]`): pyopenjtalk-plus changes OpenJTalk's rules, and 18 % of Japanese sentences came out differently with it. Korean needs MeCab-ko and jamo (extra `mizuoto[gptsovits-ko]`). The Japanese user dictionary is compiled once into the `gptsovits/open-jtalk` asset's `.mizuoto/` folder.","locale":"en"},"15470":{"id":"/en/docs/engines-gptsovits-71","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"**HuBERT's float16 checkpoint** is loaded into float32 parameters and its weight norm folded in float32, as transformers computes it (folded in float16 the features differed by 1e-4). On a GPU, where upstream calls `.half()` on the model and transformers computes the weight norm there at every call, it is folded on that device in float16, as it would be.","locale":"en"},"15471":{"id":"/en/docs/engines-gptsovits-72","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"**SoVITS's weight norm on a GPU**: upstream keeps it on the v2 and v4/v5 synthesizers (the flow's and the decoder's WaveNet layers, the WN encoder) and computes it at every call on the model's device in its dtype (`.half()`); Mizuoto folds it at load, on that device in that dtype (`fold_weight_norm(…, device=)`). Folded on the CPU in float32 the weights differed in about a third of their values, and the output with them (44 dB against 0.1 for v2). BERT is transformers' SDPA path, which transformers 4.57 picks for chinese-roberta.","locale":"en"},"15472":{"id":"/en/docs/engines-gptsovits-73","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#what-reproduces-upstream","content":"**Fine-tunes.** SoVITS checkpoints that pickle upstream's `utils.HParams` are read by a restricted unpickler (tensors, `OrderedDict`, `HParams` as a dict). v4/v5 LoRA files are merged without peft (W += B·A·α/r in float32, identical to peft's merge).","locale":"en"},"15473":{"id":"/en/docs/engines-gptsovits-74","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#deviations","content":"**v4/v5's flow prompt** is always the last auxiliary clip; upstream's depends on the requests before.","locale":"en"},"15474":{"id":"/en/docs/engines-gptsovits-75","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#deviations","content":"**Streaming speaks every text.** In streaming mode upstream speaks only the first text of each `batch_size` group.","locale":"en"},"15475":{"id":"/en/docs/engines-gptsovits-76","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#deviations","content":"**Errors raise** instead of upstream's one second of 16 kHz silence.","locale":"en"},"15476":{"id":"/en/docs/engines-gptsovits-77","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#deviations","content":"**Not ported**: upstream's CUDA-graph T2S (`t2s_accel`, which changes results), `set_seed`'s process-wide TF32 switch, and super-sampling (v3 only, not in the catalogue). On CPUs with bf16 matrix units upstream's `set_float32_matmul_precision(\"medium\")` may use them; Mizuoto stays in fp32.","locale":"en"},"15477":{"id":"/en/docs/engines-gptsovits-78","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#memory-and-speed","content":"Phases: BERT around each text front-end call, HuBERT with SoVITS for the reference's semantic codes, the speaker-verification model (v2Pro), the GPT, then SoVITS (and the v4/v5 vocoder). The GPT is placed whole (its blocks read their fused projections directly; it is small, about 150 MB). A voice's own weights are switched in with `ModelHandle.replace`. The GPT's working memory is sized by the batch's longest row (its phones, the reference's codes and 16 codes a phone, within upstream's 1500 steps). With `compute.oom_fallback`, a batch that runs out of memory is spoken one text at a time.","locale":"en"},"15478":{"id":"/en/docs/engines-gptsovits-79","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#memory-and-speed","content":"The GPT is small and launch-bound: a step is about 360 small kernels and used to wait for the device twice (upstream's two end-of-sequence checks), plus a Python boolean copied to the device by top-p. Now the two checks are read together (the same boolean) and the copy is a `fill_`: one wait per step. With `compute.cuda_graphs` (NVIDIA, the GPT wholly on its device) its one-token steps run as graphs around each layer's attention, one set per number of rows (rows drop as they finish); the cache, grown by concatenation, and the sampling stay eager on the request's generator. A voice's own GPT gets its own graphs. The real v2, v2Pro and v4 models give the same audio with and without graphs, 1.3–2.0 times faster per request.","locale":"en"},"15479":{"id":"/en/docs/engines-gptsovits-80","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#memory-and-speed","content":"`compute.compile` wraps v4/v5's CFM estimator (each SoVITS loaded, a voice's own too): 7 % faster warm on the CPU, within 3.1e-5 of eager (87 dB).","locale":"en"},"15480":{"id":"/en/docs/engines-gptsovits-81","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#training","content":"Method `speaker` (stages `text`, `speech`, `semantic`, `sovits`, `gpt`, `export`): upstream's own recipe, without Lightning, torchmetrics, transformers, pandas or the ffmpeg program. The export is the voice's own pair of weights.","locale":"en"},"15481":{"id":"/en/docs/engines-gptsovits-82","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#training","content":"**Upstream's files, identically.** Each stage writes upstream's files in upstream's layout, identical to those of its four preparation scripts: `inputs.list`, `2-name2text.txt`, `3-bert/`, `4-cnhubert/`, `5-wav32k/` (byte for byte), `7-sv_cn/`, `6-name2semantic.tsv`. Upstream's `load_audio` read clips through the ffmpeg program; `nn/dsp/swresample.py` is libswresample's default resampler, identical to ffmpeg 7.0.2 on every rate tried (soxr gave 43 dB).","locale":"en"},"15482":{"id":"/en/docs/engines-gptsovits-83","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#training","content":"**GPT** (`train_s1.py`): the losses, accuracies, learning rates, the CPU generator's state at every step and the saved `<exp>-e<N>.ckpt` equal `s1_train.py`'s seeded alike (one and two epochs, batches of 1 and 4, DPO). Upstream draws while it builds the GPT (one encoder layer deep-copied 24 times, then the head) and once for the loader's base seed; `replay_construction_draws` repeats them. The bucket sampler's reseeding of the global `random` is a private `Random(epoch)`. `training_step` steps ScaledAdam at batch indices above 0 divisible by 4, so gradients pile up over five batches first and across an epoch's end; the schedule locks the rate to 0.002 after its first step, which runs at ScaledAdam's own 0.01. All kept.","locale":"en"},"15483":{"id":"/en/docs/engines-gptsovits-84","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#training","content":"**SoVITS** (`train_s2.py`): `s2_train.py`'s and `s2_train_v3_lora.py`'s losses at every step and their saved weights tensor for tensor (half precision, version tag, no `enc_q`) on the CPU seeded alike, for v2, v2Pro, v2ProPlus, v4 and v5 Turbo (accumulation, gradient checkpointing, two epochs). v4 and v5 train SoVITS as a LoRA. Upstream lists clips from a `set`, whose order changes per process; they are sorted here. The WaveNet gate is TorchScript-compiled as upstream's (its gradients differ from eager ones in the last bits). Without the `s2d-*` asset the SoVITS stage refuses, as 0.1 did.","locale":"en"},"15484":{"id":"/en/docs/engines-gptsovits-85","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#training","content":"Lightning's resumable checkpoint (930 MB) is not written. Compare runs with the same thread count: CPU kernels split their sums by it.","locale":"en"},"15485":{"id":"/en/docs/engines-gptsovits-86","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#training","content":"`training.memory`: the speech stage frees HuBERT before the speaker model; the semantic stage puts only SoVITS's SSL projection and quantiser on the device.","locale":"en"},"15486":{"id":"/en/docs/engines-gptsovits-87","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#parity","content":"Identical sample for sample to 0.1 on the CPU through the stack in all 15 cases: cloning (Chinese, English), without a transcript, two references with a speed, batches cut at every punctuation mark, serial decoding, streamed v2 (token chunks, SOLA) and v4 (fragments), v4/v5's batched and serial flow, and a voice with its own v2Pro weights. At module level also the text front end (476 texts in 11 language modes), HuBERT, BERT, the speaker-verification model, LoRA merging and every decoder path. Four more cases load each implementation's trained voice in the other; identical too. The contract suite passes (24 tests).","locale":"en"},"15487":{"id":"/en/docs/engines-gptsovits-88","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#parity","content":"On a GPU (an RTX 3090, fp16, 2026-10-19, stage by stage against 0.1): the codes, HuBERT, the text and style encoders are identical; v2 and v4 differ from 0.1 only by upstream's TorchScript WaveNet gate (`commons.fused_add_tanh_sigmoid_multiply`), which CUDA's fuser compiles after its first calls, so its bits depend on the shapes the process has already seen. With the gate scripted as upstream's (an experiment) both cases are identical sample for sample to 0.1; Mizuoto keeps the gate eager (v2 48.9 dB, v4 32.4 dB), for the reason VoxCPM's Snake runs eagerly (VoxCPM): every request then gives the same bits. The T4 tier judges the two equivalent.","locale":"en"},"15488":{"id":"/en/docs/engines-gptsovits-89","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#limitations","content":"Japanese and Korean text need their extras; without them such text fails with `capability_not_supported` and the install command in the hint. pyopenjtalk 0.4.1 is a source package that needs CMake and a C++ compiler.","locale":"en"},"15489":{"id":"/en/docs/engines-gptsovits-90","page_id":"/en/docs/engines-gptsovits","tags":[],"type":"text","url":"/en/docs/engines-gptsovits#limitations","content":"A streamed middle chunk too short for the SOLA overlap leaves an empty piece, on which upstream's post-processing raises an error; kept as upstream behaves. It has been seen with a `min_chunk_length` of 4.","locale":"en"},"15490":{"id":"/en/docs/engines-indextts","page_id":"/en/docs/engines-indextts","type":"page","content":"IndexTTS","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-indextts","locale":"en"},"15491":{"id":"/en/docs/engines-indextts-0","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts","content":"The IndexTTS engine as implemented in Mizuoto's separate mizuoto-indextts distribution: IndexTTS-1.5, 2 and 2.5, the GPT-2 with beam sampling, conditioning, emotion and the s2mel decoder, what reproduces upstream exactly, memory and GPU decoding, and its parity results.","locale":"en"},"15492":{"id":"/en/docs/engines-indextts-1","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#variants-and-files","content":"Variants and files","locale":"en"},"15493":{"id":"/en/docs/engines-indextts-2","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#how-it-works","content":"How it works","locale":"en"},"15494":{"id":"/en/docs/engines-indextts-3","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15495":{"id":"/en/docs/engines-indextts-4","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#deviations","content":"Deviations","locale":"en"},"15496":{"id":"/en/docs/engines-indextts-5","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#memory-and-speed","content":"Memory and speed","locale":"en"},"15497":{"id":"/en/docs/engines-indextts-6","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#training","content":"Training","locale":"en"},"15498":{"id":"/en/docs/engines-indextts-7","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#parity","content":"Parity","locale":"en"},"15499":{"id":"/en/docs/engines-indextts-8","page_id":"/en/docs/engines-indextts","type":"heading","tags":[],"url":"/en/docs/engines-indextts#limitations","content":"Limitations","locale":"en"},"15500":{"id":"/en/docs/engines-indextts-9","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts","content":"bilibili's zero-shot TTS (index-tts/index-tts, bilibili Model Use License). The port is under the same licence, so it ships as a distribution of its own, `mizuoto-indextts` (`packages/native/indextts`, package `mizuoto_indextts`, with `LICENSE.txt`), registered under `mizuoto.engines` (`indextts = mizuoto_indextts:IndexTtsEngine`). Downloading and speaking need the licence accepted, and cloning needs a consent statement. On the CPU in fp32 with the same seed IndexTTS-1.5, 2 and 2.5 are identical to Mizuoto 0.1 through the whole stack. User-facing details: Engines in depth.","locale":"en"},"15501":{"id":"/en/docs/engines-indextts-10","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"Variant","locale":"en"},"15502":{"id":"/en/docs/engines-indextts-11","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"Catalogue model","locale":"en"},"15503":{"id":"/en/docs/engines-indextts-12","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"Rate","locale":"en"},"15504":{"id":"/en/docs/engines-indextts-13","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"What it adds","locale":"en"},"15505":{"id":"/en/docs/engines-indextts-14","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"`v1_5`","locale":"en"},"15506":{"id":"/en/docs/engines-indextts-15","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"`indextts/v1.5`","locale":"en"},"15507":{"id":"/en/docs/engines-indextts-16","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"24 kHz","locale":"en"},"15508":{"id":"/en/docs/engines-indextts-17","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"Cloning without a transcript, Chinese and English","locale":"en"},"15509":{"id":"/en/docs/engines-indextts-18","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"`v2`","locale":"en"},"15510":{"id":"/en/docs/engines-indextts-19","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"`indextts/v2`","locale":"en"},"15511":{"id":"/en/docs/engines-indextts-20","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"22.05 kHz","locale":"en"},"15512":{"id":"/en/docs/engines-indextts-21","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"Emotion from a clip, from eight weights, or from a description","locale":"en"},"15513":{"id":"/en/docs/engines-indextts-22","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"`v2_5`","locale":"en"},"15514":{"id":"/en/docs/engines-indextts-23","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"`indextts/v2.5`","locale":"en"},"15515":{"id":"/en/docs/engines-indextts-24","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"22.05 kHz","locale":"en"},"15516":{"id":"/en/docs/engines-indextts-25","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"Japanese and Spanish, a language token, and a speed (`duration_factor = 1 / speed`)","locale":"en"},"15517":{"id":"/en/docs/engines-indextts-26","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"1.5 reads `config.yaml`, the GPT and BigVGAN checkpoints it names and the SentencePiece model; a voice's cache is `cond_mel.pt`.","locale":"en"},"15518":{"id":"/en/docs/engines-indextts-27","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"2 and 2.5 read `config.yaml`, `gpt.pth`, `s2mel.pth`, `wav2vec2bert_stats.pt`, the speaker and emotion matrices, `glossary.yaml` and the emotion model's folder (`qwen0.6bemo4-merge`); 2.5 also `codec.pth` and its tiktoken vocabulary. Shared assets: `indextts/w2v-bert`, `indextts/campplus` (`campplus_cn_common.bin`), `indextts/bigvgan`, and for 2 only `indextts/semantic-codec` (2.5 never reads it, so its catalogue entry does not download it).","locale":"en"},"15519":{"id":"/en/docs/engines-indextts-28","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#variants-and-files","content":"Precision: fp32 by default. On a CUDA GPU, IndexTTS-2 runs its GPT in fp16 when `engines.indextts.dtype` is `fp16`, and 2.5 in bf16 when it is `auto` or `bf16`, as 0.1 chose.","locale":"en"},"15520":{"id":"/en/docs/engines-indextts-29","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"Per text segment, IndexTTS-2:","locale":"en"},"15521":{"id":"/en/docs/engines-indextts-30","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"**Voice prompt** (cached with the voice): the clip at 22.05 kHz (at most 15 s) and its 16 kHz copy; w2v-BERT 2.0's hidden state 17, normalised, conditions the GPT; the MaskGCT semantic codec quantises it into the decoder's prompt codes; CAM++ gives the style; the mel is the decoder's prompt.","locale":"en"},"15522":{"id":"/en/docs/engines-indextts-31","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"**Emotion**: the speaker clip's, another clip's (mixed by `emo_alpha`), or eight weights mixed in through the emotion matrices (rows picked by CAM++ similarity); a description is turned into weights by the emotion model (Qwen3-0.6B, greedy).","locale":"en"},"15523":{"id":"/en/docs/engines-indextts-32","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"**GPT** (`UnifiedVoice`, a 24-layer GPT-2): beam sampling of semantic codes, then a second pass over them for their latents.","locale":"en"},"15524":{"id":"/en/docs/engines-indextts-33","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"**s2mel**: a length regulator and Seed-VC's DiT as a CFM (25 Euler steps, guidance 0.7) make the mel.","locale":"en"},"15525":{"id":"/en/docs/engines-indextts-34","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"**BigVGAN v2** makes 22.05 kHz audio; segments are joined with silence, the tail faded and the result quantised to 16 bits, as upstream returns it.","locale":"en"},"15526":{"id":"/en/docs/engines-indextts-35","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"2.5 conditions the GPT on the projected CAM++ embedding and a language embedding instead of the Conformer and perceiver over w2v-BERT, reads text through tiktoken with a `<|lang|>` prefix, and turns codes into decoder features with its own codec (RepCodec, a Vocos backbone, ×2 upsampling) instead of the GPT's latents. 1.5 has no emotion: the reference's log-mel conditions the GPT, and BigVGAN v1 with its ECAPA speaker encoder turns the GPT's latents directly into audio.","locale":"en"},"15527":{"id":"/en/docs/engines-indextts-36","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"Module","locale":"en"},"15528":{"id":"/en/docs/engines-indextts-37","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"What it is","locale":"en"},"15529":{"id":"/en/docs/engines-indextts-38","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`engine.py`","locale":"en"},"15530":{"id":"/en/docs/engines-indextts-39","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`IndexTTS2.infer` (2, 2.5) and the 1.5 path (`LoadedIndexTts15`): conditioning, emotion, segments, DiT, BigVGAN, fade-out","locale":"en"},"15531":{"id":"/en/docs/engines-indextts-40","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`gpt.py`","locale":"en"},"15532":{"id":"/en/docs/engines-indextts-41","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`UnifiedVoice`: transformers 4.52's GPT-2 (`Conv1D` as `addmm`, tanh GELU, SDPA) and its beam sampling with `BeamSearchScorer`","locale":"en"},"15533":{"id":"/en/docs/engines-indextts-42","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`conditioning.py`","locale":"en"},"15534":{"id":"/en/docs/engines-indextts-43","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"IndexTTS's Conformer and the perceiver resampler","locale":"en"},"15535":{"id":"/en/docs/engines-indextts-44","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`codec.py`","locale":"en"},"15536":{"id":"/en/docs/engines-indextts-45","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"2.5's `EnhancedCodec` decoding","locale":"en"},"15537":{"id":"/en/docs/engines-indextts-46","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`qwen_emotion.py`","locale":"en"},"15538":{"id":"/en/docs/engines-indextts-47","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"The emotion model: Qwen3-0.6B, greedy, its chat template, the answer parsed into eight weights","locale":"en"},"15539":{"id":"/en/docs/engines-indextts-48","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`text.py`","locale":"en"},"15540":{"id":"/en/docs/engines-indextts-49","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"The 1.5/2 front end: WeTextProcessing's FSTs through kaldifst (`TnProcessor`), `TextNormalizer`, SentencePiece, `split_segments`","locale":"en"},"15541":{"id":"/en/docs/engines-indextts-50","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`text25.py`","locale":"en"},"15542":{"id":"/en/docs/engines-indextts-51","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"The 2.5 front end: punctuation map, normalisation, fugashi for Japanese, tiktoken with `<\\|lang\\|>`","locale":"en"},"15543":{"id":"/en/docs/engines-indextts-52","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"`assets/tn/`","locale":"en"},"15544":{"id":"/en/docs/engines-indextts-53","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"WeTextProcessing's Chinese and English tagger and verbaliser FSTs (10 MB)","locale":"en"},"15545":{"id":"/en/docs/engines-indextts-54","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#how-it-works","content":"Shared: `nn/ssl/w2vbert.py`, `nn/codecs/repcodec.py`, `nn/transformer/seedvc.py`, `nn/vocoders/bigvgan.py` (v2; v1 with ECAPA), `nn/speaker/campplus_torch.py`, `nn/vocoders/vocos.py`, `nn/dsp/` (`seamless`, `kaldi`, `mel`, `resample`, `wav`), `runtime/lm/qwen.py`, `runtime/sampling.py`, `runtime/graphs.py`, `text/normalize/wetext.py`, `text/tokenize/bpe.py`, `runtime/compile.py`.","locale":"en"},"15546":{"id":"/en/docs/engines-indextts-55","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**GPT-2 as transformers 4.52 computes it**: `Conv1D` as `addmm`, tanh GELU, SDPA causal with no mask on the prompt and unmasked on each new token.","locale":"en"},"15547":{"id":"/en/docs/engines-indextts-56","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**Beam sampling**, upstream's legacy transformers path: the log-softmax through repetition penalty (over every id, the prompt's placeholder ids included), temperature, top-k and top-p (keeping at least two), the beams' scores added, `2 × num_beams` candidates drawn without replacement, `BeamSearchScorer`'s hypotheses.","locale":"en"},"15548":{"id":"/en/docs/engines-indextts-57","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**One beam samples** (`num_beams = 1`), as transformers does then (`_sample`): the processors over the raw logits, not their log-softmax (repetition penalty over every id so far, temperature, top-k and top-p keeping one), then one multinomial draw a step (`gpt.sample_steps`, `runtime.sampling.hf_sample`). Identical to upstream on the CPU for 1.5, 2 and 2.5 (cases `*-beam1`, 2026-11-04). Until mizuoto-indextts 0.2.6 one beam ran beam sampling with a single beam, which upstream never does: another take of the same request (81,920 samples upstream, 89,088 then).","locale":"en"},"15549":{"id":"/en/docs/engines-indextts-58","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**IndexTTS-1.5 without a KV cache** unless it runs in fp16, as upstream: each step reruns the whole sequence, and with a cache the sums would differ.","locale":"en"},"15550":{"id":"/en/docs/engines-indextts-59","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**Draw order**: every draw comes from the request's generator in upstream's order (the GPT, then the DiT's noise).","locale":"en"},"15551":{"id":"/en/docs/engines-indextts-60","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**On a GPU, where upstream computes what**: 1.5's reference mel on the CPU (upstream builds it there and moves it; a GPU's FFT rounds otherwise, and that alone changed which codes the beams settled on); the null position embeddings that transformers' GPT-2 adds in float32, so a cached step's fp16 or bf16 embeddings come out float32, as the prompt's are (`wpe_zeros`); the weight norms folded on the load device (upstream removes BigVGAN's after moving it to the GPU and computes the codec's and the CFM's there at every call; `norm_on`: the pairs moved there before `fold_weight_norm`). 2.5's prompt as upstream builds it in a batch: left-padded to the longest text with zero rows, which transformers' GPT-2 then masks out with additive SDPA masks (the padded keys at the dtype's minimum, the padded rows' own masks zeroed) at the prefill and every cached step (`padding_masks`); a single prompt has no padding and so no mask. 1.5's BigVGAN output scaled to int16 in its own dtype, as upstream: under fp16, `32767 × wav` rounds in float16 before the truncation (−7.99976 becomes −8.0, not −7).","locale":"en"},"15552":{"id":"/en/docs/engines-indextts-61","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**The emotion embedding** is read from the clip again at 16 kHz, not from the 22.05 kHz copy resampled: it is a separate field of the voice cache.","locale":"en"},"15553":{"id":"/en/docs/engines-indextts-62","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**Text (1.5, 2)** is normalised by WeTextProcessing's own FSTs applied with kaldifst. Upstream runs pynini on Linux and other FSTs elsewhere; Mizuoto gives the Linux behaviour on every platform. Names and pinyin are numbered in first-seen order (upstream uses a `set`'s order, which varies between runs).","locale":"en"},"15554":{"id":"/en/docs/engines-indextts-63","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#what-reproduces-upstream","content":"**2.5's text**: a language other than zh, en, ja or es (and an unset one) is taken from the text's script (kana: ja, Han: zh, letters only Spanish has: es, otherwise en; `applied.lang` says which). Upstream sends `zhen`, which is none of the model's language tokens (the tokenizer spells `<|zhen|>` out; the language embedding falls back to `common`). This deviates on purpose: on the T4 2.5 clone set (180 clips, 2026-10-19) `zhen` raised the error rate from 1.16 % to 7.70 % (p 4e-9), English about tenfold and Chinese two- to threefold, while the guess gives exactly the clips of the language given. NeMo's Japanese and Spanish normalisation is absent upstream too, so that text passes unchanged; Japanese needs fugashi (`mizuoto-indextts[ja]`).","locale":"en"},"15555":{"id":"/en/docs/engines-indextts-64","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#deviations","content":"**w2v-BERT's layer-drop draws are not made**: they never change the output in eval mode.","locale":"en"},"15556":{"id":"/en/docs/engines-indextts-65","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#deviations","content":"**Sizes from the configuration.** Sizes upstream hard-codes (w2v-BERT's width, `gpt_layer`) come from the configuration, so tiny test models build; the real models give the same numbers.","locale":"en"},"15557":{"id":"/en/docs/engines-indextts-66","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#deviations","content":"**Strict loading.** Checkpoints load strictly; upstream keeps random weights for missing keys (none are missing in the published checkpoints).","locale":"en"},"15558":{"id":"/en/docs/engines-indextts-67","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#deviations","content":"**Not ported**: TensorRT, upstream's accelerated engine and the BigVGAN CUDA kernel (0.1's load options `use_accel`, `use_trt`, `trt_precision`, `use_cuda_kernel`; the TensorRT backend's streaming within a segment is the option `stream_chunk`, below), and 2.5's low-memory text split (upstream splits text into 40-character pieces on GPUs under 10 GB; Mizuoto's runtime manages memory instead). `use_torch_compile` turns on `compute.compile` for the s2mel DiT and BigVGAN.","locale":"en"},"15559":{"id":"/en/docs/engines-indextts-68","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"Phases: w2v-BERT, CAM++, the semantic codec and the regulator for a voice that is not cached (or w2v-BERT for an emotion clip); the emotion model for an emotion text; the GPT (`kind=\"sequence\"`; its GPT-2 `Conv1D` layers stream like linear layers); the s2mel; BigVGAN. A clone of a cached voice never places w2v-BERT or CAM++. If BigVGAN runs out of memory with `compute.oom_fallback` on, it decodes in tiles of 256 frames, each with the 39 frames its samples depend on each side: the whole's samples up to the sums' rounding (IndexTTS 2/2.5). The GPT's working memory is sized by each segment: its text tokens and 24 codes a token (speech runs at about 5), within `max_mel_tokens`, for every beam, in the dtype it computes in.","locale":"en"},"15560":{"id":"/en/docs/engines-indextts-69","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"Beam sampling used to wait for the device about ten times a step (`torch.multinomial`'s checks, the scorer reading each candidate with `.item()`, the stopping test, the beam reorder, the position embedding's index tensor). Now once: the draw is `multinomial`'s own `topk(p / Exp(1), 2 × beams)` (`runtime.sampling.multinomial_draws`, the same ids and generator state on the CPU and CUDA); the candidates' scores, tokens and beams are read back together and the scorer decides on the host from those values; the position embedding is its table's row. With `compute.cuda_graphs` (NVIDIA, the GPT wholly on its device, with a KV cache: IndexTTS 2/2.5, and 1.5 in fp16) the GPT-2's one-token steps of all beams run as graphs around each layer's attention; the cache, its beam reorder and the sampling stay eager. The same audio, 2.6–3.2 times faster per step on the 1.5's sizes. The beams' keys and values for every layer share one buffer (`BeamCaches`), which a step grows by a position with the beams' rows reordered in one copy per beam, each layer then writing its new key and value in place: each layer's keys and values are the contiguous tensors `index_select` and `torch.cat` made before, at half the copying (×1.11 on 30 s of speech). The graphs are captured per number of beams: until mizuoto-indextts 0.2.6 a one-beam request after a three-beam one replayed the three-beam graphs and failed.","locale":"en"},"15561":{"id":"/en/docs/engines-indextts-70","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"**Streaming within a segment** (option `stream_chunk`, IndexTTS 2/2.5, streamed requests only; 0, off, by default). By default a streamed request sends each segment's audio when the segment is done, as upstream's `stream_return` does, so the first audio comes after the first segment's whole generation. With `stream_chunk = n` it is upstream's TensorRT backend's streaming (`FasterIndexTTS2`'s `StreamingDecoder`) on the native models: the GPT samples with one beam (so each code is final when drawn; `num_beams` must be unset or 1), and every `n` codes a window of the last `n` (sharing `stream_overlap` codes, 5, with the window before) is decoded as a whole segment is: IndexTTS 2's latents from the GPT over the codes so far (a causal model gives a prefix's latents as the whole's), 2.5's semantic codec over the window; the s2mel's flow after the reference's prompt; BigVGAN. Neighbouring windows are joined by a Hann cross-fade over `int(overlap × 1.72)` frames and a segment's last 512 samples fade out, as upstream's. The decoder draws its noise between the GPT's steps, so the codes differ from an unstreamed request's under the same seed. Each window's flow runs over the whole reference prompt again, so the request takes longer in all. On the RTX 3060 (2026-11-04), a 13 s English sentence on IndexTTS 2 and a 12 s Chinese one on 2.5, warm, CUDA graphs:","locale":"en"},"15562":{"id":"/en/docs/engines-indextts-71","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"First audio","locale":"en"},"15563":{"id":"/en/docs/engines-indextts-72","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"Whole request","locale":"en"},"15564":{"id":"/en/docs/engines-indextts-73","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"RTF","locale":"en"},"15565":{"id":"/en/docs/engines-indextts-74","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"IndexTTS 2, by segment (3 beams / 1 beam)","locale":"en"},"15566":{"id":"/en/docs/engines-indextts-75","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"12.0 / 11.9 s","locale":"en"},"15567":{"id":"/en/docs/engines-indextts-76","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"12.0 / 11.9 s","locale":"en"},"15568":{"id":"/en/docs/engines-indextts-77","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"0.98 / 0.79","locale":"en"},"15569":{"id":"/en/docs/engines-indextts-78","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"IndexTTS 2, `stream_chunk` 100 / 50","locale":"en"},"15570":{"id":"/en/docs/engines-indextts-79","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"2.6 / 1.9 s","locale":"en"},"15571":{"id":"/en/docs/engines-indextts-80","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"18.2 / 28.1 s","locale":"en"},"15572":{"id":"/en/docs/engines-indextts-81","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"1.35 / 2.07","locale":"en"},"15573":{"id":"/en/docs/engines-indextts-82","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"IndexTTS 2.5, by segment (3 beams / 1 beam)","locale":"en"},"15574":{"id":"/en/docs/engines-indextts-83","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"5.7 / 5.0 s","locale":"en"},"15575":{"id":"/en/docs/engines-indextts-84","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"5.8 / 5.1 s","locale":"en"},"15576":{"id":"/en/docs/engines-indextts-85","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"0.47 / 0.43","locale":"en"},"15577":{"id":"/en/docs/engines-indextts-86","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"IndexTTS 2.5, `stream_chunk` 100 / 50","locale":"en"},"15578":{"id":"/en/docs/engines-indextts-87","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"2.2 / 1.7 s","locale":"en"},"15579":{"id":"/en/docs/engines-indextts-88","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"6.6 / 11.1 s","locale":"en"},"15580":{"id":"/en/docs/engines-indextts-89","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"0.55 / 0.91","locale":"en"},"15581":{"id":"/en/docs/engines-indextts-90","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"Whisper transcribes every one of them as the text (2.5 at 50 codes: one homophone). At an RTF over 1 the audio comes slower than it plays, so on that card IndexTTS 2 would pause between chunks; 100 codes (about 1.6 s of speech) is upstream's default and the better trade.","locale":"en"},"15582":{"id":"/en/docs/engines-indextts-91","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#memory-and-speed","content":"`compute.compile` on a CPU in fp32: the s2mel DiT's warm time drops 7 %, BigVGAN's 20 %; the audio stays within 6.1e-5 of eager (87.7 dB).","locale":"en"},"15583":{"id":"/en/docs/engines-indextts-92","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#training","content":"None: IndexTTS publishes no training code for its TTS models, and the manifest declares no method.","locale":"en"},"15584":{"id":"/en/docs/engines-indextts-93","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#parity","content":"IndexTTS-1.5, 2 and 2.5 are identical sample for sample to 0.1 on the CPU in fp32 through the stack in all four cases: a 1.5 clone, a 2 clone, IndexTTS-2 with emotion weights and a 2.5 Chinese clone. At component level also the emotion model, every text front end, and the GPT with and without a KV cache. The contract suite passes (18 tests).","locale":"en"},"15585":{"id":"/en/docs/engines-indextts-94","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#parity","content":"On a GPU (an RTX 3090, 2026-10-19, against 0.1 in each version's own precision) all four cases are identical sample for sample: 1.5 in fp16 (2.3 dB before the fixes above), the two IndexTTS-2 cases and 2.5 in bf16 (−2.6 dB before its padding masks). The only difference reported is the `cuda_graphs` label: the graphs replay the same kernels.","locale":"en"},"15586":{"id":"/en/docs/engines-indextts-95","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#limitations","content":"No training method.","locale":"en"},"15587":{"id":"/en/docs/engines-indextts-96","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#limitations","content":"2.5's Japanese and Spanish text is not normalised (as upstream); Japanese needs the `ja` extra.","locale":"en"},"15588":{"id":"/en/docs/engines-indextts-97","page_id":"/en/docs/engines-indextts","tags":[],"type":"text","url":"/en/docs/engines-indextts#limitations","content":"Results may not be used to train other engines (`trains_others = false`), and cloning needs the consent statement the licence requires.","locale":"en"},"15589":{"id":"/en/docs/engines-omnivoice","page_id":"/en/docs/engines-omnivoice","type":"page","content":"OmniVoice","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-omnivoice","locale":"en"},"15590":{"id":"/en/docs/engines-omnivoice-0","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice","content":"The OmniVoice engine as implemented in Mizuoto: the bidirectional Qwen3 with iterative unmasking, the HiggsAudio v2 tokenizer (DAC and HuBERT), pydub's arithmetic without pydub, what reproduces upstream exactly, the full and LoRA fine-tunes, and its parity results.","locale":"en"},"15591":{"id":"/en/docs/engines-omnivoice-1","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#variants-and-files","content":"Variants and files","locale":"en"},"15592":{"id":"/en/docs/engines-omnivoice-2","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#how-it-works","content":"How it works","locale":"en"},"15593":{"id":"/en/docs/engines-omnivoice-3","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15594":{"id":"/en/docs/engines-omnivoice-4","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#deviations","content":"Deviations","locale":"en"},"15595":{"id":"/en/docs/engines-omnivoice-5","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#memory-and-speed","content":"Memory and speed","locale":"en"},"15596":{"id":"/en/docs/engines-omnivoice-6","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#training","content":"Training","locale":"en"},"15597":{"id":"/en/docs/engines-omnivoice-7","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#parity","content":"Parity","locale":"en"},"15598":{"id":"/en/docs/engines-omnivoice-8","page_id":"/en/docs/engines-omnivoice","type":"heading","tags":[],"url":"/en/docs/engines-omnivoice#limitations","content":"Limitations","locale":"en"},"15599":{"id":"/en/docs/engines-omnivoice-9","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice","content":"Xiaomi's diffusion language model TTS for over 600 languages (k2-fsa/OmniVoice, Apache-2.0). Code: `mizuoto/engines/omnivoice`. On the CPU in fp32 with the same seed it is identical to Mizuoto 0.1 (upstream on transformers 5.3) in every parity case, and both trainers give 0.1's adapter and exported weights byte for byte. User-facing details: Engines in depth.","locale":"en"},"15600":{"id":"/en/docs/engines-omnivoice-10","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#variants-and-files","content":"One variant, `v0` (catalogue model `omnivoice/omnivoice`): cloning (the transcript is required; Mizuoto supplies it by speech recognition when it is missing, so the engine never loads Whisper itself), design from a closed vocabulary of attributes, the model's own voice, and 13 inline non-verbal tags.","locale":"en"},"15601":{"id":"/en/docs/engines-omnivoice-11","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#variants-and-files","content":"The model folder holds `config.json`, `model.safetensors`, the BPE tokenizer files and `audio_tokenizer/` (`config.json`, `model.safetensors`, `preprocessor_config.json`). A voice's cache is `prompt.pt`, as upstream's voice-clone prompt.","locale":"en"},"15602":{"id":"/en/docs/engines-omnivoice-12","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#variants-and-files","content":"Precision: bf16 on a CUDA GPU that has it (else fp16), fp32 elsewhere; `engines.omnivoice.dtype` overrides.","locale":"en"},"15603":{"id":"/en/docs/engines-omnivoice-13","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"The audio is 8 codebooks of the HiggsAudio v2 tokenizer. The language model, Qwen3-0.6B run **bidirectionally**, sees the style tokens, the text, the reference's codes and the target as masked positions; over a fixed number of steps (32 by default) it unmasks the most confident codes, with classifier-free guidance in log-probability space, a per-codebook penalty and Gumbel noise on positions. Every step is a full forward over the whole sequence (no KV cache). The target length comes from a rule-based estimate (per-script character weights scaled by the reference's speaking rate), or from `speed` and `duration`.","locale":"en"},"15604":{"id":"/en/docs/engines-omnivoice-14","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"Module","locale":"en"},"15605":{"id":"/en/docs/engines-omnivoice-15","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"What it is","locale":"en"},"15606":{"id":"/en/docs/engines-omnivoice-16","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`engine.py`","locale":"en"},"15607":{"id":"/en/docs/engines-omnivoice-17","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`create_voice_clone_prompt`, the duration, `_generate_iterative`, chunked long text, post-processing","locale":"en"},"15608":{"id":"/en/docs/engines-omnivoice-18","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`model.py`","locale":"en"},"15609":{"id":"/en/docs/engines-omnivoice-19","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"The network: the bidirectional Qwen3 over text and audio codes (`audio_embeddings`, `audio_heads`)","locale":"en"},"15610":{"id":"/en/docs/engines-omnivoice-20","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`audio_tokenizer.py`","locale":"en"},"15611":{"id":"/en/docs/engines-omnivoice-21","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"HiggsAudio v2's tokenizer as transformers 5.3 computes it: DAC acoustic encoder + HuBERT semantic branch, Euclidean residual codebooks; `fc2` + the DAC decoder","locale":"en"},"15612":{"id":"/en/docs/engines-omnivoice-22","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`audio.py`","locale":"en"},"15613":{"id":"/en/docs/engines-omnivoice-23","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"Post-processing without pydub (`Segment`: pydub's millisecond arithmetic on int16 arrays, `audioop.rms`)","locale":"en"},"15614":{"id":"/en/docs/engines-omnivoice-24","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`duration.py`","locale":"en"},"15615":{"id":"/en/docs/engines-omnivoice-25","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"The rule-based duration estimate, upstream's tables","locale":"en"},"15616":{"id":"/en/docs/engines-omnivoice-26","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`text.py`","locale":"en"},"15617":{"id":"/en/docs/engines-omnivoice-27","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"Chunking at punctuation, `add_punctuation`, `combine_text`, tag-aware tokenisation","locale":"en"},"15618":{"id":"/en/docs/engines-omnivoice-28","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`voice_design.py`","locale":"en"},"15619":{"id":"/en/docs/engines-omnivoice-29","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"The closed design vocabulary and `_resolve_instruct`","locale":"en"},"15620":{"id":"/en/docs/engines-omnivoice-30","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`lang_map.py`","locale":"en"},"15621":{"id":"/en/docs/engines-omnivoice-31","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"Language names to OmniVoice's ids","locale":"en"},"15622":{"id":"/en/docs/engines-omnivoice-32","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`train.py`","locale":"en"},"15623":{"id":"/en/docs/engines-omnivoice-33","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"`OmniVoiceTrainer` (methods `full`, `lora`)","locale":"en"},"15624":{"id":"/en/docs/engines-omnivoice-34","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#how-it-works","content":"Shared: `runtime/lm/qwen.py`, `nn/codecs/dac.py`, `nn/ssl/hubert.py`, `text/tokenize/bpe.py`, `nn/dsp/resample.py`, `nn/dsp/wav.py`, `nn/dsp/flac.py`.","locale":"en"},"15625":{"id":"/en/docs/engines-omnivoice-35","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"**The attention mask.** The language model is `runtime/lm/qwen`'s decoder under a full 4-D boolean mask: transformers returns a 4-D mask as it is, and SDPA gets it with the KV heads repeated, not causal. The conditional and unconditional rows run in one batch, as upstream batches them.","locale":"en"},"15626":{"id":"/en/docs/engines-omnivoice-36","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"**Draws.** Gumbel noise on positions (and on classes with `class_temperature`) comes from the request's generator, per step and per item, as upstream draws it; a batch's composition changes the draws, as it does upstream.","locale":"en"},"15627":{"id":"/en/docs/engines-omnivoice-37","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"**The tokenizer** is DAC (odd strides with an output padding, no final tanh), HuBERT (the positional convolution's weight norm folded over dim 2) and Euclidean residual codebooks. The semantic decoder and `fc1` are used only in training and are not loaded.","locale":"en"},"15628":{"id":"/en/docs/engines-omnivoice-38","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"**HuBERT's draws.** HuBERT draws one `torch.rand([])` per layer even in eval mode, from the CPU generator; `HubertModel` makes the same draws on `ctx.generator_for(\"cpu\")`. A clone without a cached voice prompt therefore gets other noise than one with it, in 0.1 as in Mizuoto; Mizuoto always prepares the prompt before the request, so this never shows.","locale":"en"},"15629":{"id":"/en/docs/engines-omnivoice-39","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"**pydub without pydub.** Silence removal on the prompt and the output is reproduced on int16 arrays with pydub's arithmetic: millisecond lengths rounded, positions truncated, `audioop.rms` floored. `audioop` is gone in Python 3.13, so a port was needed anyway.","locale":"en"},"15630":{"id":"/en/docs/engines-omnivoice-40","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"**Levels and long text.** The reference is levelled to an RMS of 0.1 and the output levelled back; long outputs are generated in text chunks, conditioned on the reference (or the first chunk), and cross-faded.","locale":"en"},"15631":{"id":"/en/docs/engines-omnivoice-41","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#what-reproduces-upstream","content":"**The text tokenizer** is `mizuoto.text`'s BPE, without transformers' \"Mistral fix\" (the model names transformers 5.3, where it does not apply).","locale":"en"},"15632":{"id":"/en/docs/engines-omnivoice-42","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#deviations","content":"**No free-text design.** The model was trained on a closed attribute vocabulary; free text is refused, as in 0.1.","locale":"en"},"15633":{"id":"/en/docs/engines-omnivoice-43","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#deviations","content":"**No FlashInfer or CUDA graphs.** 0.1's load options for them are gone; SDPA serves every platform. In FlashInfer's place, the request option `packed_guidance` (below).","locale":"en"},"15634":{"id":"/en/docs/engines-omnivoice-44","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#deviations","content":"**Upstream's text normalisation** (`normalize_text`, WeTextProcessing) is not used by Mizuoto's requests and is not ported.","locale":"en"},"15635":{"id":"/en/docs/engines-omnivoice-45","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#memory-and-speed","content":"Two phases: the audio tokenizer (the voice prompt, then decoding) and the language model. If decoding runs out of memory with `compute.oom_fallback` on, the tokenizer decodes in tiles of 128 frames (about 5 s), each with the 12 frames its DAC decoder's samples depend on each side: the whole's samples up to the sums' rounding (64 dB SNR on a GPU, where the GPU against the CPU is 63 dB), in 108 MB instead of 1 GB for 60 s. The language model reruns over the whole sequence each step, so it is a `oneshot` model for weight streaming (its largest units stay on the device). Training: gradient checkpointing over the model's layers is identical, LoRA dropout included; `lowest` keeps AdamW's state in RAM (identical on the CPU).","locale":"en"},"15636":{"id":"/en/docs/engines-omnivoice-46","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#memory-and-speed","content":"**Fast mode** (request option `packed_guidance`, off): upstream runs each item's conditional sequence and its unconditional one (the target alone) as two rows padded to the same length, so the unconditional row computes the whole prompt's length for nothing. Packed, the two sit side by side in one row under a block-diagonal mask, each with its positions from 0: each computes what it computed in its own row, over fewer positions. On the CPU the parity cases give the same audio; on a GPU the products and attention run over other shapes, the rounding differs, and since each step unmasks the most confident codes, the result is another take of the same request (as another seed would be). Outputs list it (`applied.packed_guidance`). On a 3090: cloning ×1.26–1.27 per request (clone-en 0.77 → 0.61 s), 30 s of speech ×1.12; voices without a reference carry little padding and gain nothing; on the CPU cloning ×1.31.","locale":"en"},"15637":{"id":"/en/docs/engines-omnivoice-47","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"Methods `full` and `lora` (stages `tokens`, `train`, `export`; upstream's `extract_audio_tokens` and `OmniTrainer` with its SDPA fine-tune configurations; no transformers, peft, accelerate or webdataset). Seeded alike, both give 0.1's codes, batches, losses, learning rates, LoRA adapter and exported `model.safetensors` byte for byte on the CPU, also with gradient accumulation and over several shards and loader workers. The LoRA is merged into the exported model.","locale":"en"},"15638":{"id":"/en/docs/engines-omnivoice-48","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"**Upstream reseeds with its config's 42 after building the model**, so the stage's seed matters only through peft's LoRA initialisation, drawn first from the process-wide generator in module order (`A` and `B` made as `nn.Linear`, `A` drawn again).","locale":"en"},"15639":{"id":"/en/docs/engines-omnivoice-49","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"**Draws after the reseed come from private generators**: each epoch's loader base seed and the LoRA dropout masks on one seeded 42; worker *w*'s `Random` and `Generator` seeded `(base + w) mod 2**32`. In each worker webdataset first spends one `randint(0, 1000000)` on a seed it never uses, then the processor draws. The shard list is shuffled with `Random(epoch)`, the samples through webdataset's 20 000-sample buffer seeded with the epoch; the workers' batches come in turn.","locale":"en"},"15640":{"id":"/en/docs/engines-omnivoice-50","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"**Batches by length** (`StreamLengthGroupDataset`, `PaddingDataCollator`'s 4-D mask), as the SDPA configurations do, not FlexAttention's packing.","locale":"en"},"15641":{"id":"/en/docs/engines-omnivoice-51","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"**Clipping** sums the per-tensor norms in upstream's parameter order (the token embedding first).","locale":"en"},"15642":{"id":"/en/docs/engines-omnivoice-52","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"**The token order** follows `JsonlDatasetReader`'s seed-42 order.","locale":"en"},"15643":{"id":"/en/docs/engines-omnivoice-53","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"Checkpoints keep no optimiser state. More loader workers than shards made 0.1 fail; here the spare workers idle. Previews are seeded.","locale":"en"},"15644":{"id":"/en/docs/engines-omnivoice-54","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#training","content":"`training.memory`: gradient checkpointing over the Qwen3 layers (LoRA's dropout masks replayed); for LoRA, `low` also stores the frozen linear weights in the autocast dtype (CUDA: autocast casts them to it at every product anyway) and `lowest` keeps the LoRA layers' frozen base weights in RAM, copied to the GPU for each product, and AdamW's state in RAM. Identical on the CPU (the tiny trainer's losses and adapter); on a GPU with deterministic kernels, the same loss and gradients with float32 and bfloat16 frozen weights. The LoRA's peak: 7.3 GB, 2.1 GB under `low`, 1.1 GB under `lowest` (RTX 3060, 2026-11-04).","locale":"en"},"15645":{"id":"/en/docs/engines-omnivoice-55","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#parity","content":"Identical sample for sample to 0.1 on the CPU in fp32 in all four stack cases: cloning, design from attributes, its own voice and the fine-tuned model. At module level also the voice prompt's codes, the tokenizer's decode, the logits, `class_temperature`, `speed`, `duration`, batches and the chunked long-text path. Two more cases load each implementation's LoRA export in the other; identical. The contract suite passes (12 tests).","locale":"en"},"15646":{"id":"/en/docs/engines-omnivoice-56","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#parity","content":"On a GPU (an RTX 3090, bf16, 2026-10-19, against 0.1) the four cases are identical sample for sample too, once the shared Qwen decoder kept RoPE's `inv_freq` in float32 through the cast to bf16 and normed q and k apart, as transformers does (see Qwen3-TTS); speed unchanged (×1.01).","locale":"en"},"15647":{"id":"/en/docs/engines-omnivoice-57","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#limitations","content":"Every step is a full forward of the conditional and unconditional rows over the whole sequence; there is no CUDA-graph path for this engine.","locale":"en"},"15648":{"id":"/en/docs/engines-omnivoice-58","page_id":"/en/docs/engines-omnivoice","tags":[],"type":"text","url":"/en/docs/engines-omnivoice#limitations","content":"Free-text voice design is not available (the model takes attributes only).","locale":"en"},"15649":{"id":"/en/docs/engines-qwen3tts","page_id":"/en/docs/engines-qwen3tts","type":"page","content":"Qwen3-TTS","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-qwen3tts","locale":"en"},"15650":{"id":"/en/docs/engines-qwen3tts-0","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts","content":"The Qwen3-TTS engine as implemented in Mizuoto: variants and files, the talker, code predictor, speaker encoder and 12 Hz codec, what reproduces upstream exactly, memory and CUDA-graph decoding, the speaker fine-tune, and its parity results.","locale":"en"},"15651":{"id":"/en/docs/engines-qwen3tts-1","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#variants-and-files","content":"Variants and files","locale":"en"},"15652":{"id":"/en/docs/engines-qwen3tts-2","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#how-it-works","content":"How it works","locale":"en"},"15653":{"id":"/en/docs/engines-qwen3tts-3","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15654":{"id":"/en/docs/engines-qwen3tts-4","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#deviations","content":"Deviations","locale":"en"},"15655":{"id":"/en/docs/engines-qwen3tts-5","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#memory","content":"Memory","locale":"en"},"15656":{"id":"/en/docs/engines-qwen3tts-6","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#speed","content":"Speed","locale":"en"},"15657":{"id":"/en/docs/engines-qwen3tts-7","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#training","content":"Training","locale":"en"},"15658":{"id":"/en/docs/engines-qwen3tts-8","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#parity","content":"Parity","locale":"en"},"15659":{"id":"/en/docs/engines-qwen3tts-9","page_id":"/en/docs/engines-qwen3tts","type":"heading","tags":[],"url":"/en/docs/engines-qwen3tts#limitations","content":"Limitations","locale":"en"},"15660":{"id":"/en/docs/engines-qwen3tts-10","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts","content":"Alibaba Qwen's 12 Hz speech language model (QwenLM/Qwen3-TTS, Apache-2.0). Code: `mizuoto/engines/qwen3tts`. On the CPU in fp32 with the same seed it gives the audio of Mizuoto 0.1 (upstream's `qwen_tts` behind its adapter) sample for sample, in all eight parity cases, and its trainer gives 0.1's checkpoint byte for byte. What each variant offers is in Engines in depth.","locale":"en"},"15661":{"id":"/en/docs/engines-qwen3tts-11","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"Variant","locale":"en"},"15662":{"id":"/en/docs/engines-qwen3tts-12","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"Catalogue models","locale":"en"},"15663":{"id":"/en/docs/engines-qwen3tts-13","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"What it does","locale":"en"},"15664":{"id":"/en/docs/engines-qwen3tts-14","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`base`","locale":"en"},"15665":{"id":"/en/docs/engines-qwen3tts-15","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`qwen3tts/1.7b-base`, `qwen3tts/0.6b-base`","locale":"en"},"15666":{"id":"/en/docs/engines-qwen3tts-16","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"Cloning: in context with the reference's transcript, from the speaker embedding (x-vector) without one","locale":"en"},"15667":{"id":"/en/docs/engines-qwen3tts-17","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`custom_voice`","locale":"en"},"15668":{"id":"/en/docs/engines-qwen3tts-18","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`qwen3tts/1.7b-custom-voice`","locale":"en"},"15669":{"id":"/en/docs/engines-qwen3tts-19","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"Nine preset speakers, steered by an instruction","locale":"en"},"15670":{"id":"/en/docs/engines-qwen3tts-20","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`custom_voice_lite`","locale":"en"},"15671":{"id":"/en/docs/engines-qwen3tts-21","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`qwen3tts/0.6b-custom-voice`","locale":"en"},"15672":{"id":"/en/docs/engines-qwen3tts-22","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"The preset speakers without instructions (upstream drops them silently for the 0.6B, so the variant does not declare them)","locale":"en"},"15673":{"id":"/en/docs/engines-qwen3tts-23","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`voice_design`","locale":"en"},"15674":{"id":"/en/docs/engines-qwen3tts-24","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"`qwen3tts/1.7b-voice-design`","locale":"en"},"15675":{"id":"/en/docs/engines-qwen3tts-25","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"A voice from a free-text description","locale":"en"},"15676":{"id":"/en/docs/engines-qwen3tts-26","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"The variant comes from `config.json` (`tts_model_type`, `tts_model_size`); only `tokenizer_type = qwen3_tts_tokenizer_12hz` is accepted. The model folder holds `config.json`, `model.safetensors`, the tokenizer files (`tokenizer.json`, or `vocab.json` + `merges.txt` + `tokenizer_config.json`) and `speech_tokenizer/` (`config.json`, `model.safetensors`). A Base voice's cache is `prompt.pt`, the clone prompt (reference codes and speaker embedding).","locale":"en"},"15677":{"id":"/en/docs/engines-qwen3tts-27","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#variants-and-files","content":"Precision: bf16 on a CUDA GPU that has it (else fp16), fp32 elsewhere; `engines.qwen3tts.dtype` overrides.","locale":"en"},"15678":{"id":"/en/docs/engines-qwen3tts-28","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"Each 80 ms frame of audio is 16 codes. The **talker**, a 28-layer Qwen3 decoder over text and codec embeddings, predicts the frame's first code; the **code predictor**, a 5-layer transformer, predicts the other 15 one after the other; the sum of the 16 code embeddings (plus the next text token's embedding) is the talker's next input. The **12 Hz codec** turns codes back into 24 kHz audio (1920 samples a frame) and, for cloning, the reference into codes. Base models also have a **speaker encoder** (ECAPA-TDNN) whose embedding sits in the prompt.","locale":"en"},"15679":{"id":"/en/docs/engines-qwen3tts-29","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"Module","locale":"en"},"15680":{"id":"/en/docs/engines-qwen3tts-30","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"What it is","locale":"en"},"15681":{"id":"/en/docs/engines-qwen3tts-31","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`engine.py`","locale":"en"},"15682":{"id":"/en/docs/engines-qwen3tts-32","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"The prompt as `Qwen3TTSForConditionalGeneration.generate` builds it, the talker loop, chunked decoding, voice caches","locale":"en"},"15683":{"id":"/en/docs/engines-qwen3tts-33","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`decode.py`","locale":"en"},"15684":{"id":"/en/docs/engines-qwen3tts-34","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`FrameDecoder`: one frame (sampling, code predictor, talker step) over fixed tensors, eagerly or as CUDA graphs","locale":"en"},"15685":{"id":"/en/docs/engines-qwen3tts-35","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`config.py`","locale":"en"},"15686":{"id":"/en/docs/engines-qwen3tts-36","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`config.json` read without transformers","locale":"en"},"15687":{"id":"/en/docs/engines-qwen3tts-37","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`talker.py`","locale":"en"},"15688":{"id":"/en/docs/engines-qwen3tts-38","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"The talker and the code predictor, on `runtime/lm/qwen.py`","locale":"en"},"15689":{"id":"/en/docs/engines-qwen3tts-39","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`speaker.py`","locale":"en"},"15690":{"id":"/en/docs/engines-qwen3tts-40","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"ECAPA-TDNN as Qwen2.5-Omni ships it: no BatchNorm, reflection padding, a 128-bin log-mel at 24 kHz in, a 2048-wide embedding out","locale":"en"},"15691":{"id":"/en/docs/engines-qwen3tts-41","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`codec.py`","locale":"en"},"15692":{"id":"/en/docs/engines-qwen3tts-42","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"The 12 Hz speech tokenizer: a Mimi-style encoder (transformers' `MimiModel` encode path) and a causal decoder (72-frame attention window, SnakeBeta upsampling)","locale":"en"},"15693":{"id":"/en/docs/engines-qwen3tts-43","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`train.py`, `sft.py`","locale":"en"},"15694":{"id":"/en/docs/engines-qwen3tts-44","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"`Qwen3Trainer` (method `speaker`) and its maths","locale":"en"},"15695":{"id":"/en/docs/engines-qwen3tts-45","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#how-it-works","content":"Shared: `runtime/lm/qwen.py` (decoder, `hf_sdpa`, `mask_for`), `runtime/lm/cache.py`, `runtime/sampling.py`, `runtime/graphs.py`, `text/tokenize/bpe.py`, `nn/dsp/mel.py` (`matcha_mel`), `nn/dsp/resample.py`, `nn/dsp/wav.py`, `nn/dsp/flac.py`.","locale":"en"},"15696":{"id":"/en/docs/engines-qwen3tts-46","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#what-reproduces-upstream","content":"**The tokenizer's split.** Upstream loads its processor with `fix_mistral_regex=True`, and transformers 4.57.3 then swaps in its \"Mistral fix\" pre-tokenizer regex for a local model whose config names a version between 4.57.2 and 5.0. `load_bpe(mistral_fix=…)` makes the same decision from the model's `config.json`; without it a few texts tokenise differently.","locale":"en"},"15697":{"id":"/en/docs/engines-qwen3tts-47","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#what-reproduces-upstream","content":"**The same tensor shapes.** The prompt is built as upstream's `generate` builds it: the three special embeddings looked up in one call, the codec head applied over the whole prefill. Smaller calls would compute the same values with other float sums.","locale":"en"},"15698":{"id":"/en/docs/engines-qwen3tts-48","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#what-reproduces-upstream","content":"**Attention as transformers called it** (`hf_sdpa`): without a mask, SDPA with `enable_gqa` and `is_causal` for multi-token queries; with one, the KV heads repeated. The cache grows by concatenation, as `DynamicCache` does.","locale":"en"},"15699":{"id":"/en/docs/engines-qwen3tts-49","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#what-reproduces-upstream","content":"**The sampler.** The talker samples through transformers' processor chain in its order (repetition penalty, min-new-tokens, suppression of the control ids, temperature, top-k, top-p), then `multinomial` on the request's generator; finished rows of a batch are fed EOS, as transformers pads them. The code predictor's 15 draws follow, per frame.","locale":"en"},"15700":{"id":"/en/docs/engines-qwen3tts-50","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#what-reproduces-upstream","content":"**The codec.** The encoder's transformer runs with a plain causal mask (its configured 250-frame window is ignored, as upstream's encode path ignores it); the decoder's transformer applies its 72-frame window. Decoding is in upstream's chunks (300 frames with 25 of left context), and when cloning in context the reference's share is cut off after the joint decode.","locale":"en"},"15701":{"id":"/en/docs/engines-qwen3tts-51","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#what-reproduces-upstream","content":"**The speaker encoder's mel** is Matcha-TTS's (`nn.dsp.mel.matcha_mel`), as upstream computes it.","locale":"en"},"15702":{"id":"/en/docs/engines-qwen3tts-52","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#deviations","content":"**The 25 Hz tokenizer is not implemented.** No released model uses it, and upstream's wrapper cannot decode its output either.","locale":"en"},"15703":{"id":"/en/docs/engines-qwen3tts-53","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#deviations","content":"**Streaming is per segment**, as in 0.1: the model's whole segment is generated, then decoded.","locale":"en"},"15704":{"id":"/en/docs/engines-qwen3tts-54","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#deviations","content":"**The frame rate is 12.5** (0.1 used 12.0; it only affected progress estimates).","locale":"en"},"15705":{"id":"/en/docs/engines-qwen3tts-55","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#deviations","content":"**Upstream's `attn_implementation` is not a load option**: attention goes through Mizuoto's attention dispatcher, chosen by `compute.attention` / `engines.qwen3tts.attention`.","locale":"en"},"15706":{"id":"/en/docs/engines-qwen3tts-56","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#memory","content":"Four handles, placed by phase: the talker (`kind=\"sequence\"`, its code predictor `hot`, since it runs 15 times a frame), the speaker encoder and the codec's encoder (only for a Base model's voice prompt), and the codec's decoder.","locale":"en"},"15707":{"id":"/en/docs/engines-qwen3tts-57","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#memory","content":"The talker's working memory is estimated from the request: each row's prompt (instruction, reference text and codes, text) and 16 frames per text token (speech runs at 3–4), within `max_new_tokens`, the cache's peak counted as one layer above its size, plus 256 MB. A sentence therefore sets aside some 300–400 MB on the 1.7B model, not the gigabytes a worst case (8192 frames) would claim, so the talker is not streamed needlessly when memory is short. `compute.kv_cache = static` gives the talker and the code predictor preallocated caches (identical on the CPU).","locale":"en"},"15708":{"id":"/en/docs/engines-qwen3tts-58","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#speed","content":"A frame is one talker step and fifteen code-predictor steps: some 6 000 small kernels, launched one by one by the CPU. The plain loop also waited for the device about 35 times a frame (`torch.multinomial`'s two validity checks per draw, the suppressed ids copied to the device at each step, the padding check, the EOS check), and each wait drained the GPU's queue. `decode.py` removes this without changing a result:","locale":"en"},"15709":{"id":"/en/docs/engines-qwen3tts-59","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#speed","content":"**One wait per frame.** One-sample draws are `multinomial`'s own computation (`argmax(p / Exp(1))`) without its checks (`runtime.sampling.multinomial1`; NaN probabilities are still an error, read with the frame's one wait); masks are built once per device; the repetition penalty works on a mask of the ids drawn (`repetition_penalty_seen`, the same arithmetic); the padding is known on the host.","locale":"en"},"15710":{"id":"/en/docs/engines-qwen3tts-60","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#speed","content":"**Streaming, frame by frame** (a streamed request of one text; `applied.stream = \"frames\"`). The model is built to stream (upstream's README: first audio after 97 ms), but upstream's package returns whole clips (its streaming option only arranges the text input); Mizuoto decodes the frames as the talker draws them. The talker and the codec decoder are placed together, and after 4 frames and then every 12 the decoder decodes the current chunk of upstream's grid (300 frames with 25 of left context) from its usual start and sends the samples not sent before (`codec.DecodeStream`). The decoder is causal throughout, so those samples are the ones the whole decode gives, up to rounding: on the CPU in fp32 within 1e-8; on a GPU in bf16 37–41 dB SNR from the whole request's audio, the decoder's own rounding at another length (66 dB in fp32), with the same codes and length. When cloning in context, upstream cuts the reference's share by a ratio of the final length, which can fall a sample before `ref_len × 1920` (about 4 % of clips); a stream cannot know that length, so it starts at `ref_len × 1920`. On an RTX 3090 (1.7B, 8 s of speech) the first audio comes after 0.28–0.33 s instead of the whole request's 1.7–2.0 s, at 8–19 % more time in all (the redundant decoding). Batches are not streamed.","locale":"en"},"15711":{"id":"/en/docs/engines-qwen3tts-61","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#speed","content":"**CUDA graphs** (`compute.cuda_graphs`, on by default; NVIDIA). A talker partly loaded, its other layers streaming from page-locked memory, keeps them: each step's graphs copy its streamed layers in (`ModelHandle.graphable`), 1.32–1.35× faster than streaming eagerly under a 4 GB cap, the same audio. Sampling and the code predictor's 15 steps are one graph each; the talker's step is one graph per stretch between attention calls, attention running eagerly over the growing cache. The graphs draw from a generator of their own, loaded from the request's and written back. Graphs are kept per batch size and sampling settings and dropped when the weights move.","locale":"en"},"15712":{"id":"/en/docs/engines-qwen3tts-62","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#speed","content":"**Fewer kernels, the same bits** (without autograd only, so training is untouched): q and k normed and rotated together on the CPU (on a GPU only under `fused_projections`: CUDA sizes a reduction by its tensor, so over the joined heads a norm's sum came out one step off now and then, one key in a decode and then the voice); the code predictor's rotary tables made once; `F.rms_norm` where a self-test on the device shows it gives the float32 norm's bits.","locale":"en"},"15713":{"id":"/en/docs/engines-qwen3tts-63","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#speed","content":"The same codes as eager; on the decode loop of the 1.7B sizes 2.7–3.4 times faster than the loop with its waits.","locale":"en"},"15714":{"id":"/en/docs/engines-qwen3tts-64","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#speed","content":"**Fast mode** (load option `fused_projections`, off): each layer's q/k/v and gate/up projections become one linear layer with the stacked weights, at load (they still stream like any layer). About 3–4 % faster per frame on a GPU, where the products pick other kernels and the audio is no longer bit-identical; identical in the CPU parity cases. Outputs list `fused_projections` when it is on. Parameter names change, so it applies to inference only.","locale":"en"},"15715":{"id":"/en/docs/engines-qwen3tts-65","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#training","content":"Method `speaker` (Base models; stages `prepare`, `train`, `export`): the model learns one speaker and becomes a CustomVoice model whose only preset speaker is the new voice, as upstream's `finetuning/sft_12hz.py`. On the real 1.7B Base, seeded alike, it gives 0.1's codes, losses and checkpoint byte for byte on the CPU, without transformers or accelerate.","locale":"en"},"15716":{"id":"/en/docs/engines-qwen3tts-66","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#training","content":"Clips are encoded eight at a time, zero-padded, as `Qwen3TTSTokenizer.encode` batches them.","locale":"en"},"15717":{"id":"/en/docs/engines-qwen3tts-67","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#training","content":"The order comes from a plain shuffled data loader on the process-wide generator (the training stage's own process). Accelerate's gradient accumulation is reproduced as the loss over the steps, an optimiser step every N batches and at each epoch's end.","locale":"en"},"15718":{"id":"/en/docs/engines-qwen3tts-68","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#training","content":"Both losses are transformers' `ForCausalLMLoss`, which shifts the already shifted labels once more; kept.","locale":"en"},"15719":{"id":"/en/docs/engines-qwen3tts-69","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#training","content":"Upstream adds the raw text embedding to the codec embeddings without its `text_projection`, which inference applies; kept, so the weights are upstream's. It follows that only a model whose text embeddings are as wide as the talker can train: the 1.7B Base can, the 0.6B Base cannot (text 2048, talker 1024). The method shows as unavailable for such a model, with the reason, and an experiment cannot start from it (`Trainer.refuses` reads the model's `config.json` before a run; `capability_not_supported`).","locale":"en"},"15720":{"id":"/en/docs/engines-qwen3tts-70","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#training","content":"Each training forward gets a fresh cache: the first `DynamicCache` update concatenates, so attention sees contiguous keys and values, as upstream's.","locale":"en"},"15721":{"id":"/en/docs/engines-qwen3tts-71","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#training","content":"`training.memory`: gradient checkpointing over the talker's and code predictor's layers gives identical results; `lowest` keeps AdamW's state in RAM (float32 there).","locale":"en"},"15722":{"id":"/en/docs/engines-qwen3tts-72","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#parity","content":"All eight stack cases are identical to 0.1 sample for sample on the CPU in fp32: a preset speaker, an instruction, voice design, in-context cloning, x-vector cloning, a transcript from speech recognition, a dialect speaker and the fine-tuned model. Two more cases speak each implementation's training export with the other implementation; both identical. The tokenizer gives transformers' ids on the tokenizer corpus. The contract suite passes (24 tests). CUDA graphs were checked against the eager path on a GPU with a tiny model and the real 0.6B Base.","locale":"en"},"15723":{"id":"/en/docs/engines-qwen3tts-73","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#parity","content":"On a GPU (an RTX 3090, bf16, 2026-10-19, against 0.1) all eight cases are identical sample for sample too. That took four things upstream does: RoPE's `inv_freq` kept in float32 when the model is cast to bf16 (`from_pretrained(dtype=…)` leaves the buffer it built in float32; a rounded one turned late positions by other angles), the speech tokenizer's encoder and decoder given transformers' boolean causal mask instead of `is_causal` (transformers 4.57's packed-sequence check keeps the mask whenever position ids come without a padding mask or a cache, and on a GPU the two pick other kernels), the encoder's q, k and v made contiguous as transformers makes them, and q and k normed apart (above). Against the code before, the talker costs ×0.92–0.96 on that GPU (rounds `g6-before`, `g6-after`).","locale":"en"},"15724":{"id":"/en/docs/engines-qwen3tts-74","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#limitations","content":"`fused_projections` trades bit-identity on a GPU for speed.","locale":"en"},"15725":{"id":"/en/docs/engines-qwen3tts-75","page_id":"/en/docs/engines-qwen3tts","tags":[],"type":"text","url":"/en/docs/engines-qwen3tts#limitations","content":"CUDA graphs need the talker on one NVIDIA GPU, and its streamed layers in page-locked memory (within `compute.max_pinned_mb`); otherwise a partly loaded talker decodes eagerly.","locale":"en"},"15726":{"id":"/en/docs/engines-voxcpm","page_id":"/en/docs/engines-voxcpm","type":"page","content":"VoxCPM","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines-voxcpm","locale":"en"},"15727":{"id":"/en/docs/engines-voxcpm-0","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm","content":"The VoxCPM engine as implemented in Mizuoto: VoxCPM2, 1.5 and 0.5B, MiniCPM-4, the local DiT and the AudioVAE, the tokenizer and normaliser as upstream's locked libraries build them, what reproduces upstream exactly, patch decoding with CUDA graphs, the full and LoRA fine-tunes, and its parity results.","locale":"en"},"15728":{"id":"/en/docs/engines-voxcpm-1","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#variants-and-files","content":"Variants and files","locale":"en"},"15729":{"id":"/en/docs/engines-voxcpm-2","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#how-it-works","content":"How it works","locale":"en"},"15730":{"id":"/en/docs/engines-voxcpm-3","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"What reproduces upstream","locale":"en"},"15731":{"id":"/en/docs/engines-voxcpm-4","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#deviations","content":"Deviations","locale":"en"},"15732":{"id":"/en/docs/engines-voxcpm-5","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#memory-and-speed","content":"Memory and speed","locale":"en"},"15733":{"id":"/en/docs/engines-voxcpm-6","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#training","content":"Training","locale":"en"},"15734":{"id":"/en/docs/engines-voxcpm-7","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#parity","content":"Parity","locale":"en"},"15735":{"id":"/en/docs/engines-voxcpm-8","page_id":"/en/docs/engines-voxcpm","type":"heading","tags":[],"url":"/en/docs/engines-voxcpm#limitations","content":"Limitations","locale":"en"},"15736":{"id":"/en/docs/engines-voxcpm-9","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm","content":"OpenBMB's tokenizer-free TTS (OpenBMB/VoxCPM, Apache-2.0, code and weights): continuous speech latents generated patch by patch, with no discrete codes. Code: `mizuoto/engines/voxcpm`. Mizuoto 0.1 had no VoxCPM, so the reference is upstream's own package, run behind an adapter in the same Mizuoto stack with the library versions upstream locks (transformers 5.3.0, tokenizers 0.22.2, wetext 0.1.2, inflect 7.5.0). On the CPU with the same seed every component and request is identical to it in bf16 (upstream's default) and in fp32, and both trainers give its weights bit for bit. User-facing details: Engines in depth.","locale":"en"},"15737":{"id":"/en/docs/engines-voxcpm-10","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"Variant","locale":"en"},"15738":{"id":"/en/docs/engines-voxcpm-11","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"Catalogue model","locale":"en"},"15739":{"id":"/en/docs/engines-voxcpm-12","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"Parameters","locale":"en"},"15740":{"id":"/en/docs/engines-voxcpm-13","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"Audio","locale":"en"},"15741":{"id":"/en/docs/engines-voxcpm-14","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"Voice modes","locale":"en"},"15742":{"id":"/en/docs/engines-voxcpm-15","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"`v2`","locale":"en"},"15743":{"id":"/en/docs/engines-voxcpm-16","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"`voxcpm/2`","locale":"en"},"15744":{"id":"/en/docs/engines-voxcpm-17","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"2B","locale":"en"},"15745":{"id":"/en/docs/engines-voxcpm-18","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"16 kHz in, 48 kHz out","locale":"en"},"15746":{"id":"/en/docs/engines-voxcpm-19","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"zero-shot, cloning with a transcript (reference + continuation), cloning without one (reference), design from a description, instructions on a cloned voice","locale":"en"},"15747":{"id":"/en/docs/engines-voxcpm-20","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"`v1_5`","locale":"en"},"15748":{"id":"/en/docs/engines-voxcpm-21","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"`voxcpm/1.5`","locale":"en"},"15749":{"id":"/en/docs/engines-voxcpm-22","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"0.6B","locale":"en"},"15750":{"id":"/en/docs/engines-voxcpm-23","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"44.1 kHz","locale":"en"},"15751":{"id":"/en/docs/engines-voxcpm-24","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"zero-shot, cloning by continuation (transcript needed)","locale":"en"},"15752":{"id":"/en/docs/engines-voxcpm-25","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"`v1`","locale":"en"},"15753":{"id":"/en/docs/engines-voxcpm-26","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"`voxcpm/0.5b`","locale":"en"},"15754":{"id":"/en/docs/engines-voxcpm-27","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"0.5B","locale":"en"},"15755":{"id":"/en/docs/engines-voxcpm-28","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"16 kHz","locale":"en"},"15756":{"id":"/en/docs/engines-voxcpm-29","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"zero-shot, cloning by continuation (transcript needed)","locale":"en"},"15757":{"id":"/en/docs/engines-voxcpm-30","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"The generation comes from `config.json`'s `architecture` (missing means `voxcpm`); 1.5 is the first generation with a 44.1 kHz VAE. The model folder holds `config.json`, `model.safetensors` (else `pytorch_model.bin`), `audiovae.pth` (else `audiovae.safetensors`), `tokenizer.json` and `tokenizer_config.json`. A voice's cache holds the VAE latents of the prompt (left-padded) and of the reference (right-padded), as upstream's `build_prompt_cache` makes them.","locale":"en"},"15758":{"id":"/en/docs/engines-voxcpm-31","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#variants-and-files","content":"Precision: `auto` is upstream's choice, the config's bf16 on every device including the CPU, float32 on Apple MPS; `engines.voxcpm.dtype` overrides. The VAE always runs in float32.","locale":"en"},"15759":{"id":"/en/docs/engines-voxcpm-32","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"Text tokens and audio patches share one sequence. Per patch, a **text-semantic language model** (MiniCPM-4 with LongRoPE and a static KV cache) and a shallower **residual acoustic language model** produce two hidden states; a **local DiT** (a bidirectional MiniCPM-4 run as a conditional flow, about 10 Euler steps with classifier-free guidance) predicts the next patch of latents from them and the previous patch; a **local encoder** embeds the patch back into the language model; a **stop head** decides whether to continue. The **AudioVAE**, a DAC-like causal convolutional codec with Snake activations, decodes the latents (v2 with sample-rate conditioning, 16 kHz latents to 48 kHz audio).","locale":"en"},"15760":{"id":"/en/docs/engines-voxcpm-33","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"Module","locale":"en"},"15761":{"id":"/en/docs/engines-voxcpm-34","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"What it is","locale":"en"},"15762":{"id":"/en/docs/engines-voxcpm-35","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`config.py`","locale":"en"},"15763":{"id":"/en/docs/engines-voxcpm-36","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`config.json` read as data, with upstream's pydantic defaults","locale":"en"},"15764":{"id":"/en/docs/engines-voxcpm-37","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`minicpm.py`","locale":"en"},"15765":{"id":"/en/docs/engines-voxcpm-38","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"MiniCPM-4: RMSNorm, LongRoPE, GQA SDPA, the static KV cache, muP residuals","locale":"en"},"15766":{"id":"/en/docs/engines-voxcpm-39","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`model.py`","locale":"en"},"15767":{"id":"/en/docs/engines-voxcpm-40","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"The scalar quantiser, the local encoder, the local DiT (v1 and v2), the CFM's Euler sampler, the prompt sequence, `PatchDecoder` and the generation loop","locale":"en"},"15768":{"id":"/en/docs/engines-voxcpm-41","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`vae.py`","locale":"en"},"15769":{"id":"/en/docs/engines-voxcpm-42","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"AudioVAE v1 and v2 (causal convolutions, Snake, rate conditioning) and v2's stateful streaming decoder","locale":"en"},"15770":{"id":"/en/docs/engines-voxcpm-43","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`text.py`","locale":"en"},"15771":{"id":"/en/docs/engines-voxcpm-44","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"The tokenizer as transformers 5.3 builds it, upstream's split of multi-character Han tokens, the text normaliser","locale":"en"},"15772":{"id":"/en/docs/engines-voxcpm-45","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`engine.py`","locale":"en"},"15773":{"id":"/en/docs/engines-voxcpm-46","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`VoxCpmEngine`, `LoadedVoxCpm`: precision, voice modes, the voice cache, retries, streaming","locale":"en"},"15774":{"id":"/en/docs/engines-voxcpm-47","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`train.py`, `sft.py`","locale":"en"},"15775":{"id":"/en/docs/engines-voxcpm-48","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`VoxCpmTrainer` (methods `full`, `lora`) and its maths","locale":"en"},"15776":{"id":"/en/docs/engines-voxcpm-49","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"`assets/wetext/`","locale":"en"},"15777":{"id":"/en/docs/engines-voxcpm-50","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"wetext 0.1.2's FSTs for Chinese (with `remove_erhua`) and English normalisation (7.7 MB)","locale":"en"},"15778":{"id":"/en/docs/engines-voxcpm-51","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#how-it-works","content":"Shared: `runtime/ops.py`, `runtime/loading.py` (weight norm folded), `runtime/graphs.py`, `nn/dsp/resample.py` (soxr as librosa calls it; torchaudio's sinc), `nn/dsp/wav.py`, `nn/dsp/tiles.py`, `text/normalize/wetext.py` (its `version=\"0.1\"` steps), `runtime/compile.py`.","locale":"en"},"15779":{"id":"/en/docs/engines-voxcpm-52","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**Precision.** The model is cast before the checkpoint is copied in, as upstream does, so the LongRoPE tables (built in float32) are rounded to bf16 with it.","locale":"en"},"15780":{"id":"/en/docs/engines-voxcpm-53","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**Attention** is SDPA with `enable_gqa` on contiguous tensors: causal for the prefill, bidirectional in the local modules, and per step against the static cache under an explicit boolean mask. Upstream attends over all of the cache's positions (zeros beyond the current length, masked); on the CPU Mizuoto attends over the cache's first multiple of 256 past the current length (`minicpm.attend_span`), mask kept. The masked positions only add exact zeros, and the CPU's SDPA gives the same bits for any cut at a multiple of 64 (checked at every position up to 3100, bf16 and fp32), so the result is identical and VoxCPM2 runs 1.5 times as fast there. On a GPU it attends over the whole cache, as upstream: the step takes SDPA's math path, whose matrix-vector product and softmax split their sums by the key length, so no cut short of the whole cache gives the same bits (checked on CUDA at every position up to 3100 in bf16, fp16 and fp32).","locale":"en"},"15781":{"id":"/en/docs/engines-voxcpm-54","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**Randomness.** The CFM's noise is the only draw at inference, one `randn` per patch in the model's dtype. Each attempt draws from a fresh generator seeded with its seed, which is where upstream's `torch.manual_seed` puts the process-wide stream. Without a seed, a 32-bit seed comes from the request's stream (upstream: `torch.seed()`) and is reported in the applied parameters.","locale":"en"},"15782":{"id":"/en/docs/engines-voxcpm-55","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**Bad-case retry.** A non-streamed result with `retry_badcase_ratio_threshold` or more patches per text token is generated again with seed + 1, at most `retry_badcase_max_times` times; the patch cap is `min(tokens × ratio + 10, max_len)`. `applied.retries` counts the regenerations.","locale":"en"},"15783":{"id":"/en/docs/engines-voxcpm-56","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**The prompt.** VoxCPM2 reads the clip with `librosa.load(sr=16000)` (soxr); 0.5B and 1.5 with `torchaudio.load` and `torchaudio.functional.resample`. A continuation prompt is padded to whole patches on the left, a reference on the right. The transcript and the text are joined without a space, as upstream joins them.","locale":"en"},"15784":{"id":"/en/docs/engines-voxcpm-57","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**The text.** Line breaks and runs of blanks become one space, then the text is normalised when asked. VoxCPM2's description or instruction becomes a `(…)` prefix with any parentheses inside removed, as upstream's web demo does; both are joined with `, ` when a request has both.","locale":"en"},"15785":{"id":"/en/docs/engines-voxcpm-58","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**The tokenizer** is what transformers 5.3's `LlamaTokenizer` builds from the vocabulary, ignoring the file's own pipeline: no normaliser, `Metaspace` with `prepend_scheme=\"always\"` and no split, no unknown token in the BPE, and the config's special tokens added in id order (a token missing from the vocabulary gets the next free id, so VoxCPM2's `<|im_end|>` is 73442, not the file's 73440). The raw `tokenizer.json` gives other ids for text with leading blanks or after a special token. Upstream's wrapper then splits multi-character Han tokens into characters; a character outside the vocabulary is `<unk>`.","locale":"en"},"15786":{"id":"/en/docs/engines-voxcpm-59","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**The normaliser** is wetext 0.1.2's: the text stripped before tagging and after each FST, and with `remove_erhua` also text with 儿 and no digit handled. Its FSTs differ from those of wetext 0.0.4 (CosyVoice's asset) and of WeTextProcessing (IndexTTS), so they ship with the engine. Numbers are spelled by `inflect`; Mizuoto's 7.3.1 and upstream's 7.5.0 give the same words on the corpus.","locale":"en"},"15787":{"id":"/en/docs/engines-voxcpm-60","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**Decoding.** VoxCPM2 drops the decoded context patches (the prompt's last `min(3, n)`) from the front; the first generation drops `2 × patch × hop` samples whenever there is any prompt audio, as upstream does whatever the prompt's length. Streaming yields one chunk per patch: VoxCPM2 through the stateful causal decoder, the first generation by decoding the last three patches and keeping the newest.","locale":"en"},"15788":{"id":"/en/docs/engines-voxcpm-61","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#what-reproduces-upstream","content":"**Snake** computes upstream's operations in upstream's order, as a plain function (upstream scripts it: see Deviations); weight norm is folded with `torch._weight_norm`, the call upstream's hook makes at each forward, on the device the VAE runs on (a GPU's reduction gives other bits than the CPU's).","locale":"en"},"15789":{"id":"/en/docs/engines-voxcpm-62","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#deviations","content":"**Not offered**: denoising the reference with ZipEnhancer (`denoise`; a ModelScope pipeline and a second model, off by default upstream), timestamps (stable-ts), upstream's CUDA `torch.compile` (`optimize`) and vLLM serving.","locale":"en"},"15790":{"id":"/en/docs/engines-voxcpm-63","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#deviations","content":"**Long text** is split by Mizuoto; upstream does not split.","locale":"en"},"15791":{"id":"/en/docs/engines-voxcpm-64","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#deviations","content":"**Cloning with a transcript on VoxCPM2** uses the reference *and* the continuation, as upstream's web demo does (`reference_prefix`, on by default). Upstream's Python API adds the reference only when the caller passes `reference_wav_path`.","locale":"en"},"15792":{"id":"/en/docs/engines-voxcpm-65","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#deviations","content":"**`compute.compile`** wraps the local DiT. On the CPU in bf16 it gains nothing, and its float differences can move where the speech ends (VoxCPM-0.5B: 56 320 against 55 040 samples); off by default.","locale":"en"},"15793":{"id":"/en/docs/engines-voxcpm-66","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#deviations","content":"**Snake is not scripted.** Upstream's TorchScript `snake` is fused on CUDA from its second call at a shape, up to 4.8e-7 off: a request's bits depended on the shapes the process had seen (the first request differed from later ones), and the fuser compiled on the default device, opening a 256 MB context on `cuda:0` from a process working on `cuda:1`. As a plain function the same operations run eagerly: identical on the CPU (which never fuses) and to upstream's first call at a shape, the same on every request, about 1 % slower in the VAE.","locale":"en"},"15794":{"id":"/en/docs/engines-voxcpm-67","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#memory-and-speed","content":"Phases: the VAE encodes a voice prompt and decodes; the model (`kind=\"sequence\"`; the local encoder and DiT `hot`, since they run many times a patch) generates; streaming holds both. If the VAE runs out of memory with `compute.oom_fallback` on, it decodes in tiles of 256 latent frames, each after the 20–22 frames its first sample depends on (the decoder is causal): the whole's samples up to the sums' rounding.","locale":"en"},"15795":{"id":"/en/docs/engines-voxcpm-68","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#memory-and-speed","content":"A patch is the DiT's Euler steps (each a guidance pair), the local encoder, the stop head and both language models' steps: some 6 000 small kernels, and three waits for the device (the stop flag and each language model's position copied from a Python integer). `model.PatchDecoder` runs a patch over fixed tensors with one wait, for the stop flag. The language models step before the flag is read (upstream reads it first and stops before stepping); they draw nothing and their caches are dropped when generation ends, so the patches are the same. A full cache raises where upstream's step would.","locale":"en"},"15796":{"id":"/en/docs/engines-voxcpm-69","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#memory-and-speed","content":"With `compute.cuda_graphs` (NVIDIA, the model wholly on its device, `compute.compile` off) a patch is one CUDA graph per number of steps and guidance value (the attention span is the whole cache there); the DiT's noise is drawn from the graphs' generator, loaded from the request's and written back at each patch. The language models' static caches are then kept with the model while graphs are kept (the memory a request needs anyway) and go when the weights move or the model unloads. The real 0.5B and 1.5 give the same audio with and without graphs, 1.6–1.9 times faster per request.","locale":"en"},"15797":{"id":"/en/docs/engines-voxcpm-70","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#memory-and-speed","content":"**Fast mode** (load option `attention_span`, off): each step attends over the filled blocks of its cache on a GPU too, as on the CPU, instead of all 8192 positions (exact on a GPU only over the whole cache, which made VoxCPM 1.4–1.7× slower in G1). On an RTX 3090: VoxCPM2 2.13 → 1.26 s a request (×1.69), 1.5 0.95 → 0.68 s (×1.40); the audio is another take of the request there, identical on the CPU; outputs list it (`applied.attention_span`). `compute.attention = fast` with FlashAttention installed does the same through the attention kernel (×1.64 and ×1.17).","locale":"en"},"15798":{"id":"/en/docs/engines-voxcpm-71","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#training","content":"Methods `full` and `lora` (`train.py`, the maths in `sft.py`), upstream's `train_voxcpm_finetune.py` with its per-model recipes (`conf/<model>/*.yaml`), which fill any hyperparameter left at 0. No `datasets`, `transformers`, `argbind` or tensorboard. Stages: `prepare` (the clips at the VAE's rate, read as `datasets` reads them: soundfile's float64 and `librosa.resample`'s soxr; their tokens; the `max_batch_tokens` filter), `train`, `export`.","locale":"en"},"15799":{"id":"/en/docs/engines-voxcpm-72","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#training","content":"**Draws in upstream's order**, from private generators seeded 42 (upstream's `Accelerator` seeds every generator with 42): the construction's default initialisations replayed (the VAE, then the model, then LoRA's `A` with Kaiming's initialisation, whose values are kept; the checkpoint replaces the rest); per loader pass the base seed and the sampler's seed; per forward the CFM's masks, condition noise (drawn even at scale 0), `r`, `t` and `z`, and LoRA's dropout masks. On a CPU one generator serves everything, as upstream's default generator does; on CUDA the forward's draws come from a device generator.","locale":"en"},"15800":{"id":"/en/docs/engines-voxcpm-73","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#training","content":"**Precision.** On CUDA, as upstream: float32 weights under bf16 autocast with a gradient scaler. Elsewhere float32 throughout: upstream cannot train off CUDA with its configurations (its forward casts the inputs to the config's bf16 while the weights stay float32), so its CPU reference is upstream with a `config.json` that says float32.","locale":"en"},"15801":{"id":"/en/docs/engines-voxcpm-74","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#training","content":"**Kept as upstream**: every clip padded to whole patches on the right; the stop label on the last patch and the loss over audio positions; each micro-batch's loss divided by the accumulation; gradients clipped at 1e9 when clipping is off; the learning rate logged is the next step's.","locale":"en"},"15802":{"id":"/en/docs/engines-voxcpm-75","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#training","content":"**The export.** Full: `model.safetensors` (float32, upstream's keys) beside the base model's config, VAE and tokenizer. LoRA: the base weights (hard-linked where the file system allows) with `lora_weights.safetensors` and `lora_config.json`, applied when the engine loads, as upstream's `VoxCPM(lora_weights_path=…)` does; upstream never merges them. Without a 3–15 s clip the preview is spoken zero-shot.","locale":"en"},"15803":{"id":"/en/docs/engines-voxcpm-76","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#training","content":"`training.memory`: gradient checkpointing over the MiniCPM layers, the local encoder's and the DiT's gives identical results (LoRA dropout and CFM draws replayed); the VAE's decoder stays off the device; for LoRA, `low` stores the frozen linear weights in the autocast dtype (CUDA) and `lowest` streams them from RAM (identical on the CPU).","locale":"en"},"15804":{"id":"/en/docs/engines-voxcpm-77","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#parity","content":"**Components**, every model in bf16 and fp32: the tokenizer and the normaliser on 420 texts, the VAE's latents and decoding; then whole requests in every mode (zero-shot and cloning in English and Chinese, reference only, continuation only, design, a cloned voice with an instruction, normalisation, a forced retry, streaming with and without a voice, chunk lengths included). All identical.","locale":"en"},"15805":{"id":"/en/docs/engines-voxcpm-78","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#parity","content":"**Through the stack**, 27 cases (every voice mode, normalisation, a forced retry, streaming, several segments, other steps and guidance, fp32 through `engines.voxcpm.dtype`): all identical in audio and behaviour (applied parameters, warnings, voice mode, segments, streamed chunk lengths).","locale":"en"},"15806":{"id":"/en/docs/engines-voxcpm-79","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#parity","content":"**Training**: VoxCPM-0.5B full, VoxCPM-0.5B LoRA and VoxCPM2 LoRA are identical to upstream's script at every step (both losses, the gradient norm, the learning rate), and so are the saved weights. Each export speaks identically when upstream loads it and when Mizuoto does.","locale":"en"},"15807":{"id":"/en/docs/engines-voxcpm-80","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#parity","content":"The contract suite passes (18 tests across the three models).","locale":"en"},"15808":{"id":"/en/docs/engines-voxcpm-81","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#parity","content":"**On a GPU** (an RTX 3090, 2026-10-19, against upstream's package, each case in a fresh process): the language models, the local encoder, the DiT and the latents are identical; with Snake scripted as upstream's (an experiment), the zero-shot v1.5 fp32, v2 zero-shot and v2 clone cases are identical sample for sample. As shipped (Snake eager) they are 72–76 dB from upstream, as upstream is from itself across process histories (74.5 dB for v1.5 fp32 zero-shot; a v2 clone even changed length).","locale":"en"},"15809":{"id":"/en/docs/engines-voxcpm-82","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#limitations","content":"No reference denoising and no timestamps.","locale":"en"},"15810":{"id":"/en/docs/engines-voxcpm-83","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#limitations","content":"On CUDA the first request in a process decodes its latents (which are identical) with slightly different bits from later requests; later requests repeat each other exactly.","locale":"en"},"15811":{"id":"/en/docs/engines-voxcpm-84","page_id":"/en/docs/engines-voxcpm","tags":[],"type":"text","url":"/en/docs/engines-voxcpm#limitations","content":"VoxCPM2's full fine-tune needs about 40 GB of memory.","locale":"en"},"15812":{"id":"/en/docs/engines","page_id":"/en/docs/engines","type":"page","content":"Engine reference","breadcrumbs":["Mizuoto Documentation","Engine reference"],"tags":[],"url":"/en/docs/engines","locale":"en"},"15813":{"id":"/en/docs/engines-0","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines","content":"How each built-in engine is implemented and how exactly it reproduces its upstream: variants, code, parity results and training methods, how exactness is defined and checked, and the rules every engine keeps.","locale":"en"},"15814":{"id":"/en/docs/engines-1","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#the-engines","content":"The engines","locale":"en"},"15815":{"id":"/en/docs/engines-2","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#what-identical-means","content":"What \"identical\" means","locale":"en"},"15816":{"id":"/en/docs/engines-3","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#the-reference","content":"The reference","locale":"en"},"15817":{"id":"/en/docs/engines-4","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#the-conditions","content":"The conditions","locale":"en"},"15818":{"id":"/en/docs/engines-5","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#tiers","content":"Tiers","locale":"en"},"15819":{"id":"/en/docs/engines-6","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#how-it-is-checked","content":"How it is checked","locale":"en"},"15820":{"id":"/en/docs/engines-7","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#rules-every-engine-keeps","content":"Rules every engine keeps","locale":"en"},"15821":{"id":"/en/docs/engines-8","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#shared-building-blocks","content":"Shared building blocks","locale":"en"},"15822":{"id":"/en/docs/engines-9","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#licence-gated-engines","content":"Licence-gated engines","locale":"en"},"15823":{"id":"/en/docs/engines-10","page_id":"/en/docs/engines","type":"heading","tags":[],"url":"/en/docs/engines#limitations","content":"Limitations","locale":"en"},"15824":{"id":"/en/docs/engines-11","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines","content":"Every engine in Mizuoto is a port: the model code of an upstream project, written again on Mizuoto's runtime (`mizuoto/runtime`) and its shared building blocks (`mizuoto/nn`, `mizuoto/text`). No upstream code is vendored, and no engine imports transformers, onnxruntime or the upstream package. Each port is held to one standard: on the CPU, in fp32, with the same seed, it gives the output of the code it replaces, sample for sample.","locale":"en"},"15825":{"id":"/en/docs/engines-12","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines","content":"This section records, engine by engine, what that took, where an engine deliberately differs, how it uses memory and runs fast, how it trains, and what the comparison found. Which engine to choose and what each offers is in Engines in depth; how an engine is written and registered is in Adding an engine.","locale":"en"},"15826":{"id":"/en/docs/engines-13","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Engine","locale":"en"},"15827":{"id":"/en/docs/engines-14","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Variants","locale":"en"},"15828":{"id":"/en/docs/engines-15","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Code","locale":"en"},"15829":{"id":"/en/docs/engines-16","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Exactness (CPU, fp32, same seed)","locale":"en"},"15830":{"id":"/en/docs/engines-17","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Training","locale":"en"},"15831":{"id":"/en/docs/engines-18","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Qwen3-TTS","locale":"en"},"15832":{"id":"/en/docs/engines-19","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`base`, `custom_voice`, `custom_voice_lite`, `voice_design`","locale":"en"},"15833":{"id":"/en/docs/engines-20","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/qwen3tts`","locale":"en"},"15834":{"id":"/en/docs/engines-21","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical in all 8 stack cases","locale":"en"},