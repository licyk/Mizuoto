stall","content":"`PYTHON`","locale":"en"},"16971":{"id":"/en/docs/installation-44","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ways-to-install","content":"`3.11`","locale":"en"},"16972":{"id":"/en/docs/installation-45","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ways-to-install","content":"The image's Python","locale":"en"},"16973":{"id":"/en/docs/installation-46","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ways-to-install","content":"In the container the server listens on `0.0.0.0`, so set an access token with `MIZUOTO_SERVER__ACCESS_TOKEN`. The browser shows an **Access token** dialog when the page opens; enter it there.","locale":"en"},"16974":{"id":"/en/docs/installation-47","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ways-to-install","content":"The image has a health check (`/api/v1/app/health`).","locale":"en"},"16975":{"id":"/en/docs/installation-48","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ways-to-install","content":"More in Docker.","locale":"en"},"16976":{"id":"/en/docs/installation-49","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Some languages need packages that are not installed by default. Without them, text in those languages fails with the install command in the error's hint; `mizuoto doctor` lists the missing ones.","locale":"en"},"16977":{"id":"/en/docs/installation-50","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Extra","locale":"en"},"16978":{"id":"/en/docs/installation-51","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"For","locale":"en"},"16979":{"id":"/en/docs/installation-52","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Note","locale":"en"},"16980":{"id":"/en/docs/installation-53","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"`pip install 'mizuoto[gptsovits-ja]'`","locale":"en"},"16981":{"id":"/en/docs/installation-54","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"GPT-SoVITS's Japanese","locale":"en"},"16982":{"id":"/en/docs/installation-55","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"pyopenjtalk 0.4.1 is published as source only: building it needs CMake and a C++ compiler","locale":"en"},"16983":{"id":"/en/docs/installation-56","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"`pip install 'mizuoto[gptsovits-ko]'`","locale":"en"},"16984":{"id":"/en/docs/installation-57","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"GPT-SoVITS's Korean","locale":"en"},"16985":{"id":"/en/docs/installation-58","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"python-mecab-ko and jamo; python-mecab-ko 1.3.7 publishes wheels for Python 3.10–3.12 only, so on 3.13 and 3.14 it is built from source and needs mecab-ko installed (`mecab-config`)","locale":"en"},"16986":{"id":"/en/docs/installation-59","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"`pip install 'mizuoto-indextts[ja]'`","locale":"en"},"16987":{"id":"/en/docs/installation-60","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"IndexTTS-2.5's Japanese","locale":"en"},"16988":{"id":"/en/docs/installation-61","page_id":"/en/docs/installation","tags":[],