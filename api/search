e":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`DownloadError`","locale":"en"},"11971":{"id":"/en/docs/development-architecture-309","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`download_failed`","locale":"en"},"11972":{"id":"/en/docs/development-architecture-310","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"502","locale":"en"},"11973":{"id":"/en/docs/development-architecture-311","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"12","locale":"en"},"11974":{"id":"/en/docs/development-architecture-312","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`InstallError`","locale":"en"},"11975":{"id":"/en/docs/development-architecture-313","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`install_failed`","locale":"en"},"11976":{"id":"/en/docs/development-architecture-314","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"500","locale":"en"},"11977":{"id":"/en/docs/development-architecture-315","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"13","locale":"en"},"11978":{"id":"/en/docs/development-architecture-316","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`RemoteError`","locale":"en"},"11979":{"id":"/en/docs/development-architecture-317","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`remote_unavailable`","locale":"en"},"11980":{"id":"/en/docs/development-architecture-318","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"502","locale":"en"},"11981":{"id":"/en/docs/development-architecture-319","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"14","locale":"en"},"11982":{"id":"/en/docs/development-architecture-320","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`CancelledError`","locale":"en"},"11983":{"id":"/en/docs/development-architecture-321","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`cancelled`","locale":"en"},"11984":{"id":"/en/docs/development-architecture-322","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"499","locale":"en"},"11985":{"id":"/en/docs/development-architecture-323","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"130","locale":"en"},"11986":{"id":"/en/docs/development-architecture-324","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`detail[\"reason\"]` of `compute_unavailable` tells `out_of_memory` from `no_device`. Job workers' process exit codes follow their own convention (`codes.EXIT_*`): `EXIT_RETRY = 75` asks to be run again, `EXIT_CANCELLED = 130` means cancelled.","locale":"en"},"11987":{"id":"/en/docs/development-conventions","page_id":"/en/docs/development-conventions","type":"page","content":"Conventions","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-conventions","locale":"en"},"11988":{"id":"/en/docs/development-conventions-0","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions","content":"The conventions code in Mizuoto follows: style, the layer rules, the rules for native code, the exactness rule, the steps for adding a command, route, setting or engine option, what tests a change needs, documentation in both languages and the commit message format.","locale":"en"},"11989":{"id":"/en/docs/development-conventions-1","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#code-style","content":"Code style","locale":"en"},"11990":{"id":"/en/docs/development-conventions-2","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#the-layer-rules","content":"The layer rules","locale":"en"},"11991":{"id":"/en/docs/development-conventions-3","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#rules-for-native-code","content":"Rules for native code","locale":"en"},"11992":{"id":"/en/docs/development-conventions-4","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#exactness","content":"Exactness","locale":"en"},"11993":{"id":"/en/docs/development-conventions-5","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#adding-things","content":"Adding things","locale":"en"},"11994":{"id":"/en/docs/development-conventions-6","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#tests-a-change-needs","content":"Tests a change needs","locale":"en"},"11995":{"id":"/en/docs/development-conventions-7","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#documentation","content":"Documentation","locale":"en"},"11996":{"id":"/en/docs/development-conventions-8","page_id":"/en/docs/development-conventions","type":"heading","tags":[],"url":"/en/docs/development-conventions#commit-messages","content":"Commit messages","locale":"en"},"11997":{"id":"/en/docs/development-conventions-9","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions","content":"This page lists the conventions a change to Mizuoto must follow. Most of them are held by tests or checks: `python scripts/dev.py check` passing is the least a change needs before it is merged. The design behind each convention is in Architecture and Design references and decisions.","locale":"en"},"11998":{"id":"/en/docs/development-conventions-10","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**Python ≥ 3.10**, with 3.10–3.14 supported. `ty` checks types for 3.10, so do not use syntax or standard-library modules newer than that (`tomllib` needs its `tomli` fallback).","locale":"en"},"11999":{"id":"/en/docs/development-conventions-11","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**ruff and ty are unpinned**, and `pyproject.toml` writes `lint.select` out rule by rule (`E4`, `E7`, `E9`, `F`, `I`, `UP`, `B`, `SIM`, `RUF100`, `ANN`), so a ruff upgrade cannot quietly change the rule set. Line length 180, indent 4. ty runs with `error-on-warning`. `python scripts/dev.py format` formats and applies the safe fixes; `lint` and `typecheck-py` only check.","locale":"en"},"12000":{"id":"/en/docs/development-conventions-12","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**Every function is annotated** (under `mizuoto/` and `packages/native/`; tests and scripts are exempt). `Any` only where the value really is anything (JSON).","locale":"en"},"12001":{"id":"/en/docs/development-conventions-13","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**Every model that crosses the API boundary is a `Record`** (`mizuoto/core/record.py`, pydantic v2, `json_schema_serialization_defaults_required`): settings, requests, responses, events, `--json` output. Defaulted fields are required in the output schema, so the generated TypeScript types match what the server sends.","locale":"en"},"12002":{"id":"/en/docs/development-conventions-14","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**Heavy imports go inside functions**: av and numpy hot paths in the core, fastapi and uvicorn in the command line, and every piece of model code in `core/inference`. That keeps `mizuoto version` and `mizuoto --help` fast, and tests check it.","locale":"en"},"12003":{"id":"/en/docs/development-conventions-15","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**No method named `list` on a class that annotates with `list[...]`** (ty resolves the name to the method). Write `list_models`, `list_voices`, `list_presets`.","locale":"en"},"12004":{"id":"/en/docs/development-conventions-16","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**Identifiers and times** come from `mizuoto/core/clock.py`: `new_id(prefix)` (a hex millisecond timestamp and 8 random hex digits, sorting roughly by creation time) and `now_iso()` (UTC, milliseconds, ending in `Z`, sorting as text).","locale":"en"},"12005":{"id":"/en/docs/development-conventions-17","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**Errors are the classes of `mizuoto/core/errors.py`**, and error codes live only in `mizuoto/core/codes.py`. A fix for the user goes in `detail[\"hint\"]`: the command line prints it as a second line and the UI shows it under the error. Routes and commands never make up their own HTTP statuses or exit codes.","locale":"en"},"12006":{"id":"/en/docs/development-conventions-18","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"**Logging** goes through the `mizuoto` logger (`logging.getLogger(__name__)` under `mizuoto.*`); only the entry point (`setup_logging` in `mizuoto/logger.py`) configures handlers.","locale":"en"},"12007":{"id":"/en/docs/development-conventions-19","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#code-style","content":"Code that follows an upstream library line for line and must stay comparable with it (`mizuoto/nn/dsp/kaldi.py`, torchaudio's fbank) is kept verbatim and exempted from lint rules in `pyproject.toml`, not rewritten.","locale":"en"},"12008":{"id":"/en/docs/development-conventions-20","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#the-layer-rules","content":"`tests/test_architecture.py` checks every module's imports with `ast`; the tables are in Architecture. In short:","locale":"en"},"12009":{"id":"/en/docs/development-conventions-21","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#the-layer-rules","content":"`core`, `api` and `cli` never import torch, torchaudio, transformers, onnxruntime or a licence-gated engine package, not even inside a function. `core` reaches `runtime`, `nn`, `engines` and `training` only inside functions of `core/inference`.","locale":"en"},"12010":{"id":"/en/docs/development-conventions-22","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#the-layer-rules","content":"Routes and commands are thin: parse the input, call **one** core method, shape the output. Each operation has one core method, so the API's JSON has the shape of the command line's `--json`. Business logic never goes into `api/` or `cli/`.","locale":"en"},"12011":{"id":"/en/docs/development-conventions-23","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#the-layer-rules","content":"Engines import only `runtime`, `nn`, `text`, `training`, `core.codes`, `core.inference.tasks` and their own package, and **never another engine**. Code two engines share goes into `nn` or `runtime`.","locale":"en"},"12012":{"id":"/en/docs/development-conventions-24","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#the-layer-rules","content":"`core/codes.py`, `core/jobs/events.py`, `core/jobs/jsonl.py`, `core/remote/frames.py` and `core/inference/tasks.py` use the standard library only: training stages, remote frames and engines all use them.","locale":"en"},"12013":{"id":"/en/docs/development-conventions-25","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#the-layer-rules","content":"A new third-party dependency goes into `pyproject.toml` and into its layer's allowed list in `tests/test_architecture.py`, with the reason it is needed (see Release).","locale":"en"},"12014":{"id":"/en/docs/development-conventions-26","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"Engines, trainers, the runtime and the server share one process, so code under `runtime`, `nn`, `text`, `engines` and `packages/native` keeps these rules (details in Runtime):","locale":"en"},"12015":{"id":"/en/docs/development-conventions-27","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Change no process-wide state.** Do not seed the global generators, change `os.environ`, the working directory or `sys.path`, call `logging.basicConfig`, `torch.set_default_dtype`, `torch.use_deterministic_algorithms` or `torch.set_float32_matmul_precision`, assign `torch.backends.*` or `torch._inductor.config`, or use `sdpa_kernel` (it switches SDPA's kernels for every thread). `compute.fast`'s switches are set only in `mizuoto/runtime/accel/features.py`, called by the host and the training stage.","locale":"en"},"12016":{"id":"/en/docs/development-conventions-28","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Randomness comes from the request.** Use `ctx.generator_for(device)` and `ctx.rng`; pass the generator to every random op (`torch.randn(..., generator=g)`), and draw in upstream's order, shapes and device. Calls that take no generator, such as `randn_like`, are rewritten in an equivalent explicit form. Where upstream draws from the global generator while it builds a model, replay the draws on a private generator.","locale":"en"},"12017":{"id":"/en/docs/development-conventions-29","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Loading draws nothing.** Modules are built from `runtime.ops` layers (`ops.default` skips random initialisation), and checkpoints load strictly (a missing or unexpected key is an error unless the engine lists it as ignorable).","locale":"en"},"12018":{"id":"/en/docs/development-conventions-30","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Load outside inference mode, and leave parameters as `nn.Module` makes them** (no `requires_grad_(False)`). Two CPU kernel traps change results: on a non-contiguous 3-D input, `F.linear` takes another kernel when the weight `requires_grad`, or when it is an inference tensor (made inside `torch.inference_mode()`), even under `no_grad` or inference mode. Upstream's weights are ordinary parameters that require grad, so native engines keep them so; requests still run in inference mode.","locale":"en"},"12019":{"id":"/en/docs/development-conventions-31","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Attention goes through `accel.attention(q, k, v, site=…)`**, never SDPA or its aten kernels directly, so `compute.attention` can switch the backend (see Attention acceleration).","locale":"en"},"12020":{"id":"/en/docs/development-conventions-32","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Download nothing.** Every file an engine reads is a model file or a shared asset, which `ModelService` downloads and hands over through `LoadSpec`.","locale":"en"},"12021":{"id":"/en/docs/development-conventions-33","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Key a module-level cache by its whole input** (every parameter, dtype and device), or build per call. A global cache keyed by part of its input makes a second configuration in the same process reuse the first one's result.","locale":"en"},"12022":{"id":"/en/docs/development-conventions-34","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Place components per phase and estimate memory per request.** Engines put each phase's components on the device with `ctx.use` / `ctx.run`; a module whose weights are read outside its `forward` is marked `fixed`; a module that needs float64 is placed through `DeviceService.float64_device`. See Memory management.","locale":"en"},"12023":{"id":"/en/docs/development-conventions-35","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#rules-for-native-code","content":"**Be cancellable.** Call `ctx.check_cancel()` in every loop (autoregressive token, ODE step, segment, beam step). `Cancelled` derives from `BaseException`; never swallow it with a broad `except BaseException`.","locale":"en"},"12024":{"id":"/en/docs/development-conventions-36","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#exactness","content":"Each Mizuoto engine is a port of an upstream project and must give **the same** results: on the CPU in fp32 with the same seed, the audio is identical sample for sample (for trainers: losses, learning rates and saved weights identical byte for byte). This rule decides much of how code is written:","locale":"en"},"12025":{"id":"/en/docs/development-conventions-37","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#exactness","content":"**Reproduce first, fix after.** Upstream's quirks (draw order, padding, alignment edge cases) are reproduced as they are and shown identical with the parity harness; a fix, where one is needed, is a separate change with the deviation and its reason recorded.","locale":"en"},"12026":{"id":"/en/docs/development-conventions-38","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#exactness","content":"**Record every deviation.** Each place a port differs from upstream (to run on every platform, to leave global state alone, because upstream depended on thread timing…) goes into the engine's notes and the design record `AGENTS.md`, with the comparison's numbers.","locale":"en"},"12027":{"id":"/en/docs/development-conventions-39","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#exactness","content":"**Speed work keeps results.** Performance work (CUDA graphs, removed waits, compilation, weight streaming) must give the same tokens and the same audio; each round is compared with the previous one by `scripts/parity/perf.py` and `train_perf.py` (see Performance work). An optimisation that does change bits (Qwen3-TTS's `fused_projections`, `compute.kv_cache = static`) can only be an opt-in setting, and is listed in the output's parameters.","locale":"en"},"12028":{"id":"/en/docs/development-conventions-40","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#exactness","content":"On GPUs in reduced precision, bit identity is not required; modules are judged by their error and whole runs statistically. The tiers and tolerances are in Testing.","locale":"en"},"12029":{"id":"/en/docs/development-conventions-41","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"To add","locale":"en"},"12030":{"id":"/en/docs/development-conventions-42","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"Steps","locale":"en"},"12031":{"id":"/en/docs/development-conventions-43","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"A command","locale":"en"},"12032":{"id":"/en/docs/development-conventions-44","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"A plain function in `mizuoto/cli/commands/` with `--json`, registered in `get_app()` of `cli/app.py` (name and help at registration), and added to `EXPECTED_TREE` in `tests/cli/test_cli.py`. See Adding a command","locale":"en"},"12033":{"id":"/en/docs/development-conventions-45","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"A route","locale":"en"},"12034":{"id":"/en/docs/development-conventions-46","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"The core method (`Record` in and out) → a route with an `operation_id` in `api/routers/` → `python scripts/dev.py typegen` and commit `schema.d.ts` → `tests/api/test_api.py`. See Adding a route","locale":"en"},"12035":{"id":"/en/docs/development-conventions-47","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"An event","locale":"en"},"12036":{"id":"/en/docs/development-conventions-48","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"An `EventBase` subclass (`__event_name__`) in `core/events/models.py`; it enters the OpenAPI schema by itself. Regenerate the types and handle it in the UI's `api/socket.ts`","locale":"en"},"12037":{"id":"/en/docs/development-conventions-49","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"A setting","locale":"en"},"12038":{"id":"/en/docs/development-conventions-50","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"A field with a default and a docstring in its group in `core/settings/models.py`; when the UI shows it, a control in Settings, the text in both languages and `typegen`; document it in both language versions of Configuration. A change to `engines.<id>.*` unloads that engine's models, which load with the new settings next time","locale":"en"},"12039":{"id":"/en/docs/development-conventions-51","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"An engine option","locale":"en"},"12040":{"id":"/en/docs/development-conventions-52","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"`[options.<name>]` (or a load option, `[load_options.<name>]`) in the manifest, and the same entry in the engine's `OPTION_SCHEMA`; a test requires the two to match. See Adding an engine","locale":"en"},"12041":{"id":"/en/docs/development-conventions-53","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"A job kind","locale":"en"},"12042":{"id":"/en/docs/development-conventions-54","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"`jobs.register(kind, factory)` in the service's constructor, the factory returning a `JobSpec` with its resources (`engine:<engine>:<device>`, `gpu:<device>`, `cpu`, `io`…); the lists it changes when it ends are registered in `AFFECTS` in the UI's `socket.ts`","locale":"en"},"12043":{"id":"/en/docs/development-conventions-55","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"An engine or a trainer","locale":"en"},"12044":{"id":"/en/docs/development-conventions-56","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"See Adding an engine and Trainers","locale":"en"},"12045":{"id":"/en/docs/development-conventions-57","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"A screen","locale":"en"},"12046":{"id":"/en/docs/development-conventions-58","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#adding-things","content":"See Web UI: components only from `@/ui`, styles only from tokens, text in both languages at once","locale":"en"},"12047":{"id":"/en/docs/development-conventions-59","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#tests-a-change-needs","content":"**Every change comes with tests**, and `python scripts/dev.py check` (lint, typecheck-py, test-py, test-web, typegen-check) passes. CI runs the same tests on Linux, Windows and macOS with Python 3.10–3.14, so mind how paths, encodings and line endings behave on Windows.","locale":"en"},"12048":{"id":"/en/docs/development-conventions-60","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#tests-a-change-needs","content":"The core's behaviour is tested with the dummy engine (no torch, no model); the network is replaced by `httpx.MockTransport`; tests get an isolated data folder and an empty environment from `make_services`.","locale":"en"},"12049":{"id":"/en/docs/development-conventions-61","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#tests-a-change-needs","content":"**A change to an engine or trainer**: update its tiny-model tests in `tests/engines_native/` (including the streaming check on a simulated device), run the contract suite with real models, and compare with upstream through the parity harness.","locale":"en"},"12050":{"id":"/en/docs/development-conventions-62","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#tests-a-change-needs","content":"When the API changes, regenerate the types and commit them, or `typegen-check` fails. UI changes pass the rule tests (imports, tokens, layout, layers, i18n keys).","locale":"en"},"12051":{"id":"/en/docs/development-conventions-63","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#documentation","content":"**Both languages.** Every page of this site has `<slug>.mdx` (Simplified Chinese, the default) and `<slug>.en.mdx` (English), section for section; the sidebars are `meta.json` and `meta.en.json`, in the same order. A test checks that every Chinese page has its English twin. The README comes in two (`README.md`, `README.zh-CN.md`), and the UI's text lives in `en.ts` and `zh-CN.ts`, whose keys must match.","locale":"en"},"12052":{"id":"/en/docs/development-conventions-64","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#documentation","content":"**A change in behaviour changes the documentation**: what users see goes into the guide, command-line or advanced pages, what developers need into the development pages.","locale":"en"},"12053":{"id":"/en/docs/development-conventions-65","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#documentation","content":"**The design record.** `AGENTS.md` at the repository root records what the code does, the rules it keeps and why, and durable findings (such as which upstream behaviours a port reproduces to give the same output). Update it with any change of design or new finding.","locale":"en"},"12054":{"id":"/en/docs/development-conventions-66","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#documentation","content":"Chinese pages keep the existing pages' terms (音色, 合成, 克隆, 模型, 引擎, 共享资源, 许可, 任务…). Write what is and why, not how it came about.","locale":"en"},"12055":{"id":"/en/docs/development-conventions-67","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#commit-messages","content":"Commit messages take the form `type(scope): summary`, the summary in lower case, saying what the change does:","locale":"en"},"12056":{"id":"/en/docs/development-conventions-68","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#commit-messages","content":"Types: `feat` (a feature), `fix`, `perf` (faster with the same results), `refactor` (no change in behaviour), `test`, `docs`, `build` (builds, CI, Docker), `chore`. A breaking change adds `!` after the type, as in `refactor!:`.","locale":"en"},"12057":{"id":"/en/docs/development-conventions-69","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#commit-messages","content":"The scope is the part affected: `runtime`, `webui`, `training`, `models`, `scripts`, `site`, or an engine id (`qwen3tts`, `gptsovits`…); several may be listed (`runtime,training`), or none for a change across the board.","locale":"en"},"12058":{"id":"/en/docs/development-conventions-70","page_id":"/en/docs/development-conventions","tags":[],"type":"text","url":"/en/docs/development-conventions#commit-messages","content":"The body says why, the measured or compared results, and any behaviour deliberately kept.","locale":"en"},"12059":{"id":"/en/docs/development-design","page_id":"/en/docs/development-design","type":"page","content":"Design references and decisions","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-design","locale":"en"},"12060":{"id":"/en/docs/development-design-0","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design","content":"Where Mizuoto's design comes from: the skeleton's lineage, what was taken from InvokeAI, ani2xcur, Material Design 3 and ComfyUI and what was not, and a table of design decisions with their reasons.","locale":"en"},"12061":{"id":"/en/docs/development-design-1","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#lineage","content":"Lineage","locale":"en"},"12062":{"id":"/en/docs/development-design-2","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"From InvokeAI: FastAPI plus a single-page app","locale":"en"},"12063":{"id":"/en/docs/development-design-3","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#shipping-the-front-end-inside-the-wheel","content":"Shipping the front end inside the wheel","locale":"en"},"12064":{"id":"/en/docs/development-design-4","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#port-selection","content":"Port selection","locale":"en"},"12065":{"id":"/en/docs/development-design-5","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#the-command-line-typer-registration","content":"The command line: Typer registration","locale":"en"},"12066":{"id":"/en/docs/development-design-6","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#material-design-3-in-layers","content":"Material Design 3 in layers","locale":"en"},"12067":{"id":"/en/docs/development-design-7","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#from-comfyui-the-runtime","content":"From ComfyUI: the runtime","locale":"en"},"12068":{"id":"/en/docs/development-design-8","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#design-decisions","content":"Design decisions","locale":"en"},"12069":{"id":"/en/docs/development-design-9","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#environment-and-distribution","content":"Environment and distribution","locale":"en"},"12070":{"id":"/en/docs/development-design-10","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#engines-and-exactness","content":"Engines and exactness","locale":"en"},"12071":{"id":"/en/docs/development-design-11","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#runtime-and-memory","content":"Runtime and memory","locale":"en"},"12072":{"id":"/en/docs/development-design-12","page_id":"/en/docs/development-design","type":"heading","tags":[],"url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Jobs, interfaces and data","locale":"en"},"12073":{"id":"/en/docs/development-design-13","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design","content":"Mizuoto was not designed from nothing. Its application skeleton (core services, thin API and command line, a Vue UI shipped in the wheel, the tooling) comes from a line of sibling projects, and its model runtime follows ComfyUI. This page records what was taken from each source and why, what was deliberately left out, and finally the design decisions that shaped the code as it is. What the code looks like is in Architecture.","locale":"en"},"12074":{"id":"/en/docs/development-design-14","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"Project","locale":"en"},"12075":{"id":"/en/docs/development-design-15","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"What it is","locale":"en"},"12076":{"id":"/en/docs/development-design-16","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"What Mizuoto keeps of it","locale":"en"},"12077":{"id":"/en/docs/development-design-17","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"SD Model Hub","locale":"en"},"12078":{"id":"/en/docs/development-design-18","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"A Stable Diffusion model manager","locale":"en"},"12079":{"id":"/en/docs/development-design-19","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"The skeleton itself: all logic in `core` with two thin entrances over it (FastAPI and Typer), `build_services()` assembling the services, the `Record` base, domain errors carrying an HTTP status and an exit code, three settings layers (host overrides > environment > file), the event bus and the socket bridge, the security middleware, port binding and `server.json`, `embed.py` for embedding, `scripts/dev.py`, and the layer rule held by a test","locale":"en"},"12080":{"id":"/en/docs/development-design-20","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"Hanaikada","locale":"en"},"12081":{"id":"/en/docs/development-design-21","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"An AI image browser on the same skeleton","locale":"en"},"12082":{"id":"/en/docs/development-design-22","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"Proof that the skeleton carries over to another domain; its image metadata and index have nothing to do with Mizuoto","locale":"en"},"12083":{"id":"/en/docs/development-design-23","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"rvc-next","locale":"en"},"12084":{"id":"/en/docs/development-design-24","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"An RVC voice-conversion application on the same skeleton","locale":"en"},"12085":{"id":"/en/docs/development-design-25","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"The skeleton under machine-learning load: a job queue with named resources and priorities, persisted requests and retry, job workers with JSON-lines events, memory holders and release after running out of memory, a voice library, training experiments with stage fingerprints; the Material 3 front end (`theme/`, `ui/`, motion, layers, shell, stores, i18n, rule tests); the documentation site","locale":"en"},"12086":{"id":"/en/docs/development-design-26","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"Mizuoto 0.1","locale":"en"},"12087":{"id":"/en/docs/development-design-27","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"One Python environment and one worker process per engine, upstream code vendored as it was","locale":"en"},"12088":{"id":"/en/docs/development-design-28","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"Capabilities declared per variant, two-tier parameters (common parameters plus engine options), licence gates, the voice library and model catalogue, the parameter mappings; and the behaviour the native engines are compared with (git tag `v1-engine-workers`)","locale":"en"},"12089":{"id":"/en/docs/development-design-29","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"Mizuoto 0.2","locale":"en"},"12090":{"id":"/en/docs/development-design-30","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"One environment, every engine implemented in-tree on a ComfyUI-style runtime","locale":"en"},"12091":{"id":"/en/docs/development-design-31","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"The code as it is","locale":"en"},"12092":{"id":"/en/docs/development-design-32","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#lineage","content":"The skeleton is GPL-3.0, and so is Mizuoto (`GPL-3.0-only`). The two licence-gated engines ship apart because of their licences (see the decisions below).","locale":"en"},"12093":{"id":"/en/docs/development-design-33","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"InvokeAI's front-end/back-end structure is where the skeleton started. What was taken:","locale":"en"},"12094":{"id":"/en/docs/development-design-34","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"**One OpenAPI schema as the contract.** Every route has an explicit `operation_id`, with pydantic models in and out. `mizuoto/api/openapi.py` adds every event model and a `ServerEvents` map (event name → schema) to the schema, so socket payloads are typed like REST. `scripts/dev.py typegen` generates `schema.d.ts` with `openapi-typescript` and it is committed; `typegen-check` catches drift between the API and the types in CI.","locale":"en"},"12095":{"id":"/en/docs/development-design-35","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"**Commands go over REST; the socket only pushes.** socket.io sits at `/ws`, server to client only. REST is the truth, and events only patch or invalidate the client's query cache; a reconnect refetches, so missed events never leave the UI stale.","locale":"en"},"12096":{"id":"/en/docs/development-design-36","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"**Long work is a job plus events**, so requests return quickly, and progress and cancellation come with it.","locale":"en"},"12097":{"id":"/en/docs/development-design-37","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"**Blocking work stays off the event loop.** Routes that touch the disk or the database are plain `def` (they run in the thread pool); events from job threads cross to the loop with `call_soon_threadsafe`.","locale":"en"},"12098":{"id":"/en/docs/development-design-38","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"**Thin routes over a service layer**, one router module per resource on the server and one query module per resource in the UI.","locale":"en"},"12099":{"id":"/en/docs/development-design-39","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"**Relative URLs plus a development proxy**: front-end code uses the same relative URLs in development and production.","locale":"en"},"12100":{"id":"/en/docs/development-design-40","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"UI preferences are stored on the server through `/api/v1/client-state/{key}`, so they follow the user across browsers.","locale":"en"},"12101":{"id":"/en/docs/development-design-41","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"Where Mizuoto differs on purpose:","locale":"en"},"12102":{"id":"/en/docs/development-design-42","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"InvokeAI","locale":"en"},"12103":{"id":"/en/docs/development-design-43","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"Mizuoto","locale":"en"},"12104":{"id":"/en/docs/development-design-44","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"Why","locale":"en"},"12105":{"id":"/en/docs/development-design-45","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"A static service locator, `ApiDependencies.invoker`","locale":"en"},"12106":{"id":"/en/docs/development-design-46","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"`app.state.services` plus the FastAPI dependency `ServicesDep`","locale":"en"},"12107":{"id":"/en/docs/development-design-47","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"A route's dependencies are in its signature and tests can pass isolated services; no graph nodes need to share services","locale":"en"},"12108":{"id":"/en/docs/development-design-48","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"Multi-user: JWTs, sliding refresh, socket rooms, per-user redaction","locale":"en"},"12109":{"id":"/en/docs/development-design-49","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"One optional access token (a Bearer header, the `mizuoto_token` cookie or `?token=`), plus a Host check (against DNS rebinding) and an Origin check on state-changing requests; binding to a non-loopback address logs a warning","locale":"en"},"12110":{"id":"/en/docs/development-design-50","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"A single user or a small trusted group running it locally; the complexity pays only for multi-tenant serving","locale":"en"},"12111":{"id":"/en/docs/development-design-51","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"Parsing `/openapi.json` at run time into node templates","locale":"en"},"12112":{"id":"/en/docs/development-design-52","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"Types generated at build time only","locale":"en"},"12113":{"id":"/en/docs/development-design-53","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"No back-end types are extended by users","locale":"en"},"12114":{"id":"/en/docs/development-design-54","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"React, Redux Toolkit, RTK Query","locale":"en"},"12115":{"id":"/en/docs/development-design-55","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"Vue 3, Pinia, TanStack Vue Query, `openapi-fetch`","locale":"en"},"12116":{"id":"/en/docs/development-design-56","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-invokeai-fastapi-plus-a-single-page-app","content":"The skeleton's existing front end","locale":"en"},"12117":{"id":"/en/docs/development-design-57","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#shipping-the-front-end-inside-the-wheel","content":"`mizuoto/webui/` is both the Vue project and a Python package. Vite builds the UI into `mizuoto/webui/dist/`; `dist/` is not committed and goes into the wheel as package data, so after `pip install` users need neither Node nor bun.","locale":"en"},"12118":{"id":"/en/docs/development-design-58","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#shipping-the-front-end-inside-the-wheel","content":"The server finds `dist/` through the package's `__path__` (`web_dist_dir()` in `api/static.py`): one line for a source checkout, an installed wheel and a container. `SPAStaticFiles` is mounted last, so it only receives paths the API, the socket and the docs did not match. Without a build it logs a warning and serves the API only, which is the normal state while working on the back end.","locale":"en"},"12119":{"id":"/en/docs/development-design-59","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#shipping-the-front-end-inside-the-wheel","content":"Unknown paths fall back to `index.html` only for requests that accept `text/html` (client-side routes survive reloads and deep links), so a mistyped asset or API path still gets a 404. Content-hashed files under `assets/` are cached for a year (`immutable`); everything else, `index.html` included, is `no-cache`, so after an upgrade a browser never pairs an old UI with a new back end.","locale":"en"},"12120":{"id":"/en/docs/development-design-60","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#shipping-the-front-end-inside-the-wheel","content":"The build uses `base: './'`, and at run time `api/baseUrl.ts` derives the deployment root from the entry script's URL (everything before the last `/assets/`); routes use hash history. One build works at the root and under an `--api-prefix` sub-path with no rewriting.","locale":"en"},"12121":{"id":"/en/docs/development-design-61","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#shipping-the-front-end-inside-the-wheel","content":"The UI is built before the wheel: `scripts/build_wheels.py` runs `bun install --frozen-lockfile` and `bun run build`, then builds the sdist and the wheel; Docker builds it in a bun stage of its own, and the final image carries no Node toolchain. See Release.","locale":"en"},"12122":{"id":"/en/docs/development-design-62","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#port-selection","content":"The server decides whether a port is free by **binding** it, not by connecting to it (`bind_first_free_port` in `mizuoto/core/net/ports.py`):","locale":"en"},"12123":{"id":"/en/docs/development-design-63","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#port-selection","content":"It creates a listening socket and binds it to the configured host and port; on `EADDRINUSE` or `EACCES` (which covers Windows' excluded port ranges) it tries the next port, up to 20 attempts and never past 65535, and fails with a clear error when none is free. `SO_EXCLUSIVEADDRUSE` on Windows, `SO_REUSEADDR` elsewhere.","locale":"en"},"12124":{"id":"/en/docs/development-design-64","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#port-selection","content":"The bound socket is handed to uvicorn (`server.run(sockets=[sock])`): there is no gap between checking and serving.","locale":"en"},"12125":{"id":"/en/docs/development-design-65","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#port-selection","content":"Strict mode (`server.strict_port`, `--strict-port`) fails instead of moving on, for reverse proxies and containers with fixed port mappings.","locale":"en"},"12126":{"id":"/en/docs/development-design-66","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#port-selection","content":"Other programs learn the actual port: a line `SERVER_READY url=…` on standard output, and `server.json` (host, port, URL, process id) in the data folder, removed on shutdown. `mizuoto runtime` and friends find the running server through it. The front end derives the back end's address from the URL it was loaded from and needs no notice.","locale":"en"},"12127":{"id":"/en/docs/development-design-67","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#the-command-line-typer-registration","content":"The command line follows ani2xcur's Typer layout:","locale":"en"},"12128":{"id":"/en/docs/development-design-68","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#the-command-line-typer-registration","content":"`get_app()` in `mizuoto/cli/app.py` registers every command and group in one function, with names and help given at registration; that file is the command line's table of contents. Command functions (`cli/commands/*.py`) are plain, undecorated functions.","locale":"en"},"12129":{"id":"/en/docs/development-design-69","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#the-command-line-typer-registration","content":"The app is built inside a function, not at import time, so each test gets a fresh one; `EXPECTED_TREE` in `tests/cli/test_cli.py` compares the whole command tree, so a forgotten registration fails.","locale":"en"},"12130":{"id":"/en/docs/development-design-70","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#the-command-line-typer-registration","content":"`typer_factory()` (`cli/factory.py`) gives every app and group the same settings; `DebugOptionTyper`, `DebugTyperCommand` and `AlphabeticalMixedGroup` make `--debug` work at every level and sort the help. The imports of Typer's private `typer._click` live only in that file, and `typer` has an upper bound (`<0.28`).","locale":"en"},"12131":{"id":"/en/docs/development-design-71","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#the-command-line-typer-registration","content":"`main()` handles errors itself: a `MizuotoError` prints its message and `detail[\"hint\"]` and exits with its exit code, Ctrl+C exits 130, anything else prints a traceback and exits 1.","locale":"en"},"12132":{"id":"/en/docs/development-design-72","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#the-command-line-typer-registration","content":"Heavy dependencies are imported inside command functions, so `mizuoto version` loads neither FastAPI nor torch. `python -m mizuoto` equals `mizuoto`.","locale":"en"},"12133":{"id":"/en/docs/development-design-73","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#material-design-3-in-layers","content":"The UI uses Material Design 3 in two layers:","locale":"en"},"12134":{"id":"/en/docs/development-design-74","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#material-design-3-in-layers","content":"**The token layer** (`mizuoto/webui/src/theme/`): colour roles `--md-sys-color-*` are generated by `@material/material-color-utilities`' Tonal Spot scheme from one seed colour (by default `#4f6b3a`), light and dark, at three contrast levels; type, shape, motion and state layers are CSS variables under Google's official names. The UI uses tokens only, never literal colours.","locale":"en"},"12135":{"id":"/en/docs/development-design-75","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#material-design-3-in-layers","content":"**The component layer** (`src/ui/`): the components `@material/web` has (buttons, icon buttons, FAB, checkbox, filter chip, divider, text field, slider, progress, switch, tabs) are wrapped in project Vue components; the rest (shell, navigation, dialogs, sheets, menus, cards, snackbar, stepper, charts, waveforms…) are built from tokens. Feature code imports only from `@/ui`.","locale":"en"},"12136":{"id":"/en/docs/development-design-76","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#material-design-3-in-layers","content":"`@material/web` is in maintenance mode and its component set no longer grows; the wrapper layer keeps that risk inside `src/ui/`, where a component that breaks is replaced without touching feature code. MUI is not used (it implements Material Design 2), nor is M3 Expressive. Icons are Lucide (imported only in `ui/icons.ts`), and the Roboto Flex font ships with the package rather than loading from outside. Details in Web UI.","locale":"en"},"12137":{"id":"/en/docs/development-design-77","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"The model runtime (`mizuoto/runtime/`) follows ComfyUI. ComfyUI is a source of patterns, not a code base adopted: Mizuoto keeps its own services, jobs, API, command line and UI, and code comments name the ComfyUI counterpart of each piece.","locale":"en"},"12138":{"id":"/en/docs/development-design-78","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"From ComfyUI","locale":"en"},"12139":{"id":"/en/docs/development-design-79","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"In Mizuoto","locale":"en"},"12140":{"id":"/en/docs/development-design-80","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"Device and memory management (`model_management.py`): device probes, free memory (driver free plus torch's cached-but-unused), a memory reserve, hardware precision tables, `load_models_gpu` in most-recently-used order, partial loading and dynamic VRAM, unloading every idle model after running out of memory, a pinned-memory budget","locale":"en"},"12141":{"id":"/en/docs/development-design-81","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`runtime/device.py` (`DeviceService`), `runtime/manager.py` (`ModelManager`), `runtime/policy.py`, `runtime/stream.py`, all service objects rather than module globals. See Memory management","locale":"en"},"12142":{"id":"/en/docs/development-design-82","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"The model wrapper (`ModelPatcher`)","locale":"en"},"12143":{"id":"/en/docs/development-design-83","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`ModelHandle` in `runtime/handle.py`, without the diffusion parts: whole or partial placement, weights streamed unit by unit, host copies","locale":"en"},"12144":{"id":"/en/docs/development-design-84","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`ops` injection (`comfy.ops`)","locale":"en"},"12145":{"id":"/en/docs/development-design-85","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`runtime/ops.py`: `ops.default` skips random initialisation (fast construction, no random draws while loading), `ops.cast` casts weights to the input's dtype and device on every forward","locale":"en"},"12146":{"id":"/en/docs/development-design-86","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"Attention selection (one signature, SDPA by default, optional backends imported under guard with fallbacks)","locale":"en"},"12147":{"id":"/en/docs/development-design-87","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`runtime/accel/`: every attention site goes through `accel.attention`, the backend chosen by `compute.attention`, with self-tests, constraint checks and fallbacks. See Attention acceleration","locale":"en"},"12148":{"id":"/en/docs/development-design-88","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"Loading and detection (safetensors or `weights_only` pickles, key renaming)","locale":"en"},"12149":{"id":"/en/docs/development-design-89","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`runtime/loading.py`, strict by default; detection looks at the catalogue's explicit metadata first (sizes and SHA-256), then at each engine's files-only `detect_variant`","locale":"en"},"12150":{"id":"/en/docs/development-design-90","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"In-tree language-model code (Qwen/Llama families without transformers, seeded generators, per-token interrupts)","locale":"en"},"12151":{"id":"/en/docs/development-design-91","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`runtime/lm/` (the Qwen2/3 decoder with transformers' numerics), `runtime/sampling.py`, `runtime/graphs.py`","locale":"en"},"12152":{"id":"/en/docs/development-design-92","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"Audio DSP ported (no torchaudio)","locale":"en"},"12153":{"id":"/en/docs/development-design-93","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"`mizuoto/nn/dsp/`, bit-exact with torchaudio, librosa and Whisper","locale":"en"},"12154":{"id":"/en/docs/development-design-94","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"What was not taken:","locale":"en"},"12155":{"id":"/en/docs/development-design-95","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"**Module-level mutable globals** (the VRAM state, the loaded-models list, the interrupt flag, command-line arguments read deep in the code). Mizuoto has `Services` and settings objects, and passes the device and cancel token explicitly, because a CPU job and a GPU job can run at once.","locale":"en"},"12156":{"id":"/en/docs/development-design-96","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"**Giant files and long `if` chains** (such as model detection matched in order). Each engine has its own detection, configuration and construction in its own package.","locale":"en"},"12157":{"id":"/en/docs/development-design-97","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"**The node graph and the custom-node ecosystem.** A typed engine registry with entry points is enough, and the licence-gated engines register exactly that way.","locale":"en"},"12158":{"id":"/en/docs/development-design-98","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"The diffusion machinery (samplers, hooks, ControlNet), and running language models as text encoders.","locale":"en"},"12159":{"id":"/en/docs/development-design-99","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"**Dependencies on `comfy-aimdo` (a native VRAM allocator) and an exactly pinned `comfy-kitchen`.** Memory management is built on torch's own allocator.","locale":"en"},"12160":{"id":"/en/docs/development-design-100","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#from-comfyui-the-runtime","content":"**Deliberate numerical divergence from reference implementations** (such as a fused RMSNorm by default). Mizuoto keeps the reference maths on the default path; fused variants that change bits are opt-in.","locale":"en"},"12161":{"id":"/en/docs/development-design-101","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#design-decisions","content":"The decisions that shaped the code as it is: what was decided, and why.","locale":"en"},"12162":{"id":"/en/docs/development-design-102","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Decision","locale":"en"},"12163":{"id":"/en/docs/development-design-103","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Reason","locale":"en"},"12164":{"id":"/en/docs/development-design-104","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"One Python environment, every engine ported in-tree and run in the server's own process; no upstream code vendored","locale":"en"},"12165":{"id":"/en/docs/development-design-105","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"The engines' dependency conflicts (transformers 4.51 to 5.3, torch 2.3 and 2.8, numpy 1 and 2) all came from upstream code using library internals and from upstream pins, not from what the models need. Ported, they need one torch and one set of dependencies, and the engine environments, worker processes and inter-process protocol go","locale":"en"},"12166":{"id":"/en/docs/development-design-106","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"The cost of running in process (a crash in native code takes the server down; no memory release by process exit) is paid for by rules","locale":"en"},"12167":{"id":"/en/docs/development-design-107","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Native code changes no global state (tested), requests are checked for residue, unloading really frees memory; an engine can run on a remote agent where process isolation is wanted; training stays in child processes","locale":"en"},"12168":{"id":"/en/docs/development-design-108","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Fish Speech and IndexTTS are distributions of their own (`mizuoto-fishspeech`, `mizuoto-indextts`), installed into the same environment and registered under the entry-point group `mizuoto.engines`","locale":"en"},"12169":{"id":"/en/docs/development-design-109","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Their licences (Fish Audio Research License, bilibili Model Use License) cover the code; a port is a derivative, and folding it into the GPL-3.0 `mizuoto` would conflict","locale":"en"},"12170":{"id":"/en/docs/development-design-110","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Each distribution has its own version and is checked and released on its own; a gated package names the Mizuoto versions it works with (`mizuoto>=0.2.0,<0.3`)","locale":"en"},"12171":{"id":"/en/docs/development-design-111","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"A fix to one engine should not wait for, or force, a release of the others. The range is tested at both ends: on Mizuoto at each commit, and on the oldest release it allows","locale":"en"},"12172":{"id":"/en/docs/development-design-112","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"torch is a dependency, but its build (CUDA, ROCm, XPU, MPS, CPU) is installed by the user first; `mizuoto doctor` prints the command for the machine","locale":"en"},"12173":{"id":"/en/docs/development-design-113","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"The right build depends on the hardware and driver, which no package manager can choose for the user","locale":"en"},"12174":{"id":"/en/docs/development-design-114","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"No transformers, onnxruntime, torchaudio or librosa at run time","locale":"en"},"12175":{"id":"/en/docs/development-design-115","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"They bring version conflicts, platform limits or global state; tokenizers come from `tokenizers`, `tiktoken` and `sentencepiece`, and ONNX models' weights are converted into torch modules by an in-tree protobuf reader","locale":"en"},"12176":{"id":"/en/docs/development-design-116","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Optional extras only where a platform limit requires one: `gptsovits-ja` (`pyopenjtalk==0.4.1`, source only), `gptsovits-ko`, `mizuoto-indextts[ja]`","locale":"en"},"12177":{"id":"/en/docs/development-design-117","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Every required dependency has wheels on every platform CI covers; without an extra, text in that language fails with `capability_not_supported` and the install command","locale":"en"},"12178":{"id":"/en/docs/development-design-118","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Japanese through `pyopenjtalk==0.4.1`, not pyopenjtalk-plus; Simplified → Traditional through the C++ `opencc==1.4.2`; Chinese segmentation through `jieba` instead of `jieba_fast`","locale":"en"},"12179":{"id":"/en/docs/development-design-119","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"pyopenjtalk-plus changes OpenJTalk's rules (18 % of Japanese sentences differ) and the pure-Python OpenCC gives other results; `jieba` has `jieba_fast`'s dictionary and results, in pure Python","locale":"en"},"12180":{"id":"/en/docs/development-design-120","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"The optional attention packages (flash-attn, xFormers, SageAttention) are backends only, with version checks, self-tests and fallbacks, never dependencies","locale":"en"},"12181":{"id":"/en/docs/development-design-121","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"They support only some platforms; the default path must work everywhere with unchanged results","locale":"en"},"12182":{"id":"/en/docs/development-design-122","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"One Docker image holds the server, the UI and every engine; the licence-gated engines come with `GATED=1`","locale":"en"},"12183":{"id":"/en/docs/development-design-123","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#environment-and-distribution","content":"Users choose only torch's build; the licences are still accepted at run time","locale":"en"},"12184":{"id":"/en/docs/development-design-124","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Decision","locale":"en"},"12185":{"id":"/en/docs/development-design-125","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Reason","locale":"en"},"12186":{"id":"/en/docs/development-design-126","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Each port matches its reference sample for sample (CPU, fp32, same seed); the reference is how Mizuoto 0.1 actually called upstream, not upstream's demos","locale":"en"},"12187":{"id":"/en/docs/development-design-127","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"A user's output should not change because the implementation did; where 0.1 differed from upstream on purpose (F5-TTS generating chunks in order rather than on a thread pool), 0.1 is the reference","locale":"en"},"12188":{"id":"/en/docs/development-design-128","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Upstream's quirks are reproduced first and fixes land as separate changes; even quirks of no product value are reproduced (IndexTTS-1.5 using no KV cache below fp16)","locale":"en"},"12189":{"id":"/en/docs/development-design-129","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Mixing fixes with porting makes a parity failure ambiguous; identical behaviour is the default, and a deviation needs a reason and a record","locale":"en"},"12190":{"id":"/en/docs/development-design-130","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Trainers reproduce upstream's recipes, including their training/inference mismatches (Qwen3-TTS's training skips `text_projection`; Fish Speech's training does not scale the codebook embeddings by 1/√11)","locale":"en"},"12191":{"id":"/en/docs/development-design-131","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Losses, learning rates and exported weights then match upstream byte for byte, and the exports load in both implementations","locale":"en"},"12192":{"id":"/en/docs/development-design-132","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"CosyVoice is compared with its reference running on torch 2.8","locale":"en"},"12193":{"id":"/en/docs/development-design-133","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"On its own torch 2.3.1 and on 2.8, sampling already diverges","locale":"en"},"12194":{"id":"/en/docs/development-design-134","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Speech recognition is a native Whisper large-v3-turbo reproducing 0.1's pipeline (overlapping 30 s windows, 5-beam search, the seek loop inside each window, the merge)","locale":"en"},"12195":{"id":"/en/docs/development-design-135","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Identical transcripts, without CTranslate2's and cuDNN's version pairing","locale":"en"},"12196":{"id":"/en/docs/development-design-136","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"The Whisper encoder lives in the ASR engine and is not shared with CosyVoice's speech tokenizers","locale":"en"},"12197":{"id":"/en/docs/development-design-137","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"s3tokenizer's attention (its scaling, its masks) is another computation","locale":"en"},"12198":{"id":"/en/docs/development-design-138","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"CosyVoice's and IndexTTS's CAM++ are not merged into one shared asset; nor is the Qwen emotion model in IndexTTS 2's and 2.5's folders","locale":"en"},"12199":{"id":"/en/docs/development-design-139","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Merging would make CosyVoice need a gated engine's licence; the emotion model lives inside each model's repository folder, and sharing it would mean moving installed models' files","locale":"en"},"12200":{"id":"/en/docs/development-design-140","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"The catalogue downloads only files the engines read","locale":"en"},"12201":{"id":"/en/docs/development-design-141","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"E.g. CosyVoice-BlankEN's weights and the semantic codec IndexTTS-2.5 never reads only took space","locale":"en"},"12202":{"id":"/en/docs/development-design-142","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"GPT-SoVITS runs the plain T2S with its steps replayed as CUDA graphs, not upstream's CUDA-graph T2S","locale":"en"},"12203":{"id":"/en/docs/development-design-143","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Upstream's accelerated path changes results; replaying the eager kernels does not","locale":"en"},"12204":{"id":"/en/docs/development-design-144","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"VoxCPM's text normalisation uses wetext 0.1.2's own FSTs, shipped with the package","locale":"en"},"12205":{"id":"/en/docs/development-design-145","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Upstream pins wetext 0.1.2, whose FSTs differ from both CosyVoice's and IndexTTS's","locale":"en"},"12206":{"id":"/en/docs/development-design-146","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"VoxCPM's reference is upstream's own package","locale":"en"},"12207":{"id":"/en/docs/development-design-147","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Mizuoto 0.1 never had VoxCPM","locale":"en"},"12208":{"id":"/en/docs/development-design-148","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Capabilities are static (Qwen3-TTS 0.6B CustomVoice is its own variant `custom_voice_lite`, without `instruct`)","locale":"en"},"12209":{"id":"/en/docs/development-design-149","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"Capabilities must be known before a model loads, for planning and the UI","locale":"en"},"12210":{"id":"/en/docs/development-design-150","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"OmniVoice designs voices from attributes only","locale":"en"},"12211":{"id":"/en/docs/development-design-151","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"The model takes a closed attribute vocabulary","locale":"en"},"12212":{"id":"/en/docs/development-design-152","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"No ZipEnhancer denoising, timestamps or CUDA `optimize` for VoxCPM; no Fish Speech S2 Pro int8 in the catalogue","locale":"en"},"12213":{"id":"/en/docs/development-design-153","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"The former need another model and a ModelScope pipeline, and are all off in upstream's default generation; there is no public int8 repository","locale":"en"},"12214":{"id":"/en/docs/development-design-154","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"F5-TTS's licence is recorded as `cc-by-nc-4.0`, not gated, with tagged outputs","locale":"en"},"12215":{"id":"/en/docs/development-design-155","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#engines-and-exactness","content":"That is the weights' licence; the non-commercial term is conveyed by tags and a notice","locale":"en"},"12216":{"id":"/en/docs/development-design-156","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Decision","locale":"en"},"12217":{"id":"/en/docs/development-design-157","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Reason","locale":"en"},"12218":{"id":"/en/docs/development-design-158","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"No estimate refuses a load: what does not fit loads partly and streams, at the minimum if need be; only an allocation that really fails is an error, after which every GPU's idle models are unloaded","locale":"en"},"12219":{"id":"/en/docs/development-design-159","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"As ComfyUI does; estimates come from file sizes, and refusing would block requests that fit","locale":"en"},"12220":{"id":"/en/docs/development-design-160","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Weights stream through forward hooks on units and layers that swap `param.data`, not through code in the `ops` layers","locale":"en"},"12221":{"id":"/en/docs/development-design-161","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"It covers every code path (`layer.forward_step`, `vae.decode`, custom layers), and costs nothing while a model is whole on its device","locale":"en"},"12222":{"id":"/en/docs/development-design-162","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Only linear and convolution weights stream, never embeddings","locale":"en"},"12223":{"id":"/en/docs/development-design-163","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Codebook embeddings are often read through `.weight` directly (cosine searches, `F.embedding`); ComfyUI likewise streams only its ops layers","locale":"en"},"12224":{"id":"/en/docs/development-design-164","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"GPT-SoVITS's T2S stays whole on its device","locale":"en"},"12225":{"id":"/en/docs/development-design-165","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Its blocks run through `prompt` / `step`, which read the fused projections directly; the model is 150 MB","locale":"en"},"12226":{"id":"/en/docs/development-design-166","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Tiled decoding as an out-of-memory fallback only for some decoders (ASR, GPT-SoVITS, F5-TTS's Vocos, Fish Speech's codec, IndexTTS 2's BigVGAN, OmniVoice's audio tokenizer, VoxCPM's VAE)","locale":"en"},"12227":{"id":"/en/docs/development-design-167","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Qwen3-TTS's codec already decodes in chunks; CosyVoice's HiFT carries a phase across the whole utterance that tiles would break; the rest are short","locale":"en"},"12228":{"id":"/en/docs/development-design-168","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"When a training run's estimated memory exceeds the free memory, the log warns with the preset that would fit; the run is not refused","locale":"en"},"12229":{"id":"/en/docs/development-design-169","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"The estimate is calibrated on one GPU (RTX 3090) per method and preset at the recipe's default batch; data and other GPUs move it","locale":"en"},"12230":{"id":"/en/docs/development-design-170","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"The training memory tools offer what keeps results and a few things that change them slightly; no Adafactor, no splitting micro-batches on out-of-memory","locale":"en"},"12231":{"id":"/en/docs/development-design-171","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Those change the recipes beyond what the presets promise","locale":"en"},"12232":{"id":"/en/docs/development-design-172","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"`compute.max_resident_models` caps resident models across engines (default 3), the least recently used idle model going first","locale":"en"},"12233":{"id":"/en/docs/development-design-173","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Every engine's models share one process and its memory","locale":"en"},"12234":{"id":"/en/docs/development-design-174","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"The host probes devices without importing torch: nvidia-smi, rocm-smi / amd-smi and the platform first, a child process only when torch's build could see a GPU the tools missed","locale":"en"},"12235":{"id":"/en/docs/development-design-175","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Listing devices or serving the UI should not pay a torch import of a second or two","locale":"en"},"12236":{"id":"/en/docs/development-design-176","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"CUDA graphs are on by default; `torch.compile` is off by default","locale":"en"},"12237":{"id":"/en/docs/development-design-177","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"CUDA graphs replay the same kernels with the same results; compiling changes floating-point results and costs the first request its compilation","locale":"en"},"12238":{"id":"/en/docs/development-design-178","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Attention's `causal` is SDPA's `is_causal` (top-left); bottom-right causality is expressed through `MaskInfo`; dropout draws from torch's default generator","locale":"en"},"12239":{"id":"/en/docs/development-design-179","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Every site passes `is_causal` as upstream did, and CosyVoice's streamed-text steps rely on the top-left form; the only site with dropout (GPT-SoVITS's T2S training) calls SDPA's own","locale":"en"},"12240":{"id":"/en/docs/development-design-180","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"The attention policy is bound per request step for inference, and process-wide for a training stage","locale":"en"},"12241":{"id":"/en/docs/development-design-181","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"Autograd runs backward passes, and checkpointed recomputations, on threads of its own","locale":"en"},"12242":{"id":"/en/docs/development-design-182","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"External attention kernels are called directly, not wrapped as Mizuoto's own `torch.library` custom ops","locale":"en"},"12243":{"id":"/en/docs/development-design-183","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#runtime-and-memory","content":"flash-attn and xFormers register their own operators and backward passes; SageAttention has no backward and is never used under autograd","locale":"en"},"12244":{"id":"/en/docs/development-design-184","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Decision","locale":"en"},"12245":{"id":"/en/docs/development-design-185","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Reason","locale":"en"},"12246":{"id":"/en/docs/development-design-186","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Named resources with capacities (`gpu:<device>`, `engine:<engine>:<device>`, `inference`, `cpu`, `io`, `project:<id>`) rather than one global GPU lock","locale":"en"},"12247":{"id":"/en/docs/development-design-187","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Serialising per engine and per device covers inference and training alike, and work on different devices runs in parallel","locale":"en"},"12248":{"id":"/en/docs/development-design-188","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A training run is one `train` job whose steps are its stages, each stage a child process; the stages are declared statically in the manifest","locale":"en"},"12249":{"id":"/en/docs/development-design-189","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"The run holds the device once; the UI and the fingerprints know the stages without running anything","locale":"en"},"12250":{"id":"/en/docs/development-design-190","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Any output line of a job worker resets its watchdog, and a training stage also beats every 10 s","locale":"en"},"12251":{"id":"/en/docs/development-design-191","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A stage that logs is evidently alive; a silent one still beats","locale":"en"},"12252":{"id":"/en/docs/development-design-192","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Only requests that differ in nothing but their text, with one segment and no seed, join a micro-batch","locale":"en"},"12253":{"id":"/en/docs/development-design-193","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A batch draws its random numbers differently; voices and parameters are per call","locale":"en"},"12254":{"id":"/en/docs/development-design-194","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A project's lines render as ordinary speak jobs; takes are outputs of kind `line`, stale by request fingerprint","locale":"en"},"12255":{"id":"/en/docs/development-design-195","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"One synthesis path serves every feature, so micro-batching and every engine come for free","locale":"en"},"12256":{"id":"/en/docs/development-design-196","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A remote agent owns its models and engines; requests carry files by content (SHA-256); training stays local","locale":"en"},"12257":{"id":"/en/docs/development-design-197","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A path on one machine means nothing on another","locale":"en"},"12258":{"id":"/en/docs/development-design-198","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"The model mirror (`mizuoto-model`) is a source in front of the official ones, laid out as Mizuoto keeps files","locale":"en"},"12259":{"id":"/en/docs/development-design-199","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A partial mirror works: what it lacks comes from the official repositories file by file, checked against the same SHA-256","locale":"en"},"12260":{"id":"/en/docs/development-design-200","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Accepting a licence is also required to download the weights and assets; the full text ships with the package and the command line can show it","locale":"en"},"12261":{"id":"/en/docs/development-design-201","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"The licences cover the weights; a reader must have the text in front of them before accepting","locale":"en"},"12262":{"id":"/en/docs/development-design-202","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Voices, models, datasets, experiments and projects are folders with JSON; listing is a scan; the database holds only what is queried","locale":"en"},"12263":{"id":"/en/docs/development-design-203","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"The folders are the truth, and a scan cannot drift from the files; hundreds of voices scan in milliseconds","locale":"en"},"12264":{"id":"/en/docs/development-design-204","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Engines get references as `cache/refs/<sha256>.wav` (16-bit WAV); voices store FLAC","locale":"en"},"12265":{"id":"/en/docs/development-design-205","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Every engine reads 16-bit WAV; registering by content avoids duplicates","locale":"en"},"12266":{"id":"/en/docs/development-design-206","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A missing transcript is looked up in the cache while planning, else transcribed in the job; without ASR, `clone_no_transcript` or an error with a hint","locale":"en"},"12267":{"id":"/en/docs/development-design-207","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Planning should not wait on a model, but the result must be usable","locale":"en"},"12268":{"id":"/en/docs/development-design-208","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"`mizuoto doctor [engine]` checks in one place the torch build against the hardware, what each engine misses, extras and 0.1's old environments","locale":"en"},"12269":{"id":"/en/docs/development-design-209","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Everything between the machine and the engines is said in one place","locale":"en"},"12270":{"id":"/en/docs/development-design-210","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"`mizuoto runtime` asks the running server (`server.json`) first, and reports its own process only when there is none","locale":"en"},"12271":{"id":"/en/docs/development-design-211","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A command-line process has no models loaded; the server does","locale":"en"},"12272":{"id":"/en/docs/development-design-212","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Reading server paths, revealing files and the like work only for a browser on the server's own machine","locale":"en"},"12273":{"id":"/en/docs/development-design-213","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A tunnel's or proxy's visitors must not browse the server's disk","locale":"en"},"12274":{"id":"/en/docs/development-design-214","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Streamed audio's binary messages are bare PCM16 and everything else is JSON text; the browser player has no buffer cap","locale":"en"},"12275":{"id":"/en/docs/development-design-215","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A binary message is always audio; when the model falls behind the player waits instead of dropping speech","locale":"en"},"12276":{"id":"/en/docs/development-design-216","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"The OpenAPI schema is generated without `separate_input_output_schemas=False`","locale":"en"},"12277":{"id":"/en/docs/development-design-217","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"With it, every defaulted response field would become optional in the generated types; the split it avoids only touches `SpeakRequest`","locale":"en"},"12278":{"id":"/en/docs/development-design-218","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"The error codes `download_failed` (exit 12) and `install_failed` (13)","locale":"en"},"12279":{"id":"/en/docs/development-design-219","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"Each needs its own hint and exit code","locale":"en"},"12280":{"id":"/en/docs/development-design-220","page_id":"/en/docs/development-design","tags":[],"type":"text","url":"/en/docs/development-design#jobs-interfaces-and-data","content":"A name cannot be both a command and a group: `mizuoto env vars`; parameter presets are `--use-preset/-P`, since `--preset` is the preset speaker","locale":