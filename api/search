e":"en"},"10735":{"id":"/en/docs/development-acceleration-53","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#what-changes-results","content":"identical on the CPU; see Memory","locale":"en"},"10736":{"id":"/en/docs/development-acceleration-54","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#what-changes-results","content":"Native code never changes process-wide state: no `torch.backends` assignments, no `sdpa_kernel` (it switches SDPA's kernels for every thread), no global seeding. `runtime/accel/features.py` is the one exemption, called by the host and by a training stage (an architecture test enforces both).","locale":"en"},"10737":{"id":"/en/docs/development-acceleration-55","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"Every attention computation in `runtime`, `nn`, the engines, the trainers and the gated packages goes through one entry point, after ComfyUI's attention backends and `comfy_kitchen`'s registry:","locale":"en"},"10738":{"id":"/en/docs/development-acceleration-56","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`q`, `k`, `v` are `(batch, heads, length, head_dim)`; `mask` is boolean (True attends) or additive, broadcastable to `(batch, heads, q_length, k_length)`.","locale":"en"},"10739":{"id":"/en/docs/development-acceleration-57","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`causal` is SDPA's `is_causal`: aligned top-left. Sites pass it as upstream passed `is_causal` (CosyVoice's streamed-text steps feed several tokens over a cache with it). Bottom-right causality, a KV cache's, comes through `mask_info`.","locale":"en"},"10740":{"id":"/en/docs/development-acceleration-58","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"An architecture test forbids `F.scaled_dot_product_attention` and its aten kernels anywhere outside `runtime/accel/`.","locale":"en"},"10741":{"id":"/en/docs/development-acceleration-59","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"Code","locale":"en"},"10742":{"id":"/en/docs/development-acceleration-60","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"Role","locale":"en"},"10743":{"id":"/en/docs/development-acceleration-61","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/dispatch.py`","locale":"en"},"10744":{"id":"/en/docs/development-acceleration-62","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`attention`, `Site`, `MaskInfo`, `Masked`; the reference forms `sdpa`, `math_kernel`, `softmax_attention`","locale":"en"},"10745":{"id":"/en/docs/development-acceleration-63","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/registry.py`","locale":"en"},"10746":{"id":"/en/docs/development-acceleration-64","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`Backend`, `Constraints`, `Call`, the registry and its per-device probes","locale":"en"},"10747":{"id":"/en/docs/development-acceleration-65","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/policy.py`","locale":"en"},"10748":{"id":"/en/docs/development-acceleration-66","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`AccelPolicy` (the chain, resolution, fallbacks), `Run` (what a request used), `bind`, `policy_for`","locale":"en"},"10749":{"id":"/en/docs/development-acceleration-67","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/backends/torch_sdpa.py`","locale":"en"},"10750":{"id":"/en/docs/development-acceleration-68","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`sdpa`, `math`, `sdpa_flash`, `sdpa_efficient`, `sdpa_cudnn`","locale":"en"},"10751":{"id":"/en/docs/development-acceleration-69","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/backends/optional.py`","locale":"en"},"10752":{"id":"/en/docs/development-acceleration-70","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`flash`, `xformers`, `sage`, `sage3`: guarded imports, probes, self-tests","locale":"en"},"10753":{"id":"/en/docs/development-acceleration-71","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/features.py`","locale":"en"},"10754":{"id":"/en/docs/development-acceleration-72","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`compute.fast`","locale":"en"},"10755":{"id":"/en/docs/development-acceleration-73","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/__main__.py`","locale":"en"},"10756":{"id":"/en/docs/development-acceleration-74","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`python -m mizuoto.runtime.accel`: each backend on each device, as JSON","locale":"en"},"10757":{"id":"/en/docs/development-acceleration-75","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`core/compute/accel.py`","locale":"en"},"10758":{"id":"/en/docs/development-acceleration-76","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"Installed packages from their metadata and install commands that keep torch (standard library only)","locale":"en"},"10759":{"id":"/en/docs/development-acceleration-77","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"A `Site` names one computation and holds its **reference**: exactly what upstream computed there, with the same arguments. Mizuoto declares 19, the dummy engine's included.","locale":"en"},"10760":{"id":"/en/docs/development-acceleration-78","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"Reference","locale":"en"},"10761":{"id":"/en/docs/development-acceleration-79","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"Sites","locale":"en"},"10762":{"id":"/en/docs/development-acceleration-80","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"`sdpa`: SDPA with the call's arguments (the default)","locale":"en"},"10763":{"id":"/en/docs/development-acceleration-81","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"most: the Qwen decoder (`qwen`), F5-TTS's DiT, the CosyVoice U-Net and v3 DiT, Seed-VC, HuBERT, BERT, Whisper, GPT-SoVITS's T2S and v4/v5 DiT, Qwen3-TTS's Mimi encoder, VoxCPM's MiniCPM, Fish Speech's prefill and codec, IndexTTS's GPT-2","locale":"en"},"10764":{"id":"/en/docs/development-acceleration-82","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"`math_kernel`: SDPA's math kernel called directly","locale":"en"},"10765":{"id":"/en/docs/development-acceleration-83","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"Fish Speech's decode steps (`fishspeech.step`)","locale":"en"},"10766":{"id":"/en/docs/development-acceleration-84","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"a hand-written softmax","locale":"en"},"10767":{"id":"/en/docs/development-acceleration-85","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"Fish Speech's fast transformer (`fishspeech.fast`), IndexTTS's perceiver (`indextts.perceiver`)","locale":"en"},"10768":{"id":"/en/docs/development-acceleration-86","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#sites-and-their-references","content":"The attentions that add relative positions inside the scores, or need the probability matrix, are not sites: wenet's relative attention, IndexTTS's Conformer, w2v-BERT, VITS, plus the s3tokenizer (q and k each scaled by d^-¼), MelStyle and G2PW's BERT. They stay hand-written, since no fused kernel computes them. `Site(swappable=False)` keeps a site on its reference whatever the policy; `approx_ok=False` refuses every backend that is not exact.","locale":"en"},"10769":{"id":"/en/docs/development-acceleration-87","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"Setting","locale":"en"},"10770":{"id":"/en/docs/development-acceleration-88","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"Values","locale":"en"},"10771":{"id":"/en/docs/development-acceleration-89","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"Default","locale":"en"},"10772":{"id":"/en/docs/development-acceleration-90","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`compute.attention`","locale":"en"},"10773":{"id":"/en/docs/development-acceleration-91","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`auto`, `fast`, `sdpa`, `math`, `sdpa_flash`, `sdpa_efficient`, `sdpa_cudnn`, `flash`, `xformers`, `sage`, `sage3`","locale":"en"},"10774":{"id":"/en/docs/development-acceleration-92","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`auto`","locale":"en"},"10775":{"id":"/en/docs/development-acceleration-93","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`engines.<id>.attention`","locale":"en"},"10776":{"id":"/en/docs/development-acceleration-94","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"the same, or `inherit`","locale":"en"},"10777":{"id":"/en/docs/development-acceleration-95","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`inherit`","locale":"en"},"10778":{"id":"/en/docs/development-acceleration-96","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`training.attention`","locale":"en"},"10779":{"id":"/en/docs/development-acceleration-97","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"the backends with a backward pass (not `sage`, `sage3`)","locale":"en"},"10780":{"id":"/en/docs/development-acceleration-98","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`auto`","locale":"en"},"10781":{"id":"/en/docs/development-acceleration-99","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"`compute.attention_strict`","locale":"en"},"10782":{"id":"/en/docs/development-acceleration-100","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"a named backend that cannot take a call raises `compute_unavailable` instead of falling back","locale":"en"},"10783":{"id":"/en/docs/development-acceleration-101","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"off","locale":"en"},"10784":{"id":"/en/docs/development-acceleration-102","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"**`auto` binds nothing**: `attention()` reads one context variable, finds no policy and calls the site's reference (about 1 µs a call).","locale":"en"},"10785":{"id":"/en/docs/development-acceleration-103","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"Otherwise the model's `AccelPolicy` is resolved when it loads (`policy_for(name, strict)`: one per value, so models share resolutions) and reported as `LoadedModelInfo.attention`. `LocalHandle` binds it for each step of a request with `RequestContext.accel` (the context variable lives in `runtime/context.py`, so binding loads no torch), so a stream suspended between steps never leaks its policy to another thread.","locale":"en"},"10786":{"id":"/en/docs/development-acceleration-104","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"A training stage binds its policy process-wide (`dispatch.PROCESS_POLICY`), because autograd runs backward passes, and gradient checkpointing's recomputed forwards, on threads of its own.","locale":"en"},"10787":{"id":"/en/docs/development-acceleration-105","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#policies","content":"A change applies to models loaded afterwards; a change to `engines.<id>.attention` unloads that engine.","locale":"en"},"10788":{"id":"/en/docs/development-acceleration-106","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"Backend","locale":"en"},"10789":{"id":"/en/docs/development-acceleration-107","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"Source","locale":"en"},"10790":{"id":"/en/docs/development-acceleration-108","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"Devices","locale":"en"},"10791":{"id":"/en/docs/development-acceleration-109","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"dtypes","locale":"en"},"10792":{"id":"/en/docs/development-acceleration-110","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"Masks","locale":"en"},"10793":{"id":"/en/docs/development-acceleration-111","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"Backward","locale":"en"},"10794":{"id":"/en/docs/development-acceleration-112","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"`sdpa`","locale":"en"},"10795":{"id":"/en/docs/development-acceleration-113","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"`F.scaled_dot_product_attention`","locale":"en"},"10796":{"id":"/en/docs/development-acceleration-114","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"all","locale":"en"},"10797":{"id":"/en/docs/development-acceleration-115","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"all","locale":"en"},"10798":{"id":"/en/docs/development-acceleration-116","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"bool, additive","locale":"en"},"10799":{"id":"/en/docs/development-acceleration-117","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#backends-and-the-chain","content":"yes, with dropout","locale":"en"},"10800":{"id":"/en/docs/development-acceleration-118","page_id":"/en/docs/development-accel