cale":"en"},"16267":{"id":"/en/docs/guide-projects-145","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#deleting","content":"**Delete** at the bottom of the page moves the project and all its takes to the trash.","locale":"en"},"16268":{"id":"/en/docs/guide-projects-146","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Command","locale":"en"},"16269":{"id":"/en/docs/guide-projects-147","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"What it does","locale":"en"},"16270":{"id":"/en/docs/guide-projects-148","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project new <name> [-m model] [--voice voice \\| --preset speaker] [-l lang] [--script file] [--split line\\|sentence]`","locale":"en"},"16271":{"id":"/en/docs/guide-projects-149","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Create a project, with a narrator and optionally a script","locale":"en"},"16272":{"id":"/en/docs/guide-projects-150","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project import <project> <script> [--split …] [--replace] [--chapter chapter-id]`","locale":"en"},"16273":{"id":"/en/docs/guide-projects-151","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Import a script (append, replace, or into a chapter)","locale":"en"},"16274":{"id":"/en/docs/guide-projects-152","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project cast <project> <speaker-id> [--name] [-m] [-v] [--preset] [-l] [--instruct] [-p name=value] [-O name=value] [--remove]`","locale":"en"},"16275":