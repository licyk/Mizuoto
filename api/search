:"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"The bun executable copied into the `web` stage","locale":"en"},"8877":{"id":"/en/docs/advanced-docker-18","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"`web`","locale":"en"},"8878":{"id":"/en/docs/advanced-docker-19","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"`node:24-bookworm-slim`","locale":"en"},"8879":{"id":"/en/docs/advanced-docker-20","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"bun installs the locked dependencies; Node.js runs type checking and the web UI build (`mizuoto/webui/dist`)","locale":"en"},"8880":{"id":"/en/docs/advanced-docker-21","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"`wheels`","locale":"en"},"8881":{"id":"/en/docs/advanced-docker-22","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"`python:<PYTHON>-slim`","locale":"en"},"8882":{"id":"/en/docs/advanced-docker-23","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"Mizuoto's wheel, built by `scripts/build_wheels.py`, the Fish Speech and IndexTTS wheels with `GATED=1`, and a pyopenjtalk wheel compiled for GPT-SoVITS's Japanese front end","locale":"en"},"8883":{"id":"/en/docs/advanced-docker-24","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"(final)","locale":"en"},"8884":{"id":"/en/docs/advanced-docker-25","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"`python:<PYTHON>-slim`","locale":"en"},"8885":{"id":"/en/docs/advanced-docker-26","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"torch from `TORCH_INDEX`, then the wheels with every optional front end; runs `mizuoto webui`","locale":"en"},"8886":{"id":"/en/docs/advanced-docker-27","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#stages","content":"The `web` stage installs dependencies with `bun install --frozen-lockfile`, then runs `vue-tsc --noEmit && vite build` through `npm run build`. `vue-tsc` needs real Node.js: in a Bun-only image, the fallback `node` command runs Bun, which can leave Vue component props and exported types unrecognised. Node.js and bun are used only during the build and do not enter the final Python image.","locale":"en"},"8887":{"id":"/en/docs/advanced-docker-28","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"Argument","locale":"en"},"8888":{"id":"/en/docs/advanced-docker-29","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"Default","locale":"en"},"8889":{"id":"/en/docs/advanced-docker-30","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"Effect","locale":"en"},"8890":{"id":"/en/docs/advanced-docker-31","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`TORCH_INDEX`","locale":"en"},"8891":{"id":"/en/docs/advanced-docker-32","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`https://download.pytorch.org/whl/cu128`","locale":"en"},"8892":{"id":"/en/docs/advanced-docker-33","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"Where torch comes from, hence its build: another CUDA (`cu126` … `cu132`), ROCm (`rocm6.4` … `rocm7.2`) or `cpu` index of download.pytorch.org","locale":"en"},"8893":{"id":"/en/docs/advanced-docker-34","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`TORCH`","locale":"en"},"8894":{"id":"/en/docs/advanced-docker-35","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`torch>=2.8`","locale":"en"},"8895":{"id":"/en/docs/advanced-docker-36","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"The torch requirement, such as `torch==2.8.0`","locale":"en"},"8896":{"id":"/en/docs/advanced-docker-37","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`GATED`","locale":"en"},"8897":{"id":"/en/docs/advanced-docker-38","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`0`","locale":"en"},"8898":{"id":"/en/docs/advanced-docker-39","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`1`: add Fish Speech and IndexTTS (with IndexTTS-2.5's Japanese)","locale":"en"},"8899":{"id":"/en/docs/advanced-docker-40","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`PYTHON`","locale":"en"},"8900":{"id":"/en/docs/advanced-docker-41","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"`3.11`","locale":"en"},"8901":{"id":"/en/docs/advanced-docker-42","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"The Python of the image (`python:<version>-slim`)","locale":"en"},"8902":{"id":"/en/docs/advanced-docker-43","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#build-arguments","content":"No GPU is visible while an image builds, so the torch build is named by its index rather than chosen from the driver. The default CUDA 12.8 build needs NVIDIA driver 570 or newer.","locale":"en"},"8903":{"id":"/en/docs/advanced-docker-44","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"No system packages: torch, PyAV and the text libraries ship their native code in their wheels.","locale":"en"},"8904":{"id":"/en/docs/advanced-docker-45","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"torch, then Mizuoto with `mizuoto[gptsovits-ja,gptsovits-ko]` (and `mizuoto-indextts[ja]` with `GATED=1`); the rest of the dependencies come from PyPI while the image builds.","locale":"en"},"8905":{"id":"/en/docs/advanced-docker-46","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"No C compiler, so **Compile models (torch.compile)** runs the engines as before, with one warning.","locale":"en"},"8906":{"id":"/en/docs/advanced-docker-47","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"With `ACCEL=1`, the optional attention packages that install without a compiler: xFormers at the release `mizuoto doctor` names for the image's torch (none for a CPU build), and SageAttention 1.0.6 on CUDA builds. FlashAttention is not included: it compiles for a long time unless a wheel matches the torch, and its only wheel for torch 2.8 stops xFormers 0.0.32 from importing. Choose them under Settings › Compute › Acceleration.","locale":"en"},"8907":{"id":"/en/docs/advanced-docker-48","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"Environment variables:","locale":"en"},"8908":{"id":"/en/docs/advanced-docker-49","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"Variable","locale":"en"},"8909":{"id":"/en/docs/advanced-docker-50","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"Value","locale":"en"},"8910":{"id":"/en/docs/advanced-docker-51","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"Effect","locale":"en"},"8911":{"id":"/en/docs/advanced-docker-52","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"`MIZUOTO_DATA_DIR`","locale":"en"},"8912":{"id":"/en/docs/advanced-docker-53","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"`/data`","locale":"en"},"8913":{"id":"/en/docs/advanced-docker-54","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"The data folder","locale":"en"},"8914":{"id":"/en/docs/advanced-docker-55","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"`MIZUOTO_SERVER__OPEN_BROWSER`","locale":"en"},"8915":{"id":"/en/docs/advanced-docker-56","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"`false`","locale":"en"},"8916":{"id":"/en/docs/advanced-docker-57","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"No browser is opened","locale":"en"},"8917":{"id":"/en/docs/advanced-docker-58","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"`PYTHONUNBUFFERED`","locale":"en"},"8918":{"id":"/en/docs/advanced-docker-59","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"`1`","locale":"en"},"8919":{"id":"/en/docs/advanced-docker-60","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"Logs reach `docker logs` at once","locale":"en"},"8920":{"id":"/en/docs/advanced-docker-61","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"`VOLUME /data`, `EXPOSE 7869`.","locale":"en"},"8921":{"id":"/en/docs/advanced-docker-62","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"A health check every 30 s on `http://127.0.0.1:7869/api/v1/app/health` (which needs no token).","locale":"en"},"8922":{"id":"/en/docs/advanced-docker-63","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#what-the-image-contains","content":"The command: `mizuoto webui --host 0.0.0.0 --port 7869 --no-open`.","locale":"en"},"8923":{"id":"/en/docs/advanced-docker-64","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#running","content":"Then open `http://<host address>:7869`; the web UI asks for the **Access token** once.","locale":"en"},"8924":{"id":"/en/docs/advanced-docker-65","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#running","content":"`--gpus all` needs the NVIDIA driver and the NVIDIA Container Toolkit on the host. Without `--gpus` the engines run on the CPU.","locale":"en"},"8925":{"id":"/en/docs/advanced-docker-66","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#running","content":"One GPU only: `--gpus '\"device=1\"'`.","locale":"en"},"8926":{"id":"/en/docs/advanced-docker-67","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#running","content":"`docker exec -it mizuoto mizuoto doctor` checks the image's torch against the GPUs the container sees.","locale":"en"},"8927":{"id":"/en/docs/advanced-docker-68","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#running","content":"The server in the container binds `0.0.0.0`, where Mizuoto no longer checks the `Host` header: anyone who reaches the port can do everything (download models, delete files). Set a token with `MIZUOTO_SERVER__ACCESS_TOKEN`, or publish the port on this machine only: `-p 127.0.0.1:7869:7869`.","locale":"en"},"8928":{"id":"/en/docs/advanced-docker-69","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#volumes","content":"Everything Mizuoto writes is in `/data`: `settings.toml`, the database, models, shared files, voices, outputs, datasets, experiments, projects, caches and logs. The image itself holds no state, so a rebuilt image keeps working on the same volume.","locale":"en"},"8929":{"id":"/en/docs/advanced-docker-70","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#settings-and-environment-variables","content":"Any setting can come from a `MIZUOTO_<GROUP>__<FIELD>` variable (see Configuration and environment variables). Such values live in memory only, are never written to `/data/settings.toml`, and show as **Set by an environment variable** in the web UI:","locale":"en"},"8930":{"id":"/en/docs/advanced-docker-71","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#settings-and-environment-variables","content":"`HF_TOKEN` is sent to huggingface.co only (see Model downloads).","locale":"en"},"8931":{"id":"/en/docs/advanced-docker-72","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#the-command-line-in-the-container","content":"The image's environment variables apply to `docker exec` too, so commands work on the same data folder:","locale":"en"},"8932":{"id":"/en/docs/advanced-docker-73","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#licence-gated-engines","content":"Fish Speech and IndexTTS are in the image only when it was built with `--build-arg GATED=1`; otherwise their cards say **Not available** (`mizuoto-fishspeech` or `mizuoto-indextts` missing). Even then, their licence must be accepted before downloading their models or speaking:","locale":"en"},"8933":{"id":"/en/docs/advanced-docker-74","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#licence-gated-engines","content":"Or click **Accept the licence** in the web UI's **Models** › **Engines**.","locale":"en"},"8934":{"id":"/en/docs/advanced-docker-75","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#an-agent-in-a-container","content":"A GPU machine can serve as a remote host from the same image, running `mizuoto agent` instead of the web UI:","locale":"en"},"8935":{"id":"/en/docs/advanced-docker-76","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#an-agent-in-a-container","content":"The agent has its own volume and models; build its image like the host's (same Mizuoto version, `GATED=1` if it serves the gated engines). The image's health check asks the web UI's port 7869, which an agent does not serve, hence `--no-healthcheck`. Without TLS, requests and audio cross the network unencrypted: use a trusted network, or give a certificate with `--ssl-certfile` / `--ssl-keyfile` (mount the files into the container).","locale":"en"},"8936":{"id":"/en/docs/advanced-docker-77","page_id":"/en/docs/advanced-docker","tags":[],"type":"text","url":"/en/docs/advanced-docker#an-agent-in-a-container","content":"Then, on the host:","locale":"en"},"8937":{"id":"/en/docs/advanced-downloads","page_id":"/en/docs/advanced-downloads","type":"page","content":"Model downloads and mirrors","breadcrumbs":["Mizuoto Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-downloads","locale":"en"},"8938":{"id":"/en/docs/advanced-downloads-0","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads","content":"Where model files come from, how Mizuoto falls back between sources, resumes and verifies them, and how to use the mizuoto-model mirror or run your own.","locale":"en"},"8939":{"id":"/en/docs/advanced-downloads-1","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#sources","content":"Sources","locale":"en"},"8940":{"id":"/en/docs/advanced-downloads-2","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#order-and-fallback","content":"Order and fallback","locale":"en"},"8941":{"id":"/en/docs/advanced-downloads-3","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#resuming-and-verification","content":"Resuming and verification","locale":"en"},"8942":{"id":"/en/docs/advanced-downloads-4","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#hugging-face-token-and-proxies","content":"Hugging Face token and proxies","locale":"en"},"8943":{"id":"/en/docs/advanced-downloads-5","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#shared-files","content":"Shared files","locale":"en"},"8944":{"id":"/en/docs/advanced-downloads-6","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#importing-a-model-folder","content":"Importing a model folder","locale":"en"},"8945":{"id":"/en/docs/advanced-downloads-7","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"The mizuoto-model mirror","locale":"en"},"8946":{"id":"/en/docs/advanced-downloads-8","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#maintaining-a-mirror","content":"Maintaining a mirror","locale":"en"},"8947":{"id":"/en/docs/advanced-downloads-9","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"`build`: lay out the installed models","locale":"en"},"8948":{"id":"/en/docs/advanced-downloads-10","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#mirror_fetchpy-the-whole-catalogue","content":"`mirror_fetch.py`: the whole catalogue","locale":"en"},"8949":{"id":"/en/docs/advanced-downloads-11","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#mirror_readmepy-the-card-and-licence-files","content":"`mirror_readme.py`: the card and licence files","locale":"en"},"8950":{"id":"/en/docs/advanced-downloads-12","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#upload-publish","content":"`upload`: publish","locale":"en"},"8951":{"id":"/en/docs/advanced-downloads-13","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#check-find-missing-files","content":"`check`: find missing files","locale":"en"},"8952":{"id":"/en/docs/advanced-downloads-14","page_id":"/en/docs/advanced-downloads","type":"heading","tags":[],"url":"/en/docs/advanced-downloads#running-your-own-mirror","content":"Running your own mirror","locale":"en"},"8953":{"id":"/en/docs/advanced-downloads-15","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads","content":"Every model in the catalogue names its repository and a pinned files manifest (`mizuoto/core/engines/manifests/files/*.files.json`): the repository's commit and each file's path, size and SHA-256. Mizuoto fetches only the listed files and checks each one's size and SHA-256, so the files are identical whichever source served them.","locale":"en"},"8954":{"id":"/en/docs/advanced-downloads-16","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`downloads.source`","locale":"en"},"8955":{"id":"/en/docs/advanced-downloads-17","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"Address","locale":"en"},"8956":{"id":"/en/docs/advanced-downloads-18","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"Notes","locale":"en"},"8957":{"id":"/en/docs/advanced-downloads-19","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`huggingface` (default)","locale":"en"},"8958":{"id":"/en/docs/advanced-downloads-20","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`https://huggingface.co`","locale":"en"},"8959":{"id":"/en/docs/advanced-downloads-21","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"The official repositories","locale":"en"},"8960":{"id":"/en/docs/advanced-downloads-22","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`hf-mirror`","locale":"en"},"8961":{"id":"/en/docs/advanced-downloads-23","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`https://hf-mirror.com`","locale":"en"},"8962":{"id":"/en/docs/advanced-downloads-24","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"A Hugging Face mirror, often faster in mainland China","locale":"en"},"8963":{"id":"/en/docs/advanced-downloads-25","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`modelscope`","locale":"en"},"8964":{"id":"/en/docs/advanced-downloads-26","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`https://www.modelscope.cn`","locale":"en"},"8965":{"id":"/en/docs/advanced-downloads-27","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"ModelScope, for the models that name a ModelScope repository","locale":"en"},"8966":{"id":"/en/docs/advanced-downloads-28","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`custom`","locale":"en"},"8967":{"id":"/en/docs/advanced-downloads-29","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"`downloads.endpoint`","locale":"en"},"8968":{"id":"/en/docs/advanced-downloads-30","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"Any Hugging Face compatible server (URL form under Running your own mirror)","locale":"en"},"8969":{"id":"/en/docs/advanced-downloads-31","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"**Settings** › **Downloads** › **Download source**; with **Custom**, fill in **Custom endpoint**.","locale":"en"},"8970":{"id":"/en/docs/advanced-downloads-32","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#sources","content":"Models with a ModelScope repository: every Qwen3-TTS, CosyVoice and VoxCPM model, and OmniVoice. CosyVoice's shared file `cosyvoice/wetext` exists on ModelScope only, so it comes from there whatever the source. The others (F5-TTS, GPT-SoVITS, IndexTTS, Fish Speech, the Whisper speech recognition model) and their shared files come from Hugging Face and compatible addresses only. On ModelScope the `master` branch is used (`cosyvoice/wetext` is pinned to a commit); its files are checked against the same sizes and SHA-256. ModelScope may answer several anonymous downloads at once with 403; `downloads.concurrency` 1 gets them.","locale":"en"},"8971":{"id":"/en/docs/advanced-downloads-33","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#order-and-fallback","content":"Each file picks its source on its own:","locale":"en"},"8972":{"id":"/en/docs/advanced-downloads-34","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#order-and-fallback","content":"With `downloads.repository` set to `mizuoto-model` (the default), the mizuoto-model mirror first;","locale":"en"},"8973":{"id":"/en/docs/advanced-downloads-35","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#order-and-fallback","content":"then the source in `downloads.source`;","locale":"en"},"8974":{"id":"/en/docs/advanced-downloads-36","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#order-and-fallback","content":"then the rest of `huggingface`, `hf-mirror`, `modelscope` in that order (with `custom` chosen, `custom` comes before these three).","locale":"en"},"8975":{"id":"/en/docs/advanced-downloads-37","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#order-and-fallback","content":"A source that answers 401, 403 or 404 for a file, or serves it with the wrong size or SHA-256, is left for the next one at once. Other errors (a dropped connection, a timeout, a 5xx) are retried on the same source up to 4 times, after 1, 2, 4 and 8 seconds (30 at most). When every source fails, the job ends with `download_failed` (exit code 12); its detail lists the sources tried and the last errors. The job log has one line per file naming the source it came from.","locale":"en"},"8976":{"id":"/en/docs/advanced-downloads-38","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"A file is written to `<name>.part` and renamed only when its size and SHA-256 match. Downloading again after an interruption resumes with an HTTP Range request; a server that ignores the range starts the file over.","locale":"en"},"8977":{"id":"/en/docs/advanced-downloads-39","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"A file already present with the right size is not downloaded again.","locale":"en"},"8978":{"id":"/en/docs/advanced-downloads-40","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"With `downloads.verify_checksums` (**Verify checksums**, on by default) off, only sizes are checked.","locale":"en"},"8979":{"id":"/en/docs/advanced-downloads-41","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"`downloads.concurrency` (**Files at once**, 1–8, default 2): how many files download at once, the largest first.","locale":"en"},"8980":{"id":"/en/docs/advanced-downloads-42","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"Download jobs share the `io` resource: four run at once, the others wait (shown as **Waiting for other downloads**).","locale":"en"},"8981":{"id":"/en/docs/advanced-downloads-43","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"A model's state:","locale":"en"},"8982":{"id":"/en/docs/advanced-downloads-44","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"State","locale":"en"},"8983":{"id":"/en/docs/advanced-downloads-45","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"In the UI","locale":"en"},"8984":{"id":"/en/docs/advanced-downloads-46","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"Meaning","locale":"en"},"8985":{"id":"/en/docs/advanced-downloads-47","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"`missing`","locale":"en"},"8986":{"id":"/en/docs/advanced-downloads-48","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"**Not downloaded**","locale":"en"},"8987":{"id":"/en/docs/advanced-downloads-49","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"No folder","locale":"en"},"8988":{"id":"/en/docs/advanced-downloads-50","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"`partial`","locale":"en"},"8989":{"id":"/en/docs/advanced-downloads-51","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"**Partly downloaded**","locale":"en"},"8990":{"id":"/en/docs/advanced-downloads-52","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"A folder without `model.json` (the download did not finish), or a shared file it needs is missing","locale":"en"},"8991":{"id":"/en/docs/advanced-downloads-53","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"`downloading`","locale":"en"},"8992":{"id":"/en/docs/advanced-downloads-54","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"**Downloading**","locale":"en"},"8993":{"id":"/en/docs/advanced-downloads-55","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"Being downloaded","locale":"en"},"8994":{"id":"/en/docs/advanced-downloads-56","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"`installed`","locale":"en"},"8995":{"id":"/en/docs/advanced-downloads-57","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"**Installed**","locale":"en"},"8996":{"id":"/en/docs/advanced-downloads-58","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"`model.json` written (it is written last)","locale":"en"},"8997":{"id":"/en/docs/advanced-downloads-59","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"`corrupt`","locale":"en"},"8998":{"id":"/en/docs/advanced-downloads-60","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"**Damaged**","locale":"en"},"8999":{"id":"/en/docs/advanced-downloads-61","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"A file's size differs, or the last verification failed","locale":"en"},"9000":{"id":"/en/docs/advanced-downloads-62","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#resuming-and-verification","content":"Verification lists the damaged files. Since files of the right size are not downloaded again, delete those files (or the whole model with `mizuoto model delete`) and then download again.","locale":"en"},"9001":{"id":"/en/docs/advanced-downloads-63","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#hugging-face-token-and-proxies","content":"When `HF_TOKEN` is set in the environment, it is sent as `Authorization: Bearer` to huggingface.co only, never to hf-mirror, ModelScope, a custom endpoint or the mizuoto-model mirror.","locale":"en"},"9002":{"id":"/en/docs/advanced-downloads-64","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#hugging-face-token-and-proxies","content":"Downloads use httpx, which reads the standard proxy variables `HTTPS_PROXY`, `HTTP_PROXY`, `ALL_PROXY` and `NO_PROXY`. Set them in the environment that starts `mizuoto webui` or `mizuoto model download`.","locale":"en"},"9003":{"id":"/en/docs/advanced-downloads-65","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#shared-files","content":"Files several models of an engine share (GPT-SoVITS's encoders and text front-end data; IndexTTS-2/2.5's w2v-BERT, semantic codec, CAM++ and BigVGAN; CosyVoice's text normalisation grammars) are shared files, kept in `<models folder>/_assets/<engine>/<name>/` with an `asset.json`.","locale":"en"},"9004":{"id":"/en/docs/advanced-downloads-66","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#shared-files","content":"They are downloaded with the first model that needs them (the job's steps list them); a model whose shared files are missing is **Partly downloaded**.","locale":"en"},"9005":{"id":"/en/docs/advanced-downloads-67","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#shared-files","content":"Manage them on their own in **Models** › **Shared files**, or:","locale":"en"},"9006":{"id":"/en/docs/advanced-downloads-68","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#shared-files","content":"Some shared files are archives (GPT-SoVITS's G2PW, NLTK data and Open JTalk dictionary): verified, unpacked into the folder, then deleted; verification and new downloads work on the unpacked files. Archive members cannot land outside the target folder.","locale":"en"},"9007":{"id":"/en/docs/advanced-downloads-69","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#importing-a-model-folder","content":"Model files you already have (an earlier download, another program's copy, your own fine-tune) can be imported instead of downloaded:","locale":"en"},"9008":{"id":"/en/docs/advanced-downloads-70","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#importing-a-model-folder","content":"Mizuoto identifies the engine and variant from the folder's files (and a GPT-SoVITS weight's version). A folder it does not recognise is refused.","locale":"en"},"9009":{"id":"/en/docs/advanced-downloads-71","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#importing-a-model-folder","content":"When the file sizes match a catalogue model's manifest exactly, the folder becomes that catalogue model and every file's SHA-256 is then checked; a mismatch is an error.","locale":"en"},"9010":{"id":"/en/docs/advanced-downloads-72","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#importing-a-model-folder","content":"Otherwise (or with `--name`) it becomes a user model `<engine>/<name>`; the name cannot be a catalogue model's.","locale":"en"},"9011":{"id":"/en/docs/advanced-downloads-73","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#importing-a-model-folder","content":"In the web UI: **Models** › **Import a model folder**. It reads a server path, so it works only in a browser on the server's own machine, and the path must lie inside `paths.browse_roots`.","locale":"en"},"9012":{"id":"/en/docs/advanced-downloads-74","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"mizuoto-model is a mirror repository holding the files Mizuoto downloads, laid out as Mizuoto keeps them:","locale":"en"},"9013":{"id":"/en/docs/advanced-downloads-75","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`<path>` is the file's place in the model's folder. Every model is in one repository, so reaching that one repository is enough. The mirror is `licyk/mizuoto-model` on Hugging Face and `licyks/mizuoto-model` on ModelScope; both hold the whole catalogue: every model and shared file, archives and the licence-gated engines included, with their licence and notice files.","locale":"en"},"9014":{"id":"/en/docs/advanced-downloads-76","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"**Settings** › **Downloads** › **Repository**: **mizuoto-model mirror first** (the default). The mirror is fetched from the place chosen in **Download source**. **Each model's own repository** skips the mirror.","locale":"en"},"9015":{"id":"/en/docs/advanced-downloads-77","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"Setting","locale":"en"},"9016":{"id":"/en/docs/advanced-downloads-78","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"Default","locale":"en"},"9017":{"id":"/en/docs/advanced-downloads-79","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"Meaning","locale":"en"},"9018":{"id":"/en/docs/advanced-downloads-80","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`downloads.repository`","locale":"en"},"9019":{"id":"/en/docs/advanced-downloads-81","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`mizuoto-model`","locale":"en"},"9020":{"id":"/en/docs/advanced-downloads-82","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`mizuoto-model`: the mirror first; `official`: each model's own repositories","locale":"en"},"9021":{"id":"/en/docs/advanced-downloads-83","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`downloads.mirror_repo`","locale":"en"},"9022":{"id":"/en/docs/advanced-downloads-84","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`licyk/mizuoto-model`","locale":"en"},"9023":{"id":"/en/docs/advanced-downloads-85","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"The mirror repository on Hugging Face, also used through hf-mirror and a custom endpoint","locale":"en"},"9024":{"id":"/en/docs/advanced-downloads-86","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`downloads.mirror_repo_modelscope`","locale":"en"},"9025":{"id":"/en/docs/advanced-downloads-87","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"`licyks/mizuoto-model`","locale":"en"},"9026":{"id":"/en/docs/advanced-downloads-88","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"The mirror repository on ModelScope, used when `downloads.source` is `modelscope`","locale":"en"},"9027":{"id":"/en/docs/advanced-downloads-89","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"The mirror is fetched from `downloads.source`: the `main` branch on Hugging Face, hf-mirror and custom endpoints, `master` on ModelScope.","locale":"en"},"9028":{"id":"/en/docs/advanced-downloads-90","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"It is not pinned to a commit, but each file is checked against the manifest's size and SHA-256 like any other; a file that does not match comes from the official repository.","locale":"en"},"9029":{"id":"/en/docs/advanced-downloads-91","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#the-mizuoto-model-mirror","content":"Files the mirror lacks (models it does not hold; archive-type shared files in a mirror made with `build`) come from each model's official repositories, so a partial mirror works.","locale":"en"},"9030":{"id":"/en/docs/advanced-downloads-92","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#maintaining-a-mirror","content":"Three scripts, run from a source checkout, make and publish a mirror: `scripts/mirror_models.py` lays out the models installed on this machine, publishes the result and checks it; `scripts/mirror_fetch.py` downloads the whole catalogue into the mirror's layout; `scripts/mirror_readme.py` writes the repository's card and licence files. Publishing is the mirror owner's step: the weights keep their own licences, and `MIRROR.json` names each file's origin.","locale":"en"},"9031":{"id":"/en/docs/advanced-downloads-93","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"Argument or option","locale":"en"},"9032":{"id":"/en/docs/advanced-downloads-94","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"Meaning","locale":"en"},"9033":{"id":"/en/docs/advanced-downloads-95","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"`OUT`","locale":"en"},"9034":{"id":"/en/docs/advanced-downloads-96","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"The output folder","locale":"en"},"9035":{"id":"/en/docs/advanced-downloads-97","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"`IDS...`","locale":"en"},"9036":{"id":"/en/docs/advanced-downloads-98","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"Only these models and shared files (default: every installed one)","locale":"en"},"9037":{"id":"/en/docs/advanced-downloads-99","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"`--models-dir <path>`","locale":"en"},"9038":{"id":"/en/docs/advanced-downloads-100","page_id":"/en/docs/advanced-downloads","tags":[],"type":"text","url":"/en/docs/advanced-downloads#build-lay-out-the-installed-models","content":"The models folder; 