/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/omnivoice`","locale":"en"},"15871":{"id":"/en/docs/engines-31","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical in all 4 stack cases","locale":"en"},"15872":{"id":"/en/docs/engines-32","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`full`, `lora`","locale":"en"},"15873":{"id":"/en/docs/engines-33","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"CosyVoice","locale":"en"},"15874":{"id":"/en/docs/engines-34","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v1_base`, `v1_sft`, `v1_instruct`, `v2`, `v3`","locale":"en"},"15875":{"id":"/en/docs/engines-35","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/cosyvoice`","locale":"en"},"15876":{"id":"/en/docs/engines-36","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical given the same voice prompt; through the whole stack 23–68 dB SNR (CAM++'s float noise)","locale":"en"},"15877":{"id":"/en/docs/engines-37","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`llm`, `llm_flow`","locale":"en"},"15878":{"id":"/en/docs/engines-38","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Fish Speech","locale":"en"},"15879":{"id":"/en/docs/engines-39","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`s2_pro`, `drama3`","locale":"en"},"15880":{"id":"/en/docs/engines-40","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`packages/native/fishspeech` (`mizuoto-fishspeech`)","locale":"en"},"15881":{"id":