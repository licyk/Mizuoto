eration-53","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#what-changes-results","content":"identical on the CPU; see Memory","locale":"en"},"11291":{"id":"/en/docs/development-acceleration-54","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#what-changes-results","content":"Native code never changes process-wide state: no `torch.backends` assignments, no `sdpa_kernel` (it switches SDPA's kernels for every thread), no global seeding. `runtime/accel/features.py` is the one exemption, called by the host and by a training stage (an architecture test enforces both).","locale":"en"},"11292":{"id":"/en/docs/development-acceleration-55","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"Every attention computation in `runtime`, `nn`, the engines, the trainers and the gated packages goes through one entry point, after ComfyUI's attention backends and `comfy_kitchen`'s registry:","locale":"en"},"11293":{"id":"/en/docs/development-acceleration-56","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`q`, `k`, `v` are `(batch, heads, length, head_dim)`; `mask` is boolean (True attends) or additive, broadcastable to `(batch, heads, q_length, k_length)`.","locale":"en"},"11294":{"id":"/en/docs/development-acceleration-57","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`causal` is SDPA's `is_causal`: aligned top-left. Sites pass it as upstream passed `is_causal` (CosyVoice's streamed-text steps feed several tokens over a cache with it). Bottom-right causality, a KV cache's, comes through `mask_info`.","locale":"en"},"11295":{"id":"/en/docs/development-acceleration-58","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"An architecture test forbids `F.scaled_dot_product_attention` and its aten kernels anywhere outside `runtime/accel/`.","locale":"en"},"11296":{"id":"/en/docs/development-acceleration-59","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"Code","locale":"en"},"11297":{"id":"/en/docs/development-acceleration-60","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"Role","locale":"en"},"11298":{"id":"/en/docs/development-acceleration-61","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/dispatch.py`","locale":"en"},"11299":{"id":"/en/docs/development-acceleration-62","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`attention`, `Site`, `MaskInfo`, `Masked`; the reference forms `sdpa`, `math_kernel`, `softmax_attention`","locale":"en"},"11300":{"id":"/en/docs/development-acceleration-63","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/registry.py`","locale":"en"},"11301":{"id":"/en/docs/development-acceleration-64","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`Backend`, `Constraints`, `Call`, the registry and its per-device probes","locale":"en"},"11302":{"id":"/en/docs/development-acceleration-65","page_id":"/en/docs/development-acceleration","tags":[],"type":"text","url":"/en/docs/development-acceleration#attention","content":"`runtime/accel/policy.py`","locale":"en"},"11303":{"id":"/en/docs/development-acceleration-66","page_id":"/en/docs/development-accelera