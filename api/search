rmance#gpu-optimisation-g2","content":"none; every other engine identical","locale":"en"},"13418":{"id":"/en/docs/development-performance-738","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"`fp16_accumulation`","locale":"en"},"13419":{"id":"/en/docs/development-performance-739","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"F5-TTS ×1.11, IndexTTS 1.5 ×1.21","locale":"en"},"13420":{"id":"/en/docs/development-performance-740","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"GPT-SoVITS ×0.6","locale":"en"},"13421":{"id":"/en/docs/development-performance-741","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"`tf32`","locale":"en"},"13422":{"id":"/en/docs/development-performance-742","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"Qwen3-TTS base ×1.13","locale":"en"},"13423":{"id":"/en/docs/development-performance-743","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"GPT-SoVITS ×0.67–0.75 (with identical audio)","locale":"en"},"13424":{"id":"/en/docs/development-performance-744","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"`cudnn_benchmark`","locale":"en"},"13425":{"id":"/en/docs/development-performance-745","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"none measurable","locale":"en"},"13426":{"id":"/en/docs/development-performance-746","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"changes the vocoders' bits","locale":"en"},"13427":{"id":"/en/docs/development-performance-747","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"all four","locale":"en"},"13428":{"id":"/en/docs/development-performance-748","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"×1.1–1.3 for VoxCPM, F5-TTS, IndexTTS 1.5, Fish Speech, CosyVoice 3, GPT-SoVITS v4","locale":"en"},"13429":{"id":"/en/docs/development-performance-749","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"**Several requests at once** (8 different texts submitted together, no seed): micro-batching (`tts.micro_batch`) runs Qwen3-TTS's 2.6× faster (6.34 → 2.42 s, median latency 3.97 → 2.39 s); for OmniVoice it gains 10 % and doubles the median latency; for GPT-SoVITS it gains 27 %, and two jobs at once without batching did better still (5.32 → 4.00 s: the text front ends overlap the other job's synthesis). `compute.gpu_jobs = 2` alone gains nothing for one engine: one engine on one device runs one call at a time.","locale":"en"},"13430":{"id":"/en/docs/development-performance-750","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"**Tried, not kept.**","locale":"en"},"13431":{"id":"/en/docs/development-performance-751","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"**Fused AdamW** for training: 1.5× faster per optimizer step (0.7 B float32 parameters: 69 → 47 ms), but the full fine-tunes' steps barely move (CosyVoice 2 `llm` 0.121 → 0.112 s, VoxCPM `full` 0.311 → 0.296 s, Qwen3-TTS `speaker` none) and the results change: not offered. On CUDA every trainer already gets torch's multi-tensor (`foreach`) Adam by default, as upstream does.","locale":"en"},"13432":{"id":"/en/docs/development-performance-752","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"**OmniVoice's step forward as a CUDA graph**: identical, 2 % faster. Outside the profiler its language model keeps the GPU about 90 % busy, so there is little launch time to save.","locale":"en"},"13433":{"id":"/en/docs/development-performance-753","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"**Loading straight to the device**: a load takes 1.6–4.8 s with the page cache warm, of which 0.5–1.7 s is copying tensors on the host, and the first model in a process also pays about 2 s of imports (torch, inflect); loading to the device would drop the host copy that makes offloading free.","locale":"en"},"13434":{"id":"/en/docs/development-performance-754","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"**Classifier-free guidance in one batch**: already so in F5-TTS, CosyVoice, IndexTTS's s2mel, OmniVoice and VoxCPM (as upstream); GPT-SoVITS v3–v5's CFM calls its estimator twice, and batching it would change the bits.","locale":"en"},"13435":{"id":"/en/docs/development-performance-755","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#gpu-optimisation-g2","content":"**Training's `low` preset** (gradient checkpointing) against the plan's +35 % per step: F5-TTS +6 %, VoxCPM +51 %, Qwen3-TTS +80 %, OmniVoice +104 % (G0's runs).","locale":"en"},"13436":{"id":"/en/docs/development-performance-756","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#against-01-and-the-contract-suite-on-the-gpu-g3","content":"**Native against 0.1** (the engine-worker release, which ran upstream's code; tag `v1-engine-workers`), measured on a quiet `cuda:0` (2026-10-18) with each side's GPU defaults: the G0 set without Fish Speech (0.1's cloning fails on a GPU, Fish Speech) and VoxCPM (not in 0.1), one process per side, three runs per case. Warm is the best of runs 2–3; the first request includes loading.","locale":"en"},"13437":{"id":"/en/docs/development-performance-757","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#against-01-and-the-contract-suite-on-the-gpu-g3","content":"Case","locale":"en"},"13438":{"id":"/en/docs/development-performance-758","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#against-01-and-the-contract-suite-on-the-gpu-g3","content":"Warm, 0.1 → native","locale":"en"},"13439":{"id":"/en/docs/development-performance-759","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#against-01-and-the-contract-suite-on-the-gpu-g3","content":"Gain","locale":"en"},"13440":{"id":"/en/docs/development-performance-760","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#against-01-and-the-contract-suite-on-the-gpu-g3","content":"First request, 0.1 → native","locale":"en"},"13441":{"id":"/en/docs/development-performance-761","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#against-01-and-the-contract-suite-on-the-gpu-g3","content":"Qwen3-TTS cv-en-aiden","locale":"en"},"13442":{"id":"/en/docs/development-performance-762","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#against-01-an