e_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Fish Speech","locale":"en"},"12885":{"id":"/en/docs/engines-39","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`s2_pro`","locale":"en"},"12886":{"id":"/en/docs/engines-40","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`packages/native/fishspeech` (`mizuoto-fishspeech`)","locale":"en"},"12887":{"id":"/en/docs/engines-41","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical codes and audio in both stack cases","locale":"en"},"12888":{"id":"/en/docs/engines-42","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`lora`","locale":"en"},"12889":{"id":"/en/docs/engines-43","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"IndexTTS","locale":"en"},"12890":{"id":"/en/docs/engines-44","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v1_5`, `v2`, `v2_5`","locale":"en"},"12891":{"id":"/en/docs/engines-45","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`packages/native/indextts` (`mizuoto-indextts`)","locale":"en"},"12892":{"id":"/en/docs/engines-46","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical in all 4 stack cases","locale":"en"},"12893":{"id":"/en/docs/engines-47","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"none","locale":"en"},"12894":{"id":"/en/docs/engines-48","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"GPT-SoVITS","locale":"en"},"12895":{"id":"/en/docs/engines-49","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v2`, `v2pro`, `v2proplus`, `v4`, `v5turbo`","locale":"en"},"12896":{"id":"/en/docs/engines-50","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/gptsovits`","locale":"en"},"12897":{"id":"/en/docs/engines-51","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical in all 15 stack cases","locale":"en"},"12898":{"id":"/en/docs/engines-52","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`speaker`","locale":"en"},"12899":{"id":"/en/docs/engines-53","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"VoxCPM","locale":"en"},"12900":{"id":"/en/docs/engines-54","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v2`, `v1_5`, `v1`","locale":"en"},"12901":{"id":"/en/docs/engines-55","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/voxcpm`","locale":"en"},"12902":{"id":"/en/docs/engines-56","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical to upstream's own package in all 27 stack cases, in bf16 and fp32","locale":"en"},"12903":{"id":"/en/docs/engines-57","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`full`, `lora`","locale":"en"},"12904":{"id":"/en/docs/engines-58","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Speech recognition","locale":"en"},"12905":{"id":"/en/docs/engines-59","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`whisper`","locale":"en"},"12906":{"id":"/en/docs/engines-60","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/asr`","locale":"en"},"12907":{"id":"/en/docs/engines-61","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical transcripts on 63 clips","locale":"en"},"12908":{"id":"/en/docs/engines-62","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"none","locale":"en"},"12909":{"id":"/en/docs/engines-63","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Every trainer gives upstream's losses, learning rates and saved weights byte for byte on the CPU when both are seeded alike, and each implementation loads the other's exports (and, but for CosyVoice's voice prompt, speaks them identically). The contract suite (the real models through the whole stack) passes for every engine on the CPU: Qwen3-TTS 24 tests, F5-TTS 12, OmniVoice 12, CosyVoice 18, Fish Speech 6, IndexTTS 18, GPT-SoVITS 24, VoxCPM 18.","locale":"en"},"12910":{"id":"/en/docs/engines-64","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"For seven engines the reference is **Mizuoto 0.1** (git tag `v1-engine-workers`). 0.1 ran each upstream project's own code, in an environment of its own, behind a small adapter; \"identical to 0.1\" therefore means identical to upstream as Mizuoto drove it, adapter choices included (how text is segmented, the order of chunks, how parameters map). Where 0.1's adapter and upstream differed, 0.1's behaviour is the one kept: F5-TTS generates a long text's chunks in order, GPT-SoVITS scales its pauses as the adapter did.","locale":"en"},"12911":{"id":"/en/docs/engines-65","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"Two engines have another reference:","locale":"en"},"12912":{"id":"/en/docs/engines-66","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"**VoxCPM** came after 0.1. Its reference is upstream's own package (the commit the manifest pins), run behind an adapter in the same Mizuoto stack, with the library versions upstream locks.","locale":"en"},"12913":{"id":"/en/docs/engines-67","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"**CosyVoice** is compared with upstream running on torch 2.8, not on the torch 2.3.1 it was released with: upstream on 2.3.1 and upstream on 2.8 disagree with each other (sampling diverges; voice conversion matches to 62 dB), and Mizuoto needs torch 2.8 or newer.","locale":"en"},"12914":{"id":"/en/docs/engines-68","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-conditions","content":"CPU, fp32 (VoxCPM also bf16, its default), the same seed, the same torch release and the same thread count (CPU kernels split their sums by it). The CPU is where the claim is made because any difference in a logit can flip a sampling draw or a beam choice, after which everything diverges; on a GPU in reduced precision, kernels change with shapes and upstream does not even agree with itself (a batch against single requests). On the CPU in fp32 the computation is deterministic, so a port that does exactly what upstream does gives exactly upstream's bits.","locale":"en"},"12915":{"id":"/en/docs/engines-69","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Tier","locale":"en"},"12916":{"id":"/en/docs/engines-70","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"What is compared","locale":"en"},"12917":{"id":"/en/docs/engines-71","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Passes when","locale":"en"},"12918":{"id":"/en/docs/engines-72","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T0 operation","locale":"en"},"12919":{"id":"/en/docs/engines-73","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"DSP, samplers, tokenizers, normalisers, g2p","locale":"en"},"12920":{"id":"/en/docs/engines-74","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"identical: `torch.equal`, the same ids, the same strings","locale":"en"},"12921":{"id":"/en/docs/engines-75","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T1 module","locale":"en"},"12922":{"id":"/en/docs/engines-76","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"each module with the real weights on captured inputs","locale":"en"},"12923":{"id":"/en/docs/engines-77","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"max abs error ≤ 1e-5 × max(1, ‖ref‖∞), cosine ≥ 0.99999","locale":"en"},"12924":{"id":"/en/docs/engines-78","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T2 stage","locale":"en"},"12925":{"id":"/en/docs/engines-79","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"teacher-forced logits; discrete outputs from captured inputs (speech-tokenizer codes, VQ codes)","locale":"en"},"12926":{"id":"/en/docs/engines-80","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"argmax agreement 100 %; discrete agreement ≥ 99.9 % with every flip explained","locale":"en"},"12927":{"id":"/en/docs/engines-81","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T3 end to end","locale":"en"},"12928":{"id":"/en/docs/engines-82","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"a whole seeded request through Mizuoto's stack","locale":"en"},"12929":{"id":"/en/docs/engines-83","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"identical tokens; audio identical, or max abs error ≤ 1e-4","locale":"en"},"12930":{"id":"/en/docs/engines-84","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Every engine above is identical at T3, with no error at all, except CosyVoice when each side makes its own voice prompt. Two opt-in paths are held to less: `compute.compile` (within 1e-4, except CosyVoice, whose vocoder amplifies float differences) and Qwen3-TTS's `fused_projections` (identical on the CPU, not on a GPU).","locale":"en"},"12931":{"id":"/en/docs/engines-85","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Behaviour is compared along with the audio: the parameters applied and the warnings, the voice mode chosen, the segments, the streamed chunks' lengths, the sample rate and the error codes of invalid requests.","locale":"en"},"12932":{"id":"/en/docs/engines-86","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"**Training** is identical when, seeded alike, every step's losses, learning rates and other metrics, and the saved weights, equal upstream's. Upstream rarely seeds everything (0.1 never did), so the reference is upstream with its generators seeded the way the native training stage seeds them.","locale":"en"},"12933":{"id":"/en/docs/engines-87","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"**On a GPU** there is no sample-level comparison with upstream. What a GPU checks is that Mizuoto's own speed paths change nothing: CUDA graphs and the decoding loops that wait for the device once per step give the same tokens and audio as the plain eager code on the same GPU.","locale":"en"},"12934":{"id":"/en/docs/engines-88","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**The parity harness** (`scripts/parity/`) runs cases through a whole Mizuoto stack with either implementation and compares the runs: `stack.py run <cases> --impl reference|native` (VoxCPM: `--impl upstream|native`), `compare.py <engine>`, and `train.py run|compare` for the trainers. The cases are `scripts/parity/cases/<engine>.jsonl` (74 in all); the environments, clips, fixtures and reports live outside the repository in `MIZUOTO_PARITY_DIR`. The reference is first compared with a repeat of itself: a case that does not repeat cannot judge the port. Its commands are in Testing.","locale":"en"},"12935":{"id":"/en/docs/engines-89","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**Component checks**: `scripts/parity/check_tokenizer.py` (the BPE against transformers' tokenizer), `scripts/parity/dsp_fixtures.py` (the DSP against torchaudio, librosa, Whisper and soxr, kept as `tests/fixtures/dsp/*.npz`), `scripts/parity/check_rng.py` (explicit generators against the seeded default stream), and per-engine module scripts such as `voxcpm_modules.py`.","locale":"en"},"12936":{"id":"/en/docs/engines-90","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**In CI**: `tests/engines_native/` runs every engine and trainer on a tiny random model of its own architecture, also with its weights streamed, half streamed and not streamed on a simulated device, which must give the same output; `tests/runtime/test_dsp.py` checks the DSP against its fixtures.","locale":"en"},"12937":{"id":"/en/docs/engines-91","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**The contract suite** (`python scripts/dev.py test-engines`) drives the installed real models through planning, jobs and the runtime: every voice mode audible and intelligible (WER under 0.35 by speech recognition), seeds that repeat, segments, cancelling, and no residue in the process.","locale":"en"},"12938":{"id":"/en/docs/engines-92","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Upstream's computation, in its order and shapes.** Batching changes floating-point sums, so a port keeps upstream's tensor shapes even where a simpler form would do (three embeddings looked up in one call, a cache grown by concatenation, SDPA called with the same arguments transformers passed).","locale":"en"},"12939":{"id":"/en/docs/engines-93","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Randomness from the request.** Every draw comes from `ctx.generator_for(device)` or `ctx.rng`, never from torch's global generator. A fresh `torch.Generator` seeded with *s* gives the same stream as the default generator after `torch.manual_seed(s)`, on the CPU and on CUDA (`check_rng.py`), so drawing upstream's draws in upstream's order reproduces upstream's seeded run. Where upstream draws while it builds a model (default initialisations that consume the global generator), the port replays those draws on a private generator when their values matter (CosyVoice 3's vocoder noise, the trainers' initialisations) or jumps the generator over them (Fish Speech's trainer).","locale":"en"},"12940":{"id":"/en/docs/engines-94","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**No process-wide state.** No environment variables, working folder, `sys.path`, `torch.backends` flags, global seeds or logging configuration are changed; `tests/test_architecture.py` forbids it and the contract suite checks a digest of the process state before and after requests (the `mizuoto.snapshot` operation).","locale":"en"},"12941":{"id":"/en/docs/engines-95","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Libraries' numerics, reproduced.** `mizuoto.nn.dsp` is bit-exact with what upstream called: torchaudio (2.3.1 and 2.8.0), librosa (0.10, 0.11, 1.0), openai-whisper, soxr as `librosa.resample` calls it, Matcha-TTS's mel, the ffmpeg program's resampler and soundfile's WAV. `mizuoto.text.tokenize.bpe` gives transformers' ids for the Qwen2-family tokenizers; normalisers apply the original FSTs with kaldifst; ONNX weights are read from the protobuf without onnx.","locale":"en"},"12942":{"id":"/en/docs/engines-96","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Strict checkpoints.** A missing or unexpected key is an error; upstream sometimes kept random weights for missing keys.","locale":"en"},"12943":{"id":"/en/docs/engines-97","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Loading outside inference mode**, requests inside it (below).","locale":"en"},"12944":{"id":"/en/docs/engines-98","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"Both were found while comparing E2-TTS: `F.linear` on a strided (non-contiguous) 3-D input takes another CPU kernel, with other rounding, when its weight requires grad, or when the weight is an *inference tensor* (made inside `torch.inference_mode()`), even under `no_grad`. Upstream's weights are ordinary parameters that require grad. So native engines leave parameters as `nn.Module` makes them (no `requires_grad_(False)`), and models are loaded outside inference mode; requests still run inside it.","locale":"en"},"12945":{"id":"/en/docs/engines-99","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Module","locale":"en"},"12946":{"id":"/en/docs/engines-100","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"What it is","locale":"en"},"12947":{"id":"/en/docs/engines-101","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Engines","locale":"en"},"12948":{"id":"/en/docs/engines-102","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`runtime/lm/qwen.py`, `runtime/lm/cache.py`","locale":"en"},"12949":{"id":"/en/docs/engines-103","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"The Qwen2/Qwen3 decoder with transformers' numerics (`hf_sdpa`, `mask_for`), `DynamicCache` and the optional preallocated `BufferCache`","locale":"en"},"12950":{"id":"/en/docs/engines-104","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen3-TTS, OmniVoice, CosyVoice 2/3, IndexTTS's emotion model; Fish Speech uses the cache","locale":"en"},"12951":{"id":"/en/docs/engines-105","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`runtime/sampling.py`","locale":"en"},"12952":{"id":"/en/docs/engines-106","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"transformers' logits processors in their order; `multinomial`'s own computation without its device waits","locale":"en"},"12953":{"id":"/en/docs/engines-107","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen3-TTS, IndexTTS, CosyVoice","locale":"en"},"12954":{"id":"/en/docs/engines-108","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`runtime/graphs.py`","locale":"en"},"12955":{"id":"/en/docs/engines-109","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"CUDA graphs over a decoder's one-token step (`DecoderSteps`, `LayerSteps`)","locale":"en"},"12956":{"id":"/en/docs/engines-110","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen3-TTS, Fish Speech, CosyVoice 2/3, VoxCPM, GPT-SoVITS, IndexTTS","locale":"en"},"12957":{"id":"/en/docs/engines-111","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`runtime/compile.py`","locale":"en"},"12958":{"id":"/en/docs/engines-112","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`Compiled`: one hot module under `torch.compile` when `compute.compile` is on","locale":"en"},"12959":{"id":"/en/docs/engines-113","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5-TTS, CosyVoice, GPT-SoVITS, IndexTTS, VoxCPM","locale":"en"},"12960":{"id":"/en/docs/engines-114","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/transformer/`","locale":"en"},"12961":{"id":"/en/docs/engines-115","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5's DiT (`dit.py`), E2's UNetT, wenet's Conformer, Seed-VC's DiT, VITS, BERT","locale":"en"},"12962":{"id":"/en/docs/engines-116","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5-TTS, CosyVoice, GPT-SoVITS, IndexTTS","locale":"en"},"12963":{"id":"/en/docs/engines-117","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/flow/`","locale":"en"},"12964":{"id":"/en/docs/engines-118","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5's CFM with torchdiffeq's fixed grids, Matcha's U-Net, coupling flows","locale":"en"},"12965":{"id":"/en/docs/engines-119","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5-TTS, CosyVoice, GPT-SoVITS","locale":"en"},"12966":{"id":"/en/docs/engines-120","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/vocoders/`","locale":"en"},"12967":{"id":"/en/docs/engines-121","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Vocos, HiFT v1–v3, BigVGAN v1/v2, HiFi-GAN","locale":"en"},"12968":{"id":"/en/docs/engines-122","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5-TTS, IndexTTS, CosyVoice, GPT-SoVITS","locale":"en"},"12969":{"id":"/en/docs/engines-123","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/codecs/`","locale":"en"},"12970":{"id":"/en/docs/engines-124","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"DAC, the s3tokenizer speech tokenizers built from their ONNX files, RepCodec","locale":"en"},"12971":{"id":"/en/docs/engines-125","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"OmniVoice, CosyVoice, IndexTTS","locale":"en"},"12972":{"id":"/en/docs/engines-126","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/ssl/`, `nn/speaker/`","locale":"en"},"12973":{"id":"/en/docs/engines-127","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"HuBERT, w2v-BERT 2.0; CAM++ (as CosyVoice's ONNX graph has it, and as 3D-Speaker's code), ECAPA, MelStyle","locale":"en"},"12974":{"id":"/en/docs/engines-128","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"OmniVoice, GPT-SoVITS, IndexTTS, CosyVoice","locale":"en"},"12975":{"id":"/en/docs/engines-129","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/dsp/`","locale":"en"},"12976":{"id":"/en/docs/engines-130","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Mel filterbanks, kaldi fbank, resamplers, WAV and FLAC, the tiled decoding used as a memory fallback","locale":"en"},"12977":{"id":"/en/docs/engines-131","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"all","locale":"en"},"12978":{"id":"/en/docs/engines-132","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`text/tokenize/`, `text/normalize/`","locale":"en"},"12979":{"id":"/en/docs/engines-133","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen2-family BPE, Whisper's tiktoken vocabulary, wetext's normaliser over kaldifst","locale":"en"},"12980":{"id":"/en/docs/engines-134","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen3-TTS, OmniVoice, Fish Speech, CosyVoice, IndexTTS, VoxCPM","locale":"en"},"12981":{"id":"/en/docs/engines-135","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"How the runtime places these models in memory, streams their weights and retries after running out of memory is in Runtime; the settings that turn on the speed paths are in Performance.","locale":"en"},"12982":{"id":"/en/docs/engines-136","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#licence-gated-engines","content":"Fish Speech and IndexTTS are ports of code whose licences (the Fish Audio Research License, the bilibili Model Use License) also cover the port. They are therefore separate distributions, `mizuoto-fishspeech` and `mizuoto-indextts`, each shipping its licence, installed into the same environment and registered under the entry-point group `mizuoto.engines`. Their manifests ship with `mizuoto`, so the catalogue and the licence text are there before the distribution is installed. They follow the same rules as the built-in engines and import nothing from another engine.","locale":"en"},"12983":{"id":"/en/docs/engines-137","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#limitations","content":"Exactness is established on the CPU. GPU runs are checked for identical results between Mizuoto's own fast and plain paths, not sample for sample against upstream.","locale":"en"},"12984":{"id":"/en/docs/engines-138","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#limitations","content":"CUDA graphs run on NVIDIA GPUs only. Every engine declares AMD (ROCm), Intel (XPU) and Apple (MPS) GPUs, but none has been run on that hardware yet.","locale":"en"},"12985":{"id":"/en/docs/first-run","page_id":"/en/docs/first-run","type":"page","content":"First run","breadcrumbs":["Mizuoto Documentation","Getting started"],"tags":[],"url":"/en/docs/first-run","locale":"en"},"12986":{"id":"/en/docs/first-run-0","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run","content":"Where you start, checking torch and the engines, downloading models, licence-gated engines, and the first real synthesis.","locale":"en"},"12987":{"id":"/en/docs/first-run-1","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#where-you-start","content":"Where you start","locale":"en"},"12988":{"id":"/en/docs/first-run-2","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#torch-and-the-engines","content":"Torch and the engines","locale":"en"},"12989":{"id":"/en/docs/first-run-3","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#speech-recognition","content":"Speech recognition","locale":"en"},"12990":{"id":"/en/docs/first-run-4","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#downloading-models","content":"Downloading models","locale":"en"},"12991":{"id":"/en/docs/first-run-5","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#licence-gated-engines","content":"Licence-gated engines","locale":"en"},"12992":{"id":"/en/docs/first-run-6","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#the-first-synthesis","content":"The first synthesis","locale":"en"},"12993":{"id":"/en/docs/first-run-7","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run","content":"With Mizuoto installed and `mizuoto webui` running, this page takes you through the first use: where to start, checking torch and the engines, what a model download does, the licence-gated engines, and finally the first synthesis. Each step is given for the web UI and the command line.","locale":"en"},"12994":{"id":"/en/docs/first-run-8","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"The UI opens on **Speak**. Nothing has to be set up first: the dummy engine works right away (it speaks in tones), so you can look around before downloading anything. Three places matter for a real engine:","locale":"en"},"12995":{"id":"/en/docs/first-run-9","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"Where","locale":"en"},"12996":{"id":"/en/docs/first-run-10","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"What to do there","locale":"en"},"12997":{"id":"/en/docs/first-run-11","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"**Settings › Downloads**","locale":"en"},"12998":{"id":"/en/docs/first-run-12","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"Choose the **Download source**: **Hugging Face**, **hf-mirror.com** or **ModelScope** (the last two are often faster in mainland China), or **Custom**","locale":"en"},"12999":{"id":"/en/docs/first-run-13","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"**Settings › Compute**","locale":"en"},"13000":{"id":"/en/docs/first-run-14","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"This machine's devices, each GPU's memory, and the torch in use with its build, such as `torch 2.8.0 (cu128)`. When torch is missing or its build does not suit this computer, it names the right build and shows the command that installs it (`mizuoto doctor` says the same)","locale":"en"},"13001":{"id":"/en/docs/first-run-15","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"**Models**","locale":"en"},"13002":{"id":"/en/docs/first-run-16","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"Every catalogue model with its engine, size, GPU memory and state, and a **Download** button; see Downloading models","locale":"en"},"13003":{"id":"/en/docs/first-run-17","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"On **Speak**, a model that is not downloaded yet replaces the **Speak** button with the one that downloads it. Downloads are jobs, so you can leave the page at any time.","locale":"en"},"13004":{"id":"/en/docs/first-run-18","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"The models of Fish Speech and IndexTTS cannot be downloaded until their licences are accepted. See Licence-gated engines below.","locale":"en"},"13005":{"id":"/en/docs/first-run-19","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"Every engine is part of Mizuoto and runs in the server's own process: there is nothing to install per engine. An engine is **Available** when torch is installed (the dummy engine needs none) and its implementation is there: built in, or for Fish Speech and IndexTTS their own distribution (`mizuoto-fishspeech`, `mizuoto-indextts`). Otherwise its card under **Models › Engines** says **Not available** and what it needs, and the model picker marks its models **Not available**.","locale":"en"},"13006":{"id":"/en/docs/first-run-20","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"To fix it, install what is missing into Mizuoto's Python, then restart Mizuoto:","locale":"en"},"13007":{"id":"/en/docs/first-run-21","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"torch: the build `mizuoto doctor` names, such as `pip install \"torch>=2.8\" --index-url https://download.pytorch.org/whl/cu128` (the commands for each platform are in Installation).","locale":"en"},"13008":{"id":"/en/docs/first-run-22","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"A licence-gated engine: its distribution, such as `pip install mizuoto-indextts`.","locale":"en"},"13009":{"id":"/en/docs/first-run-23","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"On **Speak**, a model whose engine is not available replaces the button at the bottom with the command that installs what it needs. The command line:","locale":"en"},"13010":{"id":"/en/docs/first-run-24","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"Some languages need an optional extra (GPT-SoVITS's Japanese and Korean, IndexTTS-2.5's Japanese); `mizuoto doctor` lists the missing ones with their install command, see Optional extras.","locale":"en"},"13011":{"id":"/en/docs/first-run-25","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#speech-recognition","content":"To clone a voice, models usually need the reference clip's transcript. With the speech recognition model downloaded, missing transcripts are filled in:","locale":"en"},"13012":{"id":"/en/docs/first-run-26","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#speech-recognition","content":"In the UI it is the engine marked **Used by Mizuoto itself** under **Models › Engines**; its model is under **Models › Models**.","locale":"en"},"13013":{"id":"/en/docs/first-run-27","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"Under **Models › Models** the models are grouped by engine, one row each with its size, GPU memory and state: **Not downloaded**, **Downloading**, **Partly downloaded**, **Installed** or **Damaged**. Click **Download**; while it runs the row shows the amount done, the speed and the time left.","locale":"en"},"13014":{"id":"/en/docs/first-run-28","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"Files are downloaded into `.part` files and resume after an interruption; each finished file is checked against its size and SHA-256.","locale":"en"},"13015":{"id":"/en/docs/first-run-29","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"When a source lacks a file or serves it wrong, the next source is tried (the one in the settings first, then Hugging Face, hf-mirror and ModelScope).","locale":"en"},"13016":{"id":"/en/docs/first-run-30","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"Files several models of an engine share (GPT-SoVITS's encoders, for example) are downloaded with the first model that needs them; the **Shared files** tab lists them.","locale":"en"},"13017":{"id":"/en/docs/first-run-31","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"On **Speak**, after choosing a model, the button at the bottom offers **Download** *model* *(size)*.","locale":"en"},"13018":{"id":"/en/docs/first-run-32","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"The command line:","locale":"en"},"13019":{"id":"/en/docs/first-run-33","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"The licences of Fish Speech (Fish Audio Research License) and IndexTTS (bilibili Model Use License) restrict their use. Each is a distribution of its own (`mizuoto-fishspeech`, `mizuoto-indextts`, see Installation), and downloading its models and shared files and speaking both need the licence accepted first.","locale":"en"},"13020":{"id":"/en/docs/first-run-34","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"Open **Models › Engines** and click **Accept the licence** on the engine's card (or, on **Speak** with one of its models chosen, **Accept the** *engine* **licence** at the bottom).","locale":"en"},"13021":{"id":"/en/docs/first-run-35","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"The dialog shows the licence's full text and a link to the original. Read it, then check **I have read and accept this licence**.","locale":"en"},"13022":{"id":"/en/docs/first-run-36","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"Click **Accept the licence**. The card shows **Licence accepted** and its models can be downloaded.","locale":"en"},"13023":{"id":"/en/docs/first-run-37","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"The command line:","locale":"en"},"13024":{"id":"/en/docs/first-run-38","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"You accept a specific version of the licence; a new version must be accepted again. Also:","locale":"en"},"13025":{"id":"/en/docs/first-run-39","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"IndexTTS results show the licence's notice beneath them: cloning a voice without its owner's permission is forbidden by the IndexTTS disclaimer.","locale":"en"},"13026":{"id":"/en/docs/first-run-40","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"Fish Speech results show \"Built with Fish Audio\" beneath them, and cannot be used as training data for other engines.","locale":"en"},"13027":{"id":"/en/docs/first-run-41","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"F5-TTS needs no acceptance, but its pretrained weights (CC-BY-NC-4.0) are for non-commercial use; its results carry that licence's tag.","locale":"en"},"13028":{"id":"/en/docs/first-run-42","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#the-first-synthesis","content":"Once the model is downloaded, open **Speak**, choose it and a voice, type some text and click **Speak**. Speak explains every option.","locale":"en"},"13029":{"id":"/en/docs/first-run-43","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#the-first-synthesis","content":"The first synthesis loads the model into the server's process, which takes a while; then the model stays in memory until it has been idle for the time set under **Settings › Compute**. When the GPU has less free memory than the model needs, Mizuoto fails at once with **The GPU is not available or ran out of memory**, and **What to do** says how to fix it, such as another device or freeing GPU memory.","locale":"en"},"13030":{"id":"/en/docs/guide-history","page_id":"/en/docs/guide-history","type":"page","content":"History","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-history","locale":"en"},"13031":{"id":"/en/docs/guide-history-0","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history","content":"The History screen: every result, to search, filter by model, mark as favourite, run again, download and delete.","locale":"en"},"13032":{"id":"/en/docs/guide-history-1","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#finding-results","content":"Finding results","locale":"en"},"13033":{"id":"/en/docs/guide-history-2","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#each-result","content":"Each result","locale":"en"},"13034":{"id":"/en/docs/guide-history-3","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#where-the-files-are","content":"Where the files are","locale":"en"},"13035":{"id":"/en/docs/guide-history-4","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#command-line","content":"Command line","locale":"en"},"13036":{"id":"/en/docs/guide-history-5","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history","content":"**History** lists every result, newest first: from Speak, the tries on voice pages, design candidates, conversions and edits from Tools, training previews, and the files projects export.","locale":"en"},"13037":{"id":"/en/docs/guide-history-6","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history","content":"The takes of a project's lines are **not** listed here; they are managed on the project's page (see Projects). Files **exported** from a project or a chapter are listed.","locale":"en"},"13038":{"id":"/en/docs/guide-history-7","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"Three filters at the top, which combine:","locale":"en"},"13039":{"id":"/en/docs/guide-history-8","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"**Search the text**: the result's text or name;","locale":"en"},"13040":{"id":"/en/docs/guide-history-9","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"**Model**: **All models**, or one model;","locale":"en"},"13041":{"id":"/en/docs/guide-history-10","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"**Favourites**: favourites only.","locale":"en"},"13042":{"id":"/en/docs/guide-history-11","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"The list loads 50 at a time; at the bottom, **Load more** loads the next.","locale":"en"},"13043":{"id":"/en/docs/guide-history-12","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Each shows its text (or name), length, waveform (click to seek), model, time taken, real-time factor (RTF) and seed, with any warnings and licence notices (such as Fish Speech's \"Built with Fish Audio\"). Its menu:","locale":"en"},"13044":{"id":"/en/docs/guide-history-13","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Action","locale":"en"},"13045":{"id":"/en/docs/guide-history-14","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"What it does","locale":"en"},"13046":{"id":"/en/docs/guide-history-15","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Favourite** / **Not a favourite**","locale":"en"},"13047":{"id":"/en/docs/guide-history-16","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Mark it, for the **Favourites** filter","locale":"en"},"13048":{"id":"/en/docs/guide-history-17","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Download**","locale":"en"},"13049":{"id":"/en/docs/guide-history-18","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Download the file","locale":"en"},"13050":{"id":"/en/docs/guide-history-19","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Show in folder**","locale":"en"},"13051":{"id":"/en/docs/guide-history-20","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Open its folder on the server (only in a browser on the server machine)","locale":"en"},"13052":{"id":"/en/docs/guide-history-21","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Use as a reference clip**","locale":"en"},"13053":{"id":"/en/docs/guide-history-22","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Open Speak with this result as **A clip**, its text as the transcript","locale":"en"},"13054":{"id":"/en/docs/guide-history-23","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Keep as a voice**","locale":"en"},"13055":{"id":"/en/docs/guide-history-24","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Type the **Name of the new voice** to put it in the library","locale":"en"},"13056":{"id":"/en/docs/guide-history-25","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Run again with these settings**","locale":"en"},"13057":{"id":"/en/docs/guide-history-26","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Open Speak with the model, voice, text and parameters that made it (the same seed when one was set); for results of a synthesis","locale":"en"},"13058":{"id":"/en/docs/guide-history-27","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Delete**","locale":"en"},"13059":{"id":"/en/docs/guide-history-28","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Delete the result and its file","locale":"en"},"13060":{"id":"/en/docs/guide-history-29","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"With more than one result listed, **Download all** downloads them together.","locale":"en"},"13061":{"id":"/en/docs/guide-history-30","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#where-the-files-are","content":"Result files are in `outputs/` in the data folder (change it under **Settings › Storage › Results**); where each came from (model, parameters, timings, licence tags) is recorded in the database.","locale":"en"},"13062":{"id":"/en/docs/guide-models","page_id":"/en/docs/guide-models","type":"page","content":"Models","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-models","locale":"en"},"13063":{"id":"/en/docs/guide-models-0","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models","content":"The Models screen: download, verify, delete and import catalogue models; engine cards (availability, device, precision, enabled, options, checks, licence); and shared files.","locale":"en"},"13064":{"id":"/en/docs/guide-models-1","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#models","content":"Models","locale":"en"},"13065":{"id":"/en/docs/guide-models-2","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#import-a-model-folder","content":"Import a model folder","locale":"en"},"13066":{"id":"/en/docs/guide-models-3","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#engines","content":"Engines","locale":"en"},"13067":{"id":"/en/docs/guide-models-4","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#device-precision-enabled","content":"Device, precision, enabled","locale":"en"},"13068":{"id":"/en/docs/guide-models-5","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#options","content":"Options","locale":"en"},"13069":{"id":"/en/docs/guide-models-6","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#check-this-machine","content":"Check this machine","locale":"en"},"13070":{"id":"/en/docs/guide-models-7","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#licence","content":"Licence","locale":"en"},"13071":{"id":"/en/docs/guide-models-8","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#shared-files","content":"Shared files","locale":"en"},"13072":{"id":"/en/docs/guide-models-9","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#command-line","content":"Command line","locale":"en"},"13073":{"id":"/en/docs/guide-models-10","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models","content":"**Models** has three tabs: **Models** (each engine's catalogue), **Engines** (each engine's availability and settings) and **Shared files** (files several models of an engine share).","locale":"en"},"13074":{"id":"/en/docs/guide-models-11","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Models are grouped by engine: speech engines first, then helpers such as speech recognition, the dummy engine last. When an engine is not available, its group says what it needs: *engine* **needs** *torch* **to use these models (mizuoto doctor).**","locale":"en"},"13075":{"id":"/en/docs/guide-models-12","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"One row per model, with its name, variant, size, GPU memory (**N GB of GPU memory**) and description, and its state:","locale":"en"},"13076":{"id":"/en/docs/guide-models-13","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"State","locale":"en"},"13077":{"id":"/en/docs/guide-models-14","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Meaning","locale":"en"},"13078":{"id":"/en/docs/guide-models-15","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Not downloaded**","locale":"en"},"13079":{"id":"/en/docs/guide-models-16","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Not downloaded yet","locale":"en"},"13080":{"id":"/en/docs/guide-models-17","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Downloading**","locale":"en"},"13081":{"id":"/en/docs/guide-models-18","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Being downloaded; shows the amount done, the speed and the time left","locale":"en"},"13082":{"id":"/en/docs/guide-models-19","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Partly downloaded**","locale":"en"},"13083":{"id":"/en/docs/guide-models-20","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"A folder that was not finished, or a shared file it needs is missing","locale":"en"},"13084":{"id":"/en/docs/guide-models-21","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Installed**","locale":"en"},"13085":{"id":"/en/docs/guide-models-22","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Downloaded, every file checked","locale":"en"},"13086":{"id":"/en/docs/guide-models-23","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Damaged**","locale":"en"},"13087":{"id":"/en/docs/guide-models-24","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"A file's size differs, or a verification failed","locale":"en"},"13088":{"id":"/en/docs/guide-models-25","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Built in**","locale":"en"},"13089":{"id":"/en/docs/guide-models-26","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"The dummy engine's model; nothing to download","locale":"en"},"13090":{"id":"/en/docs/guide-models-27","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"What you can do:","locale":"en"},"13091":{"id":"/en/docs/guide-models-28","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Download** fetches the missing files. Downloads resume, every file is checked against its size and SHA-256, and when a source lacks a file the next source is tried (see Download sources). Shared files it needs come along.","locale":"en"},"13092":{"id":"/en/docs/guide-models-29","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Verify** computes the SHA-256 of every file of an installed model again. It says **All N files are intact**, or lists **Damaged:** *files*. Delete a damaged model and download it again.","locale":"en"},"13093":{"id":"/en/docs/guide-models-30","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"The delete button deletes the model's files (asking **Delete** *model*? **It can be downloaded again.**).","locale":"en"},"13094":{"id":"/en/docs/guide-models-31","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"When you already have a model's files (an earlier download, a copy from elsewhere, a fine-tune), click **Import a model folder** and choose a folder on the server. The button shows only in a browser on the server machine.","locale":"en"},"13095":{"id":"/en/docs/guide-models-32","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"Mizuoto works out the engine and variant from the files:","locale":"en"},"13096":{"id":"/en/docs/guide-models-33","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"when the file sizes match a catalogue model, it checks their SHA-256 and imports the folder as that model;","locale":"en"},"13097":{"id":"/en/docs/guide-models-34","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"otherwise it imports it as a user model, `engine/folder-name`.","locale":"en"},"13098":{"id":"/en/docs/guide-models-35","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"The command line can name it, or move rather than copy: `mizuoto model import <folder> [--name name] [--move]`.","locale":"en"},"13099":{"id":"/en/docs/guide-models-36","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#engines","content":"One card per engine:","locale":"en"},"13100":{"id":"/en/docs/guide-models-37","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#engines","content":"Under the title, the number of models and the licence's name (speech recognition says **Used by Mizuoto itself**); at the right **Available** or **Not available**, and **On** *host* when the engine runs on a remote host.","locale":"en"},"13101":{"id":"/en/docs/guide-models-38","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#engines","content":"A line about the engine. When it is not available, what it needs: **Needs** *torch* (or *mizuoto-indextts*…)**, which is not installed: mizuoto doctor says how to install it.** Every engine is part of Mizuoto except the licence-gated ones, which are packages of their own (see First run).","locale":"en"},"13102":{"id":"/en/docs/guide-models-39","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"**Device**: **Automatic**, the devices of this machine the engine supports (such as `cuda:0`, `cpu`), and the devices of each remote host you added where the engine is available (shown as \"host · device\"). With a remote device the engine runs on that machine, the card shows **On** *host*, and its packages are managed there (see Remote hosts).","locale":"en"},"13103":{"id":"/en/docs/guide-models-40","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"**Precision**: **Automatic**, `bf16`, `fp16` or `fp32`.","locale":"en"},"13104":{"id":"/en/docs/guide-models-41","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"**Enabled**: when off, the engine's models cannot be used; Speak then offers an **Enable** button at the bottom.","locale":"en"},"13105":{"id":"/en/docs/guide-models-42","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"Changing these unloads the engine's models; the next use loads them with the new settings.","locale":"en"},"13106":{"id":"/en/docs/guide-models-43","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"When an engine has load options, its card has **Options**:","locale":"en"},"13107":{"id":"/en/docs/guide-models-44","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"Engine","locale":"en"},"13108":{"id":"/en/docs/guide-models-45","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"Options","locale":"en"},"13109":{"id":"/en/docs/guide-models-46","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"CosyVoice","locale":"en"},"13110":{"id":"/en/docs/guide-models-47","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`fp16`: half precision on the GPU, faster and slightly different","locale":"en"},"13111":{"id":"/en/docs/guide-models-48","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"IndexTTS 2 / 2.5","locale":"en"},"13112":{"id":"/en/docs/guide-models-49","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`use_qwen_emo` (the emotion model for described emotions, about 1.2 GB), `use_torch_compile`","locale":"en"},"13113":{"id":"/en/docs/guide-models-50","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"F5-TTS","locale":"en"},"13114":{"id":"/en/docs/guide-models-51","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`ode_method` (`euler` or `midpoint`)","locale":"en"},"13115":{"id":"/en/docs/guide-models-52","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"Qwen3-TTS","locale":"en"},"13116":{"id":"/en/docs/guide-models-53","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`fused_projections`: a fast mode, a few percent faster on a GPU, no longer bit-identical","locale":"en"},"13117":{"id":"/en/docs/guide-models-54","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"**Changes apply when the model loads next (its models are unloaded now).** The setting **Compile models (torch.compile)** under **Settings › Compute** speeds up several engines at once. More in Performance.","locale":"en"},"13118":{"id":"/en/docs/guide-models-55","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#check-this-machine","content":"Expand **Check this machine** for the engine's checks on this machine: torch and its build against the GPU, whether the engine is available, and the optional extras it can use (such as GPT-SoVITS's Japanese front end), with a command to fix each problem. The command line: `mizuoto doctor <engine>`.","locale":"en"},"13119":{"id":"/en/docs/guide-models-56","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#licence","content":"Licence-gated engines (Fish Speech, IndexTTS) have an **Accept the licence** button that opens the full licence; once accepted the card shows **Licence accepted**. See First run.","locale":"en"},"13120":{"id":"/en/docs/guide-models-57","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#shared-files","content":"**Files several models of an engine share, downloaded once with the first model that needs them.** For example GPT-SoVITS's encoders, G2PW, the NLTK data, the Open JTalk dictionary and the discriminators used for training; IndexTTS-2's w2v-BERT, semantic codec, CAM++ and BigVGAN; and CosyVoice's text normalisation grammars.","locale":"en"},"13121":{"id":"/en/docs/guide-models-58","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#shared-files","content":"Each row shows the name, size, description and **used by** *models*. Each can be downloaded or deleted on its own. A model missing a shared file it needs shows as **Partly downloaded**. Shared files are kept in `models/_assets/<engine>/` in the data folder.","locale":"en"},"13122":{"id":"/en/docs/guide-projects","page_id":"/en/docs/guide-projects","type":"page","content":"Projects","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-projects","locale":"en"},"13123":{"id":"/en/docs/guide-projects-0","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"The Projects screen: a cast of voices reads a book, a script or a dialogue line by line; importing scripts, editing lines, rendering, takes and exporting audio with subtitles.","locale":"en"},"13124":{"id":"/en/docs/guide-projects-1","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#the-list","content":"The list","locale":"en"},"13125":{"id":"/en/docs/guide-projects-2","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#a-new-project","content":"A new project","locale":"en"},"13126":{"id":"/en/docs/guide-projects-3","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#the-script-format","content":"The script format","locale":"en"},"13127":{"id":"/en/docs/guide-projects-4","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#importing-a-script","content":"Importing a script","locale":"en"},"13128":{"id":"/en/docs/guide-projects-5","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#editing-the-script","content":"Editing the script","locale":"en"},"13129":{"id":"/en/docs/guide-projects-6","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#chapters","content":"Chapters","locale":"en"},"13130":{"id":"/en/docs/guide-projects-7","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#lines","content":"Lines","locale":"en"},"13131":{"id":"/en/docs/guide-projects-8","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#line-states","content":"Line states","locale":"en"},"13132":{"id":"/en/docs/guide-projects-9","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#cast","content":"Cast","locale":"en"},"13133":{"id":"/en/docs/guide-projects-10","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#rendering","content":"Rendering","locale":"en"},"13134":{"id":"/en/docs/guide-projects-11","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#takes","content":"Takes","locale":"en"},"13135":{"id":"/en/docs/guide-projects-12","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#export","content":"Export","locale":"en"},"13136":{"id":"/en/docs/guide-projects-13","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#deleting","content":"Deleting","locale":"en"},"13137":{"id":"/en/docs/guide-projects-14","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#command-line","content":"Command line","locale":"en"},"13138":{"id":"/en/docs/guide-projects-15","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"**Projects** are for long-form reading: a book, a script or a dialogue with several voices. A project has two parts:","locale":"en"},"13139":{"id":"/en/docs/guide-projects-16","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"**The script**: chapters, each a list of lines. Each line has its text and the speaker who says it, and may have its own style instruction.","locale":"en"},"13140":{"id":"/en/docs/guide-projects-17","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"**The cast**: each speaker has its own model, voice (a library voice, a preset speaker or the model's own voice), language, way of speaking and parameters. **The first speaker is the narrator**: lines without a speaker are theirs. A speaker without a model uses the project's.","locale":"en"},"13141":{"id":"/en/docs/guide-projects-18","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"Each line is rendered on its own, and each rendering is a **take**. After you change a line's text, speaker or settings, only that line needs rendering again; at the end the lines are joined, with the pauses you set, into one file with subtitles. Speakers may use models of different engines.","locale":"en"},"13142":{"id":"/en/docs/guide-projects-19","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"A project is saved in `projects/<name>/project.json` in the data folder.","locale":"en"},"13143":{"id":"/en/docs/guide-projects-20","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-list","content":"Open **Projects** in the navigation. Each card shows the project's name, rendered lines out of all lines (red when some failed), its description, **N chapter(s) · N line(s)**, **N speaker(s)**, the length of what is rendered and a bar coloured by the lines' states. Click a card to open the project.","locale":"en"},"13144":{"id":"/en/docs/guide-projects-21","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Click **New project**.","locale":"en"},"13145":{"id":"/en/docs/guide-projects-22","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Type the **Project name**.","locale":"en"},"13146":{"id":"/en/docs/guide-projects-23","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Choose the **Model**: the project's model, used by the narrator and by every speaker that names none.","locale":"en"},"13147":{"id":"/en/docs/guide-projects-24","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Optionally paste a script under **Script** (see the next section) and choose **Make a line of each**: **line of text** or **sentence**.","locale":"en"},"13148":{"id":"/en/docs/guide-projects-25","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Click **Create**.","locale":"en"},"13149":{"id":"/en/docs/guide-projects-26","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"A new project starts with one speaker, **Narrator**.","locale":"en"},"13150":{"id":"/en/docs/guide-projects-27","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"An imported script is plain text, with these rules (the hint under the box says the same):","locale":"en"},"13151":{"id":"/en/docs/guide-projects-28","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"You write","locale":"en"},"13152":{"id":"/en/docs/guide-projects-29","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"It means","locale":"en"},"13153":{"id":"/en/docs/guide-projects-30","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"`# Title`","locale":"en"},"13154":{"id":"/en/docs/guide-projects-31","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A new chapter, titled with the text after `#`","locale":"en"},"13155":{"id":"/en/docs/guide-projects-32","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"`Name: text` (`:` or `：`), or `[Name]: text`","locale":"en"},"13156":{"id":"/en/docs/guide-projects-33","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A line of that speaker (see the rules below)","locale":"en"},"13157":{"id":"/en/docs/guide-projects-34","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"Any other line","locale":"en"},"13158":{"id":"/en/docs/guide-projects-35","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A line of the narrator","locale":"en"},"13159":{"id":"/en/docs/guide-projects-36","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A blank line","locale":"en"},"13160":{"id":"/en/docs/guide-projects-37","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"The end of a paragraph (the pause after a paragraph is longer when exported)","locale":"en"},"13161":{"id":"/en/docs/guide-projects-38","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A `Name:` prefix counts as a speaker only when one of these holds; otherwise the whole line, prefix included, is the narrator's:","locale":"en"},"13162":{"id":"/en/docs/guide-projects-39","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"the name is already in the cast;","locale":"en"},"13163":{"id":"/en/docs/guide-projects-40","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"the same name begins two or more lines;","locale":"en"},"13164":{"id":"/en/docs/guide-projects-41","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"the script is a dialogue (some name meets one of the two rules above) and the prefix **looks like a name**: it starts with a letter and has at most three words, such as `Dr. Watson` or `林黛玉`.","locale":"en"},"13165":{"id":"/en/docs/guide-projects-42","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"So in a script that is not a dialogue (no name recurs), an occasional \"Note: the power is off tomorrow\" does not become a speaker; but in a dialogue, any prefix that looks like a name does. A dialogue in which every name occurs only once is not recognised; add speakers with those names under **Cast** first, then import.","locale":"en"},"13166":{"id":"/en/docs/guide-projects-43","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"New names join the cast. They have no model or voice yet (they use the project's model); choose their voices under **Cast** after importing.","locale":"en"},"13167":{"id":"/en/docs/guide-projects-44","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"Lines before the first `#` go into one chapter: titled after the project when the project has no chapters yet, else untitled.","locale":"en"},"13168":{"id":"/en/docs/guide-projects-45","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"**Make a line of each**: with **line of text** each line of the script is one line; with **sentence** each is split further into its sentences.","locale":"en"},"13169":{"id":"/en/docs/guide-projects-46","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"An example:","locale":"en"},"13170":{"id":"/en/docs/guide-projects-47","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"It imports as one chapter of six lines: \"Anna\" and \"Old man\" each begin two lines and become two new speakers; the other lines are the narrator's; the first line, the dialogue and the last line are three paragraphs.","locale":"en"},"13171":{"id":"/en/docs/guide-projects-48","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Click **Import a script** at the bottom of the project's page (or in the middle of an empty project), paste the script, choose how to split it and **Add it**:","locale":"en"},"13172":{"id":"/en/docs/guide-projects-49","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Choice","locale":"en"},"13173":{"id":"/en/docs/guide-projects-50","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"What it does","locale":"en"},"13174":{"id":"/en/docs/guide-projects-51","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"**as new chapters**","locale":"en"},"13175":{"id":"/en/docs/guide-projects-52","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Appends the script's chapters to the end of the project","locale":"en"},"13176":{"id":"/en/docs/guide-projects-53","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"**to this chapter**","locale":"en"},"13177":{"id":"/en/docs/guide-projects-54","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Appends every line to the chapter that is open, without making chapters (`#` headings are left out)","locale":"en"},"13178":{"id":"/en/docs/guide-projects-55","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"**instead of the script**","locale":"en"},"13179":{"id":"/en/docs/guide-projects-56","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Replaces every chapter with the script's; the old lines' takes are deleted","locale":"en"},"13180":{"id":"/en/docs/guide-projects-57","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Click **Import**.","locale":"en"},"13181":{"id":"/en/docs/guide-projects-58","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#editing-the-script","content":"A project's page has three tabs: **Script**, **Cast** and **Export**. The top shows its name, the save state (**Saving…**, **Saved**, **Unsaved changes**) and rendered lines out of all, with their length.","locale":"en"},"13182":{"id":"/en/docs/guide-projects-59","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#editing-the-script","content":"Every change is saved a moment after you stop typing, and when you leave the page; there is nothing to save by hand.","locale":"en"},"13183":{"id":"/en/docs/guide-projects-60","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#chapters","content":"**Chapters** on the left lists the chapters, each with its rendered lines out of all; click one to open it. **Add a chapter** makes a new one. Above the lines are the **Chapter title** and a menu with **Move up**, **Move down** and **Delete the chapter** (its lines' takes are deleted too).","locale":"en"},"13184":{"id":"/en/docs/guide-projects-61","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"One row per line, from left to right:","locale":"en"},"13185":{"id":"/en/docs/guide-projects-62","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"a state dot (hover for the state's name; see the next section);","locale":"en"},"13186":{"id":"/en/docs/guide-projects-63","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Speaker**: who says the line; choosing the first speaker (the narrator) means no speaker;","locale":"en"},"13187":{"id":"/en/docs/guide-projects-64","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Text**: Ctrl+Enter in it inserts a line below;","locale":"en"},"13188":{"id":"/en/docs/guide-projects-65","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"a play button for the line's take in use;","locale":"en"},"13189":{"id":"/en/docs/guide-projects-66","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Render this line again**: renders a new take of this line now, even when it is current;","locale":"en"},"13190":{"id":"/en/docs/guide-projects-67","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"a menu:","locale":"en"},"13191":{"id":"/en/docs/guide-projects-68","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Item","locale":"en"},"13192":{"id":"/en/docs/guide-projects-69","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"What it does","locale":"en"},"13193":{"id":"/en/docs/guide-projects-70","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Insert a line below**","locale":"en"},"13194":{"id":"/en/docs/guide-projects-71","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"The new line keeps this line's speaker","locale":"en"},"13195":{"id":"/en/docs/guide-projects-72","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**End the paragraph here** / **Continue the paragraph**","locale":"en"},"13196":{"id":"/en/docs/guide-projects-73","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Where a paragraph ends, for the pauses when exported","locale":"en"},"13197":{"id":"/en/docs/guide-projects-74","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Add a style instruction**","locale":"en"},"13198":{"id":"/en/docs/guide-projects-75","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Shows **Style for this line**, used for this line instead of its speaker's **How it speaks**","locale":"en"},"13199":{"id":"/en/docs/guide-projects-76","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Move up** / **Move down**","locale":"en"},"13200":{"id":"/en/docs/guide-projects-77","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Reorder","locale":"en"},"13201":{"id":"/en/docs/guide-projects-78","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Try in Speak**","locale":"en"},"13202":{"id":"/en/docs/guide-projects-79","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Loads the line's whole request (model, voice, text, parameters) into Speak, to try things out","locale":"en"},"13203":{"id":"/en/docs/guide-projects-80","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Take N (s s)**","locale":"en"},"13204":{"id":"/en/docs/guide-projects-81","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"The line's takes, the one in use marked ✓; click one to use it","locale":"en"},"13205":{"id":"/en/docs/guide-projects-82","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Delete**","locale":"en"},"13206":{"id":"/en/docs/guide-projects-83","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Deletes the line and its takes","locale":"en"},"13207":{"id":"/en/docs/guide-projects-84","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Add a line** at the end of the chapter appends a line. A line that failed shows why beneath it.","locale":"en"},"13208":{"id":"/en/docs/guide-projects-85","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"State","locale":"en"},"13209":{"id":"/en/docs/guide-projects-86","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"Meaning","locale":"en"},"13210":{"id":"/en/docs/guide-projects-87","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Rendered**","locale":"en"},"13211":{"id":"/en/docs/guide-projects-88","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"It has a take, made from its current text and settings","locale":"en"},"13212":{"id":"/en/docs/guide-projects-89","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Changed since its take**","locale":"en"},"13213":{"id":"/en/docs/guide-projects-90","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"It has a take, but its text, speaker, the speaker's model, voice or parameters changed since, or the library voice it uses was changed","locale":"en"},"13214":{"id":"/en/docs/guide-projects-91","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Not rendered**","locale":"en"},"13215":{"id":"/en/docs/guide-projects-92","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"No take yet","locale":"en"},"13216":{"id":"/en/docs/guide-projects-93","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Failed**","locale":"en"},"13217":{"id":"/en/docs/guide-projects-94","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"The last rendering failed; the reason shows beneath the line","locale":"en"},"13218":{"id":"/en/docs/guide-projects-95","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Rendering**","locale":"en"},"13219":{"id":"/en/docs/guide-projects-96","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"Being rendered","locale":"en"},"13220":{"id":"/en/docs/guide-projects-97","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Empty**","locale":"en"},"13221":{"id":"/en/docs/guide-projects-98","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"No text; skipped when rendering and exporting","locale":"en"},"13222":{"id":"/en/docs/guide-projects-99","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"At the top of **Cast**, the **Project** part holds the project's **Model**, **Project name** and **Description**. Below it, one card per speaker:","locale":"en"},"13223":{"id":"/en/docs/guide-projects-100","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Speaker name**; the first speaker carries the **Narrator** badge; beside it the speaker's number of lines and a remove button. A removed speaker's lines go to the narrator.","locale":"en"},"13224":{"id":"/en/docs/guide-projects-101","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Model**: without one, its label reads **Model (the project's: …)**; with one, **Use the project's** goes back.","locale":"en"},"13225":{"id":"/en/docs/guide-projects-102","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"The voice: **Library voice**, **Preset speaker** or **Its own voice**, as the model supports. The library picker shows how this model can use each voice, as in Speak.","locale":"en"},"13226":{"id":"/en/docs/guide-projects-103","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Language**: **The project's language**, or one of the model's languages.","locale":"en"},"13227":{"id":"/en/docs/guide-projects-104","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**How it speaks**: a style instruction for each of this speaker's lines (only when the model takes instructions).","locale":"en"},"13228":{"id":"/en/docs/guide-projects-105","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Parameters**: the same panel as in Speak; it shows **N set** when you changed some.","locale":"en"},"13229":{"id":"/en/docs/guide-projects-106","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Add a speaker** adds one. The project's own language is set under **Project** on the same tab (**Language**; **Each model decides** leaves it to each model), or with `mizuoto project set --lang`.","locale":"en"},"13230":{"id":"/en/docs/guide-projects-107","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"When a speaker's model, voice, language, way of speaking or parameters change, every rendered line of that speaker becomes **Changed since its take**. **Level each take** under Export is a rendering setting too: changing it makes every line stale.","locale":"en"},"13231":{"id":"/en/docs/guide-projects-108","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"Two buttons at the bottom of the page:","locale":"en"},"13232":{"id":"/en/docs/guide-projects-109","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"**Render chapter (N)**: renders every line of the open chapter that is not **Rendered** (not rendered, changed or failed).","locale":"en"},"13233":{"id":"/en/docs/guide-projects-110","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"**Render all (N)**: the same for the whole project.","locale":"en"},"13234":{"id":"/en/docs/guide-projects-111","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"Rendering is one **Render a project** job with a step per chapter. It submits an ordinary speak job per line and keeps up to 8 of them queued, so that **Settings › Speech › Run waiting requests together** can run lines with the same model, voice and settings, differing only in their text, as one batch (on engines that take batches, such as Qwen3-TTS, GPT-SoVITS and OmniVoice). Those speak jobs do not announce themselves one by one; the render announces itself once when it ends.","locale":"en"},"13235":{"id":"/en/docs/guide-projects-112","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"A failed line does not stop the others: it is marked **Failed** with the reason, and the rest go on.","locale":"en"},"13236":{"id":"/en/docs/guide-projects-113","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"Cancelling the render cancels the speak jobs it submitted.","locale":"en"},"13237":{"id":"/en/docs/guide-projects-114","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"You can keep editing while it renders; a changed line is judged stale or not by its new contents.","locale":"en"},"13238":{"id":"/en/docs/guide-projects-115","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#takes","content":"Each rendering of a line adds a take and uses it at once. Up to 5 takes are kept per line; older ones not in use are deleted. **Take N** in the line's menu goes back to an earlier one.","locale":"en"},"13239":{"id":"/en/docs/guide-projects-116","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#takes","content":"Takes are FLAC results and are not listed in History. Deleting a line, a chapter or the project deletes their takes.","locale":"en"},"13240":{"id":"/en/docs/guide-projects-117","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"The **Export** tab:","locale":"en"},"13241":{"id":"/en/docs/guide-projects-118","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Setting","locale":"en"},"13242":{"id":"/en/docs/guide-projects-119","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Default","locale":"en"},"13243":{"id":"/en/docs/guide-projects-120","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"What it does","locale":"en"},"13244":{"id":"/en/docs/guide-projects-121","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Pause after a line (ms)**","locale":"en"},"13245":{"id":"/en/docs/guide-projects-122","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"350","locale":"en"},"13246":{"id":"/en/docs/guide-projects-123","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Silence between two lines of a paragraph","locale":"en"},"13247":{"id":"/en/docs/guide-projects-124","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Pause after a paragraph (ms)**","locale":"en"},"13248":{"id":"/en/docs/guide-projects-125","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"800","locale":"en"},"13249":{"id":"/en/docs/guide-projects-126","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Silence after a line that ends a paragraph","locale":"en"},"13250":{"id":"/en/docs/guide-projects-127","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Pause between chapters (ms)**","locale":"en"},"13251":{"id":"/en/docs/guide-projects-128","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"2000","locale":"en"},"13252":{"id":"/en/docs/guide-projects-129","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Silence between chapters when several are exported together","locale":"en"},"13253":{"id":"/en/docs/guide-projects-130","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Format**","locale":"en"},"13254":{"id":"/en/docs/guide-projects-131","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"WAV","locale":"en"},"13255":{"id":"/en/docs/guide-projects-132","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"WAV, FLAC, MP3, OGG, M4A","locale":"en"},"13256":{"id":"/en/docs/guide-projects-133","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Sample rate**","locale":"en"},"13257":{"id":"/en/docs/guide-projects-134","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"24000","locale":"en"},"13258":{"id":"/en/docs/guide-projects-135","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Every take is resampled to it (speakers' models may differ in rate)","locale":"en"},"13259":{"id":"/en/docs/guide-projects-136","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Level each take**","locale":"en"},"13260":{"id":"/en/docs/guide-projects-137","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**By loudness**","locale":"en"},"13261":{"id":"/en/docs/guide-projects-138","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**By loudness**, **By peak** or **As made**; applied when each line is rendered","locale":"en"},"13262":{"id":"/en/docs/guide-projects-139","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Export what is rendered**: off (the default), every line of what you export must be **Rendered**, else the export is refused; on, lines never rendered are left out and lines changed since their take use the take they have.","locale":"en"},"13263":{"id":"/en/docs/guide-projects-140","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Then click:","locale":"en"},"13264":{"id":"/en/docs/guide-projects-141","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Export this chapter**: the open chapter only; the file is named \"project — chapter title\".","locale":"en"},"13265":{"id":"/en/docs/guide-projects-142","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Export everything**: the whole project as one file.","locale":"en"},"13266":{"id":"/en/docs/guide-projects-143","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Exporting is an **Export a project** job. The file then appears under **Exported files**, where you can play it, **Download** it and download its **Subtitles (SRT)**: one cue per line, timed to the audio. Exported files are listed in History as well.","locale":"en"},"13267":{"id":"/en/docs/guide-projects-144","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#deleting","content":"**Delete** at the bottom of the page moves the project and all its takes to the trash.","locale":"en"},"13268":{"id":"/en/docs/guide-projects-145","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Command","locale":"en"},"13269":{"id":"/en/docs/guide-projects-146","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"What it does","locale":"en"},"13270":{"id":"/en/docs/guide-projects-147","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project new <name> [-m model] [--voice voice \\| --preset speaker] [-l lang] [--script file] [--split line\\|sentence]`","locale":"en"},"13271":{"id":"/en/docs/guide-projects-148","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Create a project, with a narrator and optionally a script","locale":"en"},"13272":{"id":"/en/docs/guide-projects-149","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project import <project> <script> [--split …] [--replace] [--chapter chapter-id]`","locale":"en"},"13273":{"id":"/en/docs/guide-projects-150","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Import a script (append, replace, or into a chapter)","locale":"en"},"13274":{"id":"/en/docs/guide-projects-151","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project cast <project> <speaker-id> [--name] [-m] [-v] [--preset] [-l] [--instruct] [-p name=value] [-O name=value] [--remove]`","locale":"en"},"13275":{"id":"/en/docs/guide-projects-152","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Add, change or remove a speaker; a new id adds one, `''` clears a value","locale":"en"},"13276":{"id":"/en/docs/guide-projects-153","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project set <project> [--name] [-m] [-l] [--line-pause] [--paragraph-pause] [--chapter-pause] [-f] [--sample-rate] [--normalize]`","locale":"en"},"13277":{"id":"/en/docs/guide-projects-154","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Change the project's settings","locale":"en"},"13278":{"id":"/en/docs/guide-projects-155","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project render <project> [-c chapter-id] [--line line-id] [--force]`","locale":"en"},"13279":{"id":"/en/docs/guide-projects-156","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Render the lines without a current take; `--force` renders current ones too","locale":"en"},"13280":{"id":"/en/docs/guide-projects-157","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project export <project> [-o file] [-c chapter-id] [-f format] [--srt file] [--allow-missing]`","locale":"en"},"13281":{"id":"/en/docs/guide-projects-158","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Export; `--srt` writes `.srt` or `.vtt` subtitles","locale":"en"},"13282":{"id":"/en/docs/guide-projects-159","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project show <project>`","locale":"en"},"13283":{"id":"/en/docs/guide-projects-160","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","con