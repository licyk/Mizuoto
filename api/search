/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"GPT-SoVITS `speaker` (batch 4)","locale":"en"},"16674":{"id":"/en/docs/guide-train-156","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"6 GB","locale":"en"},"16675":{"id":"/en/docs/guide-train-157","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"6 GB","locale":"en"},"16676":{"id":"/en/docs/guide-train-158","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"6 GB","locale":"en"},"16677":{"id":"/en/docs/guide-train-159","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"OmniVoice `full`","locale":"en"},"16678":{"id":"/en/docs/guide-train-160","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"16 GB","locale":"en"},"16679":{"id":"/en/docs/guide-train-161","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"16 GB","locale":"en"},"16680":{"id":"/en/docs/guide-train-162","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"6 GB","locale":"en"},"16681":{"id":"/en/docs/guide-train-163","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"OmniVoice LoRA","locale":"en"},"16682":{"id":"/en/docs/guide-train-164","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"12 GB","locale":"en"},"16683":{"id":"/en/docs/guide-train-165","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"4 GB","locale":"en"},"16684":{"id":"/en/docs/guide-train-166","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"4 GB","locale":"en"},"16685":{"id":"/en/docs/guide-train-167","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"Qwen3-TTS 1.7B `speaker`","locale":"en"},"16686":{"id":"/en/docs/guide-train-168","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"24 GB","locale":"en"},"16687":{"id":"/en/docs/guide-train-169","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"24 GB","locale":"en"},"16688":{"id":"/en/docs/guide-train-170","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"12 GB","locale":"en"},"16689":{"id":"/en/docs/guide-train-171","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"VoxCPM 0.5B `full`","locale":"en"},"16690":{"id":"/en/docs/guide-train-172","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"24 GB","locale":"en"},"16691":{"id":"/en/docs/guide-train-173","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"16 GB","locale":"en"},"16692":{"id":"/en/docs/guide-train-174","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"16 GB","locale":"en"},"16693":{"id":"/en/docs/guide-train-175","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"VoxCPM 0.5B / 1.5 / 2 LoRA (batch 16)","locale":"en"},"16694":{"id":"/en/docs/guide-train-176","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"12 GB / 12 GB / 24 GB","locale":"en"},"16695":{"id":"/en/docs/guide-train-177","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"4 GB / 6 GB / 12 GB","locale":"en"},"16696":{"id":"/en/docs/guide-train-178","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"4 GB / 6 GB / 12 GB","locale":"en"},"16697":{"id":"/en/docs/guide-train-179","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"Every engine also trains on a CPU, which is enough to check the whole run works with little data and few steps.","locale":"en"},"16698":{"id":"/en/docs/guide-train-180","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"**Settings › Training** also has **Training precision**, **Checkpoints kept per run** and **Memory**: *Standard* trains as each recipe does; *Low* adds gradient checkpointing (each block of the model runs again in the backward pass instead of keeping its activations) and keeps what is not needed off the GPU, with the same results, slower by a few percent to twice the time (measured on an RTX 3090 a step: F5-TTS +6 %, VoxCPM +51 %, Qwen3-TTS +80 %, OmniVoice +104 %); *Lowest* also keeps the optimizer's state in RAM and streams LoRA's frozen weights from RAM, whose results differ slightly. A method's own **gradient_checkpointing** hyperparameter overrides it.","locale":"en"},"16699":{"id":"/en/docs/guide-train-181","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"**Repeat fine-tunes exactly on a GPU** (`training.deterministic`, off by default): on a GPU two runs of the same experiment give slightly different weights, because kernels that sum with atomics (in many backward passes, and SDPA's fused attention backward) add in a varying order. GPT-SoVITS's losses drift apart after a few steps; Fish Speech's LoRA differs in the last bits. With the setting on, every stage uses torch's deterministic kernels and the math attention kernel: the runs repeat exactly (checked on an RTX 3090 for both). When **Attention** names a backend, it still computes what it can repeat (FlashAttention is asked for its deterministic backward) and the rest goes to the math kernel, so those runs repeat too (OmniVoice with FlashAttention, on two GPUs: the same weights). It costs some time (the test fine-tunes, warm: GPT-SoVITS 30.6 → 34.7 s, Fish Speech 41.1 → 43.0 s) and, on long sequences, the math kernel's memory. On the CPU fine-tunes always repeat.","locale":"en"},"16700":{"id":"/en/docs/guide-train-182","page_id":"/en/docs/guide-train","tags":[],"type":"text","url":"/en/docs/guide-train#cpu-and-gpu","content":"When you pick a method for a new experiment, the dialog shows roughly how much GPU memory a run needs with each Memory setting; the experiment's page shows, in **GPU memory**, the free memory of the GPU it would train on and each setting's estimate, marks the ones that do not fit, and when the current one does not, offers the change that would fit with one button (**Use Lowest**, or **Set Batch size to 3** where no setting helps); a run whose estimate exceeds the GPU's free memory also says so in its log, with the setting that would fit, or a smaller `batch_size` where no setting helps (Fish Speech's LoRA at its default batch of 4 needs more than a 24 GB card under *Standard*; under *Lowest* it fits one). On a GPU each logged step also reports **memory/peak_mb**, what it really used.","locale":"en"},"16701":{"id":"/en/docs/guide-voices","page_id":"/en/docs/guide-voices","type":"page","content":"Voices","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-voices","locale":"en"},"16702":{"id":"/en/docs/guide-voices-0","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"The voice library: make voices from audio, design them, add preset speakers, manage clips, transcripts and fine-tuned weights, see which models can use them, export and import.","locale":"en"},"16703":{"id":"/en/docs/guide-voices-1","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#the-list","content":"The list","locale":"en"},"16704":{"id":"/en/docs/guide-voices-2","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#a-new-voice","content":"A new voice","locale":"en"},"16705":{"id":"/en/docs/guide-voices-3","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#the-voices-page","content":"The voice's page","locale":"en"},"16706":{"id":"/en/docs/guide-voices-4","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#reference-clips","content":"Reference clips","locale":"en"},"16707":{"id":"/en/docs/guide-voices-5","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#fine-tuned-weights","content":"Fine-tuned weights","locale":"en"},"16708":{"id":"/en/docs/guide-voices-6","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#which-models-can-use-it","content":"Which models can use it","locale":"en"},"16709":{"id":"/en/docs/guide-voices-7","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#try-it","content":"Try it","locale":"en"},"16710":{"id":"/en/docs/guide-voices-8","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#details","content":"Details","locale":"en"},"16711":{"id":"/en/docs/guide-voices-9","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#the-page-footer","content":"The page footer","locale":"en"},"16712":{"id":"/en/docs/guide-voices-10","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#import","content":"Import","locale":"en"},"16713":{"id":"/en/docs/guide-voices-11","page_id":"/en/docs/guide-voices","type":"heading","tags":[],"url":"/en/docs/guide-voices#command-line","content":"Command line","locale":"en"},"16714":{"id":"/en/docs/guide-voices-12","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"**Voices** is the voice library. A voice can be used again and again in **Speak**, **Projects** and **Tools**; when you change models, Mizuoto works out how the new model can use it.","locale":"en"},"16715":{"id":"/en/docs/guide-voices-13","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"There are four kinds:","locale":"en"},"16716":{"id":"/en/docs/guide-voices-14","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"Kind","locale":"en"},"16717":{"id":"/en/docs/guide-voices-15","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"Where it comes from","locale":"en"},"16718":{"id":"/en/docs/guide-voices-16","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"**From a clip**","locale":"en"},"16719":{"id":"/en/docs/guide-voices-17","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"One or more reference clips with their transcripts, for cloning","locale":"en"},"16720":{"id":"/en/docs/guide-voices-18","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"**Designed**","locale":"en"},"16721":{"id":"/en/docs/guide-voices-19","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"A voice a design model made from a description; the clip it spoke becomes its main clip, so other models can clone it too","locale":"en"},"16722":{"id":"/en/docs/guide-voices-20","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"**Preset**","locale":"en"},"16723":{"id":"/en/docs/guide-voices-21","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"A model's preset speaker, for that model only","locale":"en"},"16724":{"id":"/en/docs/guide-voices-22","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"**Trained**","locale":"en"},"16725":{"id":"/en/docs/guide-voices-23","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"A voice with its own fine-tuned weights, from training (see Train)","locale":"en"},"16726":{"id":"/en/docs/guide-voices-24","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices","content":"Each voice is a folder under `voices/<name>/` in the data folder (`voice.json` and FLAC clips in `references/`). The list is a scan of those folders, so a voice folder copied in appears too.","locale":"en"},"16727":{"id":"/en/docs/guide-voices-25","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#the-list","content":"At the top: **Search voices**, chips to filter by kind, **Import a voice** and **New voice**. Each card shows the name, kind, description, language, **Clips: N** and their total length; **Play its clip** plays the main clip, and **Use in Speak** opens Speak with the voice chosen. Click a card to open the voice's page.","locale":"en"},"16728":{"id":"/en/docs/guide-voices-26","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Click **New voice**, type a **Name**, then choose a way:","locale":"en"},"16729":{"id":"/en/docs/guide-voices-27","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Add one or more reference clips: drop or choose files, **Record** (3 to 30 seconds of clear speech works best), **Server files** or **Earlier results**.","locale":"en"},"16730":{"id":"/en/docs/guide-voices-28","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Each clip gets a **What is said in the clip** field. It may stay empty: **Missing transcripts are filled by speech recognition when it is installed.**","locale":"en"},"16731":{"id":"/en/docs/guide-voices-29","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Choose the **Language** (or **Any language**).","locale":"en"},"16732":{"id":"/en/docs/guide-voices-30","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Click **Create**.","locale":"en"},"16733":{"id":"/en/docs/guide-voices-31","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"You need an installed model that designs voices, such as Qwen3-TTS 1.7B VoiceDesign; without one the dialog says **No design model is installed.**","locale":"en"},"16734":{"id":"/en/docs/guide-voices-32","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Choose the **Design model**.","locale":"en"},"16735":{"id":"/en/docs/guide-voices-33","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Describe the voice under **The voice, described**, for example \"A warm, low male voice, calm and a little hoarse\".","locale":"en"},"16736":{"id":"/en/docs/guide-voices-34","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"**What the voice says in its sample** is the sentence to listen to; change it if you like.","locale":"en"},"16737":{"id":"/en/docs/guide-voices-35","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Click **Generate**. Each click makes one candidate under **Candidates** (the last 4 are kept); listen to each.","locale":"en"},"16738":{"id":"/en/docs/guide-voices-36","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Click **Keep this one** beside the one you like: it becomes a **Designed** voice.","locale":"en"},"16739":{"id":"/en/docs/guide-voices-37","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Choose the **Model** (only installed models with preset speakers are listed).","locale":"en"},"16740":{"id":"/en/docs/guide-voices-38","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Choose the **Speaker**.","locale":"en"},"16741":{"id":"/en/docs/guide-voices-39","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Click **Create**.","locale":"en"},"16742":{"id":"/en/docs/guide-voices-40","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#a-new-voice","content":"Any result can become a voice too: **Keep as a voice** in its menu.","locale":"en"},"16743":{"id":"/en/docs/guide-voices-41","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#the-voices-page","content":"The top shows the name and kind; a designed voice also shows **Designed with** *model* and its description, a preset voice **Speaker** *name* **of** *model*.","locale":"en"},"16744":{"id":"/en/docs/guide-voices-42","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#reference-clips","content":"(Not for preset voices.) One row per clip: a play button, the waveform (click or drag to seek), its length and sample rate, and:","locale":"en"},"16745":{"id":"/en/docs/guide-voices-43","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#reference-clips","content":"the **Main clip** badge, or **Make it the main clip**. The main clip comes first when the voice is cloned, and is the one played from the list.","locale":"en"},"16746":{"id":"/en/docs/guide-voices-44","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#reference-clips","content":"a remove button (one clip must remain).","locale":"en"},"16747":{"id":"/en/docs/guide-voices-45","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#reference-clips","content":"below it, the clip's transcript; click **Save** (or press Enter) after changing it.","locale":"en"},"16748":{"id":"/en/docs/guide-voices-46","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#reference-clips","content":"**Transcribe again** has speech recognition transcribe every clip again; **Add a clip** adds another.","locale":"en"},"16749":{"id":"/en/docs/guide-voices-47","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#fine-tuned-weights","content":"(For voices from a clip and trained voices.) A voice can carry its own fine-tuned weights for an engine; today that is GPT-SoVITS: a GPT `.ckpt` and a SoVITS `.pth`.","locale":"en"},"16750":{"id":"/en/docs/guide-voices-48","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#fine-tuned-weights","content":"Choose the **Engine**.","locale":"en"},"16751":{"id":"/en/docs/guide-voices-49","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#fine-tuned-weights","content":"**Choose the gpt file (.ckpt)** and **Choose the sovits file (.pth)**.","locale":"en"},"16752":{"id":"/en/docs/guide-voices-50","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#fine-tuned-weights","content":"Click **Add the weights**; when the upload is done it says **Weights for GPT-SoVITS added**.","locale":"en"},"16753":{"id":"/en/docs/guide-voices-51","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#fine-tuned-weights","content":"The weights' version is read from the files. GPT-SoVITS models of the same version switch to these weights when they use the voice (marked **own weights** under **Which models can use it**); models of another version warn and clone as usual. **The voice keeps its clips too: the engine still needs a reference clip with the weights.** Weights exported by a training experiment are added to the voice for you.","locale":"en"},"16754":{"id":"/en/docs/guide-voices-52","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#which-models-can-use-it","content":"Each installed model, and whether and how it can use the voice: **Clone**, **Clone (no transcript)**, **Preset speaker**, **Designed** or **Trained**, with badges such as **own weights**, **transcribed first** or **trimmed to fit**; models that cannot say why.","locale":"en"},"16755":{"id":"/en/docs/guide-voices-53","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#which-models-can-use-it","content":"Rows that clone have a **Prepare** button: it computes and caches what the model needs from the clips ahead of time, so the first synthesis is faster. Otherwise the first synthesis does it once by itself.","locale":"en"},"16756":{"id":"/en/docs/guide-voices-54","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#try-it","content":"Choose a usable **Model**, change the **Text** if you like, and click **Speak**. The results are listed below.","locale":"en"},"16757":{"id":"/en/docs/guide-voices-55","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#details","content":"**Name**, **Language**, **Tags** (comma-separated) and **Description**; click **Save** after changing them.","locale":"en"},"16758":{"id":"/en/docs/guide-voices-56","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#the-page-footer","content":"**Delete**: moves the voice to the data folder's trash (`trash/`).","locale":"en"},"16759":{"id":"/en/docs/guide-voices-57","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#the-page-footer","content":"**Export**: downloads a zip with the voice's details, clips and fine-tuned weights.","locale":"en"},"16760":{"id":"/en/docs/guide-voices-58","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#the-page-footer","content":"**Use in Speak**: opens Speak with this voice.","locale":"en"},"16761":{"id":"/en/docs/guide-voices-59","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#import","content":"Click **Import a voice** on the list and choose an exported zip.","locale":"en"},"16762":{"id":"/en/docs/guide-voices-60","page_id":"/en/docs/guide-voices","tags":[],"type":"text","url":"/en/docs/guide-voices#command-line","content":"The other commands (`add-ref`, `set-transcript`, `retranscribe`, `edit`, `remove`…) are in `mizuoto voice --help` and the command reference. `voice add`, `voice from-output` and `voice edit` take `--consent`, an optional note on whose voice it is that is stored with the voice (`voice info` prints it); nothing requires it.","locale":"en"},"16763":{"id":"/en/docs/guide","page_id":"/en/docs/guide","type":"page","content":"Interface overview","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide","locale":"en"},"16764":{"id":"/en/docs/guide-0","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide","content":"The web UI's layout: navigation, the jobs sheet, the models in memory, the theme, and the guide to each screen.","locale":"en"},"16765":{"id":"/en/docs/guide-1","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#navigation","content":"Navigation","locale":"en"},"16766":{"id":"/en/docs/guide-2","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#the-top-bar","content":"The top bar","locale":"en"},"16767":{"id":"/en/docs/guide-3","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#the-page-footer","content":"The page footer","locale":"en"},"16768":{"id":"/en/docs/guide-4","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#the-screens","content":"The screens","locale":"en"},"16769":{"id":"/en/docs/guide-5","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide","content":"This section explains the Mizuoto web UI screen by screen. If you have not installed or started Mizuoto yet, read Quick start first. Every action in the UI has a `mizuoto` command too; see Command line.","locale":"en"},"16770":{"id":"/en/docs/guide-6","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"The navigation is on the left. In a narrow window (a phone) it moves to the bottom, which shows the first four screens and **More**; More opens the rest (**Train**, **Models**, **History**, **Settings**):","locale":"en"},"16771":{"id":"/en/docs/guide-7","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Screen","locale":"en"},"16772":{"id":"/en/docs/guide-8","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"What it is for","locale":"en"},"16773":{"id":"/en/docs/guide-9","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Speak**","locale":"en"},"16774":{"id":"/en/docs/guide-10","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Choose a model and a voice and turn text into speech","locale":"en"},"16775":{"id":"/en/docs/guide-11","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Projects**","locale":"en"},"16776":{"id":"/en/docs/guide-12","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"A cast of voices reads a book, a script or a dialogue line by line","locale":"en"},"16777":{"id":"/en/docs/guide-13","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Tools**","locale":"en"},"16778":{"id":"/en/docs/guide-14","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Convert voice** and **Edit speech**","locale":"en"},"16779":{"id":"/en/docs/guide-15","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Voices**","locale":"en"},"16780":{"id":"/en/docs/guide-16","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"The voice library: make, design, import and export voices, and see which models can use them","locale":"en"},"16781":{"id":"/en/docs/guide-17","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Train**","locale":"en"},"16782":{"id":"/en/docs/guide-18","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Datasets and experiments: fine-tune models on your own recordings","locale":"en"},"16783":{"id":"/en/docs/guide-19","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Models**","locale":"en"},"16784":{"id":"/en/docs/guide-20","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Model downloads, engines and shared files","locale":"en"},"16785":{"id":"/en/docs/guide-21","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**History**","locale":"en"},"16786":{"id":"/en/docs/guide-22","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Every result","locale":"en"},"16787":{"id":"/en/docs/guide-23","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Settings** (at the bottom)","locale":"en"},"16788":{"id":"/en/docs/guide-24","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Language, server, compute devices, download sources, storage, appearance and more","locale":"en"},"16789":{"id":"/en/docs/guide-25","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"The UI opens on the screen you were last on. Each screen keeps its state (and scroll position) while you visit others; the page of each voice, dataset, experiment and project keeps its own.","locale":"en"},"16790":{"id":"/en/docs/guide-26","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-top-bar","content":"Four buttons at the top right:","locale":"en"},"16791":{"id":"/en/docs/guide-27","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-top-bar","content":"**Jobs**: while jobs run it shows a spinner and their number (**N running**). It opens the jobs sheet with the 30 most recent jobs; each job card shows the state and progress (for downloads also the amount done, the speed and the time left) and offers **Cancel**, **Retry** and **Log**. **All jobs** opens the full list, filtered by **All**, **Active** or **Finished**, where **Clear finished** tidies the history. A queued job says what it waits for, such as **Waiting for the GPU**, **Waiting for the engine**, **Waiting for other synthesis jobs** (see **Synthesis jobs at once** in Settings) or **Waiting for other downloads**; when another job holds the GPU, **Run anyway** runs it beside that one if the memory suffices.","locale":"en"},"16792":{"id":"/en/docs/guide-28","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-top-bar","content":"**Models in memory**: shows how many models are loaded (**N loaded**). It lists each loaded model with its device, the memory its weights take and whether it is **Busy** or **Idle**; **Unload** one, or **Free GPU memory** to unload every idle model at once. An engine whose last request failed is listed with the error.","locale":"en"},"16793":{"id":"/en/docs/guide-29","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-top-bar","content":"**Help**: opens this documentation in a new browser tab.","locale":"en"},"16794":{"id":"/en/docs/guide-30","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-top-bar","content":"**Theme**: cycles through light, dark and following the system. More under **Settings › Appearance**.","locale":"en"},"16795":{"id":"/en/docs/guide-31","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-top-bar","content":"When a job started on another screen finishes or fails, a message pops up at the bottom of the window; a failure's message has an **Open log** button.","locale":"en"},"16796":{"id":"/en/docs/guide-32","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-page-footer","content":"The main button of **Speak**, **Tools** and other screens stays at the bottom of the page, with the jobs started there and any error. An error shows the **Reason** and **What to do**, with **Details** to expand and a **Copy** button.","locale":"en"},"16797":{"id":"/en/docs/guide-33","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-page-footer","content":"When the chosen model is not ready yet, the main button is replaced by the one step it still needs — **Enable**, **Accept the** *engine* **licence**, the command that installs what the engine needs (torch, or a licence-gated engine's package) or **Download** *model* *(size)* — with its progress while it runs.","locale":"en"},"16798":{"id":"/en/docs/guide-34","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"Speak\" href=\"/docs/guide-speak\" description=\"Model, voice, text, style, parameters and presets, the plan, streaming and results.\" />","locale":"en"},"16799":{"id":"/en/docs/guide-35","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"Voices\" href=\"/docs/guide-voices\" description=\"The voice library: from audio, designed, preset speakers, clips, fine-tuned weights, export and import.\" />","locale":"en"},"16800":{"id":"/en/docs/guide-36","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"Projects\" href=\"/docs/guide-projects\" description=\"Long-form reading: chapters and lines, the cast, script import, rendering, takes and export.\" />","locale":"en"},"16801":{"id":"/en/docs/guide-37","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"Tools\" href=\"/docs/guide-tools\" description=\"Voice conversion (CosyVoice) and speech editing (F5-TTS).\" />","locale":"en"},"16802":{"id":"/en/docs/guide-38","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"Models\" href=\"/docs/guide-models\" description=\"The catalogue, engine cards (availability, device, precision, options, licence) and shared files.\" />","locale":"en"},"16803":{"id":"/en/docs/guide-39","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"Train\" href=\"/docs/guide-train\" description=\"Datasets and their preparation; experiments, stages, losses, previews and exports.\" />","locale":"en"},"16804":{"id":"/en/docs/guide-40","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"History\" href=\"/docs/guide-history\" description=\"Every result: search, filter, favourites, run again, download and delete.\" />","locale":"en"},"16805":{"id":"/en/docs/guide-41","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#the-screens","content":"<Card title=\"Settings\" href=\"/docs/guide-settings\" description=\"General, Compute, Remote hosts, Speech, Training, Downloads, Storage, Appearance and About.\" />","locale":"en"},"16806":{"id":"/en/docs","page_id":"/en/docs","type":"page","content":"Mizuoto","breadcrumbs":["Mizuoto Documentation","Getting started"],"tags":[],"url":"/en/docs","locale":"en"},"16807":{"id":"/en/docs-0","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Open text-to-speech engines in one platform: one web UI, one command line and one HTTP API.","locale":"en"},"16808":{"id":"/en/docs-1","page_id":"/en/docs","type":"heading","tags":[],"url":"/en/docs#what-it-does","content":"What it does","locale":"en"},"16809":{"id":"/en/docs-2","page_id":"/en/docs","type":"heading","tags":[],"url":"/en/docs#engines","content":"Engines","locale":"en"},"16810":{"id":"/en/docs-3","page_id":"/en/docs","type":"heading","tags":[],"url":"/en/docs#sections","content":"Sections","locale":"en"},"16811":{"id":"/en/docs-4","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Mizuoto puts open text-to-speech engines — CosyVoice, F5-TTS, GPT-SoVITS, OmniVoice, Qwen3-TTS, VoxCPM, Fish Speech and IndexTTS — into **one platform**: one local server, one web UI and one command line, `mizuoto`. Use it to speak text, clone and design voices, have a cast of voices read a whole book or script, convert and edit recordings, and fine-tune models on your own recordings.","locale":"en"},"16812":{"id":"/en/docs-5","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Every engine is implemented in Mizuoto itself, on its own runtime over torch, and runs inside the server's process; there is one Python environment and nothing to build per engine. Requests, voices, parameters, jobs and results look the same whichever engine serves them.","locale":"en"},"16813":{"id":"/en/docs-6","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"First time here\" href=\"/docs/quick-start\" description=\"From nothing to the first spoken sentence, the short way.\" />","locale":"en"},"16814":{"id":"/en/docs-7","page_id":"/en