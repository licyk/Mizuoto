ibution is installed. The top level:","locale":"en"},"12333":{"id":"/en/docs/development-engine-32","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"Field","locale":"en"},"12334":{"id":"/en/docs/development-engine-33","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"Meaning","locale":"en"},"12335":{"id":"/en/docs/development-engine-34","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"`id`","locale":"en"},"12336":{"id":"/en/docs/development-engine-35","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"The engine id; the implementation is registered under the same id","locale":"en"},"12337":{"id":"/en/docs/development-engine-36","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"`devices`","locale":"en"},"12338":{"id":"/en/docs/development-engine-37","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"Device kinds the engine runs on (`cuda`, `cpu`, `mps`, `xpu`)","locale":"en"},"12339":{"id":"/en/docs/development-engine-38","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"`languages`","locale":"en"},"12340":{"id":"/en/docs/development-engine-39","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"Canonical language codes; `*` means any","locale":"en"},"12341":{"id":"/en/docs/development-engine-40","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#1-the-manifest","content":"`[upstream]`","locale":"en"},"12342":{"id":"/en/docs/