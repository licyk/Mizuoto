erformance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"3,375 → 3,651 → 3,647","locale":"en"},"13526":{"id":"/en/docs/development-performance-846","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"4,885 → 4,231 → 3,445","locale":"en"},"13527":{"id":"/en/docs/development-performance-847","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"GPT-SoVITS v2","locale":"en"},"13528":{"id":"/en/docs/development-performance-848","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"1,973 → 1,509 → 1,507","locale":"en"},"13529":{"id":"/en/docs/development-performance-849","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"2,959 → 3,779 → 3,467","locale":"en"},"13530":{"id":"/en/docs/development-performance-850","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"IndexTTS 2","locale":"en"},"13531":{"id":"/en/docs/development-performance-851","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"9,337 → 6,907 → 6,889","locale":"en"},"13532":{"id":"/en/docs/development-performance-852","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"7,459 → 8,537 → 8,318","locale":"en"},"13533":{"id":"/en/docs/development-performance-853","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#first-audio-and-memory-against-01-g8","content":"GPU memory is within 10 % of 0.1 or below it (CosyVoice 2 +8 %, GPT-SoVITS and IndexTTS a quarter less). RAM is higher where 0.1 loaded straight onto the GPU (transformers' `device_map`, Qwen3-TTS): Mizuoto builds every model in RAM for the model manager to place, and by default keeps it there as a host copy, so offloading costs no transfer (memory); without host copies the peak is that staging. 0.1's optional accelerators (vLLM, TensorRT) are installed in none of its environments here and were not compared.","locale":"en"},"13534":{"id":"/en/docs/development-performance-854","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#loading-without-a-ram-copy-g10","content":"2026-11-04, weights left in the checkpoint's file while a model loads for a GPU (memory). One model per process, one case per engine, every load from a warm page cache; RAM sampled every 0.1 s (anonymous memory, the process's own; file-backed pages are page cache), reload = a run after moving the model to RAM against a warm run. GPU: RTX 3060 12 GB (31 GB RAM, torch 2.8 + CUDA 12.8), two rounds before and three after; CPU: Ryzen 9 5900X, 12 threads. Every output is identical to before's.","locale":"en"},"13535":{"id":"/en/docs/development-performance-855","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#loading-without-a-ram-copy-g10","content":"Model","locale":"en"},"13536":{"id":"/en/docs/development-performance-856","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#loading-without-a-ram-copy-g10","content":"Load s, before → after","locale":"en"},"13537":{"id":"/en/docs/development-performance-857","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#loading-without-a-ram-cop