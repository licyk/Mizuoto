ntent":"What it does","locale":"en"},"13949":{"id":"/en/docs/installation-66","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"`--port <port>`","locale":"en"},"13950":{"id":"/en/docs/installation-67","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"The first port to try, from the settings by default (7869); `0` picks any free port","locale":"en"},"13951":{"id":"/en/docs/installation-68","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"`--strict-port`","locale":"en"},"13952":{"id":"/en/docs/installation-69","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"Fail when the port is taken instead of trying the next one","locale":"en"},"13953":{"id":"/en/docs/installation-70","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"`--open` / `--no-open`","locale":"en"},"13954":{"id":"/en/docs/installation-71","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"Open the web UI in a browser or not","locale":"en"},"13955":{"id":"/en/docs/installation-72","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"`--host <address>`","locale":"en"},"13956":{"id":"/en/docs/installation-73","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"The address to listen on, `127.0.0.1` by default: this machine only","locale":"en"},"13957":{"id":"/en/docs/installation-74","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#starting","content":"`--data-dir <folder>`","locale":"en"},"13958":{"id":"/en/docs/installation-75","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#startin