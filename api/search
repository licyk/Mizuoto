/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"6.5 GB","locale":"en"},"8884":{"id":"/en/docs/advanced-engines-143","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"yes","locale":"en"},"8885":{"id":"/en/docs/advanced-engines-144","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"`qwen3tts/0.6b-custom-voice`","locale":"en"},"8886":{"id":"/en/docs/advanced-engines-145","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"CustomVoice 0.6B (preset speakers)","locale":"en"},"8887":{"id":"/en/docs/advanced-engines-146","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"2.4 GB","locale":"en"},"8888":{"id":"/en/docs/advanced-engines-147","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"4 GB","locale":"en"},"8889":{"id":"/en/docs/advanced-engines-148","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"`qwen3tts/1.7b-voice-design`","locale":"en"},"8890":{"id":"/en/docs/advanced-engines-149","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"VoiceDesign (voice from a description)","locale":"en"},"8891":{"id":"/en/docs/advanced-engines-150","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"4.3 GB","locale":"en"},"8892":{"id":"/en/docs/advanced-engines-151","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"6.5 GB","locale":"en"},"8893":{"id":"/en/docs/advanced-engines-152","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"yes","locale":"en"},"8894":{"id":"/en/docs/advanced-engines-153","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"**Capabilities**: Base has **Clone a voice** and **Clone without a transcript**; CustomVoice has **Preset speakers** and **Instructions** (the 0.6B has no instructions: upstream drops them silently, so Mizuoto does not declare them); VoiceDesign has **Design from a description**. Every variant has **Streaming** (frame by frame, the first audio after about 0.3 s on a GPU), **Batches** (up to 8) and **Seed**.","locale":"en"},"8895":{"id":"/en/docs/advanced-engines-154","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"**Preset speakers**: aiden, dylan, eric, ono_anna, ryan, serena, sohee, uncle_fu, vivian.","locale":"en"},"8896":{"id":"/en/docs/advanced-engines-155","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"**Languages**: zh, en, de, it, pt, es, ja, ko, fr, ru.","locale":"en"},"8897":{"id":"/en/docs/advanced-engines-156","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"**Reference clips**: 1–30 s, at least 16 kHz (3–20 s works best). With the clip's transcript it follows the voice more closely.","locale":"en"},"8898":{"id":"/en/docs/advanced-engines-157","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"**Long text**: upstream does not split it, so Mizuoto does.","locale":"en"},"8899":{"id":"/en/docs/advanced-engines-158","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"**Training**: **Teach it a speaker** (`speaker`, the 1.7B Base only): upstream's single-speaker fine-tune (`sft_12hz.py`), reimplemented; the Base model learns the dataset's voice and is exported as a new CustomVoice model with that voice as its preset speaker. A few minutes of one speaker; 24 GB of GPU memory or more for the 1.7B.","locale":"en"},"8900":{"id":"/en/docs/advanced-engines-159","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#qwen3-tts","content":"**Load options**: Attention follows the attention settings. `fused_projections` (off) is a fast mode: each layer's q/k/v and gate/up projections become one product each, a few percent faster on a GPU, where the audio is then no longer bit-identical to the original implementation's (outputs list `fused_projections`).","locale":"en"},"8901":{"id":"/en/docs/advanced-engines-160","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Alibaba Tongyi's LLM + flow-matching TTS. Best for: low-latency token-level streaming, speaking text as it is written (streamed text input), converting a recording to another voice, and instructions for dialects, emotions and speed.","locale":"en"},"8902":{"id":"/en/docs/advanced-engines-161","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Model","locale":"en"},"8903":{"id":"/en/docs/advanced-engines-162","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Variant","locale":"en"},"8904":{"id":"/en/docs/advanced-engines-163","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Size","locale":"en"},"8905":{"id":"/en/docs/advanced-engines-164","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"GPU memory","locale":"en"},"8906":{"id":"/en/docs/advanced-engines-165","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Recommended","locale":"en"},"8907":{"id":"/en/docs/advanced-engines-166","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"`cosyvoice/cosyvoice3-0.5b`","locale":"en"},"8908":{"id":"/en/docs/advanced-engines-167","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Fun-CosyVoice 3","locale":"en"},"8909":{"id":"/en/docs/advanced-engines-168","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"4.2 GB","locale":"en"},"8910":{"id":"/en/docs/advanced-engines-169","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"6 GB","locale":"en"},"8911":{"id":"/en/docs/advanced-engines-170","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"yes","locale":"en"},"8912":{"id":"/en/docs/advanced-engines-171","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"`cosyvoice/cosyvoice2-0.5b`","locale":"en"},"8913":{"id":"/en/docs/advanced-engines-172","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"CosyVoice 2","locale":"en"},"8914":{"id":"/en/docs/advanced-engines-173","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"2.9 GB","locale":"en"},"8915":{"id":"/en/docs/advanced-engines-174","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"5 GB","locale":"en"},"8916":{"id":"/en/docs/advanced-engines-175","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"yes","locale":"en"},"8917":{"id":"/en/docs/advanced-engines-176","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"`cosyvoice/cosyvoice-300m`","locale":"en"},"8918":{"id":"/en/docs/advanced-engines-177","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"CosyVoice 1 (300M)","locale":"en"},"8919":{"id":"/en/docs/advanced-engines-178","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"2.2 GB","locale":"en"},"8920":{"id":"/en/docs/advanced-engines-179","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"3.5 GB","locale":"en"},"8921":{"id":"/en/docs/advanced-engines-180","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"`cosyvoice/cosyvoice-300m-sft`","locale":"en"},"8922":{"id":"/en/docs/advanced-engines-181","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"CosyVoice 1 SFT (preset speakers)","locale":"en"},"8923":{"id":"/en/docs/advanced-engines-182","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"2.2 GB","locale":"en"},"8924":{"id":"/en/docs/advanced-engines-183","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"3.5 GB","locale":"en"},"8925":{"id":"/en/docs/advanced-engines-184","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"`cosyvoice/cosyvoice-300m-instruct`","locale":"en"},"8926":{"id":"/en/docs/advanced-engines-185","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"CosyVoice 1 Instruct","locale":"en"},"8927":{"id":"/en/docs/advanced-engines-186","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"2.2 GB","locale":"en"},"8928":{"id":"/en/docs/advanced-engines-187","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"3.5 GB","locale":"en"},"8929":{"id":"/en/docs/advanced-engines-188","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Variant","locale":"en"},"8930":{"id":"/en/docs/advanced-engines-189","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Sample rate","locale":"en"},"8931":{"id":"/en/docs/advanced-engines-190","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"Main capabilities","locale":"en"},"8932":{"id":"/en/docs/advanced-engines-191","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"v1_base","locale":"en"},"8933":{"id":"/en/docs/advanced-engines-192","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"22.05 kHz","locale":"en"},"8934":{"id":"/en/docs/advanced-engines-193","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Clone a voice**, **Clone without a transcript**, **Voice conversion**, **Streaming**, **Speed**, **Inline tags**, **Long text**","locale":"en"},"8935":{"id":"/en/docs/advanced-engines-194","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"v1_sft","locale":"en"},"8936":{"id":"/en/docs/advanced-engines-195","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"22.05 kHz","locale":"en"},"8937":{"id":"/en/docs/advanced-engines-196","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"the above plus **Preset speakers** (no inline tags)","locale":"en"},"8938":{"id":"/en/docs/advanced-engines-197","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"v1_instruct","locale":"en"},"8939":{"id":"/en/docs/advanced-engines-198","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"22.05 kHz","locale":"en"},"8940":{"id":"/en/docs/advanced-engines-199","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Preset speakers**, **Instructions**, **Streaming**, **Speed**, **Inline tags**, **Long text** (no cloning)","locale":"en"},"8941":{"id":"/en/docs/advanced-engines-200","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"v2","locale":"en"},"8942":{"id":"/en/docs/advanced-engines-201","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"24 kHz","locale":"en"},"8943":{"id":"/en/docs/advanced-engines-202","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Clone a voice**, **Clone without a transcript**, **Instructions**, **Voice conversion**, **Streaming**, **Streaming text**, **Speed**, **Inline tags**, **Long text**","locale":"en"},"8944":{"id":"/en/docs/advanced-engines-203","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"v3","locale":"en"},"8945":{"id":"/en/docs/advanced-engines-204","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"24 kHz","locale":"en"},"8946":{"id":"/en/docs/advanced-engines-205","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"as v2, plus **Pronunciation**, without **Long text**","locale":"en"},"8947":{"id":"/en/docs/advanced-engines-206","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Languages**: zh, en, ja, ko, yue; v3: zh, en, ja, ko, de, es, fr, it, ru, yue.","locale":"en"},"8948":{"id":"/en/docs/advanced-engines-207","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Preset speakers** (v1 SFT / Instruct): 中文女, 中文男, 日语男, 粤语女, 英文女, 英文男, 韩语女.","locale":"en"},"8949":{"id":"/en/docs/advanced-engines-208","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Inline tags**: v1 `[laughter]`, `[breath]`, `<strong></strong>`; v2 adds `<laughter></laughter>`; v3 has eleven, such as `[breath]`, `[laughter]`, `[cough]`, `[sigh]`.","locale":"en"},"8950":{"id":"/en/docs/advanced-engines-209","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Reference clips**: 1–30 s, at least 16 kHz.","locale":"en"},"8951":{"id":"/en/docs/advanced-engines-210","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Streaming**: v2/v3 stream token by token; streamed text input needs the reference clip's transcript (zero-shot cloning or instruct2).","locale":"en"},"8952":{"id":"/en/docs/advanced-engines-211","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Training** (GPU or CPU): **Fine-tune the language model** (`llm`) and **Fine-tune the LLM and the flow** (`llm_flow`), from v1_base, v2 or v3, following upstream's LibriTTS recipe; at least 60 s of data; exported as a new model. The LLM alone makes prosody and pronunciation follow the dataset; with the flow the timbre follows too.","locale":"en"},"8953":{"id":"/en/docs/advanced-engines-212","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Shared files**: `cosyvoice/wetext` (13 MB, the text normalisation grammars that write out numbers, dates and units), downloaded with the first model.","locale":"en"},"8954":{"id":"/en/docs/advanced-engines-213","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#cosyvoice","content":"**Load option**: `fp16` (half precision on the GPU: faster, slightly different).","locale":"en"},"8955":{"id":"/en/docs/advanced-engines-214","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"A flow-matching TTS that clones a voice from a short clip and its transcript. Best for: exact control of the generated duration, and replacing a few words of a recording (speech editing).","locale":"en"},"8956":{"id":"/en/docs/advanced-engines-215","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"Model","locale":"en"},"8957":{"id":"/en/docs/advanced-engines-216","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"Variant","locale":"en"},"8958":{"id":"/en/docs/advanced-engines-217","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"Size","locale":"en"},"8959":{"id":"/en/docs/advanced-engines-218","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"GPU memory","locale":"en"},"8960":{"id":"/en/docs/advanced-engines-219","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"Recommended","locale":"en"},"8961":{"id":"/en/docs/advanced-engines-220","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"`f5tts/v1-base`","locale":"en"},"8962":{"id":"/en/docs/advanced-engines-221","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"F5-TTS v1 Base","locale":"en"},"8963":{"id":"/en/docs/advanced-engines-222","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"1.3 GB","locale":"en"},"8964":{"id":"/en/docs/advanced-engines-223","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"2.5 GB","locale":"en"},"8965":{"id":"/en/docs/advanced-engines-224","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"yes","locale":"en"},"8966":{"id":"/en/docs/advanced-engines-225","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"`f5tts/base`","locale":"en"},"8967":{"id":"/en/docs/advanced-engines-226","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"F5-TTS Base","locale":"en"},"8968":{"id":"/en/docs/advanced-engines-227","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"1.3 GB","locale":"en"},"8969":{"id":"/en/docs/advanced-engines-228","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"2.5 GB","locale":"en"},"8970":{"id":"/en/docs/advanced-engines-229","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"`f5tts/e2-base`","locale":"en"},"8971":{"id":"/en/docs/advanced-engines-230","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"E2-TTS Base","locale":"en"},"8972":{"id":"/en/docs/advanced-engines-231","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"1.3 GB","locale":"en"},"8973":{"id":"/en/docs/advanced-engines-232","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"2.5 GB","locale":"en"},"8974":{"id":"/en/docs/advanced-engines-233","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"**Capabilities** (all three variants): **Clone a voice**, **Speed**, **Duration**, **Long text**, **Seed**, **Streaming** (chunk by chunk), **Speech editing**. Cloning needs the clip's transcript: when it is missing, it is transcribed if `tts.auto_transcribe` is on and the speech recognition model is downloaded.","locale":"en"},"8975":{"id":"/en/docs/advanced-engines-234","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"**Languages**: zh, en. 24 kHz.","locale":"en"},"8976":{"id":"/en/docs/advanced-engines-235","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"**Reference clips**: 1–12 s, at least 16 kHz.","locale":"en"},"8977":{"id":"/en/docs/advanced-engines-236","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"**Licence**: MIT code, CC-BY-NC-4.0 pretrained weights (trained on Emilia): not for commercial use. Nothing to accept; results carry a notice.","locale":"en"},"8978":{"id":"/en/docs/advanced-engines-237","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"**Training**: **Fine-tune the model** (`full`): upstream's `finetune_cli` recipe, the whole model trained further and exported as a new model of the same kind. Best with an hour of speech or more; a GPU is all but required. The result inherits CC-BY-NC-4.0.","locale":"en"},"8979":{"id":"/en/docs/advanced-engines-238","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#f5-tts","content":"**Load option**: `ode_method` (`euler` or `midpoint`).","locale":"en"},"8980":{"id":"/en/docs/advanced-engines-239","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"Few-shot cloning from a 3–10 s clip, and the classic fine-tuning path: a voice can have its own GPT and SoVITS weights, switched in per request. Best for: a voice of your own trained on a few minutes of recordings.","locale":"en"},"8981":{"id":"/en/docs/advanced-engines-240","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"Model","locale":"en"},"8982":{"id":"/en/docs/advanced-engines-241","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"Variant","locale":"en"},"8983":{"id":"/en/docs/advanced-engines-242","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"Size","locale":"en"},"8984":{"id":"/en/docs/advanced-engines-243","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"GPU memory","locale":"en"},"8985":{"id":"/en/docs/advanced-engines-244","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"Recommended","locale":"en"},"8986":{"id":"/en/docs/advanced-engines-245","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"`gptsovits/v2-base`","locale":"en"},"8987":{"id":"/en/docs/advanced-engines-246","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"v2","locale":"en"},"8988":{"id":"/en/docs/advanced-engines-247","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"249 MB","locale":"en"},"8989":{"id":"/en/docs/advanced-engines-248","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"2.5 GB","locale":"en"},"8990":{"id":"/en/docs/advanced-engines-249","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"`gptsovits/v2pro-base`","locale":"en"},"8991":{"id":"/en/docs/advanced-engines-250","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"v2Pro","locale":"en"},"8992":{"id":"/en/docs/advanced-engines-251","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"303 MB","locale":"en"},"8993":{"id":"/en/docs/advanced-engines-252","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"2.5 GB","locale":"en"},"8994":{"id":"/en/docs/advanced-engines-253","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"yes","locale":"en"},"8995":{"id":"/en/docs/advanced-engines-254","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"`gptsovits/v2proplus-base`","locale":"en"},"8996":{"id":"/en/docs/advanced-engines-255","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"v2ProPlus","locale":"en"},"8997":{"id":"/en/docs/advanced-engines-256","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"339 MB","locale":"en"},"8998":{"id":"/en/docs/advanced-engines-257","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"2.8 GB","locale":"en"},"8999":{"id":"/en/docs/advanced-engines-258","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"`gptsovits/v4-base`","locale":"en"},"9000":{"id":"/en/docs/advanced-engines-259","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"v4","locale":"en"},"9001":{"id":"/en/docs/advanced-engines-260","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"937 MB","locale":"en"},"9002":{"id":"/en/docs/advanced-engines-261","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"4 GB","locale":"en"},"9003":{"id":"/en/docs/advanced-engines-262","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"`gptsovits/v5turbo-base`","locale":"en"},"9004":{"id":"/en/docs/advanced-engines-263","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"v5 Turbo","locale":"en"},"9005":{"id":"/en/docs/advanced-engines-264","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"934 MB","locale":"en"},"9006":{"id":"/en/docs/advanced-engines-265","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"4 GB","locale":"en"},"9007":{"id":"/en/docs/advanced-engines-266","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"**Capabilities**: **Clone a voice**, **Several clips** (up to 4), **Trained voices**, **Speed**, **Batches** (up to 20), **Long text**, **Streaming**, **Seed**; v2, v2Pro and v2ProPlus also **Clone without a transcript**.","locale":"en"},"9008":{"id":"/en/docs/advanced-engines-267","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"**Sample rate**: 32 kHz for v2 / v2Pro / v2ProPlus, 48 kHz for v4 / v5 Turbo.","locale":"en"},"9009":{"id":"/en/docs/advanced-engines-268","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"**Languages**: zh, en, ja, ko, yue. Japanese needs the optional extra `mizuoto[gptsovits-ja]`, Korean `mizuoto[gptsovits-ko]`.","locale":"en"},"9010":{"id":"/en/docs/advanced-engines-269","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"**Reference clips**: 3–10 s.","locale":"en"},"9011":{"id":"/en/docs/advanced-engines-270","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"**Voice weights**: a voice can carry a GPT (`.ckpt`) and SoVITS (`.pth`) pair, used when its version matches the model's variant (otherwise Mizuoto warns and clones). Add them with `mizuoto voice add-weights <voice> -e gptsovits -f gpt=x.ckpt -f sovits=y.pth`.","locale":"en"},"9012":{"id":"/en/docs/advanced-engines-271","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"**Shared files**: every model needs `gptsovits/encoders` (1.0 GB), `gptsovits/g2pw` (562 MB), `gptsovits/nltk-data` and `gptsovits/open-jtalk`, downloaded with the first model; training v2, v2Pro and v2ProPlus also needs the matching discriminator `gptsovits/s2d-*`.","locale":"en"},"9013":{"id":"/en/docs/advanced-engines-272","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#gpt-sovits","content":"**Training**: **Fine-tune a voice** (`speaker`): upstream's own recipe (text features, speech features, semantic tokens, train SoVITS, train GPT), exported as the voice's own pair of weights. One to ten minutes of one speaker; minutes on a GPU, hours on a CPU. v4 and v5 Turbo train SoVITS as a LoRA.","locale":"en"},"9014":{"id":"/en/docs/advanced-engines-273","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"Xiaomi's diffusion language model TTS. Best for: rare languages (over 600), speaking without any reference in the model's own voice, and voices designed from attributes such as gender, age, pitch, accent and Chinese dialect.","locale":"en"},"9015":{"id":"/en/docs/advanced-engines-274","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"Model","locale":"en"},"9016":{"id":"/en/docs/advanced-engines-275","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"Variant","locale":"en"},"9017":{"id":"/en/docs/advanced-engines-276","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"Size","locale":"en"},"9018":{"id":"/en/docs/advanced-engines-277","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"GPU memory","locale":"en"},"9019":{"id":"/en/docs/advanced-engines-278","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"Recommended","locale":"en"},"9020":{"id":"/en/docs/advanced-engines-279","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"`omnivoice/omnivoice`","locale":"en"},"9021":{"id":"/en/docs/advanced-engines-280","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"OmniVoice","locale":"en"},"9022":{"id":"/en/docs/advanced-engines-281","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"3.1 GB","locale":"en"},"9023":{"id":"/en/docs/advanced-engines-282","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"5 GB","locale":"en"},"9024":{"id":"/en/docs/advanced-engines-283","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"yes","locale":"en"},"9025":{"id":"/en/docs/advanced-engines-284","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"**Capabilities**: **Clone a voice**, **Design from attributes**, **Its own voice**, **Inline tags**, **Pronunciation**, **Speed**, **Duration**, **Batches** (up to 8), **Long text**, **Seed**. Mizuoto always passes the clip's transcript when cloning (speech recognition fills it in when missing), so OmniVoice never loads Whisper itself.","locale":"en"},"9026":{"id":"/en/docs/advanced-engines-285","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"**Design attributes**: gender (male, female), age (child … elderly), pitch (very low pitch … very high pitch), style (whisper), accent (ten, such as american accent), dialect (twelve Chinese dialects such as 河南话, 四川话, 东北话). Free-text descriptions are not taken.","locale":"en"},"9027":{"id":"/en/docs/advanced-engines-286","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"**Inline tags**: thirteen, such as `[laughter]`, `[sigh]`, `[question-en]`, `[surprise-wa]`.","locale":"en"},"9028":{"id":"/en/docs/advanced-engines-287","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"**Reference clips**: 1–20 s, at least 16 kHz. 24 kHz output.","locale":"en"},"9029":{"id":"/en/docs/advanced-engines-288","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"**Options**: `packed_guidance` (off) is a fast mode: cloning about a quarter faster on a GPU, where each result is then another take of the request rather than the original implementation's.","locale":"en"},"9030":{"id":"/en/docs/advanced-engines-289","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#omnivoice","content":"**Training**: **Fine-tune the model** (`full`) and **Fine-tune with LoRA** (`lora`, merged at export), both exported as a new model. The full fine-tune suits hours of speech for a new language or style and needs 24 GB of GPU memory or more; LoRA is lighter.","locale":"en"},"9031":{"id":"/en/docs/advanced-engines-290","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"OpenBMB's tokenizer-free TTS: it generates continuous speech latents patch by patch (a MiniCPM-4 language model and a small diffusion model per patch), with no speech codes in between. Best for: natural cloning, with or without the clip's transcript; voices made from a sentence of description; style instructions on a cloned voice; 30 languages at 48 kHz (VoxCPM2).","locale":"en"},"9032":{"id":"/en/docs/advanced-engines-291","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"Model","locale":"en"},"9033":{"id":"/en/docs/advanced-engines-292","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"Variant","locale":"en"},"9034":{"id":"/en/docs/advanced-engines-293","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"Size","locale":"en"},"9035":{"id":"/en/docs/advanced-engines-294","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"GPU memory","locale":"en"},"9036":{"id":"/en/docs/advanced-engines-295","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"Recommended","locale":"en"},"9037":{"id":"/en/docs/advanced-engines-296","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"`voxcpm/2`","locale":"en"},"9038":{"id":"/en/docs/advanced-engines-297","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"VoxCPM2","locale":"en"},"9039":{"id":"/en/docs/advanced-engines-298","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"5.0 GB","locale":"en"},"9040":{"id":"/en/docs/advanced-engines-299","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"6.5 GB","locale":"en"},"9041":{"id":"/en/docs/advanced-engines-300","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"yes","locale":"en"},"9042":{"id":"/en/docs/advanced-engines-301","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"`voxcpm/1.5`","locale":"en"},"9043":{"id":"/en/docs/advanced-engines-302","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"VoxCPM 1.5","locale":"en"},"9044":{"id":"/en/docs/advanced-engines-303","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"2.0 GB","locale":"en"},"9045":{"id":"/en/docs/advanced-engines-304","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"3 GB","locale":"en"},"9046":{"id":"/en/docs/advanced-engines-305","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"`voxcpm/0.5b`","locale":"en"},"9047":{"id":"/en/docs/advanced-engines-306","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"VoxCPM 0.5B","locale":"en"},"9048":{"id":"/en/docs/advanced-engines-307","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"1.6 GB","locale":"en"},"9049":{"id":"/en/docs/advanced-engines-308","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"2.5 GB","locale":"en"},"9050":{"id":"/en/docs/advanced-engines-309","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Capabilities**: VoxCPM2: **Clone a voice**, **Clone without a transcript**, **Design from a description**, **Instructions**, **Its own voice**, **Streaming** (one chunk per 40 ms patch), **Seed**. VoxCPM 1.5 and 0.5B: **Clone a voice** (the transcript is needed; speech recognition fills it in), **Its own voice**, **Streaming**, **Seed**.","locale":"en"},"9051":{"id":"/en/docs/advanced-engines-310","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Cloning**: with the clip's transcript, VoxCPM2 is given the clip both as an isolated reference and as the start of the speech to continue, as upstream's demo does (the option **reference_prefix** off keeps only the continuation); without it, as the reference alone. VoxCPM 1.5 and 0.5B continue the clip.","locale":"en"},"9052":{"id":"/en/docs/advanced-engines-311","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Descriptions and instructions** (VoxCPM2): written in parentheses before the text, as upstream does it: `(A young woman, gentle and sweet voice)Hello`. Either language works; Chinese dialects are asked for this way (粤语, 四川话…).","locale":"en"},"9053":{"id":"/en/docs/advanced-engines-312","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Parameters**: **Steps** (the diffusion's Euler steps per patch, 10), **Guidance scale** (2.0), **Text normalisation** (off; numbers, dates and symbols written out by wetext), **Max new tokens** (patches, 4096). Options: `min_len`, `retry_badcase` (on: a result much longer than its text is generated again with the next seed, at most `retry_badcase_max_times`; not when streaming), `retry_badcase_ratio_threshold`, `reference_prefix`.","locale":"en"},"9054":{"id":"/en/docs/advanced-engines-313","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Languages**: VoxCPM2 30 (ar, my, zh, da, nl, en, fi, fr, de, el, he, hi, id, it, ja, km, ko, lo, ms, no, pl, pt, ru, es, sw, sv, tl, th, tr, vi), with no language tag: it reads the text as written. VoxCPM 1.5 and 0.5B: zh, en.","locale":"en"},"9055":{"id":"/en/docs/advanced-engines-314","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Reference clips**: 1–30 s, at least 16 kHz. Output: 48 kHz (VoxCPM2), 44.1 kHz (1.5), 16 kHz (0.5B).","locale":"en"},"9056":{"id":"/en/docs/advanced-engines-315","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Precision**: the models' own bf16 on every device but Apple's (fp32 there), as upstream; `engines.voxcpm.dtype fp32` for full precision.","locale":"en"},"9057":{"id":"/en/docs/advanced-engines-316","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Not included**: upstream's optional denoiser for the reference clip (ZipEnhancer, a ModelScope pipeline) and its timestamps; both are off by default upstream.","locale":"en"},"9058":{"id":"/en/docs/advanced-engines-317","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#voxcpm","content":"**Training**: **Fine-tune the model** (`full`) and **Fine-tune with LoRA** (`lora`), upstream's own recipes (`train_voxcpm_finetune.py` with its configurations per model), both exported as a new model; a LoRA model keeps the base weights beside its adapters and applies them when it loads, as upstream does. A hyperparameter left at 0 takes the recipe's value for the model. On a GPU it trains as upstream does (float32 weights under bf16 autocast); on a CPU in float32 (upstream itself cannot train off CUDA). VoxCPM2's full fine-tune needs about 40 GB of memory; LoRA far less.","locale":"en"},"9059":{"id":"/en/docs/advanced-engines-318","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"Fish Audio S2 Pro: a dual-autoregressive model trained on about ten million hours in some fifty languages. Best for: expressive cloning, free-form inline tags such as `[laughing]`, and dialogue between speakers.","locale":"en"},"9060":{"id":"/en/docs/advanced-engines-319","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"Model","locale":"en"},"9061":{"id":"/en/docs/advanced-engines-320","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"Variant","locale":"en"},"9062":{"id":"/en/docs/advanced-engines-321","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"Size","locale":"en"},"9063":{"id":"/en/docs/advanced-engines-322","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"GPU memory","locale":"en"},"9064":{"id":"/en/docs/advanced-engines-323","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"Recommended","locale":"en"},"9065":{"id":"/en/docs/advanced-engines-324","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"`fishspeech/s2-pro`","locale":"en"},"9066":{"id":"/en/docs/advanced-engines-325","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"S2 Pro","locale":"en"},"9067":{"id":"/en/docs/advanced-engines-326","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"10.5 GB","locale":"en"},"9068":{"id":"/en/docs/advanced-engines-327","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"22 GB","locale":"en"},"9069":{"id":"/en/docs/advanced-engines-328","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"yes","locale":"en"},"9070":{"id":"/en/docs/advanced-engines-329","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"**Capabilities**: **Clone a voice**, **Several clips** (up to 4), **Inline tags**, **Dialogue**, **Streaming** (by segment), **Seed**. 44.1 kHz.","locale":"en"},"9071":{"id":"/en/docs/advanced-engines-330","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"**Reference clips**: 2–30 s.","locale":"en"},"9072":{"id":"/en/docs/advanced-engines-331","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"**Licence**: Fish Audio Research License, gated (`fish-audio-research@2026-03-07`); not for commercial use; results cannot train other engines; results show \"Built with Fish Audio\".","locale":"en"},"9073":{"id":"/en/docs/advanced-engines-332","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"**Devices**: bf16 on a GPU; fp32 on a CPU (bf16 is emulated there, far slower). About 22 GB of GPU memory.","locale":"en"},"9074":{"id":"/en/docs/advanced-engines-333","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"**Training**: **Fine-tune with LoRA** (`lora`, GPU or CPU): upstream's LoRA recipe (semantic tokens, packing, training, merging), exported as a new model. Upstream warns that it learns speaking style more than timbre; 24 GB of GPU memory; the result stays under Fish Audio's research licence.","locale":"en"},"9075":{"id":"/en/docs/advanced-engines-334","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#fish-speech","content":"The catalogue has no int8 version: no public repository exists for it.","locale":"en"},"9076":{"id":"/en/docs/advanced-engines-335","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"bilibili's zero-shot TTS: clones from a clip without its transcript. Best for: emotion control — IndexTTS-2 takes the emotion from a clip, eight emotion weights or a description; 2.5 adds Japanese, Spanish and speed.","locale":"en"},"9077":{"id":"/en/docs/advanced-engines-336","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"Model","locale":"en"},"9078":{"id":"/en/docs/advanced-engines-337","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"Variant","locale":"en"},"9079":{"id":"/en/docs/advanced-engines-338","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"Size","locale":"en"},"9080":{"id":"/en/docs/advanced-engines-339","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"GPU memory","locale":"en"},"9081":{"id":"/en/docs/advanced-engines-340","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"Recommended","locale":"en"},"9082":{"id":"/en/docs/advanced-engines-341","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"`indextts/v1.5`","locale":"en"},"9083":{"id":"/en/docs/advanced-engines-342","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"IndexTTS-1.5","locale":"en"},"9084":{"id":"/en/docs/advanced-engines-343","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"1.6 GB","locale":"en"},"9085":{"id":"/en/docs/advanced-engines-344","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"4 GB","locale":"en"},"9086":{"id":"/en/docs/advanced-engines-345","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"`indextts/v2`","locale":"en"},"9087":{"id":"/en/docs/advanced-engines-346","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"IndexTTS-2","locale":"en"},"9088":{"id":"/en/docs/advanced-engines-347","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"5.6 GB","locale":"en"},"9089":{"id":"/en/docs/advanced-engines-348","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"9 GB","locale":"en"},"9090":{"id":"/en/docs/advanced-engines-349","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"yes","locale":"en"},"9091":{"id":"/en/docs/advanced-engines-350","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"`indextts/v2.5`","locale":"en"},"9092":{"id":"/en/docs/advanced-engines-351","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"IndexTTS-2.5","locale":"en"},"9093":{"id":"/en/docs/advanced-engines-352","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"5.2 GB","locale":"en"},"9094":{"id":"/en/docs/advanced-engines-353","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"9 GB","locale":"en"},"9095":{"id":"/en/docs/advanced-engines-354","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"Variant","locale":"en"},"9096":{"id":"/en/docs/advanced-engines-355","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"Sample rate","locale":"en"},"9097":{"id":"/en/docs/advanced-engines-356","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"Main capabilities","locale":"en"},"9098":{"id":"/en/docs/advanced-engines-357","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"v1_5","locale":"en"},"9099":{"id":"/en/docs/advanced-engines-358","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"24 kHz","locale":"en"},"9100":{"id":"/en/docs/advanced-engines-359","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Clone a voice**, **Clone without a transcript**, **Pronunciation**, **Long text**","locale":"en"},"9101":{"id":"/en/docs/advanced-engines-360","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"v2","locale":"en"},"9102":{"id":"/en/docs/advanced-engines-361","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"22.05 kHz","locale":"en"},"9103":{"id":"/en/docs/advanced-engines-362","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"the above plus **Emotion from a clip**, **Emotion sliders**, **Emotion from text**, **Streaming**","locale":"en"},"9104":{"id":"/en/docs/advanced-engines-363","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"v2_5","locale":"en"},"9105":{"id":"/en/docs/advanced-engines-364","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"22.05 kHz","locale":"en"},"9106":{"id":"/en/docs/advanced-engines-365","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"as v2, plus **Speed**; languages zh, en, ja, es","locale":"en"},"9107":{"id":"/en/docs/advanced-engines-366","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Emotion weights** (eight, in upstream's order): happy, angry, sad, afraid, disgusted, melancholic, surprised, calm. An emotion clip takes a strength; emotion from text needs the load option `use_qwen_emo` (on by default, about 1.2 GB).","locale":"en"},"9108":{"id":"/en/docs/advanced-engines-367","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Reference clips**: 1–30 s.","locale":"en"},"9109":{"id":"/en/docs/advanced-engines-368","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Licence**: bilibili Model Use License, gated (`bilibili-model-use@2025-09-09`); commercial use is allowed, but results cannot train other engines; the notice under results reminds that cloning a voice without its owner's permission is forbidden by the IndexTTS disclaimer.","locale":"en"},"9110":{"id":"/en/docs/advanced-engines-369","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Languages**: Japanese text for IndexTTS-2.5 needs the optional extra `mizuoto-indextts[ja]`.","locale":"en"},"9111":{"id":"/en/docs/advanced-engines-370","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Shared files**: IndexTTS-2 and 2.5 need `indextts/w2v-bert` (2.2 GB), `indextts/campplus` and `indextts/bigvgan`, and IndexTTS-2 also `indextts/semantic-codec`; they are downloaded with the model.","locale":"en"},"9112":{"id":"/en/docs/advanced-engines-371","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Training**: none.","locale":"en"},"9113":{"id":"/en/docs/advanced-engines-372","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#indextts","content":"**Load options**: `use_qwen_emo` (on by default), `use_torch_compile` (v2/v2.5: compiles the s2mel DiT and BigVGAN, as `compute.compile` does; see Performance).","locale":"en"},"9114":{"id":"/en/docs/advanced-engines-373","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"An internal engine Mizuoto uses itself: Whisper large-v3-turbo, implemented in Mizuoto, about 100 languages, transcribing reference clips, voices and datasets that have no text. It is not offered as a speech model and does not appear in `GET /v1/models`.","locale":"en"},"9115":{"id":"/en/docs/advanced-engines-374","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"Model","locale":"en"},"9116":{"id":"/en/docs/advanced-engines-375","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"Size","locale":"en"},"9117":{"id":"/en/docs/advanced-engines-376","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"GPU memory","locale":"en"},"9118":{"id":"/en/docs/advanced-engines-377","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"Recommended","locale":"en"},"9119":{"id":"/en/docs/advanced-engines-378","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"`asr/whisper-large-v3-turbo`","locale":"en"},"9120":{"id":"/en/docs/advanced-engines-379","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"1.5 GB","locale":"en"},"9121":{"id":"/en/docs/advanced-engines-380","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"2 GB","locale":"en"},"9122":{"id":"/en/docs/advanced-engines-381","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"yes","locale":"en"},"9123":{"id":"/en/docs/advanced-engines-382","page_id":"/en/docs/advanced-engines","tags":[],"type":"text","url":"/en/docs/advanced-engines#speech-recognition-asr","content":"Transcripts are cached by the audio's SHA-256 and the model, so the same clip is never transcribed twice. `tts.auto_transcribe` (on by default) and `tts.asr_model` control automatic transcription; see Configuration.","locale":"en"},"9124":{"id":"/en/docs/advanced-faq","page_id":"/en/docs/advanced-faq","type":"page","content":"FAQ","breadcrumbs":["Mizuoto Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-faq","locale":"en"},"9125":{"id":"/en/docs/advanced-faq-0","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq","content":"Common questions by topic: starting up, the access token, torch and engines, GPU memory, licences, downloads, logs and remote hosts.","locale":"en"},"9126":{"id":"/en/docs/advanced-faq-1","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#starting-up-and-data","content":"Starting up and data","locale":"en"},"9127":{"id":"/en/docs/advanced-faq-2","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#access-token","content":"Access token","locale":"en"},"9128":{"id":"/en/docs/advanced-faq-3","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#first-run","content":"First run","locale":"en"},"9129":{"id":"/en/docs/advanced-faq-4","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#torch-and-engines","content":"Torch and engines","locale":"en"},"9130":{"id":"/en/docs/advanced-faq-5","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"GPU memory and speed","locale":"en"},"9131":{"id":"/en/docs/advanced-faq-6","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#licences","content":"Licences","locale":"en"},"9132":{"id":"/en/docs/advanced-faq-7","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#downloads","content":"Downloads","locale":"en"},"9133":{"id":"/en/docs/advanced-faq-8","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#logs","content":"Logs","locale":"en"},"9134":{"id":"/en/docs/advanced-faq-9","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#remote-hosts","content":"Remote hosts","locale":"en"},"9135":{"id":"/en/docs/advanced-faq-10","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq","content":"When something goes wrong, read the job's log first (**Log** in the **Jobs** panel, or `mizuoto job log <job id>`), then run `mizuoto doctor`: it checks torch's build against the hardware, whether each engine is available and which optional extras are missing, and gives the commands that fix what it finds.","locale":"en"},"9136":{"id":"/en/docs/advanced-faq-11","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"The default port is 7869. When it is taken, the server tries the next ports (20 at most) and logs \"Port 7869 is unavailable. Using port 7870.\"; the browser opens the port actually used, and stdout gets a line `SERVER_READY url=…` once it listens.","locale":"en"},"9137":{"id":"/en/docs/advanced-faq-12","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"The default data folder:","locale":"en"},"9138":{"id":"/en/docs/advanced-faq-13","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"System","locale":"en"},"9139":{"id":"/en/docs/advanced-faq-14","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"Location","locale":"en"},"9140":{"id":"/en/docs/advanced-faq-15","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"Windows","locale":"en"},"9141":{"id":"/en/docs/advanced-faq-16","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"`%APPDATA%\\mizuoto`","locale":"en"},"9142":{"id":"/en/docs/advanced-faq-17","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"macOS","locale":"en"},"9143":{"id":"/en/docs/advanced-faq-18","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"`~/Library/Application Support/mizuoto`","locale":"en"},"9144":{"id":"/en/docs/advanced-faq-19","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"Linux","locale":"en"},"9145":{"id":"/en/docs/advanced-faq-20","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"`$XDG_DATA_HOME/mizuoto`, by default `~/.local/share/mizuoto`","locale":"en"},"9146":{"id":"/en/docs/advanced-faq-21","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"It holds `settings.toml`, the database `mizuoto.db`, `models/`, `voices/`, `outputs/`, `datasets/`, `experiments/`, `projects/`, `cache/`, `jobs/` (job logs) and `logs/`.","locale":"en"},"9147":{"id":"/en/docs/advanced-faq-22","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"Move it with the `MIZUOTO_DATA_DIR` environment variable or `mizuoto webui --data-dir <path>`; to move only one kind of file, change `paths.*` (**Settings** › **Storage**). `data_dir` and `resolved_paths` in `mizuoto config show` give the folders in use, and the web UI shows the **Data folder** and **Settings file** in **Settings** › **About**. See Configuration.","locale":"en"},"9148":{"id":"/en/docs/advanced-faq-23","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"Stop the server, then delete or rename `settings.toml` (`mizuoto config path` prints where it is). The next start uses every default; voices, models and outputs are untouched. Values set by `MIZUOTO_<GROUP>__<FIELD>` environment variables still win.","locale":"en"},"9149":{"id":"/en/docs/advanced-faq-24","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"Yes, but they are **separate processes**:","locale":"en"},"9150":{"id":"/en/docs/advanced-faq-25","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"Jobs go into the same database, so the web UI's **Jobs** panel and `mizuoto job list` show both sides' jobs.","locale":"en"},"9151":{"id":"/en/docs/advanced-faq-26","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"A command runs its job in the foreground in its own process: it does not queue with the server's GPU jobs and loads its own models, so the same model can be loaded in GPU memory twice.","locale":"en"},"9152":{"id":"/en/docs/advanced-faq-27","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"`mizuoto job cancel` reaches only its own process's jobs; for a job the server runs it answers \"is not running\". Cancel the server's jobs in the web UI or with `POST /api/v1/jobs/{id}/cancel`.","locale":"en"},"9153":{"id":"/en/docs/advanced-faq-28","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#starting-up-and-data","content":"`mizuoto config set` writes `settings.toml`; the server reads the change within about a second. The server's address and port take effect at its next start. A change to an engine's `engines.<id>.*` unloads that engine's models, which load with the new settings on next use.","locale":"en"},"9154":{"id":"/en/docs/advanced-faq-29","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-token","content":"With `server.access_token` set, the UI shows the **Access token** dialog (\"This server asks for its access token.\"); enter it once. An API request without it gets 401 `auth_required`; send it as an `Authorization: Bearer <token>` header, the `mizuoto_token` cookie or a `?token=` query parameter (see HTTP API).","locale":"en"},"9155":{"id":"/en/docs/advanced-faq-30","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-token","content":"**Settings** › **General** has **Set token** and **Clear token**; on the command line:","locale":"en"},"9156":{"id":"/en/docs/advanced-faq-31","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-token","content":"A forgotten token is replaced by setting a new one on the server machine.","locale":"en"},"9157":{"id":"/en/docs/advanced-faq-32","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-token","content":"Mizuoto does not require one, but set one. With `mizuoto webui --host 0.0.0.0` the server only logs \"Binding to 0.0.0.0 makes the server reachable from other machines.\" and stops checking the `Host` header; without a token, anyone who can reach the address can do everything (download models, delete outputs…). Reading server paths and showing files in a folder stay limited to a browser on the server's own machine.","locale":"en"},"9158":{"id":"/en/docs/advanced-faq-33","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#first-run","content":"The web UI opens on **Speak**, where the dummy engine works right away (it speaks in tones); there is no setup screen. Choose the download source under **Settings** › **Downloads**, check torch under **Settings** › **Compute** (or with `mizuoto doctor`), then download models from **Models**, or with the button that replaces **Speak** when the chosen model is not downloaded, and follow them in **Jobs**. See First run.","locale":"en"},"9159":{"id":"/en/docs/advanced-faq-34","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#torch-and-engines","content":"An engine needs torch (only the dummy engine runs without it) and its implementation: every engine is built into Mizuoto except Fish Speech and IndexTTS, which are distributions of their own. The engine card and `mizuoto doctor <engine>` say what is missing:","locale":"en"},"9160":{"id":"/en/docs/advanced-faq-35","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#torch-and-engines","content":"`torch`: install the build `mizuoto doctor` names (see Installation).","locale":"en"},"9161":{"id":"/en/docs/advanced-faq-36","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#torch-and-engines","content":"`mizuoto-fishspeech` or `mizuoto-indextts`: install it into Mizuoto's Python, such as `pip install mizuoto-indextts`.","locale":"en"},"9162":{"id":"/en/docs/advanced-faq-37","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#torch-and-engines","content":"Then restart Mizuoto. Using such a model fails with `engine_not_installed` (exit code 7) and the install command in the hint.","locale":"en"},"9163":{"id":"/en/docs/advanced-faq-38","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#torch-and-engines","content":"torch's build must match the hardware: a CUDA build for NVIDIA (no newer than the driver supports), a ROCm build for AMD, the XPU build for Intel, PyPI's own build on Apple silicon. `mizuoto doctor` compares them and prints the command that installs the right build into Mizuoto's Python, such as:","locale":"en"},"9164":{"id":"/en/docs/advanced-faq-39","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#torch-and-engines","content":"The same check shows in **Settings** › **Compute**. \"sees no GPU: CUDA_VISIBLE_DEVICES hides them\" means the variable is set where Mizuoto starts.","locale":"en"},"9165":{"id":"/en/docs/advanced-faq-40","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#torch-and-engines","content":"GPT-SoVITS's Japanese and Korean front ends and IndexTTS-2.5's Japanese are optional extras: `pip install 'mizuoto[gptsovits-ja]'` (pyopenjtalk is built from source: it needs CMake and a C++ compiler), `pip install 'mizuoto[gptsovits-ko]'`, `pip install 'mizuoto-indextts[ja]'`. The error's hint gives the command; `mizuoto doctor` lists the missing ones. See Optional extras.","locale":"en"},"9166":{"id":"/en/docs/advanced-faq-41","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"A model that does not fit its GPU loads partly: the layers that fit stay on the GPU and the rest of its weights stream from RAM as they run (slower; the result says so). Mizuoto always tries to load a model, whatever the estimate says, and fails with `compute_unavailable` (exit code 9, HTTP 503; `detail.reason` is `out_of_memory`) only when an allocation really fails. It then unloads every model not in use from every GPU, as ComfyUI does. You can:","locale":"en"},"9167":{"id":"/en/docs/advanced-faq-42","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"close the other program holding the GPU, or click **Free GPU memory** (or **Unload** a model) in the **Models in memory** panel;","locale":"en"},"9168":{"id":"/en/docs/advanced-faq-43","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"set **Settings** › **Compute** › **Memory** › **How models use GPU memory** to *low* or *none* (`compute.vram_mode`), or cap Mizuoto's share with `compute.vram_limit_mb`;","locale":"en"},"9169":{"id":"/en/docs/advanced-faq-44","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"use another GPU: `mizuoto config set engines.<id>.device cuda:1` (**Models** › **Engines** › **Device**);","locale":"en"},"9170":{"id":"/en/docs/advanced-faq-45","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"use the CPU: `mizuoto config set engines.<id>.device cpu`;","locale":"en"},"9171":{"id":"/en/docs/advanced-faq-46","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"pick a smaller model (Qwen3-TTS 0.6B, for one).","locale":"en"},"9172":{"id":"/en/docs/advanced-faq-47","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"When memory runs out during a request anyway, Mizuoto runs the step again with more of its weights in RAM and the same random draws (the same result, slower); with `compute.oom_fallback` it then tries a cheaper way (tiles, smaller batches). `compute.gpu_jobs` (default 1) sets how many jobs run at once on one GPU; a job waiting for the GPU can be started beside the running one with **Run anyway** when the memory suffices. `compute.inference_jobs` (default 1) sets how many synthesis jobs run at once across all engines and devices. More in Performance.","locale":"en"},"9173":{"id":"/en/docs/advanced-faq-48","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"Every engine runs on a CPU, much more slowly than on a GPU: the CPU runs in fp32, and large models such as Fish Speech are especially slow. Pick smaller models (Qwen3-TTS 0.6B, the GPT-SoVITS v2 family…), run the engine on a GPU machine as a remote host, or turn on streaming playback to hear the audio as it is made.","locale":"en"},"9174":{"id":"/en/docs/advanced-faq-49","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#gpu-memory-and-speed","content":"Idle models are unloaded after `compute.unload_after_minutes` (default 20; 0 never unloads), which `engines.<id>.idle_minutes` overrides per engine; at most `compute.max_resident_models` models (default 3) stay loaded, the least recently used idle one making room first. `mizuoto runtime` lists the loaded models. Models in `engines.<id>.pinned_models` are not unloaded to make room or for being idle. See Performance.","locale":"en"},"9175":{"id":"/en/docs/advanced-faq-50","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"Fish Speech (Fish Audio Research License) and IndexTTS (bilibili Model Use License) need their licence accepted before their models and shared files are downloaded, or they synthesize (exit code 5, HTTP 403). Read it, then:","locale":"en"},"9176":{"id":"/en/docs/advanced-faq-51","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"or click **Accept the licence** in **Models** › **Engines** and tick **I have read and accept this licence**. The acceptance is stored as `engines.<id>.accepted_licence` (the licence's id and version); a new licence version must be accepted again.","locale":"en"},"9177":{"id":"/en/docs/advanced-faq-52","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"No. The engine's licence, accepted with its full text in front of you, governs its use, and the notice under its results reminds you that cloning a voice without its owner's permission is forbidden by the IndexTTS disclaimer. `mizuoto speak --consent` no longer exists, and the API ignores `voice_spec.consent`. A voice's or dataset's consent note (`mizuoto voice add --consent …`, `voice edit --consent`, `dataset create --consent`) is still stored if you give one, but nothing requires it.","locale":"en"},"9178":{"id":"/en/docs/advanced-faq-53","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"F5-TTS's pretrained weights are CC-BY-NC-4.0: its results are not for commercial use, and neither are models fine-tuned from them.","locale":"en"},"9179":{"id":"/en/docs/advanced-faq-54","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"Fish Speech's licence does not allow commercial use.","locale":"en"},"9180":{"id":"/en/docs/advanced-faq-55","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"Results of Fish Speech and IndexTTS cannot train other engines: datasets keep the outputs' licence tags and training refuses those clips.","locale":"en"},"9181":{"id":"/en/docs/advanced-faq-56","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"Results carry the engine's licence tags and notices (such as \"Built with Fish Audio\"), shown under the result.","locale":"en"},"9182":{"id":"/en/docs/advanced-faq-57","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#licences","content":"Each engine's licence is in Engines in depth.","locale":"en"},"9183":{"id":"/en/docs/advanced-faq-58","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#downloads","content":"Choose **hf-mirror.com** or **ModelScope** in **Settings** › **Downloads** › **Download source**, or `mizuoto config set downloads.source hf-mirror`; **Repository** should stay at its default, **mizuoto-model mirror first**. A file that fails on one source comes from the next one by itself. See Model downloads and mirrors.","locale":"en"},"9184":{"id":"/en/docs/advanced-faq-59","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#downloads","content":"Model downloads read the standard proxy variables `HTTPS_PROXY`, `HTTP_PROXY`, `ALL_PROXY` and `NO_PROXY`. Set them where `mizuoto webui` is started.","locale":"en"},"9185":{"id":"/en/docs/advanced-faq-60","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#downloads","content":"Download it again: unfinished files (`.part`) resume where they stopped.","locale":"en"},"9186":{"id":"/en/docs/advanced-faq-61","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#downloads","content":"**Partly downloaded** can also mean a shared file it needs is missing; downloading the model again fetches it.","locale":"en"},"9187":{"id":"/en/docs/advanced-faq-62","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#downloads","content":"**Damaged**: `mizuoto model verify <model>` lists the damaged files; delete them (or `mizuoto model delete <model>`) and download again, since files of the right size are not downloaded again.","locale":"en"},"9188":{"id":"/en/docs/advanced-faq-63","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#downloads","content":"When every source fails the job ends with `download_failed` (exit code 12), whose detail lists the sources tried and the last errors.","locale":"en"},"9189":{"id":"/en/docs/advanced-faq-64","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#downloads","content":"Set the `HF_TOKEN` environment variable; Mizuoto sends it to huggingface.co (and only there, never to a mirror).","locale":"en"},"9190":{"id":"/en/docs/advanced-faq-65","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"Log","locale":"en"},"9191":{"id":"/en/docs/advanced-faq-66","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"Location","locale":"en"},"9192":{"id":"/en/docs/advanced-faq-67","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"How to read it","locale":"en"},"9193":{"id":"/en/docs/advanced-faq-68","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"A job's log","locale":"en"},"9194":{"id":"/en/docs/advanced-faq-69","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"`<data folder>/jobs/<job id>.log`","locale":"en"},"9195":{"id":"/en/docs/advanced-faq-70","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"**Jobs** › **Log**; `mizuoto job log <job id>`; `GET /api/v1/jobs/{id}/log`","locale":"en"},"9196":{"id":"/en/docs/advanced-faq-71","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"The server's log","locale":"en"},"9197":{"id":"/en/docs/advanced-faq-72","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"standard error (the terminal that started `mizuoto webui`)","locale":"en"},"9198":{"id":"/en/docs/advanced-faq-73","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"—","locale":"en"},"9199":{"id":"/en/docs/advanced-faq-74","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"`MIZUOTO_LOG_LEVEL` sets the level (`DEBUG`, `INFO`, `WARNING`, `ERROR`; default `INFO`), and every command takes `--debug`.","locale":"en"},"9200":{"id":"/en/docs/advanced-faq-75","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#logs","content":"When an engine fails, the request fails with `engine_error` (exit code 10), whose detail carries the exception and its traceback (**Details** under the error in the web UI; the job's `error` in `mizuoto job show <job id> --json`). The **Models in memory** panel lists an engine whose last request failed, with the error.","locale":"en"},"9201":{"id":"/en/docs/advanced-faq-76","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#remote-hosts","content":"**Offline**: the agent cannot be reached. Check that `mizuoto agent` runs on that machine and listens on an address this machine can reach (it listens on `127.0.0.1` unless given `--host 0.0.0.0`); check the address, the port (7870 by default) and the firewall; TLS must be on on both sides or on neither.","locale":"en"},"9202":{"id":"/en/docs/advanced-faq-77","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#remote-hosts","content":"**Refused**: the token is wrong, or the two Mizuoto versions do not match. Give the token again with `mizuoto remote add <name> <address> --token <token>`; it is in the agent machine's `settings.toml` (`remote.agent.token`).","locale":"en"},"9203":{"id":"/en/docs/advanced-faq-78","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#remote-hosts","content":"Requests to an unavailable host fail with `remote_unavailable` (exit code 14); `mizuoto remote use <engine> --local` runs the engine here again. See Remote hosts.","locale":"en"},"9204":{"id":"/en/docs/advanced-faq-79","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#remote-hosts","content":"For the command line's conventions and exit codes see Command line overview; for installing, see Installation.","locale":"en"},"9205":{"id":"/en/docs/advanced-performance","page_id":"/en/docs/advanced-performance","type":"page","content":"Performance","breadcrumbs":["Mizuoto Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-performance","locale":"en"},"9206":{"id":"/en/docs/advanced-performance-0","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance","content":"Where models run and how long they stay loaded, GPU memory (models larger than the GPU, running out of memory), precision, attention backends, torch.compile, and running waiting requests together.","locale":"en"},"9207":{"id":"/en/docs/advanced-performance-1","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#devices-and-precision","content":"Devices and precision","locale":"en"},"9208":{"id":"/en/docs/advanced-performance-2","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#which-gpus-mizuoto-finds","content":"Which GPUs Mizuoto finds","locale":"en"},"9209":{"id":"/en/docs/advanced-performance-3","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"Loaded models and memory","locale":"en"},"9210":{"id":"/en/docs/advanced-performance-4","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#gpu-memory","content":"GPU memory","locale":"en"},"9211":{"id":"/en/docs/advanced-performance-5","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#whole-or-not-at-all-high","content":"Whole or not at all (`high`)","locale":"en"},"9212":{"id":"/en/docs/advanced-performance-6","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#running-out-of-memory","content":"Running out of memory","locale":"en"},"9213":{"id":"/en/docs/advanced-performance-7","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"Compiling models (`compute.compile`)","locale":"en"},"9214":{"id":"/en/docs/advanced-performance-8","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#attention-backends","content":"Attention backends","locale":"en"},"9215":{"id":"/en/docs/advanced-performance-9","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"Running waiting requests together (micro-batching)","locale":"en"},"9216":{"id":"/en/docs/advanced-performance-10","page_id":"/en/docs/advanced-performance","type":"heading","tags":[],"url":"/en/docs/advanced-performance#on-a-cpu","content":"On a CPU","locale":"en"},"9217":{"id":"/en/docs/advanced-performance-11","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance","content":"Every engine runs in the server's own process, on Mizuoto's runtime (torch). The defaults run on any machine. This page covers the settings that decide where models run and how long they stay loaded, the speed-ups you can turn on (attention backends, `compute.fast`, `compute.compile`), and how waiting requests are batched. The defaults keep every result identical to each engine's original implementation; each opt-in that changes results says so. Each engine is described in Engines in depth; every setting is listed in Configuration.","locale":"en"},"9218":{"id":"/en/docs/advanced-performance-12","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"Setting","locale":"en"},"9219":{"id":"/en/docs/advanced-performance-13","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"Default","locale":"en"},"9220":{"id":"/en/docs/advanced-performance-14","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"Meaning","locale":"en"},"9221":{"id":"/en/docs/advanced-performance-15","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"`engines.<id>.device`","locale":"en"},"9222":{"id":"/en/docs/advanced-performance-16","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"`auto`","locale":"en"},"9223":{"id":"/en/docs/advanced-performance-17","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"where the engine runs: `auto`, `cpu`, `cuda:N` (NVIDIA, or AMD under ROCm), `xpu:N` (Intel), `mps` (Apple silicon); `<host>/<device>` runs it on a remote host (see Remote hosts). UI: **Device** on the engine's card","locale":"en"},"9224":{"id":"/en/docs/advanced-performance-18","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"`compute.default_device`","locale":"en"},"9225":{"id":"/en/docs/advanced-performance-19","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"`auto`","locale":"en"},"9226":{"id":"/en/docs/advanced-performance-20","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"the device for engines set to `auto`; `auto` picks the GPU with the most free memory, else the CPU. UI: **Settings** › **Compute** › **Default device**","locale":"en"},"9227":{"id":"/en/docs/advanced-performance-21","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"`compute.devices`","locale":"en"},"9228":{"id":"/en/docs/advanced-performance-22","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"empty","locale":"en"},"9229":{"id":"/en/docs/advanced-performance-23","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"the devices Mizuoto may use, such as `[\"cuda:0\"]`; empty: all","locale":"en"},"9230":{"id":"/en/docs/advanced-performance-24","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"`engines.<id>.dtype`","locale":"en"},"9231":{"id":"/en/docs/advanced-performance-25","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"`auto`","locale":"en"},"9232":{"id":"/en/docs/advanced-performance-26","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#devices-and-precision","content":"precision: `auto`, `fp32`, `fp16`, `bf16`. UI: **Precision** on the engine's card","locale":"en"},"9233":{"id":"/en/docs/advanced-performance-27","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#which-gpus-mizuoto-finds","content":"Mizuoto looks for GPUs without loading torch: `nvidia-smi` for NVIDIA cards, `rocm-smi` (or `amd-smi`) for AMD cards, which torch's ROCm build names `cuda:0`, `cuda:1`… like NVIDIA's, and Apple silicon by the platform (`mps`). `CUDA_VISIBLE_DEVICES` applies to what `nvidia-smi` finds as it does to torch: only the cards it names (indices or `GPU-` UUIDs), numbered from `cuda:0` in its order (indices are `nvidia-smi`'s, in PCI bus order: set `CUDA_DEVICE_ORDER=PCI_BUS_ID` if your cards differ). When none of these finds a GPU but the installed torch is a build that could use one (the XPU build for Intel GPUs, a ROCm build without `rocm-smi`, a CUDA build in a container without `nvidia-smi`), Mizuoto asks torch in a separate process once (a second or two); a CPU build of torch is never asked. Once Mizuoto has loaded torch to run a model, torch's own figures are used. `mizuoto doctor` lists the GPUs found and how, and **Settings** › **Compute** shows them.","locale":"en"},"9234":{"id":"/en/docs/advanced-performance-28","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#which-gpus-mizuoto-finds","content":"Every engine runs on NVIDIA (CUDA), AMD (ROCm), Intel (XPU) and Apple (MPS) GPUs and on the CPU. On a GPU without double precision (Apple's, and Intel Arc cards), the one model part that computes in double precision, CosyVoice 3's pitch predictor, runs on the CPU while the rest of the model stays on the GPU. On Apple silicon `compute.compile` is ignored and torch's MPS backend may lack an operation an engine needs; starting Mizuoto with `PYTORCH_ENABLE_MPS_FALLBACK=1` runs such operations on the CPU. The ROCm, XPU and MPS paths are not yet tested on real hardware: please report what fails.","locale":"en"},"9235":{"id":"/en/docs/advanced-performance-29","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#which-gpus-mizuoto-finds","content":"`auto` precision is what each engine's upstream uses on the device: half precision (bf16 or fp16, when the card handles it) on a GPU, fp32 on a CPU. Fish Speech, for instance, uses bf16 on a GPU and fp32 on a CPU; CosyVoice stays in fp32 unless its load option `fp16` is on. The engines' outputs match their upstream code in fp32 on a CPU; other precisions and devices give slightly different numbers.","locale":"en"},"9236":{"id":"/en/docs/advanced-performance-30","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"A model loads on first use, in the server's process, on its engine's device, and stays loaded for the next request:","locale":"en"},"9237":{"id":"/en/docs/advanced-performance-31","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"Setting","locale":"en"},"9238":{"id":"/en/docs/advanced-performance-32","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"Default","locale":"en"},"9239":{"id":"/en/docs/advanced-performance-33","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"Meaning","locale":"en"},"9240":{"id":"/en/docs/advanced-performance-34","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`compute.max_resident_models`","locale":"en"},"9241":{"id":"/en/docs/advanced-performance-35","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`3`","locale":"en"},"9242":{"id":"/en/docs/advanced-performance-36","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"models kept loaded at once, across every engine; beyond it the least recently used idle one is unloaded first. UI: **Settings** › **Compute** › **Models kept in memory**","locale":"en"},"9243":{"id":"/en/docs/advanced-performance-37","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`compute.unload_after_minutes`","locale":"en"},"9244":{"id":"/en/docs/advanced-performance-38","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`20`","locale":"en"},"9245":{"id":"/en/docs/advanced-performance-39","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"unload a model idle this long; `0` keeps it. UI: **Unload models after idle minutes (0: never)**","locale":"en"},"9246":{"id":"/en/docs/advanced-performance-40","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`engines.<id>.idle_minutes`","locale":"en"},"9247":{"id":"/en/docs/advanced-performance-41","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"empty","locale":"en"},"9248":{"id":"/en/docs/advanced-performance-42","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"overrides the above for one engine","locale":"en"},"9249":{"id":"/en/docs/advanced-performance-43","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`engines.<id>.pinned_models`","locale":"en"},"9250":{"id":"/en/docs/advanced-performance-44","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`[]`","locale":"en"},"9251":{"id":"/en/docs/advanced-performance-45","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"models never unloaded, neither for being idle nor to make room for another; they give up GPU memory last","locale":"en"},"9252":{"id":"/en/docs/advanced-performance-46","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`compute.gpu_jobs`","locale":"en"},"9253":{"id":"/en/docs/advanced-performance-47","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`1`","locale":"en"},"9254":{"id":"/en/docs/advanced-performance-48","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"GPU jobs that may run at once on one device. UI: **GPU jobs at once**","locale":"en"},"9255":{"id":"/en/docs/advanced-performance-49","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`compute.inference_jobs`","locale":"en"},"9256":{"id":"/en/docs/advanced-performance-50","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`1`","locale":"en"},"9257":{"id":"/en/docs/advanced-performance-51","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"synthesis jobs (speak, voice conversion, speech editing) that may run at once across every engine and device; requests run together as one micro-batch (`tts.micro_batch`) count as one. UI: **Synthesis jobs at once**","locale":"en"},"9258":{"id":"/en/docs/advanced-performance-52","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"Synthesis jobs run `compute.inference_jobs` at a time (one by default), whatever engine and device they use; the others wait in the queue in order (**Waiting for other synthesis jobs**). `compute.gpu_jobs` still limits the jobs on each GPU.","locale":"en"},"9259":{"id":"/en/docs/advanced-performance-53","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"An engine serves one request at a time on a device; the next waits (**Waiting for the engine**). A job waiting for a GPU another job holds shows **Waiting for the GPU**; when the memory suffices for both, **Run anyway** in **Jobs** starts it beside the other, or raise `compute.gpu_jobs`. A fine-tune takes the whole GPU, whatever `compute.gpu_jobs` says, and the idle models on it move to RAM first.","locale":"en"},"9260":{"id":"/en/docs/advanced-performance-54","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"Idle models are unloaded by the server only. A command (`mizuoto speak`…) loads the models it needs in its own process, and they go when it ends.","locale":"en"},"9261":{"id":"/en/docs/advanced-performance-55","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"`mizuoto runtime` lists the loaded models of the running server (device, memory, how much of it is on the device, last use, busy or idle); `mizuoto runtime --unload [MODEL]` unloads one, or every model not in use. In the web UI the **Models in memory** panel does the same, with a bar for how much of each model is on its GPU, and **Free GPU memory** releases the memory idle models hold. The API is `GET /api/v1/runtime` and `POST /api/v1/runtime/unload`.","locale":"en"},"9262":{"id":"/en/docs/advanced-performance-56","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#loaded-models-and-memory","content":"Changing any `engines.<id>.*` setting unloads that engine's models; they load with the new settings when next used.","locale":"en"},"9263":{"id":"/en/docs/advanced-performance-57","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Mizuoto manages GPU memory as ComfyUI does. A request places only the parts of a model it needs for each step (a voice prompt's encoder, then the language model, then the vocoder), and the parts it does not need give up their memory first when another needs it. When a model does not fit at all, it loads **partly**: the layers that fit stay on the GPU and the rest of its weights stay in RAM, copied to the GPU as each layer runs. It is slower, and it runs instead of failing.","locale":"en"},"9264":{"id":"/en/docs/advanced-performance-58","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Setting","locale":"en"},"9265":{"id":"/en/docs/advanced-performance-59","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Default","locale":"en"},"9266":{"id":"/en/docs/advanced-performance-60","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Meaning","locale":"en"},"9267":{"id":"/en/docs/advanced-performance-61","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.vram_mode`","locale":"en"},"9268":{"id":"/en/docs/advanced-performance-62","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`auto`","locale":"en"},"9269":{"id":"/en/docs/advanced-performance-63","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`auto`/`normal`: whole when it fits, else partly; `high`: whole or not at all; `low`: weights take at most half of the GPU's memory, leaving room for other models; `none`: almost every weight streams from RAM (least memory, slowest). On Apple silicon models always load whole (its memory is shared with the system). UI: **Settings** › **Compute** › **Memory**","locale":"en"},"9270":{"id":"/en/docs/advanced-performance-64","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`engines.<id>.vram_mode`","locale":"en"},"9271":{"id":"/en/docs/advanced-performance-65","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`auto`","locale":"en"},"9272":{"id":"/en/docs/advanced-performance-66","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"the same for one engine's models (`auto`: the global setting). UI: **GPU memory for this engine** on its card","locale":"en"},"9273":{"id":"/en/docs/advanced-performance-67","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.vram_reserve_mb`","locale":"en"},"9274":{"id":"/en/docs/advanced-performance-68","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`1024`","locale":"en"},"9275":{"id":"/en/docs/advanced-performance-69","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"GPU memory (MB) left free beyond what a request needs","locale":"en"},"9276":{"id":"/en/docs/advanced-performance-70","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.vram_limit_mb`","locale":"en"},"9277":{"id":"/en/docs/advanced-performance-71","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`0`","locale":"en"},"9278":{"id":"/en/docs/advanced-performance-72","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"use at most this much of each GPU (MB; `0`: all of it), for sharing a GPU with other programs","locale":"en"},"9279":{"id":"/en/docs/advanced-performance-73","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.ram_reserve_mb`","locale":"en"},"9280":{"id":"/en/docs/advanced-performance-74","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"empty","locale":"en"},"9281":{"id":"/en/docs/advanced-performance-75","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"RAM left free (MB; empty: the larger of 2 GB and a tenth of the RAM): below it, copies kept in RAM are dropped and idle models unloaded","locale":"en"},"9282":{"id":"/en/docs/advanced-performance-76","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.host_copies`","locale":"en"},"9283":{"id":"/en/docs/advanced-performance-77","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`auto`","locale":"en"},"9284":{"id":"/en/docs/advanced-performance-78","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"keep a copy in RAM of the weights of models on a GPU, so moving them off it costs nothing (`auto`: while RAM allows)","locale":"en"},"9285":{"id":"/en/docs/advanced-performance-79","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.max_pinned_mb`","locale":"en"},"9286":{"id":"/en/docs/advanced-performance-80","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`0`","locale":"en"},"9287":{"id":"/en/docs/advanced-performance-81","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"page-locked RAM for the host copies of weights, those that stream to a GPU and those kept to reload a model (faster copies; `0`: up to 40 % of RAM on Windows, more on Linux)","locale":"en"},"9288":{"id":"/en/docs/advanced-performance-82","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.async_offload`","locale":"en"},"9289":{"id":"/en/docs/advanced-performance-83","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`-1`","locale":"en"},"9290":{"id":"/en/docs/advanced-performance-84","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"copy streams that move streamed weights while the GPU computes (`-1`: two on NVIDIA and AMD, none elsewhere); used for models that run once per input, not for autoregressive ones, where they only cost memory","locale":"en"},"9291":{"id":"/en/docs/advanced-performance-85","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.oom_retry`","locale":"en"},"9292":{"id":"/en/docs/advanced-performance-86","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"on","locale":"en"},"9293":{"id":"/en/docs/advanced-performance-87","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"when a step runs out of GPU memory, run it again with more of its weights in RAM: the same result, slower","locale":"en"},"9294":{"id":"/en/docs/advanced-performance-88","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.oom_fallback`","locale":"en"},"9295":{"id":"/en/docs/advanced-performance-89","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"off","locale":"en"},"9296":{"id":"/en/docs/advanced-performance-90","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"after that, allow a cheaper way for the step (tiled decoding, smaller batches): it fits in less memory, and its output differs slightly and says so","locale":"en"},"9297":{"id":"/en/docs/advanced-performance-91","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.kv_cache`","locale":"en"},"9298":{"id":"/en/docs/advanced-performance-92","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`dynamic`","locale":"en"},"9299":{"id":"/en/docs/advanced-performance-93","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`static`: Qwen3-TTS's and CosyVoice's language models write their caches into preallocated buffers (less copying and fragmentation). Identical on a CPU; opt-in because on a GPU it may change results in the last bits","locale":"en"},"9300":{"id":"/en/docs/advanced-performance-94","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.cuda_graphs`","locale":"en"},"9301":{"id":"/en/docs/advanced-performance-95","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`true`","locale":"en"},"9302":{"id":"/en/docs/advanced-performance-96","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Qwen3-TTS's, Fish Speech's, CosyVoice 2/3's, VoxCPM's, GPT-SoVITS's and IndexTTS's decoding launched as CUDA graphs on NVIDIA GPUs, a frame at once: several times faster, identical results; a model partly streamed from RAM decodes without them, except Qwen3-TTS's talker, which keeps them (its streamed layers are copied inside the graphs); `false` launches kernel by kernel","locale":"en"},"9303":{"id":"/en/docs/advanced-performance-97","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`engines.qwen3tts.load_options.fused_projections`","locale":"en"},"9304":{"id":"/en/docs/advanced-performance-98","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`false`","locale":"en"},"9305":{"id":"/en/docs/advanced-performance-99","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Fast mode: Qwen3-TTS's q/k/v and gate/up projections fused into one product each (as qwen-tts-webui), a few percent faster on a GPU; not bit-identical there","locale":"en"},"9306":{"id":"/en/docs/advanced-performance-100","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`engines.voxcpm.load_options.attention_span`","locale":"en"},"9307":{"id":"/en/docs/advanced-performance-101","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`false`","locale":"en"},"9308":{"id":"/en/docs/advanced-performance-102","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Fast mode: VoxCPM's decoding attends over the filled part of its cache on a GPU too, 1.4–1.7× faster; not bit-identical there","locale":"en"},"9309":{"id":"/en/docs/advanced-performance-103","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`compute.cuda_allocator`","locale":"en"},"9310":{"id":"/en/docs/advanced-performance-104","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`auto`","locale":"en"},"9311":{"id":"/en/docs/advanced-performance-105","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"torch's CUDA allocator: `native`, `async` (cudaMallocAsync; CUDA graphs are not used under it, so decoding is slower), `expandable` (expandable segments: the same results, less memory reserved); applies at the next start","locale":"en"},"9312":{"id":"/en/docs/advanced-performance-106","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"How a model is placed is in each result's details (`meta.memory`: MB streamed from RAM, MB on the device), and a result made partly from RAM, or retried after running out of memory, carries a warning. When parts are partly loaded, `meta.memory.partial` says why for each: the free memory, the working memory set aside and the reserve that were weighed, or the part it gave memory up for. The log says the same.","locale":"en"},"9313":{"id":"/en/docs/advanced-performance-107","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"The working memory set aside for a step follows the request: a language model's cache is sized by the text, not by the longest generation `max_new_tokens` allows. A generation that runs far longer than its text and outgrows the GPU runs that step again with more weights streamed, with the same result.","locale":"en"},"9314":{"id":"/en/docs/advanced-performance-108","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"Partly loaded models run their layers' weights through RAM each time they run: a language model pays it for every generated frame, so the more of it fits, the faster it goes. Copies overlap the computation on NVIDIA and AMD GPUs; on Intel GPUs they are synchronous.","locale":"en"},"9315":{"id":"/en/docs/advanced-performance-109","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"`mizuoto doctor` prints the memory settings in effect.","locale":"en"},"9316":{"id":"/en/docs/advanced-performance-110","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#gpu-memory","content":"How it works inside (phases, units, streaming, the budget, estimates): Memory.","locale":"en"},"9317":{"id":"/en/docs/advanced-performance-111","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#whole-or-not-at-all-high","content":"With `compute.vram_mode = high` (**Whole or not at all**), Mizuoto always tries to load a model whole, whatever the catalogue's estimate and the card's free memory say, as ComfyUI does. It first moves idle models off that GPU to make room, then copies the weights. The request fails only when an allocation really fails: the code is `compute_unavailable` (`detail.reason` is `out_of_memory`; exit code 9 on the command line), and every model not in use is then unloaded from every GPU (see below). With `compute.gpu_jobs` above 1, a request short of room while another request holds the GPU first waits for it to finish (up to 10 minutes), then tries.","locale":"en"},"9318":{"id":"/en/docs/advanced-performance-112","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#whole-or-not-at-all-high","content":"In the other modes a model that does not fit loads partly, down to its smallest working set (the parts that never stream and the copies in flight). Even when the estimate says that does not fit, Mizuoto tries it: in every mode only an allocation that really fails is an error.","locale":"en"},"9319":{"id":"/en/docs/advanced-performance-113","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-out-of-memory","content":"When a step of a request runs out of memory anyway (an estimate was short, another program took memory), Mizuoto moves the other idle models off that GPU, leaves half of the step's own weights in RAM and runs the step again with the same random draws, so the result is the same, only slower; it tries twice. When that is not enough, and `compute.oom_fallback` is on, an engine with a cheaper way uses it (speech recognition one 30 s window at a time, GPT-SoVITS one text at a time, F5-TTS's, IndexTTS's and VoxCPM's decoders in tiles). Otherwise the request fails with `compute_unavailable` (`detail.reason` is `out_of_memory`), and, as ComfyUI does, Mizuoto unloads every model not in use from every GPU, so the next try starts on empty devices (models on the CPU stay). If it fails again, give the engine another device, set `compute.vram_mode` to `low` or `none`, or lower `compute.max_resident_models`. Mizuoto also remembers how much memory each step really used and sets that much aside the next time.","locale":"en"},"9320":{"id":"/en/docs/advanced-performance-114","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"`compute.compile` (off by default; **Settings** › **Compute** › **Compile models (torch.compile)**) runs the heaviest module of some engines through `torch.compile`:","locale":"en"},"9321":{"id":"/en/docs/advanced-performance-115","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"Engine","locale":"en"},"9322":{"id":"/en/docs/advanced-performance-116","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"Compiled","locale":"en"},"9323":{"id":"/en/docs/advanced-performance-117","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"F5-TTS","locale":"en"},"9324":{"id":"/en/docs/advanced-performance-118","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"the DiT (or E2's UNetT)","locale":"en"},"9325":{"id":"/en/docs/advanced-performance-119","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"CosyVoice","locale":"en"},"9326":{"id":"/en/docs/advanced-performance-120","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"the flow estimator","locale":"en"},"9327":{"id":"/en/docs/advanced-performance-121","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"GPT-SoVITS v4, v5 Turbo","locale":"en"},"9328":{"id":"/en/docs/advanced-performance-122","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"the CFM estimator","locale":"en"},"9329":{"id":"/en/docs/advanced-performance-123","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"IndexTTS-2 / 2.5","locale":"en"},"9330":{"id":"/en/docs/advanced-performance-124","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"the s2mel DiT and BigVGAN (also turned on by the load option `use_torch_compile`)","locale":"en"},"9331":{"id":"/en/docs/advanced-performance-125","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"VoxCPM","locale":"en"},"9332":{"id":"/en/docs/advanced-performance-126","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"the local DiT","locale":"en"},"9333":{"id":"/en/docs/advanced-performance-127","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"It applies to models loaded after the change; loaded models keep what they had.","locale":"en"},"9334":{"id":"/en/docs/advanced-performance-128","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"The first requests pay the compilation: on a CPU, 30 s to 160 s more.","locale":"en"},"9335":{"id":"/en/docs/advanced-performance-129","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"On a CPU (fp32, 8 threads) the compiled module's time dropped by 23 % for F5-TTS (a whole request from 60 s to 45 s), 7 % for IndexTTS's DiT and 20 % for its BigVGAN, 7 % for GPT-SoVITS v4, and nothing for CosyVoice or (bf16) VoxCPM. The audio differs slightly from the uncompiled run; for VoxCPM that can move where the speech ends.","locale":"en"},"9336":{"id":"/en/docs/advanced-performance-130","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"On a GPU (RTX 3090) the warm requests were 1.34× faster for F5-TTS, 1.14× for GPT-SoVITS v4 and 1.03–1.06× for IndexTTS and CosyVoice, after 55–134 s of compiling; VoxCPM runs without its CUDA graphs while compiled and was slower (0.41–0.64×): leave it off for VoxCPM.","locale":"en"},"9337":{"id":"/en/docs/advanced-performance-131","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"It needs a working C++ compiler. Without one, or when a model's code cannot be compiled, Mizuoto logs one warning and runs that model as before. The Docker image has none, so there it changes nothing.","locale":"en"},"9338":{"id":"/en/docs/advanced-performance-132","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#compiling-models-computecompile","content":"More measurements, and how speed work is checked to keep results identical: Performance record.","locale":"en"},"9339":{"id":"/en/docs/advanced-performance-133","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"Every attention computation of every engine and trainer goes through one switch, `compute.attention` (**Settings** › **Compute** › **Attention**), after ComfyUI's attention backends:","locale":"en"},"9340":{"id":"/en/docs/advanced-performance-134","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"Value","locale":"en"},"9341":{"id":"/en/docs/advanced-performance-135","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"What computes attention","locale":"en"},"9342":{"id":"/en/docs/advanced-performance-136","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"`auto` (default)","locale":"en"},"9343":{"id":"/en/docs/advanced-performance-137","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"each model as its original implementation did, so results stay identical to it","locale":"en"},"9344":{"id":"/en/docs/advanced-performance-138","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"`fast`","locale":"en"},"9345":{"id":"/en/docs/advanced-performance-139","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"what measured fastest: on NVIDIA GPUs FlashAttention, when installed, for fp16/bf16 attention over padded keys (VoxCPM's decoding: 1.4–1.6× faster), PyTorch's SDPA for everything else; elsewhere SDPA","locale":"en"},"9346":{"id":"/en/docs/advanced-performance-140","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"`sdpa`, `math`, `sdpa_flash`, `sdpa_efficient`, `sdpa_cudnn`","locale":"en"},"9347":{"id":"/en/docs/advanced-performance-141","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"PyTorch's SDPA (its own choice of kernel), its exact math kernel, or one of its fused kernels","locale":"en"},"9348":{"id":"/en/docs/advanced-performance-142","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"`flash`, `xformers`, `sage`, `sage3`","locale":"en"},"9349":{"id":"/en/docs/advanced-performance-143","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"FlashAttention, xFormers, SageAttention 2 (or 1), SageAttention 3 (Blackwell)","locale":"en"},"9350":{"id":"/en/docs/advanced-performance-144","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"Anything but `auto` changes results slightly (SageAttention quantises the attention scores). `sdpa` gives the same audio as `auto` for most models, and no faster. SageAttention is never used for the models that generate token by token (they ran on without end with it), and was no faster elsewhere; xFormers was slower where it differed: both stay available by name. Outputs list the backend that computed each part (`params.attention`: the calls per backend and why any fell back), and `mizuoto runtime` shows each loaded model's backend.","locale":"en"},"9351":{"id":"/en/docs/advanced-performance-145","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"A backend that cannot take a call falls back to the next one, ending with the model's own computation. Reasons include: not installed, the wrong GPU, a mask it does not support, a head size, fp32, a backward pass it lacks, or a kernel error. Each reason is logged once. Running out of memory is not a fallback: the memory retry handles it. With `compute.attention_strict` the request fails instead.","locale":"en"},"9352":{"id":"/en/docs/advanced-performance-146","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"Some attention keeps its own computation whatever the setting, because no fused kernel computes it: relative positions inside the scores (wenet's, w2v-BERT's, GPT-SoVITS's VITS) and a few hand-written encoders.","locale":"en"},"9353":{"id":"/en/docs/advanced-performance-147","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"`engines.<id>.attention` (**Attention for this engine** on the engine's card) sets it per engine.","locale":"en"},"9354":{"id":"/en/docs/advanced-performance-148","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"Training has its own setting, `training.attention` (**Settings** › **Training** › **Attention**). It offers only backends with a backward pass, so not SageAttention.","locale":"en"},"9355":{"id":"/en/docs/advanced-performance-149","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"The setting applies to models loaded after the change.","locale":"en"},"9356":{"id":"/en/docs/advanced-performance-150","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"How backends are chosen and checked: Acceleration.","locale":"en"},"9357":{"id":"/en/docs/advanced-performance-151","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"The packages are not dependencies. Each is tied to a torch version, a CUDA or ROCm runtime and a GPU generation, so you install them yourself, without letting them replace your torch. `mizuoto doctor` lists which are installed and whether each runs on each GPU (a tiny self-test), and gives the command for this machine. For example: `pip install \"xformers==0.0.32.post2\" --no-deps` for torch 2.8.0, `pip install flash-attn --no-build-isolation --no-deps` (it compiles), `pip install sageattention==2.2.0 --no-build-isolation --no-deps` (it needs `nvcc`). With torch 2.8 install FlashAttention or xFormers, not both: the only flash-attn wheel for torch 2.8 (2.8.3) is newer than xFormers 0.0.32 accepts, and xFormers then does not load. For `fast`, FlashAttention is the one that matters.","locale":"en"},"9358":{"id":"/en/docs/advanced-performance-152","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#attention-backends","content":"`compute.fast` (**Settings** › **Compute** › **Acceleration**) turns on GPU speed switches for the whole process, after ComfyUI's `--fast`: `tf32`, `fp16_accumulation`, `cudnn_benchmark` and `sdpa_reduced_precision`. Each changes results slightly. They take effect when Mizuoto next starts, and outputs list them (`params.fast`). Measured on an RTX 3090, all four made VoxCPM, F5-TTS, IndexTTS 1.5, Fish Speech, CosyVoice 3 and GPT-SoVITS v4 1.1–1.3× faster, while `fp16_accumulation` made GPT-SoVITS v2 about 5 % slower (v4 6–9 % faster) and `tf32` left GPT-SoVITS's speed alone (measured again on a quiet GPU, alternating with the default: an earlier 1.3–1.6× slowdown was other work on the machine).","locale":"en"},"9359":{"id":"/en/docs/advanced-performance-153","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"`tts.micro_batch` (on by default; **Settings** › **Speech** › **Run waiting requests together**): requests queued on the server for the same model that differ only in their text are sent to the engine as one batch; each request still gets its own job and result.","locale":"en"},"9360":{"id":"/en/docs/advanced-performance-154","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"A request is batched only when all of these hold:","locale":"en"},"9361":{"id":"/en/docs/advanced-performance-155","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"the model's variant takes **Batches** of at least 2: Qwen3-TTS (8), GPT-SoVITS (20), OmniVoice (8);","locale":"en"},"9362":{"id":"/en/docs/advanced-performance-156","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"its text is one segment (not split, not a batch request);","locale":"en"},"9363":{"id":"/en/docs/advanced-performance-157","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"it has no seed (a batch draws random numbers differently from a single request);","locale":"en"},"9364":{"id":"/en/docs/advanced-performance-158","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"it is not streamed text input;","locale":"en"},"9365":{"id":"/en/docs/advanced-performance-159","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"model, device, voice, style, language, parameters, engine options and reference clips are all the same.","locale":"en"},"9366":{"id":"/en/docs/advanced-performance-160","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#running-waiting-requests-together-micro-batching","content":"The running request takes the queued requests of its group just before calling the engine; when the batch fails, they go back to the queue and run one by one. The command line runs one job at a time in the foreground, so only the server (web UI, HTTP API) batches.","locale":"en"},"9367":{"id":"/en/docs/advanced-performance-161","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"Every engine and every trainer runs on a CPU, which is fine for trying things and short sentences, but much slower than a GPU, especially for long texts and training (GPT-SoVITS trains in minutes on a GPU and hours on a CPU). Smaller models (Qwen3-TTS 0.6B, GPT-SoVITS) shorten the wait noticeably; `compute.compile` helps F5-TTS most.","locale":"en"},"9368":{"id":"/en/docs/advanced-performance-162","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"Two settings make CPU work faster without changing any result (Linux; on other systems they change nothing):","locale":"en"},"9369":{"id":"/en/docs/advanced-performance-163","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"Setting","locale":"en"},"9370":{"id":"/en/docs/advanced-performance-164","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"Default","locale":"en"},"9371":{"id":"/en/docs/advanced-performance-165","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"Meaning","locale":"en"},"9372":{"id":"/en/docs/advanced-performance-166","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"`compute.cpu_allocator`","locale":"en"},"9373":{"id":"/en/docs/advanced-performance-167","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"`auto`","locale":"en"},"9374":{"id":"/en/docs/advanced-performance-168","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"CPU memory: `tuned` (`auto` on Linux) reuses large blocks and puts big tensors on huge pages (not in training under `training.memory = lowest`), 10–20 % faster on the CPU with identical results; `system` keeps the C library's defaults; applies at the next start","locale":"en"},"9375":{"id":"/en/docs/advanced-performance-169","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"`compute.cpu_threads`","locale":"en"},"9376":{"id":"/en/docs/advanced-performance-170","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"`auto`","locale":"en"},"9377":{"id":"/en/docs/advanced-performance-171","page_id":"/en/docs/advanced-performance","tags":[],"type":"text","url":"/en/docs/advanced-performance#on-a-cpu","content":"`cores` (`auto` on Linux) binds torch's CPU threads to distinct physical cores; `off` leaves them to the scheduler (better when other busy programs share the CPU); applies at the next start","locale":"en"},"9378":{"id":"/en/docs/advanced-remote","page_id":"/en/docs/advanced-remote","type":"page","content":"Remote hosts","breadcrumbs":["Mizuoto Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-remote","locale":"en"},"9379":{"id":"/en/docs/advanced-remote-0","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote","content":"Run an engine on another machine: that machine runs mizuoto agent, this one sets the engine's device to host/device, and voices, outputs and the UI stay here.","locale":"en"},"9380":{"id":"/en/docs/advanced-remote-1","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#what-runs-where","content":"What runs where","locale":"en"},"9381":{"id":"/en/docs/advanced-remote-2","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"The agent: the machine with the engines","locale":"en"},"9382":{"id":"/en/docs/advanced-remote-3","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#the-host-the-machine-that-uses-remote-engines","content":"The host: the machine that uses remote engines","locale":"en"},"9383":{"id":"/en/docs/advanced-remote-4","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#adding-a-host","content":"Adding a host","locale":"en"},"9384":{"id":"/en/docs/advanced-remote-5","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#moving-an-engine-to-a-host","content":"Moving an engine to a host","locale":"en"},"9385":{"id":"/en/docs/advanced-remote-6","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#listing-and-removing","content":"Listing and removing","locale":"en"},"9386":{"id":"/en/docs/advanced-remote-7","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#when-something-fails","content":"When something fails","locale":"en"},"9387":{"id":"/en/docs/advanced-remote-8","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#security","content":"Security","locale":"en"},"9388":{"id":"/en/docs/advanced-remote-9","page_id":"/en/docs/advanced-remote","type":"heading","tags":[],"url":"/en/docs/advanced-remote#http-api","content":"HTTP API","locale":"en"},"9389":{"id":"/en/docs/advanced-remote-10","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote","content":"When one machine has the GPU and another is where you use Mizuoto, an engine can run on the GPU machine. That machine runs `mizuoto agent` (the **agent** below); the machine you use (the **host** below) adds it as a remote host and sets the engine's device to `<name>/<device>`, for example `gpu-box/cuda:0`. Synthesis, streaming and cancelling then work as they do locally; only the engine, and the models it loads, run on the agent.","locale":"en"},"9390":{"id":"/en/docs/advanced-remote-11","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"On the agent","locale":"en"},"9391":{"id":"/en/docs/advanced-remote-12","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"On the host","locale":"en"},"9392":{"id":"/en/docs/advanced-remote-13","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"torch and the engines' packages (`mizuoto doctor` there)","locale":"en"},"9393":{"id":"/en/docs/advanced-remote-14","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"The model catalogue and the checks of each request (the plan)","locale":"en"},"9394":{"id":"/en/docs/advanced-remote-15","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"Installed models (`mizuoto model download`)","locale":"en"},"9395":{"id":"/en/docs/advanced-remote-16","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"The voice library, reference clips and voice caches","locale":"en"},"9396":{"id":"/en/docs/advanced-remote-17","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"The engines, in the agent's own process; loaded models, idle unloading","locale":"en"},"9397":{"id":"/en/docs/advanced-remote-18","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"Outputs, history, jobs and their logs","locale":"en"},"9398":{"id":"/en/docs/advanced-remote-19","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"GPU memory: loading, running out of it","locale":"en"},"9399":{"id":"/en/docs/advanced-remote-20","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"The web UI, the HTTP API, the command line","locale":"en"},"9400":{"id":"/en/docs/advanced-remote-21","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"A cache of the files hosts sent: `<cache>/remote/files/<sha256>/`","locale":"en"},"9401":{"id":"/en/docs/advanced-remote-22","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"Training (always here)","locale":"en"},"9402":{"id":"/en/docs/advanced-remote-23","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"**Model states come from the agent.** For an engine whose device names a remote host, a model is \"installed\" when the agent's list of installed models has it (the host asks again every 15 seconds or so), not when this machine's models folder does. Install the models on the agent with its own `mizuoto` commands.","locale":"en"},"9403":{"id":"/en/docs/advanced-remote-24","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"**Both machines run the same Mizuoto version.** Mizuoto 0.2 speaks agent protocol 2, at the level of a loaded engine (load, prepare a voice, synthesize, convert, edit). A host and an agent of different protocols refuse each other at the handshake, with the hint to install the same Mizuoto version on both machines.","locale":"en"},"9404":{"id":"/en/docs/advanced-remote-25","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"**Files travel by content.** Files a request names (reference clips, an emotion clip…) are sent by SHA-256: those the agent already has are not sent again, the others are uploaded once in 8 MB pieces. When the agent starts it deletes files no host has used for a month.","locale":"en"},"9405":{"id":"/en/docs/advanced-remote-26","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"**Voice caches come back.** The cache an engine prepares for a voice (on its first use) is written on the agent and sent back file by file into the voice's cache folder on the host, which later requests read.","locale":"en"},"9406":{"id":"/en/docs/advanced-remote-27","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"**Streaming, streamed text and cancelling work.** Audio chunks come back as they are made; a cancel is forwarded to the engine on the agent.","locale":"en"},"9407":{"id":"/en/docs/advanced-remote-28","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#what-runs-where","content":"**Training stays here.** With the engine on a remote host, its training methods say why: `<engine> runs on <host>, and training runs on this machine: mizuoto remote use <engine> --local`.","locale":"en"},"9408":{"id":"/en/docs/advanced-remote-29","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"Option","locale":"en"},"9409":{"id":"/en/docs/advanced-remote-30","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"Setting","locale":"en"},"9410":{"id":"/en/docs/advanced-remote-31","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"Default","locale":"en"},"9411":{"id":"/en/docs/advanced-remote-32","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"Meaning","locale":"en"},"9412":{"id":"/en/docs/advanced-remote-33","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"`--host`","locale":"en"},"9413":{"id":"/en/docs/advanced-remote-34","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"`remote.agent.host`","locale":"en"},"9414":{"id":"/en/docs/advanced-remote-35","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"`127.0.0.1`","locale":"en"},"9415":{"id":"/en/docs/advanced-remote-36","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"Address to listen on; `0.0.0.0` for every interface","locale":"en"},"9416":{"id":"/en/docs/advanced-remote-37","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"`--port`","locale":"en"},"9417":{"id":"/en/docs/advanced-remote-38","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"`remote.agent.port`","locale":"en"},"9418":{"id":"/en/docs/advanced-remote-39","page_id":"/en/docs/advanced-remote","tags":[],"type":"text","url":"/en/docs/advanced-remote#the-agent-the-machine-with-the-engines","content":"`7870`","locale":"en"},"941