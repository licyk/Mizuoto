development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"torch is a dependency, but its build is installed by the user first: from the download.pytorch.org index that matches the machine (CUDA, ROCm, XPU or CPU; on Apple silicon PyPI's wheels include MPS), then Mizuoto, whose installation keeps it. `mizuoto/core/compute/torch_index.py` knows the builds published for torch ≥ 2.8 (CUDA cu126–cu132, ROCm 6.4–7.2, XPU, CPU) and picks the newest CUDA build the driver runs, else ROCm, XPU, MPS or CPU; `mizuoto doctor` prints the install command when the installed build does not match the hardware.","locale":"en"},"11449":{"id":"/en/docs/development-release-74","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"Device","locale":"en"},"11450":{"id":"/en/docs/development-release-75","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"Platforms","locale":"en"},"11451":{"id":"/en/docs/development-release-76","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"NVIDIA (CUDA)","locale":"en"},"11452":{"id":"/en/docs/development-release-77","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"Linux, Windows","locale":"en"},"11453":{"id":"/en/docs/development-release-78","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"AMD (ROCm; `cuda` to torch)","locale":"en"},"11454":{"id":"/en/docs/development-release-79","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"Linux","locale":"en"},"11455":{"id":"/en/docs/development-release-80","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"Intel (XPU)","locale":"en"},"11456":{"id":"/en/docs/development-release-81","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"Linux, Windows","locale":"en"},"11457":{"id":"/en/docs/development-release-82","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"Apple silicon (MPS)","locale":"en"},"11458":{"id":"/en/docs/development-release-83","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"macOS arm64","locale":"en"},"11459":{"id":"/en/docs/development-release-84","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"CPU","locale":"en"},"11460":{"id":"/en/docs/development-release-85","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"All","locale":"en"},"11461":{"id":"/en/docs/development-release-86","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"CI tests every combination of Linux x86_64, Windows x86_64 and macOS arm64 with Python 3.10–3.13 on CPU torch, and separately torch 2.8.0 and the latest release.","locale":"en"},"11462":{"id":"/en/docs/development-release-87","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#torch-and-platforms","content":"The code has paths for these devices (device probing, float64 modules on the CPU where a device lacks float64, no compilation on MPS, CUDA graphs and half precision only on CUDA) and they are tested on simulated devices, but they have not been verified on AMD, Intel or Apple hardware.","locale":"en"},"11463":{"id":"/en/docs/development-release-88","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"Each distribution has a version of its own, in a file that holds nothing else; a push to `main` that changes it releases that distribution (see below):","locale":"en"},"11464":{"id":"/en/docs/development-release-89","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"File","locale":"en"},"11465":{"id":"/en/docs/development-release-90","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"Version of","locale":"en"},"11466":{"id":"/en/docs/development-release-91","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"Tag","locale":"en"},"11467":{"id":"/en/docs/development-release-92","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`mizuoto/version.py`","locale":"en"},"11468":{"id":"/en/docs/development-release-93","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`mizuoto` (the web UI's `package.json` follows it by hand)","locale":"en"},"11469":{"id":"/en/docs/development-release-94","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`v<version>`","locale":"en"},"11470":{"id":"/en/docs/development-release-95","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`packages/native/fishspeech/mizuoto_fishspeech/version.py`","locale":"en"},"11471":{"id":"/en/docs/development-release-96","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`mizuoto-fishspeech`","locale":"en"},"11472":{"id":"/en/docs/development-release-97","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`mizuoto-fishspeech-v<version>`","locale":"en"},"11473":{"id":"/en/docs/development-release-98","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`packages/native/indextts/mizuoto_indextts/version.py`","locale":"en"},"11474":{"id":"/en/docs/development-release-99","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`mizuoto-indextts`","locale":"en"},"11475":{"id":"/en/docs/development-release-100","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`mizuoto-indextts-v<version>`","locale":"en"},"11476":{"id":"/en/docs/development-release-101","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"A gated package names the Mizuoto versions it works with in its `pyproject.toml`: `mizuoto>=0.2.0,<0.3`. Its code runs on Mizuoto's runtime and its manifest (options, catalogue, licence) ships in `mizuoto`, so:","locale":"en"},"11477":{"id":"/en/docs/development-release-102","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"**The lower bound** is the oldest Mizuoto release with everything the package uses. CI tests the package on that release from PyPI (the `oldest-mizuoto` job); raise the bound when the package starts using something newer, and release Mizuoto first.","locale":"en"},"11478":{"id":"/en/docs/development-release-103","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"**The upper bound** is the next minor release while Mizuoto is 0.x. `check_gated_distribution` (in `tests/core/test_engines.py`, run by each package's `test_<id>_package.py`) fails once Mizuoto's version leaves the range, so a Mizuoto release past it also releases the gated packages with a raised range.","locale":"en"},"11479":{"id":"/en/docs/development-release-104","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"**A change to a gated engine's options** changes its manifest in `mizuoto` too: release Mizuoto with the manifest, then the package with its lower bound raised to that release.","locale":"en"},"11480":{"id":"/en/docs/development-release-105","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"`mizuoto doctor` reports an installed gated engine that does not go with this Mizuoto (its range excludes it, or its `OPTION_SCHEMA` and the manifest disagree) as an error with `pip install --upgrade mizuoto mizuoto-<id>`, and `mizuoto version` lists each distribution's version.","locale":"en"},"11481":{"id":"/en/docs/development-release-106","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#versions","content":"Voice caches are keyed by Mizuoto's version, and for a gated engine by its distribution's version too, so they are rebuilt once after an upgrade of either. Settings keys a version no longer knows are ignored (see Architecture). A host and its remote agents must speak the same protocol version (`AGENT_PROTOCOL`, now 2): otherwise each refuses the other at `hello` with an upgrade hint. More in The data folder and compatibility.","locale":"en"},"11482":{"id":"/en/docs/development-release-107","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#wheels-scriptsbuild_wheelspy","content":"**host**: `bun install --frozen-lockfile` and `bun run build` in `mizuoto/webui` (`--skip-web` reuses the existing `dist/`, as Docker's `wheels` stage does), a check that `dist/index.html` exists, then `uv build` of the `mizuoto` sdist and, from it, the wheel, from a clean copy of `mizuoto/`, `pyproject.toml` and `README.md` (no `__pycache__`, no stale `build/`).","locale":"en"},"11483":{"id":"/en/docs/development-release-108","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#wheels-scriptsbuild_wheelspy","content":"**native**: each package in `packages/native/` (or the ones named), copied without `__pycache__`, `*.egg-info`, `build` and `dist`, and built with `uv build --wheel`.","locale":"en"},"11484":{"id":"/en/docs/development-release-109","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#wheels-scriptsbuild_wheelspy","content":"The output goes to `dist/` by default. The script uses the standard library plus uv and bun.","locale":"en"},"11485":{"id":"/en/docs/development-release-110","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#wheels-scriptsbuild_wheelspy","content":"The package data that ships in the wheel is listed in `pyproject.toml` (`[tool.setuptools.package-data]`): the built UI, the engine manifests, files manifests and licence texts, F5-TTS's vocabulary, GPT-SoVITS's text front-end data, Whisper's vocabulary. IndexTTS's text-normalisation FSTs ship in `mizuoto-indextts`.","locale":"en"},"11486":{"id":"/en/docs/development-release-111","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#smoke-test-scriptssmoke_wheelspy","content":"It tries the built distributions as a user gets them. In a temporary folder outside the checkout, uv creates a new environment (`--python`, 3.11 by default), installs torch first from `--torch-index` (the CPU build by default; `--torch` picks the version, `torch>=2.8` by default), then, in one install, the wheels in `--dist` and the distributions it lacks from `--index` (`--others index`, the default), which must leave that torch in place. Since each distribution is released on its own, a release is tried with the others as users have them: a `mizuoto` wheel with the gated engines' released packages, a gated engine's wheel with the newest released Mizuoto its range allows. A Mizuoto release the released gated packages do not allow fails here. The installed versions must be the wheels'. uv runs without the machine's configuration (`--no-config`, no `UV_*`/`PIP_*` variables). Then, in a temporary data folder:","locale":"en"},"11487":{"id":"/en/docs/development-release-112","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#smoke-test-scriptssmoke_wheelspy","content":"`mizuoto version`, `mizuoto env vars` and `mizuoto doctor`: every engine must be available;","locale":"en"},"11488":{"id":"/en/docs/development-release-113","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#smoke-test-scriptssmoke_wheelspy","content":"every engine's implementation and trainer imported (`get_engine`), every module of `mizuoto` and the gated packages imported, and every data file the checkout has beside the code of the distributions built from it found installed (the ones engines read at run time actually read);","locale":"en"},"11489":{"id":"/en/docs/development-release-114","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#smoke-test-scriptssmoke_wheelspy","content":"a dummy-engine `mizuoto speak`;","locale":"en"},"11490":{"id":"/en/docs/development-release-115","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#smoke-test-scriptssmoke_wheelspy","content":"the server: `/api/v1/app/health`, the UI, and a dummy speak through the API.","locale":"en"},"11491":{"id":"/en/docs/development-release-116","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`.github/workflows/ci.yml` checks each push and pull request for what it changes: Mizuoto, a gated package, the web UI, the docs site (see Testing).","locale":"en"},"11492":{"id":"/en/docs/development-release-117","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`.github/workflows/release.yml` runs on a push to `main` that changes a version file (`mizuoto/version.py`, `packages/native/*/mizuoto_*/version.py`), on a pushed tag `v*` or `mizuoto-*-v*` (GitHub applies no path filter to tags) and by hand (its `packages` input: `all`, `mizuoto`, `mizuoto-fishspeech` or `mizuoto-indextts`). One release runs at a time per ref, and none is cancelled. Packages are installed with uv, as in CI.","locale":"en"},"11493":{"id":"/en/docs/development-release-118","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`plan`: `python scripts/ci.py release` decides what this run releases. A push releases each distribution whose version file it changed (the compare API's files); a tag releases the one it names and must equal its version (`v0.2.0` for Mizuoto 0.2.0, `mizuoto-indextts-v0.2.1` for mizuoto-indextts 0.2.1); a manual run, its input.","locale":"en"},"11494":{"id":"/en/docs/development-release-119","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`checks`: `ci.yml` itself, called as a reusable workflow, for what the push changed (a version file checks its distribution; a tag or a manual run, everything). CI's own run of the same push to `main` skips its jobs, so nothing runs twice.","locale":"en"},"11495":{"id":"/en/docs/development-release-120","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`build` (Ubuntu, Python 3.11, uv; bun for Mizuoto's web UI): `build_wheels.py host` and/or `build_wheels.py native <id>…`, only what is released; `twine check dist/*`; `dist/` is uploaded as the `dist` artifact.","locale":"en"},"11496":{"id":"/en/docs/development-release-121","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`smoke` (Ubuntu, Python 3.10 and 3.13): downloads the artifact and runs `smoke_wheels.py --dist dist --python <version> --others index`, so the release is tried with the other distributions as released on PyPI.","locale":"en"},"11497":{"id":"/en/docs/development-release-122","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`publish`: in the `pypi` environment (which can require an approval), with the `TWINE_PASSWORD` secret (a PyPI API token; user `__token__`), `twine upload --skip-existing` of Mizuoto first, then the gated wheels, so a package that needs a new Mizuoto never appears before it. A version already on PyPI is skipped.","locale":"en"},"11498":{"id":"/en/docs/development-release-123","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"`github-release` (tags only): a GitHub release named after the tag, with that distribution's files and notes generated from the previous tag of the same distribution; a gated engine's release is not marked latest.","locale":"en"},"11499":{"id":"/en/docs/development-release-124","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ci-and-the-release-workflow","content":"So the usual release of one distribution is: bump its version file, push to `main` (the release publishes it), then push its tag (`v<version>`, or `mizuoto-<id>-v<version>`) for the GitHub release (its upload finds the files already on PyPI). Bumping several version files in one push releases them together, Mizuoto first.","locale":"en"},"11500":{"id":"/en/docs/development-release-125","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"The `Dockerfile` at the repository root builds one image: the server, its web UI and every engine, with GPT-SoVITS's Japanese and Korean front ends (and IndexTTS-2.5's Japanese with `GATED=1`). Models go into the `/data` volume.","locale":"en"},"11501":{"id":"/en/docs/development-release-126","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"Build argument","locale":"en"},"11502":{"id":"/en/docs/development-release-127","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"Default","locale":"en"},"11503":{"id":"/en/docs/development-release-128","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"Meaning","locale":"en"},"11504":{"id":"/en/docs/development-release-129","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`PYTHON`","locale":"en"},"11505":{"id":"/en/docs/development-release-130","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`3.11`","locale":"en"},"11506":{"id":"/en/docs/development-release-131","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"The `python:<version>-slim` base of the wheels stage and the image","locale":"en"},"11507":{"id":"/en/docs/development-release-132","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`TORCH_INDEX`","locale":"en"},"11508":{"id":"/en/docs/development-release-133","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`https://download.pytorch.org/whl/cu128`","locale":"en"},"11509":{"id":"/en/docs/development-release-134","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"Where torch comes from: a CUDA (`cu126` … `cu132`), ROCm (`rocm6.4` … `rocm7.2`) or `cpu` index","locale":"en"},"11510":{"id":"/en/docs/development-release-135","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`TORCH`","locale":"en"},"11511":{"id":"/en/docs/development-release-136","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`torch>=2.8`","locale":"en"},"11512":{"id":"/en/docs/development-release-137","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"Which torch","locale":"en"},"11513":{"id":"/en/docs/development-release-138","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`GATED`","locale":"en"},"11514":{"id":"/en/docs/development-release-139","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`0`","locale":"en"},"11515":{"id":"/en/docs/development-release-140","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`1` also builds and installs the licence-gated engines (their licences must still be accepted)","locale":"en"},"11516":{"id":"/en/docs/development-release-141","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"Stage","locale":"en"},"11517":{"id":"/en/docs/development-release-142","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"What","locale":"en"},"11518":{"id":"/en/docs/development-release-143","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`web`","locale":"en"},"11519":{"id":"/en/docs/development-release-144","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`oven/bun:1`: `bun install --frozen-lockfile`, `bun run build`","locale":"en"},"11520":{"id":"/en/docs/development-release-145","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`wheels`","locale":"en"},"11521":{"id":"/en/docs/development-release-146","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`python:<PYTHON>-slim` with a compiler and CMake: a wheel of `pyopenjtalk==0.4.1` (published as an sdist only), `build_wheels.py host --skip-web`, and `build_wheels.py native` when `GATED=1`","locale":"en"},"11522":{"id":"/en/docs/development-release-147","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"the image","locale":"en"},"11523":{"id":"/en/docs/development-release-148","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"`python:<PYTHON>-slim`: torch from `TORCH_INDEX` first, then the wheels with `mizuoto[gptsovits-ja,gptsovits-ko]` (and `mizuoto-indextts[ja]`), the rest from PyPI; `MIZUOTO_DATA_DIR=/data`, a `/data` volume, port 7869, a health check on `/api/v1/app/health`","locale":"en"},"11524":{"id":"/en/docs/development-release-149","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#docker","content":"No system packages are installed in the image: PyAV, torch and the text libraries ship their native code in their wheels. Without a C compiler in the image, `compute.compile` runs eagerly (it warns once). For using the image, see Docker.","locale":"en"},"11525":{"id":"/en/docs/development-release-150","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-model-mirror-scriptsmirror_modelspy","content":"`downloads.repository = \"mizuoto-model\"` makes Mizuoto download from its mirror repository first (`downloads.mirror_repo`, default `licyk/mizuoto-model`, the same id on Hugging Face and ModelScope) and fill in what the mirror lacks from each model's official repositories, so a partial mirror works. The mirror lays files out as Mizuoto keeps them: a model under `<engine>/<model>/<path>`, a shared asset under `_assets/<engine>/<asset>/<path>`.","locale":"en"},"11526":{"id":"/en/docs/development-release-151","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-model-mirror-scriptsmirror_modelspy","content":"`build` lays the installed catalogue models and shared assets out under `OUT` (hard links where possible), checks each file against its pinned size and SHA-256 (`--no-verify`: sizes only), and writes `MIRROR.json` (each file's path, size, SHA-256 and official origin) and a README. Archive parts (`unpack`) are not kept after unpacking, so they stay official-only. Licence-gated engines are left out unless `--gated`.","locale":"en"},"11527":{"id":"/en/docs/development-release-152","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-model-mirror-scriptsmirror_modelspy","content":"`upload` publishes with `hf upload-large-folder` (it needs `hf auth login`) and, with `--modelscope`, with `modelscope upload`.","locale":"en"},"11528":{"id":"/en/docs/development-release-153","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-model-mirror-scriptsmirror_modelspy","content":"`check` lists, with HEAD requests, which catalogue files the published mirror lacks.","locale":"en"},"11529":{"id":"/en/docs/development-release-154","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-model-mirror-scriptsmirror_modelspy","content":"Publishing the mirror is the mirror owner's step; the weights keep their own licences.","locale":"en"},"11530":{"id":"/en/docs/development-release-155","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-docs-site","content":"This site lives in `site/`. It is built on fumadocs (TanStack Start + Vite) with bun into static files (`.output/public`). `.github/workflows/site.yml` publishes it to GitHub Pages: on a push to `main` that changes `site/` (or by hand) it runs the site's checks, builds it with `VITE_BASE_PATH=/Mizuoto/` (Pages serves it under `https://licyk.github.io/Mizuoto/`; the router and the search index follow Vite's base), adds `.nojekyll`, and force-pushes the output to the `gh-pages` branch over SSH with the `GITEE_RSA_PRIVATE_KEY` secret (a key with write access to the repository). The repository's Pages settings serve that branch. `site/vercel.json` is ready for a Vercel deployment at the root path.","locale":"en"},"11531":{"id":"/en/docs/development-release-156","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-docs-site","content":"CI's `site` job runs `bun install --frozen-lockfile`, `bun run check`, `bun run test` and `bun run build` in `site/`, for changes to `site/` only.","locale":"en"},"11532":{"id":"/en/docs/development-release-157","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-docs-site","content":"Pages are in `site/content/docs/`: `<slug>.mdx` in Simplified Chinese (the default language, `zh-CN`) and `<slug>.en.mdx` in English, with the same structure. The sidebars are `meta.json` and `meta.en.json`, grouped by `---Title---` separators.","locale":"en"},"11533":{"id":"/en/docs/development-release-158","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-docs-site","content":"The frontmatter has `title`, `description` and `icon` (a Lucide icon name). The MDX components are in `site/src/components/mdx.tsx`: `Cards`/`Card`, `Callout`, `Tabs`/`Tab`, `Steps`/`Step`, `Accordions`/`Accordion` and `Mermaid` (a `chart` prop; rendered in the browser with Mermaid loaded from a CDN, following the site's light or dark theme).","locale":"en"},"11534":{"id":"/en/docs/development-release-159","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-docs-site","content":"`prepare-static-output.mjs` checks that every page in `meta.json` produced `docs/<slug>/index.html` and copies `_shell.html` to `404.html`.","locale":"en"},"11535":{"id":"/en/docs/development-release-160","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-docs-site","content":"`src/lib/i18n-content.test.ts` requires an English page for every Chinese one and the same page order in both sidebars.","locale":"en"},"11536":{"id":"/en/docs/development-runtime","page_id":"/en/docs/development-runtime","type":"page","content":"Runtime","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-runtime","locale":"en"},"11537":{"id":"/en/docs/development-runtime-0","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime","content":"How engines run inside Mizuoto's process: the runtime's parts (devices, model handles and manager, layers, attention, sampling), the request context, the rule that engines change no global state, LocalEngine, memory levels, cancel and timeouts, streams, remote engines, and the commands that show it.","locale":"en"},"11538":{"id":"/en/docs/development-runtime-1","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#who-is-where","content":"Who is where","locale":"en"},"11539":{"id":"/en/docs/development-runtime-2","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#the-runtime","content":"The runtime","locale":"en"},"11540":{"id":"/en/docs/development-runtime-3","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#devices-devicepy","content":"Devices: `device.py`","locale":"en"},"11541":{"id":"/en/docs/development-runtime-4","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"Model handles and the model manager","locale":"en"},"11542":{"id":"/en/docs/development-runtime-5","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#layers-attention-loading","content":"Layers, attention, loading","locale":"en"},"11543":{"id":"/en/docs/development-runtime-6","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#the-request-context","content":"The request context","locale":"en"},"11544":{"id":"/en/docs/development-runtime-7","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#global-state","content":"Global state","locale":"en"},"11545":{"id":"/en/docs/development-runtime-8","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"LocalEngine: calling a model in this process","locale":"en"},"11546":{"id":"/en/docs/development-runtime-9","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#streams-are-generators","content":"Streams are generators","locale":"en"},"11547":{"id":"/en/docs/development-runtime-10","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#cancel-and-timeouts","content":"Cancel and timeouts","locale":"en"},"11548":{"id":"/en/docs/development-runtime-11","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#errors","content":"Errors","locale":"en"},"11549":{"id":"/en/docs/development-runtime-12","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#memory","content":"Memory","locale":"en"},"11550":{"id":"/en/docs/development-runtime-13","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#remote-engines","content":"Remote engines","locale":"en"},"11551":{"id":"/en/docs/development-runtime-14","page_id":"/en/docs/development-runtime","type":"heading","tags":[],"url":"/en/docs/development-runtime#seeing-it-mizuoto-runtime-and-mizuoto-doctor","content":"Seeing it: `mizuoto runtime` and `mizuoto doctor`","locale":"en"},"11552":{"id":"/en/docs/development-runtime-15","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime","content":"Every engine runs in the server's own process (or in the command's, on the command line), on Mizuoto's own runtime: `mizuoto/runtime/`, a small framework in the manner of ComfyUI's model management. The core reaches it only through `mizuoto/core/inference/`. This page covers both sides: what an engine gets from the runtime, and how the core calls a loaded model. How to write an engine is in Adding an engine.","locale":"en"},"11553":{"id":"/en/docs/development-runtime-16","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"Part","locale":"en"},"11554":{"id":"/en/docs/development-runtime-17","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"Code","locale":"en"},"11555":{"id":"/en/docs/development-runtime-18","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"Role","locale":"en"},"11556":{"id":"/en/docs/development-runtime-19","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`InferenceService`","locale":"en"},"11557":{"id":"/en/docs/development-runtime-20","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/core/inference/service.py`","locale":"en"},"11558":{"id":"/en/docs/development-runtime-21","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"Builds the `Runtime` on first use, from the `compute` settings; says which engines are implemented here, what an engine is missing (`torch`, `mizuoto-fishspeech`…), its extras and its trainer","locale":"en"},"11559":{"id":"/en/docs/development-runtime-22","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`RuntimeService`","locale":"en"},"11560":{"id":"/en/docs/development-runtime-23","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/core/inference/runtime.py`","locale":"en"},"11561":{"id":"/en/docs/development-runtime-24","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"One engine per (engine, device), made on demand; `loaded()` gives a model's `EngineHandle`; `max_resident_models`, the idle reaper, `runtime_changed`, the doctor","locale":"en"},"11562":{"id":"/en/docs/development-runtime-25","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`LocalEngine` / `LocalHandle`","locale":"en"},"11563":{"id":"/en/docs/development-runtime-26","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/core/inference/local.py`","locale":"en"},"11564":{"id":"/en/docs/development-runtime-27","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"One engine on one device in this process, and the handle of one of its loaded models","locale":"en"},"11565":{"id":"/en/docs/development-runtime-28","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`RemoteEngine` / `RemoteEngineHandle`","locale":"en"},"11566":{"id":"/en/docs/development-runtime-29","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/core/remote/client.py`","locale":"en"},"11567":{"id":"/en/docs/development-runtime-30","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"The same, for a device named `<host>/<device>`: a session with `mizuoto agent` on another machine","locale":"en"},"11568":{"id":"/en/docs/development-runtime-31","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`EngineHandle`, `EngineRequest`, `ModelRef`","locale":"en"},"11569":{"id":"/en/docs/development-runtime-32","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/core/inference/engine.py`","locale":"en"},"11570":{"id":"/en/docs/development-runtime-33","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"What the core holds and passes: standard library only at module level","locale":"en"},"11571":{"id":"/en/docs/development-runtime-34","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"Task types","locale":"en"},"11572":{"id":"/en/docs/development-runtime-35","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/core/inference/tasks.py`","locale":"en"},"11573":{"id":"/en/docs/development-runtime-36","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`SynthesisTask`, `VoiceSpec`, `Reference`, `LoadSpec`, `AudioChunk`, `Description`… (standard library dataclasses)","locale":"en"},"11574":{"id":"/en/docs/development-runtime-37","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`Engine`, `LoadedEngine`, registry","locale":"en"},"11575":{"id":"/en/docs/development-runtime-38","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/runtime/engine.py`","locale":"en"},"11576":{"id":"/en/docs/development-runtime-39","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"The engine contract; `BUILTIN` and the `mizuoto.engines` entry points","locale":"en"},"11577":{"id":"/en/docs/development-runtime-40","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`RequestContext`","locale":"en"},"11578":{"id":"/en/docs/development-runtime-41","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/runtime/context.py`","locale":"en"},"11579":{"id":"/en/docs/development-runtime-42","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"One per call: cancel, generators, progress, text pieces, scratch","locale":"en"},"11580":{"id":"/en/docs/development-runtime-43","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`Runtime`","locale":"en"},"11581":{"id":"/en/docs/development-runtime-44","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`mizuoto/runtime/runtime.py`","locale":"en"},"11582":{"id":"/en/docs/development-runtime-45","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"What `Engine.load` gets: `devices` (`DeviceService`), `manager` (`ModelManager`), `options` (`RuntimeOptions`)","locale":"en"},"11583":{"id":"/en/docs/development-runtime-46","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#who-is-where","content":"`TtsService`, `AsrService` and the voice service never see a `LocalEngine`: they call `RuntimeService.loaded(ModelRef, device, dtype, options, request)` and use the handle it returns. Local or remote makes no difference to them.","locale":"en"},"11584":{"id":"/en/docs/development-runtime-47","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-runtime","content":"`InferenceService.runtime` builds one `Runtime` per process the first time a model loads, so a command that never loads a model imports none of it.","locale":"en"},"11585":{"id":"/en/docs/development-runtime-48","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`DeviceService` is the device half of ComfyUI's `model_management.py`, as an object instead of module globals. Device names are Mizuoto's: `cpu`, `cuda:N` (NVIDIA, or AMD on ROCm), `xpu:N`, `mps`; resolving `auto` is the core's job (`ComputeService.resolve_device`). Engines get a real `torch.device`; nothing narrows `CUDA_VISIBLE_DEVICES`.","locale":"en"},"11586":{"id":"/en/docs/development-runtime-49","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`memory(device)`: (free, total) bytes; on CUDA, memory torch holds but does not use counts as free.","locale":"en"},"11587":{"id":"/en/docs/development-runtime-50","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`empty_cache(device)`, `synchronize(device)`.","locale":"en"},"11588":{"id":"/en/docs/development-runtime-51","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`supports(device, dtype)` and `pick_dtype(device, requested, supported, cpu)`: the dtype a component runs in, from the user's `engines.<id>.dtype` and the engine's preference order (fp32 on the CPU unless asked; GTX 16xx cards are kept off fp16).","locale":"en"},"11589":{"id":"/en/docs/development-runtime-52","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`is_oom(error)`: whether an exception means a device ran out of memory, without importing torch.","locale":"en"},"11590":{"id":"/en/docs/development-runtime-53","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`float64_device(device)`: where a module that computes in float64 runs, the device or the CPU when it has no float64 (MPS, XPU without fp64). `pin_to_cpu(module)` keeps such a module on the CPU when its parent moves; CosyVoice 3's F0 predictor uses both.","locale":"en"},"11591":{"id":"/en/docs/development-runtime-54","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`probe_devices()`: the accelerators torch sees (CUDA, ROCm by HIP, XPU, MPS) with their memory. The core's probe (`mizuoto/core/compute/probe.py`) asks `nvidia-smi`, `rocm-smi`/`amd-smi` and the platform first, and torch only in a child process (`python -m mizuoto.runtime.device`) when the installed build could find a GPU they did not, or in this process once the runtime has loaded torch.","locale":"en"},"11592":{"id":"/en/docs/development-runtime-55","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"An engine's `DEVICES` (every kind by default) mirror its manifest's `devices`; `torch.compile` runs eagerly on MPS.","locale":"en"},"11593":{"id":"/en/docs/development-runtime-56","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#devices-devicepy","content":"`torch_build()`: what the installed torch was built for and which accelerators work here (`mizuoto doctor`).","locale":"en"},"11594":{"id":"/en/docs/development-runtime-57","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"A `ModelHandle` (`handle.py`, ComfyUI's `ModelPatcher` without the diffusion parts) wraps one `nn.Module` with weights: its `name` (shown in the loaded-models list, e.g. `omnivoice/omnivoice:model`), `load_device`, `offload_device` (the CPU), `kind` (`sequence` for an autoregressive LM, else `oneshot`) and its sizes (`size_bytes`, `loaded_bytes`, `streamed_bytes`, `host_bytes`). The engine only reads `module`; a `LoadedEngine` lists its handles in `self.handles`.","locale":"en"},"11595":{"id":"/en/docs/development-runtime-58","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"The `ModelManager` (`manager.py`, ComfyUI's `load_models_gpu` / `free_memory`) keeps every registered handle with its owner (`<model id>@<device>`) and last use, and places handles **whole or partly** for each phase of a request (`ctx.use`, `ctx.run`): idle components give up memory unit by unit, a model that does not fit keeps part of its weights in RAM and streams them to the device as its layers run, and a phase that runs out of memory runs again, exactly, with more weights streamed. The policy (`policy.py`, `VramPolicy`) comes from the `compute` settings at each load.","locale":"en"},"11596":{"id":"/en/docs/development-runtime-59","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"Method","locale":"en"},"11597":{"id":"/en/docs/development-runtime-60","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"Use","locale":"en"},"11598":{"id":"/en/docs/development-runtime-61","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"`register(owner, handles, mode, pinned)` / `unregister(owner)`","locale":"en"},"11599":{"id":"/en/docs/development-runtime-62","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"After a load; when the model is unloaded (frees without copying back)","locale":"en"},"11600":{"id":"/en/docs/development-runtime-63","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"`use(handles, memory_required)`","locale":"en"},"11601":{"id":"/en/docs/development-runtime-64","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"Around each phase, or the whole call for an engine without `PHASED`","locale":"en"},"11602":{"id":"/en/docs/development-runtime-65","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"`after_oom(handles)`","locale":"en"},"11603":{"id":"/en/docs/development-runtime-66","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"`ctx.run`'s clean-up before a retry","locale":"en"},"11604":{"id":"/en/docs/development-runtime-67","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"`release_idle(device)`, `drop_host_copies()`","locale":"en"},"11605":{"id":"/en/docs/development-runtime-68","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"Free a GPU (before a fine-tune, after running out of memory); RAM is short","locale":"en"},"11606":{"id":"/en/docs/development-runtime-69","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"`resident()`, `owner_usage(owner)`, `owner_placements(owner)`","locale":"en"},"11607":{"id":"/en/docs/development-runtime-70","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"The loaded-models list, `meta.memory` and its `partial` report","locale":"en"},"11608":{"id":"/en/docs/development-runtime-71","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"Phases, the budget and VRAM modes, units and streaming, host copies, eviction, the exact retry, working-memory estimates and their calibration, and how an engine takes part: Memory.","locale":"en"},"11609":{"id":"/en/docs/development-runtime-72","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#model-handles-and-the-model-manager","content":"On the CPU nothing is moved and nothing is counted, unless `DeviceService(simulate={\"cpu\": bytes})` makes it play a GPU (tests and the parity harness: `compute.simulate_vram_mb`).","locale":"en"},"11610":{"id":"/en/docs/development-runtime-73","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`ops.py`**: every engine builds its modules from an `ops` namespace instead of `torch.nn`. `ops.default` has the same layers with **no random initialisation**: constructing a large model takes no time and draws no random numbers, so loading never touches an RNG. `ops.cast` also casts weights to the input's dtype and device on every forward, for a component stored in one dtype and computed in another. `init_random(module, generator)` gives a `default` module real weights in tests.","locale":"en"},"11611":{"id":"/en/docs/development-runtime-74","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`accel/`**: every attention computation in native code is `accel.attention(q, k, v, *, site=SITE, mask=…, causal=…, scale=…, enable_gqa=…, dropout_p=…, mask_info=…)`, never a direct call to SDPA (an architecture test forbids that outside `runtime/accel`). Each `Site` holds its **reference**, the exact computation upstream made there; with `compute.attention = auto` (the default) the reference runs, bit for bit. Another setting binds a policy that chooses among SDPA's kernels, FlashAttention, xFormers and SageAttention per call, with compatibility checks and fallbacks; `features.apply` sets the host's `compute.fast` switches, the one place native code sets `torch.backends` flags. See Acceleration.","locale":"en"},"11612":{"id":"/en/docs/development-runtime-75","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`loading.py`**: `load_state_dict` (safetensors, or a pickle with `weights_only=True`), `strip_prefix`, `replace_prefixes`, `fold_weight_norm`, and `load_into`, strict by default: a missing or unexpected key is an error naming it, unless the engine lists it as ignorable.","locale":"en"},"11613":{"id":"/en/docs/development-runtime-76","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`sampling.py`**: `hf_sample` / `hf_process`, transformers' logits processors in transformers' order (repetition penalty, min new tokens, suppression, temperature, top-k, top-p), then `multinomial1`, `torch.multinomial`'s own computation on the request's generator without its waits for the device, so a seeded draw matches (sync-free sampling).","locale":"en"},"11614":{"id":"/en/docs/development-runtime-77","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`lm/`**: `QwenDecoder` (the Qwen2/Qwen3 decoder with transformers' numerics and parameter names, `mask_for`, `hf_sdpa`), `DynamicCache`, the opt-in `BufferCache` (`compute.kv_cache = static`) and `peak_bytes` for working-memory estimates.","locale":"en"},"11615":{"id":"/en/docs/development-runtime-78","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`graphs.py`**: `Graphs`, `LayerSteps`, `DecoderSteps`: decoding steps captured as CUDA graphs that replay the eager kernels (`compute.cuda_graphs`), see CUDA graphs.","locale":"en"},"11616":{"id":"/en/docs/development-runtime-79","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`convert/onnx.py`**: an ONNX graph's nodes and tensors read from the protobuf wire format, without the onnx package (CosyVoice's speech tokenizers and CAM++, GPT-SoVITS's G2PW).","locale":"en"},"11617":{"id":"/en/docs/development-runtime-80","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`compile.py`**: `Compiled` / `compile_module(module, enabled, name)` wrap one hot module in `torch.compile(dynamic=True)` when `compute.compile` is on; engines call `compiled or module`, and any compiler error falls back to eager. See `torch.compile`.","locale":"en"},"11618":{"id":"/en/docs/development-runtime-81","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`policy.py`, `units.py`, `stream.py`**: the VRAM policy, a model's streamable units, and the per-device `Streamer` (Memory).","locale":"en"},"11619":{"id":"/en/docs/development-runtime-82","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"**`snapshot.py`**: `snapshot()` digests the process-wide state an engine call must leave alone; the contract suite compares it before and after requests.","locale":"en"},"11620":{"id":"/en/docs/development-runtime-83","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#layers-attention-loading","content":"The building blocks engines share live beside the runtime: `mizuoto/nn` (DSP bit-exact with torchaudio, librosa and Whisper; flows; transformers; vocoders; codecs; SSL and speaker encoders) and `mizuoto/text` (BPE tokenizers identical to transformers' for the models Mizuoto runs, Whisper's vocabulary, wetext's normaliser).","locale":"en"},"11621":{"id":"/en/docs/development-runtime-84","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"Each call to an engine gets one `RequestContext` (`mizuoto/runtime/context.py`):","locale":"en"},"11622":{"id":"/en/docs/development-runtime-85","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"Member","locale":"en"},"11623":{"id":"/en/docs/development-runtime-86","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"Purpose","locale":"en"},"11624":{"id":"/en/docs/development-runtime-87","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`check_cancel()`, `cancelled()`","locale":"en"},"11625":{"id":"/en/docs/development-runtime-88","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"Cooperative cancel. `check_cancel()` raises `Cancelled`, a `BaseException`, so model code's `except Exception` cannot swallow it. Engines call it at every token or ODE step","locale":"en"},"11626":{"id":"/en/docs/development-runtime-89","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`bind()`","locale":"en"},"11627":{"id":"/en/docs/development-runtime-90","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"Makes the context the running thread's request; layers then call the module-level `check_cancel()` without being handed it","locale":"en"},"11628":{"id":"/en/docs/development-runtime-91","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`generator_for(device)`, `generator`","locale":"en"},"11629":{"id":"/en/docs/development-runtime-92","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"The request's `torch.Generator` on a device, one per device, seeded with the request's seed (fresh entropy without one)","locale":"en"},"11630":{"id":"/en/docs/development-runtime-93","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`rng`","locale":"en"},"11631":{"id":"/en/docs/development-runtime-94","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"The request's `random.Random`, seeded the same way","locale":"en"},"11632":{"id":"/en/docs/development-runtime-95","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`reseed(seed)`","locale":"en"},"11633":{"id":"/en/docs/development-runtime-96","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"Start the request's streams again (an engine that reseeds per segment, as GPT-SoVITS's upstream did)","locale":"en"},"11634":{"id":"/en/docs/development-runtime-97","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`progress(stage, value, message)`","locale":"en"},"11635":{"id":"/en/docs/development-runtime-98","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`loading:<part>`, `generating`, …","locale":"en"},"11636":{"id":"/en/docs/development-runtime-99","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`applied`, `warn(message)`","locale":"en"},"11637":{"id":"/en/docs/development-runtime-100","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"The parameter values the engine actually used, and its warnings: both come back with the result","locale":"en"},"11638":{"id":"/en/docs/development-runtime-101","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`text_pieces()`","locale":"en"},"11639":{"id":"/en/docs/development-runtime-102","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"Streamed text as the client sends it (`SynthesisTask.text_stream`): a real generator, safe on another thread, ending early on cancel","locale":"en"},"11640":{"id":"/en/docs/development-runtime-103","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`tmpdir`","locale":"en"},"11641":{"id":"/en/docs/development-runtime-104","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"A scratch folder under `<cache>/scratch/<engine>/`, removed when the call ends","locale":"en"},"11642":{"id":"/en/docs/development-runtime-105","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`use(handles, memory)`, `run(name, handles, fn, memory, generators, fallback)`","locale":"en"},"11643":{"id":"/en/docs/development-runtime-106","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"A phase of the request: its components placed with room for its working memory; `run` adds the exact retry after running out of memory and the optional fallback (Memory)","locale":"en"},"11644":{"id":"/en/docs/development-runtime-107","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`accel`","locale":"en"},"11645":{"id":"/en/docs/development-runtime-108","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"The model's attention policy, bound with the context (Acceleration)","locale":"en"},"11646":{"id":"/en/docs/development-runtime-109","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#the-request-context","content":"`log`, `device`, `seed`, `request_id`","locale":"en"},"11647":{"id":"/en/docs/development-runtime-110","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#global-state","content":"Engines share one process with the server, each other and the tests, so native code **changes nothing process-wide**. `test_native_code_leaves_global_state_alone` forbids, in `runtime`, `nn`, `text`, the engines and the gated packages:","locale":"en"},"11648":{"id":"/en/docs/development-runtime-111","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#global-state","content":"seeding a global RNG: `torch.manual_seed`, `torch.cuda.manual_seed(_all)`, `random.seed`, `np.random.seed`;","locale":"en"},"11649":{"id":"/en/docs/development-runtime-112","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#global-state","content":"`os.chdir`, `sys.path.append` / `insert`, `os.putenv`, assignments to `os.environ`;","locale":"en"},"11650":{"id":"/en/docs/development-runtime-113","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#global-state","content":"`logging.basicConfig`, `torch.set_default_dtype`, `torch.use_deterministic_algorithms`, assignments to `torch.backends.*` and `torch._inductor.config`.","locale":"en"},"11651":{"id":"/en/docs/development-runtime-114","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#global-state","content":"Randomness comes from `ctx.generator_for(device)` and `ctx.rng` instead. That is also what makes parity possible: a fresh `torch.Generator` seeded with *s* yields the same stream as torch's default generator after `torch.manual_seed(s)`, on the CPU and on CUDA (`scripts/parity/check_rng.py`), so an engine that makes upstream's draws in upstream's order on the request's generator reproduces a seeded upstream run draw for draw. Where upstream drew from the global generator while building or preparing something, the port replays those draws on a private generator rather than touching the global one.","locale":"en"},"11652":{"id":"/en/docs/development-runtime-115","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#global-state","content":"Training stages are the one exception: they run in their own process and seed the process-wide generators there (see Trainers).","locale":"en"},"11653":{"id":"/en/docs/development-runtime-116","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"`RuntimeService.engine(engine_id, device)` makes a `LocalEngine` on first use and registers it with the `ComputeService` as the memory holder `engine:<engine>:<device>`. Its state is `stopped` (nothing loaded), `ready`, `busy`, or `crashed` when the engine's implementation failed to import.","locale":"en"},"11654":{"id":"/en/docs/development-runtime-117","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"**Loading** (`LocalEngine.load`):","locale":"en"},"11655":{"id":"/en/docs/development-runtime-118","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"`start()` finds the implementation with `get_engine(id)` (imports its module, not torch).","locale":"en"},"11656":{"id":"/en/docs/development-runtime-119","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"`make_room(model_id)`: the runtime service unloads the least recently used idle models beyond `compute.max_resident_models` (pinned models stay).","locale":"en"},"11657":{"id":"/en/docs/development-runtime-120","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"A `LoadSpec(model_id, model_dir, variant, device, dtype, options)` is built; `options` merges the engine's load options with `model_options(model_id)`, which adds the folders of the model's shared assets as `options[\"assets\"]`.","locale":"en"},"11658":{"id":"/en/docs/development-runtime-121","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"`Engine.load(spec, runtime, ctx)` runs with the context bound, **outside** `torch.inference_mode()`; the handles are registered with the manager, and `describe()` is kept as the handle's `description`.","locale":"en"},"11659":{"id":"/en/docs/development-runtime-122","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"**Calls** (`LocalHandle.prepare_voice`, `synthesize`, `convert`, `edit`, `call`): each runs in the calling thread (a job's) inside `torch.inference_mode()`, with the context bound and the model's handles held by `manager.use(...)`. The seed is the task's `params[\"seed\"]`.","locale":"en"},"11660":{"id":"/en/docs/development-runtime-123","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#localengine-calling-a-model-in-this-process","content":"A CPU kernel trap found while checking E2-TTS against upstream: `F.linear` on a strided (non-contiguous) 3-D input takes another kernel when the weight requires grad, or when it is an *inference tensor* (made inside `torch.inference_mode()`), even under `no_grad`. Upstream's weights are ordinary parameters that require grad, so native engines leave parameters as `nn.Module` makes them (no `requires_grad_(False)`), and models are loaded outside inference mode. Requests still run inside it. The engine reference has both traps.","locale":"en"},"11661":{"id":"/en/docs/development-runtime-124","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#streams-are-generators","content":"`synthesize`, `convert` and `edit` return generators of `AudioChunk`. `LocalEngine.stream` drives the engine's own generator lazily: the engine runs only while the caller asks for the next chunk, and only then is it bound to the thread and in inference mode. Each chunk is checked (it must be an `AudioChunk`), turned into float32 mono numpy samples and handed on; the first one sets `timings[\"first_chunk\"]`. The caller closes the stream (`contextlib.closing`) to stop early, which closes the engine's generator too. `TtsService` drains it chunk by chunk and forwards chunks to a `StreamSink` when the client streams.","locale":"en"},"11662":{"id":"/en/docs/development-runtime-125","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#cancel-and-timeouts","content":"The caller passes an `EngineRequest` with its `cancel` event (a job's `cancel_event`), an optional `timeout`, the streamed-text queue (`text_input`, filled by `TextFeed`) and a `progress` callback. A small watcher thread checks every 20 ms: it copies the caller's cancel into the context's cancel event, and past the timeout it marks the call timed out and cancels it. The engine stops at its next `check_cancel()`; the call then fails with `CancelledError`, or `OperationTimeoutError` after a timeout. When the call ends, the handle copies `applied`, `warnings` and `timings[\"total\"]` into the `EngineRequest`.","locale":"en"},"11663":{"id":"/en/docs/development-runtime-126","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#errors","content":"What an engine raises becomes the core's error:","locale":"en"},"11664":{"id":"/en/docs/development-runtime-127","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#errors","content":"`EngineError(message, detail, code)` keeps its code (`error_from_code`), with the engine and device added to the detail; `Unsupported` is `capability_not_supported`.","locale":"en"},"11665":{"id":"/en/docs/development-runtime-128","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#errors","content":"Running out of memory (`is_oom`) offloads every idle component on that device (`release_idle`) and fails with `compute_unavailable`, `detail.reason = \"out_of_memory\"`; the job service then unloads every model not in use from every GPU (`release_after_oom`).","locale":"en"},"11666":{"id":"/en/docs/development-runtime-129","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#errors","content":"Anything else is `engine_error` with the exception's name and traceback in the detail (and in the log).","locale":"en"},"11667":{"id":"/en/docs/development-runtime-130","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Memory is managed at three levels:","locale":"en"},"11668":{"id":"/en/docs/development-runtime-131","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Level","locale":"en"},"11669":{"id":"/en/docs/development-runtime-132","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Who","locale":"en"},"11670":{"id":"/en/docs/development-runtime-133","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"What","locale":"en"},"11671":{"id":"/en/docs/development-runtime-134","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Components","locale":"en"},"11672":{"id":"/en/docs/development-runtime-135","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"`ModelManager`","locale":"en"},"11673":{"id":"/en/docs/development-runtime-136","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Before each phase of a call, idle components on the same device give up memory, unit by unit, to make room; what does not fit streams from RAM (Memory)","locale":"en"},"11674":{"id":"/en/docs/development-runtime-137","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Models","locale":"en"},"11675":{"id":"/en/docs/development-runtime-138","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"`RuntimeService`","locale":"en"},"11676":{"id":"/en/docs/development-runtime-139","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"At most `compute.max_resident_models` (default 3) models stay loaded across all engines; before a load the least recently used idle one is unloaded. The server's reaper (every 10 s) also unloads models idle for longer than `compute.unload_after_minutes` (default 20; 0 = never) or `engines.<id>.idle_minutes`. `engines.<id>.pinned_models` are never unloaded to make room or for idleness","locale":"en"},"11677":{"id":"/en/docs/development-runtime-140","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"The process","locale":"en"},"11678":{"id":"/en/docs/development-runtime-141","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"`ComputeService`","locale":"en"},"11679":{"id":"/en/docs/development-runtime-142","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Each `LocalEngine` is a memory holder: **Free GPU memory** (`POST /api/v1/compute/release`) unloads every model of every idle holder and offloads what is left; refused while a holder is busy","locale":"en"},"11680":{"id":"/en/docs/development-runtime-143","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"Nothing refuses a model on an estimate of GPU memory: it always tries to load, and only a real allocation failure is an error. When a job fails for running out of memory (after the exact retries), `ComputeService.release_after_oom` unloads every model not in use from every GPU (ComfyUI's `unload_all_models`); models on the CPU stay. How components share a device below this level is in Memory.","locale":"en"},"11681":{"id":"/en/docs/development-runtime-144","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#memory","content":"A change to any `engines.<id>.*` setting unloads that engine's models (`unload_engine`), so the next request loads them with the new device, dtype or load options.","locale":"en"},"11682":{"id":"/en/docs/development-runtime-145","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#remote-engines","content":"When an engine's device is `<host>/<device>` (for example `engines.qwen3tts.device = \"gpu-box/cuda:0\"`), `RuntimeService.engine` asks `RemoteService` for a `RemoteEngine`: a session with the `mizuoto agent` on that host for one engine on one device. The agent is a whole Mizuoto with its own data folder, models and runtime; it runs the engine in its own process exactly as a host does. `RemoteEngineHandle` answers the same calls as `LocalHandle`. For the user-facing set-up, see Remote engines.","locale":"en"},"11683":{"id":"/en/docs/development-runtime-146","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#remote-engines","content":"**Protocol 2** (`AGENT_PROTOCOL` in `mizuoto/core/remote/wire.py`) works at the level of a loaded engine. The frames are `mizuoto/core/remote/frames.py`'s (a 4-byte length, a kind, a JSON body or a JSON header plus raw bytes), over TCP or TLS:","locale":"en"},"11684":{"id":"/en/docs/development-runtime-147","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#remote-engines","content":"The host connects and sends `hello` with the token (compared with `hmac.compare_digest`) and its protocol. An agent of another protocol refuses the host with a hint to install the same Mizuoto version on both machines, and the host refuses such an agent in turn. Otherwise the agent answers with its `AgentInfo`: version, devices, which engines are available there and its installed models.","locale":"en"},"11685":{"id":"/en/docs/development-runtime-148","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#remote-engines","content":"`open {engine, device}`, then `load`, `prepare_voice`, `synthesize`, `convert`, `edit`, `call`, `unload` and `status`, one after another; `cancel` and `text` (streamed text) may come at any time.","locale":"en"},"11686":{"id":"/en/docs/development-runtime-149","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#remote-engines","content":"The agent answers each operation with `progress`, `chunk` (a binary frame: float32 little-endian mono) and `file` frames, then a `result` or `error`, and beats every 5 s. With no frame for `remote.heartbeat_timeout` (60 s), the host closes the session with `worker_failed` (`during = \"heartbeat\"`); the next request reconnects.","locale":"en"},"11687":{"id":"/en/docs/development-runtime-150","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#remote-engines","content":"**Files by content.** A path means nothing on the other machine. Every file a request names becomes `mizuoto-file:<sha256>/<name>`: `have` asks which the agent lacks, and `put` sends those in 8 MiB frames, checked against the SHA-256. The agent keeps them in `<cache>/remote/files/` and removes what no host asked for in a month. The folder a `prepare_voice` writes into becomes `mizuoto-out:…`; its files come back as `file` frames into the host's own folder.","locale":"en"},"11688":{"id":"/en/docs/development-runtime-151","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#remote-engines","content":"The host plans against its own catalogue and the agent's model list; the agent handles its own GPU memory, and training always stays local.","locale":"en"},"11689":{"id":"/en/docs/development-runtime-152","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#seeing-it-mizuoto-runtime-and-mizuoto-doctor","content":"`mizuoto runtime` asks the running server (found through `server.json` in the data folder), since its process holds the models; without a server it reports the command's own process. The same is `GET /api/v1/runtime` and `POST /api/v1/runtime/unload`, and the web UI's **Models in memory** sheet (`LoadedModelsSheet`).","locale":"en"},"11690":{"id":"/en/docs/development-runtime-153","page_id":"/en/docs/development-runtime","tags":[],"type":"text","url":"/en/docs/development-runtime#seeing-it-mizuoto-runtime-and-mizuoto-doctor","content":"`mizuoto doctor [ENGINE]` is `RuntimeService.doctor`: the installed torch build against the machine's hardware (CUDA, ROCm, XPU, MPS, CPU) with the install command for the right build (`mizuoto/core/compute/torch_index.py`), each engine available or missing (and what is missing), optional extras that do not import (`Engine.EXTRAS`) and a trainer's missing requirements. The same is `GET /api/v1/runtime/doctor` and `GET /api/v1/engines/{id}/doctor`.","locale":"en"},"11691":{"id":"/en/docs/development-setup","page_id":"/en/docs/development-setup","type":"page","content":"Development setup","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-setup","locale":"en"},"11692":{"id":"/en/docs/development-setup-0","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup","content":"The environment and tasks needed to go from a fresh clone to the dev server, every check and a real engine.","locale":"en"},"11693":{"id":"/en/docs/development-setup-1","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#the-python-environment","content":"The Python environment","locale":"en"},"11694":{"id":"/en/docs/development-setup-2","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#create-venv","content":"Create `.venv`","locale":"en"},"11695":{"id":"/en/docs/development-setup-3","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#install-torch-first","content":"Install torch first","locale":"en"},"11696":{"id":"/en/docs/development-setup-4","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#install-mizuoto-editable-with-the-development-tools","content":"Install Mizuoto editable, with the development tools","locale":"en"},"11697":{"id":"/en/docs/development-setup-5","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#use-that-interpreter-from-then-on","content":"Use that interpreter from then on","locale":"en"},"11698":{"id":"/en/docs/development-setup-6","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#optional-extras","content":"Optional extras","locale":"en"},"11699":{"id":"/en/docs/development-setup-7","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#the-web-ui-bun","content":"The web UI: bun","locale":"en"},"11700":{"id":"/en/docs/development-setup-8","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`scripts/dev.py` tasks","locale":"en"},"11701":{"id":"/en/docs/development-setup-9","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#dev-edit-and-watch","content":"`dev`: edit and watch","locale":"en"},"11702":{"id":"/en/docs/development-setup-10","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#a-real-engine-on-your-machine","content":"A real engine on your machine","locale":"en"},"11703":{"id":"/en/docs/development-setup-11","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup","content":"A Mizuoto development setup has two parts: one Python environment (`.venv`) with torch, Mizuoto installed editable and the development tools, and bun for the web UI and this site. Every engine runs in that one environment; there is nothing else to build. Everyday tasks run through `scripts/dev.py`, which uses only the standard library, behaves the same on Linux, macOS and Windows, and runs the same tools CI runs.","locale":"en"},"11704":{"id":"/en/docs/development-setup-12","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#create-venv","content":"An isolated virtual environment with Python 3.11 (Mizuoto supports 3.10–3.13 and CI tests all four; development uses 3.11):","locale":"en"},"11705":{"id":"/en/docs/development-setup-13","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#install-torch-first","content":"torch is a dependency of Mizuoto, but its build (CUDA, ROCm, XPU, CPU) is your choice, so install it first from the index that matches the machine. The CPU build is enough for development and for every test CI runs:","locale":"en"},"11706":{"id":"/en/docs/development-setup-14","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#install-torch-first","content":"For a GPU, take the build `mizuoto doctor` names instead (for example `…/whl/cu128`); Installation lists them. Installing Mizuoto afterwards keeps that build.","locale":"en"},"11707":{"id":"/en/docs/development-setup-15","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#install-mizuoto-editable-with-the-development-tools","content":"The development tools are also listed in `[dependency-groups] dev` of `pyproject.toml`. Without the two gated packages their tests skip and their engines show as missing.","locale":"en"},"11708":{"id":"/en/docs/development-setup-16","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#use-that-interpreter-from-then-on","content":"`dev.py` runs ruff, ty and pytest with the interpreter running it (`sys.executable`), not whichever is on `PATH`.","locale":"en"},"11709":{"id":"/en/docs/development-setup-17","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"Some front ends need packages that are not in the default install. Without them those languages fail with `capability_not_supported` and the install command in the hint, and `mizuoto doctor` lists them as warnings:","locale":"en"},"11710":{"id":"/en/docs/development-setup-18","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"Extra","locale":"en"},"11711":{"id":"/en/docs/development-setup-19","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"Packages","locale":"en"},"11712":{"id":"/en/docs/development-setup-20","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"For","locale":"en"},"11713":{"id":"/en/docs/development-setup-21","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"`mizuoto[gptsovits-ja]`","locale":"en"},"11714":{"id":"/en/docs/development-setup-22","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"`pyopenjtalk==0.4.1` (an sdist: needs CMake and a C++ compiler)","locale":"en"},"11715":{"id":"/en/docs/development-setup-23","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"GPT-SoVITS's Japanese","locale":"en"},"11716":{"id":"/en/docs/development-setup-24","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"`mizuoto[gptsovits-ko]`","locale":"en"},"11717":{"id":"/en/docs/development-setup-25","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"`python-mecab-ko`, `jamo`","locale":"en"},"11718":{"id":"/en/docs/development-setup-26","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"GPT-SoVITS's Korean","locale":"en"},"11719":{"id":"/en/docs/development-setup-27","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"`mizuoto-indextts[ja]`","locale":"en"},"11720":{"id":"/en/docs/development-setup-28","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"`fugashi`, `unidic-lite`","locale":"en"},"11721":{"id":"/en/docs/development-setup-29","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"IndexTTS-2.5's Japanese","locale":"en"},"11722":{"id":"/en/docs/development-setup-30","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"From a checkout: `uv pip install --python .venv/bin/python -e \".[gptsovits-ja,gptsovits-ko]\"`.","locale":"en"},"11723":{"id":"/en/docs/development-setup-31","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#optional-extras","content":"ty does not follow an editable install's path hook, so `pyproject.toml` sets `tool.ty.environment.extra-paths` to `packages/native/fishspeech` and `packages/native/indextts`, which resolves `mizuoto_fishspeech` and `mizuoto_indextts` from source. torch and the optional extras' packages are listed in `tool.ty.analysis.allowed-unresolved-imports`.","locale":"en"},"11724":{"id":"/en/docs/development-setup-32","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#the-web-ui-bun","content":"The web UI (`mizuoto/webui/`) and the docs site (`site/`) use bun to install, build and test. `dev.py` looks for `bun` on `PATH`, then in the installer's default `~/.bun/bin`, and gives a clear error, not a traceback, when neither has it.","locale":"en"},"11725":{"id":"/en/docs/development-setup-33","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#the-web-ui-bun","content":"The built `dist/` ships in the wheel as package data; `mizuoto webui` from a checkout without `dist/` serves the API but no UI.","locale":"en"},"11726":{"id":"/en/docs/development-setup-34","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`python scripts/dev.py` with no arguments lists every task. Options after the task name are passed on to the underlying script; a task that takes none fails when given some.","locale":"en"},"11727":{"id":"/en/docs/development-setup-35","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Task","locale":"en"},"11728":{"id":"/en/docs/development-setup-36","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"What it does","locale":"en"},"11729":{"id":"/en/docs/development-setup-37","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`check`","locale":"en"},"11730":{"id":"/en/docs/development-setup-38","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Everything CI runs: `lint`, `typecheck-py`, `test-py`, `test-web`, `typegen-check`","locale":"en"},"11731":{"id":"/en/docs/development-setup-39","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`lint`","locale":"en"},"11732":{"id":"/en/docs/development-setup-40","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`ruff check .` and `ruff format --check .`","locale":"en"},"11733":{"id":"/en/docs/development-setup-41","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`format`","locale":"en"},"11734":{"id":"/en/docs/development-setup-42","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`ruff check --fix .` and `ruff format .`","locale":"en"},"11735":{"id":"/en/docs/development-setup-43","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typecheck-py`","locale":"en"},"11736":{"id":"/en/docs/development-setup-44","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"ty over `mizuoto`, the gated engines, `tests` and `scripts`","locale":"en"},"11737":{"id":"/en/docs/development-setup-45","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`test-py [pytest options…]`","locale":"en"},"11738":{"id":"/en/docs/development-setup-46","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"pytest; the `live`, `engine`, `weights` and `e2e` markers are deselected by default","locale":"en"},"11739":{"id":"/en/docs/development-setup-47","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`test-engines [engine…] [-- pytest options]`","locale":"en"},"11740":{"id":"/en/docs/development-setup-48","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"The contract suite against the installed models (`MIZUOTO_TEST_DEVICE=cpu\\|cuda:N`)","locale":"en"},"11741":{"id":"/en/docs/development-setup-49","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`model-manifests [engine…]`","locale":"en"},"11742":{"id":"/en/docs/development-setup-50","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Pin the catalogue models' files (sizes, SHA-256) (`scripts/model_manifests.py`)","locale":"en"},"11743":{"id":"/en/docs/development-setup-51","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`wheels [all\\|host\\|native] [engine…]`","locale":"en"},"11744":{"id":"/en/docs/development-setup-52","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Build `mizuoto` (with the UI) and the gated engines' wheels into `dist/` (`scripts/build_wheels.py`)","locale":"en"},"11745":{"id":"/en/docs/development-setup-53","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`smoke`","locale":"en"},"11746":{"id":"/en/docs/development-setup-54","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Install the built wheels over a CPU torch in a new environment and try them (`scripts/smoke_wheels.py`)","locale":"en"},"11747":{"id":"/en/docs/development-setup-55","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`dev [--api-port] [--web-port] [--data-dir]`","locale":"en"},"11748":{"id":"/en/docs/development-setup-56","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"The API server (7869) and the Vite dev server (5173) together; Ctrl+C stops both","locale":"en"},"11749":{"id":"/en/docs/development-setup-57","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`web-install` / `web` / `web-dev`","locale":"en"},"11750":{"id":"/en/docs/development-setup-58","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Install the UI's dependencies / build the UI / Vite only (expects a running API)","locale":"en"},"11751":{"id":"/en/docs/development-setup-59","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`test-web`","locale":"en"},"11752":{"id":"/en/docs/development-setup-60","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`bun run test` (vitest) and `bun run typecheck` (vue-tsc)","locale":"en"},"11753":{"id":"/en/docs/development-setup-61","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`openapi`","locale":"en"},"11754":{"id":"/en/docs/development-setup-62","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Print the OpenAPI schema on standard output (`scripts/generate_openapi.py`)","locale":"en"},"11755":{"id":"/en/docs/development-setup-63","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen`","locale":"en"},"11756":{"id":"/en/docs/development-setup-64","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Regenerate `mizuoto/webui/src/api/schema.d.ts` from the schema (commit the result)","locale":"en"},"11757":{"id":"/en/docs/development-setup-65","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen-check`","locale":"en"},"11758":{"id":"/en/docs/development-setup-66","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Regenerate, then `git diff --exit-code`: fails when the types are stale","locale":"en"},"11759":{"id":"/en/docs/development-setup-67","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"The docs site has its own tasks: `site-install`, `site-dev`, `site` and `test-site` (see Release). The parity harness is not a `dev.py` task; it lives in `scripts/parity/` (see Testing).","locale":"en"},"11760":{"id":"/en/docs/development-setup-68","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-edit-and-watch","content":"It starts the API as `python -m mizuoto webui --no-open --port 7869 --strict-port` (with the repository root on `PYTHONPATH`) and Vite as `bun run dev`, passing `MIZUOTO_BACKEND=http://127.0.0.1:7869` to Vite. Vite proxies `/api` and `/ws` to the API, so the browser only opens `http://localhost:5173`. UI changes reload in place; Python changes, an engine's included, need the task restarted (models load into the server's process). While the API is down, Vite's proxy prints one short line every few seconds instead of a flood of connection errors.","locale":"en"},"11761":{"id":"/en/docs/development-setup-69","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-edit-and-watch","content":"`--data-dir` keeps the development settings, database, models and outputs apart from your everyday data folder (`MIZUOTO_DATA_DIR` does the same).","locale":"en"},"11762":{"id":"/en/docs/development-setup-70","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-real-engine-on-your-machine","content":"Every engine is already installed with Mizuoto; a real one needs only its models:","locale":"en"},"11763":{"id":"/en/docs/development-setup-71","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-real-engine-on-your-machine","content":"The model loads into the process that runs the command (or into the server's, for requests through the API). `mizuoto runtime` lists what the running server has loaded; `mizuoto runtime --unload` frees it.","locale":"en"},"11764":{"id":"/en/docs/development-setup-72","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-real-engine-on-your-machine","content":"A change to an engine's code takes effect in a new process: restart the server, or run the command again.","locale":"en"},"11765":{"id":"/en/docs/development-setup-73","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-real-engine-on-your-machine","content":"Licence-gated engines (Fish Speech, IndexTTS) need their package installed and `mizuoto engine accept-licence <id>` before their models download.","locale":"en"},"11766":{"id":"/en/docs/development-setup-74","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-real-engine-on-your-machine","content":"A development machine's GPUs may be full with another process's work. Put the engine on the CPU then: `mizuoto config set engines.qwen3tts.device cpu`, or `MIZUOTO_TEST_DEVICE=cpu` for the contract suite. A model always tries to load; when the GPU's memory runs out, the job fails with `compute_unavailable` (exit 9) and every model not in use is unloaded from the GPUs.","locale":"en"},"11767":{"id":"/en/docs/development-setup-75","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-real-engine-on-your-machine","content":"How to verify an engine completely (tiny random models, the contract suite, parity with 0.1) is in Testing.","locale":"en"},"11768":{"id":"/en/docs/development-testing","page_id":"/en/docs/development-testing","type":"page","content":"Testing","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-testing","locale":"en"},"11769":{"id":"/en/docs/development-testing-0","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"How Mizuoto's tests are organised: the core runs the whole stack in seconds on the dummy engine, every engine and trainer runs on a tiny random model in CI (also streamed on simulated devices), real models have a contract suite, a parity harness compares the native engines with their references sample for sample, behavioural consistency is judged in tiers, the web UI uses vitest, and CI covers three platforms and four Pythons.","locale":"en"},"11770":{"id":"/en/docs/development-testing-1","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#layout","content":"Layout","locale":"en"},"11771":{"id":"/en/docs/development-testing-2","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#the-dummy-engine","content":"The dummy engine","locale":"en"},"11772":{"id":"/en/docs/development-testing-3","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#fixtures","content":"Fixtures","locale":"en"},"11773":{"id":"/en/docs/development-testing-4","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#tiny-random-models","content":"Tiny random models","locale":"en"},"11774":{"id":"/en/docs/development-testing-5","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#streaming-on-a-simulated-device","content":"Streaming on a simulated device","locale":"en"},"11775":{"id":"/en/docs/development-testing-6","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"Real engines: the contract suite","locale":"en"},"11776":{"id":"/en/docs/development-testing-7","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#parity-with-the-references","content":"Parity with the references","locale":"en"},"11777":{"id":"/en/docs/development-testing-8","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Tiers and tolerances of behavioural consistency","locale":"en"},"11778":{"id":"/en/docs/development-testing-9","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#web-ui-tests","content":"Web UI tests","locale":"en"},"11779":{"id":"/en/docs/development-testing-10","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#ci","content":"CI","locale":"en"},"11780":{"id":"/en/docs/development-testing-11","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"Mizuoto's tests come in three layers:","locale":"en"},"11781":{"id":"/en/docs/development-testing-12","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"**The core's tests** need no GPU and no model: the dummy engine carries planning, jobs, the runtime service, streaming, cancellation and errors end to end, in the test's own process.","locale":"en"},"11782":{"id":"/en/docs/development-testing-13","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"**The engines' tests** run every engine and trainer on a tiny model with random weights, on the CPU, including runs partly loaded and streamed on a simulated device, also in CI.","locale":"en"},"11783":{"id":"/en/docs/development-testing-14","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"**Real models**: the contract suite drives installed models through the whole stack, and the parity harness compares the native engines with their references sample for sample. Developers run these by hand when they change an engine.","locale":"en"},"11784":{"id":"/en/docs/development-testing-15","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"`python scripts/dev.py check` runs what CI runs: `lint`, `typecheck-py`, `test-py`, `test-web`, `typegen-check`.","locale":"en"},"11785":{"id":"/en/docs/development-testing-16","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`pyproject.toml` defines four markers, all deselected by default (`addopts = \"-m 'not live and not engine and not weights and not e2e'\"`):","locale":"en"},"11786":{"id":"/en/docs/development-testing-17","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Marker","locale":"en"},"11787":{"id":"/en/docs/development-testing-18","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Meaning","locale":"en"},"11788":{"id":"/en/docs/development-testing-19","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`live`","locale":"en"},"11789":{"id":"/en/docs/development-testing-20","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Needs something outside this repository","locale":"en"},"11790":{"id":"/en/docs/development-testing-21","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`engine`","locale":"en"},"11791":{"id":"/en/docs/development-testing-22","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"The engine contract suite against installed models (`dev.py test-engines`)","locale":"en"},"11792":{"id":"/en/docs/development-testing-23","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`weights`","locale":"en"},"11793":{"id":"/en/docs/development-testing-24","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Needs downloaded model weights","locale":"en"},"11794":{"id":"/en/docs/development-testing-25","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`e2e`","locale":"en"},"11795":{"id":"/en/docs/development-testing-26","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Browser end-to-end tests","locale":"en"},"11796":{"id":"/en/docs/development-testing-27","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"So `python -m pytest` (or `python scripts/dev.py test-py`) runs the core's tests and the tiny-model tests. A test that needs torch or an optional package skips without it (`pytest.importorskip`).","locale":"en"},"11797":{"id":"/en/docs/development-testing-28","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#the-dummy-engine","content":"`mizuoto/engines/dummy/` is a complete engine with no model: an engine (`engine.py`) and a trainer (`train.py`), with the manifest `mizuoto/core/engines/manifests/dummy.toml`. It imports numpy only, so it needs no torch, and it runs in the test's process as every engine does.","locale":"en"},"11798":{"id":"/en/docs/development-testing-29","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#the-dummy-engine","content":"It turns each character into a short tone whose pitch comes from the voice (a preset, a description, the references' SHA-256 or a hash of the weights), so different voices sound different, and draws from `ctx.rng`, so the same seed gives the same audio.","locale":"en"},"11799":{"id":"/en/docs/development-testing-30","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#the-dummy-engine","content":"It declares **every** capability: preset speakers, cloning, design, style and emotion, streamed output and streamed text input, voice conversion, speech editing, batches, weights, a `transcribe` op (so the ASR path is testable too), training.","locale":"en"},"11800":{"id":"/en/docs/development-testing-31","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#the-dummy-engine","content":"Engine options make it misbehave on purpose: `delay_ms`, `chunk_ms` and `load_delay_ms` slow it down; `fail = error | oom | crash | exception` and `fail_at_segment` make it fail, run out of memory, report a crash (`worker_failed`) or raise an unhandled exception where asked.","locale":"en"},"11801":{"id":"/en/docs/development-testing-32","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#the-dummy-engine","content":"That is how cancellation at the next check, OOM becoming `compute_unavailable`, timeouts, unloading, the reaper and streamed chunks are all checked in seconds on a CI machine without a GPU. The dummy engine is also how users try Mizuoto out, and `smoke_wheels.py` uses it.","locale":"en"},"11802":{"id":"/en/docs/development-testing-33","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"`tests/conftest.py`:","locale":"en"},"11803":{"id":"/en/docs/development-testing-34","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"One temporary data folder per test and an empty environment (`environ={}`: the developer's own `MIZUOTO_*` variables never leak in).","locale":"en"},"11804":{"id":"/en/docs/development-testing-35","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"`services` is `make_services()` for short; `wav_file` is a 2 s, 22.05 kHz stereo WAV.","locale":"en"},"11805":{"id":"/en/docs/development-testing-36","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"Tests that need the scheduler and the reaper pass `start_background=True`. The API tests do: `create_app(make_services(start_background=True), bound_host=\"127.0.0.1\", serve_ui=False)`, then `TestClient`.","locale":"en"},"11806":{"id":"/en/docs/development-testing-37","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"Download tests replace `services.models.http_transport` with an `httpx.MockTransport`.","locale":"en"},"11807":{"id":"/en/docs/development-testing-38","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"Remote tests (`tests/core/test_remote.py`) start an `AgentServer` on the same machine, and the host drives its dummy engine over TCP.","locale":"en"},"11808":{"id":"/en/docs/development-testing-39","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiny-random-models","content":"`tests/engines_native/` builds, for each engine, a model of the engine's own architecture with a few small layers and random weights, writes it to a temporary folder as the engine expects to find it (configs, a byte-level vocabulary, safetensors), and drives the real code: `Engine.load` with a `Runtime(DeviceService(), ModelManager(...))`, a `RequestContext`, voice prompts, decoding, batches, seeds that repeat, cancellation. `test_<id>_train_tiny.py` runs every stage of the engine's trainer on a few clips. They need no download, so CI runs them on every push with CPU torch. The gated engines' tests are in their packages, `packages/native/<pkg>/tests/`; `testpaths` in `pyproject.toml` lists those folders, so `python -m pytest` runs them with the rest, and they skip unless their packages are installed. They use `tests/engines_native`'s helpers (`streaming.py`, `accel_checks.py`), so run them from the repository root, or from the package folder with the root's `pyproject.toml` (its `pythonpath` puts the root on `sys.path`).","locale":"en"},"11809":{"id":"/en/docs/development-testing-40","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiny-random-models","content":"A few rules across engines are held here too:","locale":"en"},"11810":{"id":"/en/docs/development-testing-41","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiny-random-models","content":"**Attention.** Every `mask_info` an attention site passes is checked against its dense mask. `MIZUOTO_TEST_ACCEL=count python -m pytest tests/engines_native packages/native` also routes every attention call through a policy that counts its site and computes the site's own reference; it fails at the end when a site the engines have was never reached that way (a direct SDPA call that bypasses `compute.attention`). Each conftest lists its folder's sites (`SITES_TESTED`); the checks themselves are in `tests/engines_native/accel_checks.py`.","locale":"en"},"11811":{"id":"/en/docs/development-testing-42","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiny-random-models","content":"**Training memory tools.** `check_checkpointing` in `training_memory.py` runs a trainer's stages twice in fresh work folders, once as given and once with every block checkpointed, and compares every metric and every weight file written: they must be identical. The other tools that keep results (such as the optimiser state in RAM) are checked the same way.","locale":"en"},"11812":{"id":"/en/docs/development-testing-43","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#streaming-on-a-simulated-device","content":"Memory management changes where weights live, not what is computed, so a partly loaded or streamed model must give exactly what a whole one gives. `tests/engines_native/streaming.py` lets the CPU play a device of a given size (`DeviceService(simulate=…, strict=True)`):","locale":"en"},"11813":{"id":"/en/docs/development-testing-44","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#streaming-on-a-simulated-device","content":"`check_streamed` runs a tiny engine at three device sizes (every unit streamed, half, everything resident) and compares with the plain CPU sample for sample.","locale":"en"},"11814":{"id":"/en/docs/development-testing-45","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#streaming-on-a-simulated-device","content":"In strict mode, a component off the device rests as meta tensors and a streamed unit's weights exist only while the unit runs. So an engine that uses a component it did not place for the phase (`ctx.use`), or reads a unit's weights outside its `forward`, fails here.","locale":"en"},"11815":{"id":"/en/docs/development-testing-46","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#streaming-on-a-simulated-device","content":"`check_oom_retry` makes one layer inside a phase run out of memory the first time it is called: the phase runs again with more weights streamed, and the result must be exactly the undisturbed one.","locale":"en"},"11816":{"id":"/en/docs/development-testing-47","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#streaming-on-a-simulated-device","content":"Memory management itself is in Memory management.","locale":"en"},"11817":{"id":"/en/docs/development-testing-48","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`tests/engines/test_contract.py` goes through the whole stack (plan → job → runtime → engine) for every installed catalogue model of every available engine:","locale":"en"},"11818":{"id":"/en/docs/development-testing-49","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`test-engines` sets `MIZUOTO_CONTRACT=1` and `MIZUOTO_TEST_ENGINES` (the engines named) and runs `tests/engines` with `-m engine -v`. The suite uses the models of `MIZUOTO_TEST_DATA_DIR` (default: the normal data folder), but runs in a temporary data folder and writes nothing to the real one, on `MIZUOTO_TEST_DEVICE` (default `auto`).","locale":"en"},"11819":{"id":"/en/docs/development-testing-50","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"Test","locale":"en"},"11820":{"id":"/en/docs/development-testing-51","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"What it checks","locale":"en"},"11821":{"id":"/en/docs/development-testing-52","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`test_load_and_describe`","locale":"en"},"11822":{"id":"/en/docs/development-testing-53","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`describe` after loading matches the manifest: sample rate, preset speakers","locale":"en"},"11823":{"id":"/en/docs/development-testing-54","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`test_every_voice_mode_speaks_the_text`","locale":"en"},"11824":{"id":"/en/docs/development-testing-55","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"Every declared voice mode, in English and Chinese, is audible (RMS > 0.01), at the right rate, about as long as the text needs; with ASR installed, word error rate \\< 0.35","locale":"en"},"11825":{"id":"/en/docs/development-testing-56","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`test_seed_repeats_and_segments`","locale":"en"},"11826":{"id":"/en/docs/development-testing-57","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"The same seed repeats sample for sample; two sentences that do not fit one segment become two segments (or the engine handles long text itself)","locale":"en"},"11827":{"id":"/en/docs/development-testing-58","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`test_cancel_stops_the_engine`","locale":"en"},"11828":{"id":"/en/docs/development-testing-59","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"Cancelled mid-generation, the job is `cancelled` within 30 s, the model is still loaded, and the next request speaks normally","locale":"en"},"11829":{"id":"/en/docs/development-testing-60","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"`test_no_residue`","locale":"en"},"11830":{"id":"/en/docs/development-testing-61","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"Digests of the process-wide state (working folder, environment, `sys.path`, RNGs, torch flags, log handlers, warning filters) are the same before and after many requests, taken with the `mizuoto.snapshot` op","locale":"en"},"11831":{"id":"/en/docs/development-testing-62","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"The reference to clone comes from `MIZUOTO_TEST_REFERENCE` (plus `MIZUOTO_TEST_REFERENCE_TEXT`), else an installed preset or design model speaks one. Licence-gated engines take part only with `MIZUOTO_TEST_ACCEPT_LICENCES=1` (and their packages installed), and their licences are accepted in the temporary folder only.","locale":"en"},"11832":{"id":"/en/docs/development-testing-63","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#real-engines-the-contract-suite","content":"On the CPU, every catalogue model of every engine passes the contract suite. The whole suite takes hours (the larger the model, the slower), so when changing one engine, run that engine.","locale":"en"},"11833":{"id":"/en/docs/development-testing-64","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`scripts/parity/` compares the native engines with their references sample for sample (its README describes it in full). The reference is Mizuoto 0.1's engine workers (git tag `v1-engine-workers`, each engine running upstream code in its original environment); for VoxCPM, which 0.1 never had, it is upstream's own package, put into the same stack by `stack.py --impl upstream`. The code is in the repository; the data lives in a workspace outside it, `MIZUOTO_PARITY_DIR` (default `~/code_workspace/experiment/kodama-refactor`), which holds:","locale":"en"},"11834":{"id":"/en/docs/development-testing-65","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`reference/`: a git worktree at the tag `v1-engine-workers`, the 0.1 code the native engines are compared with;","locale":"en"},"11835":{"id":"/en/docs/development-testing-66","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`reference-host/` and `native-env/`: the Python environments that drive the reference and the native stack (the native side uses the reference environments' torch 2.8.0, so differences come from code and not from kernels); CosyVoice also has a reference environment and data folder on torch 2.8;","locale":"en"},"11836":{"id":"/en/docs/development-testing-67","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`corpus/` (reference clips and their transcripts), `fixtures/` (the audio and behaviour each run writes), `reports/` (the comparison reports).","locale":"en"},"11837":{"id":"/en/docs/development-testing-68","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Script","locale":"en"},"11838":{"id":"/en/docs/development-testing-69","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"What it does","locale":"en"},"11839":{"id":"/en/docs/development-testing-70","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`stack.py run <cases.jsonl> --impl reference\\|native\\|upstream`","locale":"en"},"11840":{"id":"/en/docs/development-testing-71","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Runs each case (a `SpeakRequest`, or a `convert` / `edit` request) through the whole stack of one implementation and keeps its audio and behaviour under `fixtures/<engine>/<case>/<name>`. `--name` sets the run's file stem (e.g. `reference-repeat`, `reference-t28`), `--only` picks cases, `--setting k=v` applies a setting to the whole run, `--repeat` runs each case again in the same stack, `--device` (default `cpu`)","locale":"en"},"11841":{"id":"/en/docs/development-testing-72","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`compare.py <engine…> [--a reference] [--b native]`","locale":"en"},"11842":{"id":"/en/docs/development-testing-73","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Compares two runs sample for sample (`--tolerance`, `--report` writes a Markdown report); prints the current table from the fixtures without running a model","locale":"en"},"11843":{"id":"/en/docs/development-testing-74","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`train.py run <engine> --impl reference\\|native --model <id> --method <m> --hp k=v --name <n>`","locale":"en"},"11844":{"id":"/en/docs/development-testing-75","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Trains on the workspace's dataset with one implementation and keeps the experiment, metrics, previews and exports","locale":"en"},"11845":{"id":"/en/docs/development-testing-76","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`train.py compare <engine> <name>`","locale":"en"},"11846":{"id":"/en/docs/development-testing-77","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Compares the two implementations' training runs; the exported voice or model can be handed to the other implementation to load","locale":"en"},"11847":{"id":"/en/docs/development-testing-78","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`perf.py`, `train_perf.py`","locale":"en"},"11848":{"id":"/en/docs/development-testing-79","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Time the same cases and fine-tunes phase by phase and check the audio, metrics and weights against the previous round (see Performance work)","locale":"en"},"11849":{"id":"/en/docs/development-testing-80","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`memory.py`","locale":"en"},"11850":{"id":"/en/docs/development-testing-81","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Peak device memory and RAM per case, load and offload times (see Memory management)","locale":"en"},"11851":{"id":"/en/docs/development-testing-82","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`voxcpm_modules.py`, `voxcpm_upstream.py`","locale":"en"},"11852":{"id":"/en/docs/development-testing-83","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"VoxCPM's component-level comparison, and the adapter that puts upstream's package into the stack as an engine","locale":"en"},"11853":{"id":"/en/docs/development-testing-84","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`check_rng.py --device cuda:0`","locale":"en"},"11854":{"id":"/en/docs/development-testing-85","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"A fresh `torch.Generator` seeded with *s* against the default stream after `torch.manual_seed(s)`","locale":"en"},"11855":{"id":"/en/docs/development-testing-86","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`check_tokenizer.py <model>`","locale":"en"},"11856":{"id":"/en/docs/development-testing-87","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`mizuoto.text`'s BPE against transformers' tokenizer on the corpus (run in an environment that has transformers)","locale":"en"},"11857":{"id":"/en/docs/development-testing-88","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"`dsp_fixtures.py`","locale":"en"},"11858":{"id":"/en/docs/development-testing-89","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"Writes `tests/fixtures/dsp/*.npz` from the real torchaudio, librosa, Whisper and soxr","locale":"en"},"11859":{"id":"/en/docs/development-testing-90","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"**Self-consistency first.** The reference is compared with a repeat of itself (`--name reference-repeat`) before anything is compared with it: a case that does not repeat cannot judge the native one. `cases/<engine>.jsonl` holds one case per line; the README explains its fields.","locale":"en"},"11860":{"id":"/en/docs/development-testing-91","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#parity-with-the-references","content":"The result: on the CPU in fp32, every engine is identical to its reference (VoxCPM in bf16 too), except CosyVoice when each side makes its own voice prompt: CAM++'s speaker embedding differs from onnxruntime's by about 1e-6, and HiFT's sine source accumulates and amplifies that along the utterance; given the same voice prompt, CosyVoice is identical sample for sample too. Every trainer gives upstream's losses, learning rates and weights byte for byte on the CPU when both are seeded alike.","locale":"en"},"11861":{"id":"/en/docs/development-testing-92","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"\"The same\" is judged in tiers. The lower tiers are checked bit for bit; the upper ones judge the whole stack:","locale":"en"},"11862":{"id":"/en/docs/development-testing-93","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Tier","locale":"en"},"11863":{"id":"/en/docs/development-testing-94","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"What","locale":"en"},"11864":{"id":"/en/docs/development-testing-95","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Where","locale":"en"},"11865":{"id":"/en/docs/development-testing-96","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Pass","locale":"en"},"11866":{"id":"/en/docs/development-testing-97","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**T0 Op**","locale":"en"},"11867":{"id":"/en/docs/development-testing-98","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"DSP, samplers, tokenizers, normalisers, g2p","locale":"en"},"11868":{"id":"/en/docs/development-testing-99","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"CPU","locale":"en"},"11869":{"id":"/en/docs/development-testing-100","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Identical (`torch.equal`, the same ids, the same strings)","locale":"en"},"11870":{"id":"/en/docs/development-testing-101","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**T1 Module**","locale":"en"},"11871":{"id":"/en/docs/development-testing-102","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Each module with real weights on captured inputs","locale":"en"},"11872":{"id":"/en/docs/development-testing-103","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"CPU fp32","locale":"en"},"11873":{"id":"/en/docs/development-testing-104","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Max abs error ≤ 1e-5 × max(1, ‖ref‖∞); cosine ≥ 0.99999","locale":"en"},"11874":{"id":"/en/docs/development-testing-105","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"GPU bf16/fp16","locale":"en"},"11875":{"id":"/en/docs/development-testing-106","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Cosine ≥ 0.999","locale":"en"},"11876":{"id":"/en/docs/development-testing-107","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**T2 Stage**","locale":"en"},"11877":{"id":"/en/docs/development-testing-108","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Teacher-forced logits; discrete outputs from captured inputs (speech-tokenizer codes, VQ codes, ODE trajectories with injected noise)","locale":"en"},"11878":{"id":"/en/docs/development-testing-109","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"CPU fp32","locale":"en"},"11879":{"id":"/en/docs/development-testing-110","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Argmax agreement 100 %; discrete agreement ≥ 99.9 % with every flip inspected and explained (e.g. ties at FSQ rounding boundaries); trajectories within T1","locale":"en"},"11880":{"id":"/en/docs/development-testing-111","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**T3 End to end, seeded**","locale":"en"},"11881":{"id":"/en/docs/development-testing-112","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"A full request through Mizuoto's stack: native against reference, same seed, same torch","locale":"en"},"11882":{"id":"/en/docs/development-testing-113","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"CPU fp32","locale":"en"},"11883":{"id":"/en/docs/development-testing-114","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**Identical tokens; audio identical or max abs error ≤ 1e-4**; exceptions listed per engine with a reason","locale":"en"},"11884":{"id":"/en/docs/development-testing-115","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**T4 Statistical**","locale":"en"},"11885":{"id":"/en/docs/development-testing-116","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Corpus runs in each engine's production dtype and device, native against reference; seeds not aligned (GPU kernels differ)","locale":"en"},"11886":{"id":"/en/docs/development-testing-117","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"GPU (bf16/fp16), CPU","locale":"en"},"11887":{"id":"/en/docs/development-testing-118","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Over ≥ 20 texts × 3 voices × 3 seeds per voice per voice mode and model: mean CER/WER (Whisper large-v3-turbo) ≤ reference + 0.5 pp, and no case worse than the reference's worst + 5 pp; speaker similarity (CAM++ cosine to the reference clip) mean ≥ reference − 0.01; duration ratio within ±5 %; UTMOS mean ≥ reference − 0.05; loudness and F0 median within the reference's spread","locale":"en"},"11888":{"id":"/en/docs/development-testing-119","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**Why T3 is judged on the CPU in fp32 only.** Any logit difference flips a multinomial draw (or a beam) and everything after it diverges. On GPUs in reduced precision even upstream does not match itself bit for bit (batched against single greedy decoding, for one), so GPU consistency is judged by T1's per-module error plus T4's statistics.","locale":"en"},"11889":{"id":"/en/docs/development-testing-120","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**Behaviour beyond the audio** is part of the comparison too, checked through the contract suite on both implementations: applied parameters and warnings, the voice-mode resolution (`fit`), streaming granularity and chunk counts, cancel behaviour, error codes for invalid inputs (a reference too long, an unsupported language, a missing transcript), output sample rates, segment joins.","locale":"en"},"11890":{"id":"/en/docs/development-testing-121","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"Acceleration and speed work keep to the same tiers: an acceleration that changes bits (compilation, for one) stays at least within the engine's T1/T3 tolerance, with the measured error recorded; speed work on the default path must not change a bit.","locale":"en"},"11891":{"id":"/en/docs/development-testing-122","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#tiers-and-tolerances-of-behavioural-consistency","content":"**T0's DSP fixtures are identical on the machine class that made them**: x86-64 Linux with AVX2 and without AVX-512, under the same torch. Elsewhere the kernels round differently (numpy's AVX-512 `exp` and `log`, the Windows CRT's libm, torch's FFT and soxr's SIMD on Arm, another torch), so `tests/runtime/test_dsp.py` checks there that the outputs agree within that rounding: max abs error ≤ 1e-4 × max(1, ‖ref‖∞) in float32, 1e-12 × max(1, ‖ref‖∞) in float64. CI's macOS, Windows and AVX-512 runners measured up to 4e-5.","locale":"en"},"11892":{"id":"/en/docs/development-testing-123","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`mizuoto/webui/src/**/*.test.ts` run with vitest; `python scripts/dev.py test-web` runs `bun run test` and then `bun run typecheck` (vue-tsc). Besides unit tests of components and stores, a few rule tests guard the whole UI: `imports.test.ts`, `tokens.test.ts`, `layout.test.ts`, `ui/layers.test.ts` and `i18n/i18n.test.ts` (the same keys in both languages); see Web UI.","locale":"en"},"11893":{"id":"/en/docs/development-testing-124","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`python scripts/dev.py typegen-check` regenerates `schema.d.ts` and compares it with the committed one; it fails when the API changed and the types were not regenerated.","locale":"en"},"11894":{"id":"/en/docs/development-testing-125","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"The docs site (`site/`) has its own vitest tests; `src/lib/i18n-content.test.ts` requires a `<slug>.en.mdx` for every Chinese `<slug>.mdx` and the same page order in both sidebars.","locale":"en"},"11895":{"id":"/en/docs/development-testing-126","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`.github/workflows/ci.yml` runs on every push to a branch and every pull request, with torch's CPU build (`https://download.pytorch.org/whl/cpu`). Mizuoto and the two gated packages are released on their own, so each is checked on its own, and a change runs only the checks for what it changes. Packages are installed with uv (`astral-sh/setup-uv`, `UV_SYSTEM_PYTHON=1`: into the Python that `setup-python` provides, no virtual environment; the cache stays off, since unpacked torch wheels would crowd the 10 GB cache limit).","locale":"en"},"11896":{"id":"/en/docs/development-testing-127","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"The first job, `scope`, reads the changed files (a push's from the compare API, a pull request's from its file list) and `python scripts/ci.py scope` maps them to checks:","locale":"en"},"11897":{"id":"/en/docs/development-testing-128","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Changed","locale":"en"},"11898":{"id":"/en/docs/development-testing-129","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Checks","locale":"en"},"11899":{"id":"/en/docs/development-testing-130","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`packages/native/<id>/**`","locale":"en"},"11900":{"id":"/en/docs/development-testing-131","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"that package's `gated` and `oldest-mizuoto` jobs, and `torch` for it","locale":"en"},"11901":{"id":"/en/docs/development-testing-132","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`mizuoto/webui/**`","locale":"en"},"11902":{"id":"/en/docs/development-testing-133","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`web`","locale":"en"},"11903":{"id":"/en/docs/development-testing-134","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`site/**`","locale":"en"},"11904":{"id":"/en/docs/development-testing-135","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`site` (the docs site's tests and build)","locale":"en"},"11905":{"id":"/en/docs/development-testing-136","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"anything else under `mizuoto/`, `tests/`, `scripts/`, `pyproject.toml`, or a new path","locale":"en"},"11906":{"id":"/en/docs/development-testing-137","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`host`, `web` (its API types come from the code), `torch`, and both packages' jobs: they run on Mizuoto's runtime at this commit","locale":"en"},"11907":{"id":"/en/docs/development-testing-138","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`.github/workflows/**`, `scripts/ci.py`","locale":"en"},"11908":{"id":"/en/docs/development-testing-139","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"everything","locale":"en"},"11909":{"id":"/en/docs/development-testing-140","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`README*.md`, `AGENTS.md`, `CLAUDE.md`, `LICENSE`, `Dockerfile`, `.gitignore`…","locale":"en"},"11910":{"id":"/en/docs/development-testing-141","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"nothing","locale":"en"},"11911":{"id":"/en/docs/development-testing-142","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"A new branch, a manual run, a list the compare API cuts short (300 files) or a failure to read it checks everything; `tests/test_ci.py` covers the mapping.","locale":"en"},"11912":{"id":"/en/docs/development-testing-143","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Job","locale":"en"},"11913":{"id":"/en/docs/development-testing-144","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Environment","locale":"en"},"11914":{"id":"/en/docs/development-testing-145","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Steps","locale":"en"},"11915":{"id":"/en/docs/development-testing-146","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`host`","locale":"en"},"11916":{"id":"/en/docs/development-testing-147","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, Windows, macOS × Python 3.10, 3.11, 3.12, 3.13","locale":"en"},"11917":{"id":"/en/docs/development-testing-148","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`uv pip install torch` from the CPU index, then `-e . pytest pytest-cov ruff ty httpx tomli` (Mizuoto alone); in every cell `dev.py lint` (the whole repository), `dev.py typecheck-py --python-version <cell> --python-platform <cell> mizuoto tests scripts` (the standard library's stubs differ between Pythons and platforms) and `python -m pytest -q tests`; each of the three runs even when another failed","locale":"en"},"11918":{"id":"/en/docs/development-testing-149","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`gated`","locale":"en"},"11919":{"id":"/en/docs/development-testing-150","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"each package in scope × Ubuntu, Windows, macOS × Python 3.10, 3.13","locale":"en"},"11920":{"id":"/en/docs/development-testing-151","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`-e . -e packages/native/<id>`; `ruff check` and `ruff format --check` of `packages/native/<id>`, `typecheck-py` and `pytest` of its `tests/`","locale":"en"},"11921":{"id":"/en/docs/development-testing-152","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`oldest-mizuoto`","locale":"en"},"11922":{"id":"/en/docs/development-testing-153","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"each package in scope, Ubuntu, Python 3.12","locale":"en"},"11923":{"id":"/en/docs/development-testing-154","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"The package on the oldest Mizuoto its `pyproject.toml` allows (`python scripts/ci.py lower-bound <id>`), from PyPI: its tests run outside the checkout, with only `tests/` on `PYTHONPATH`, so `import mizuoto` finds the released one (the range check, which compares the range with Mizuoto at this commit, is left out)","locale":"en"},"11924":{"id":"/en/docs/development-testing-155","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`torch`","locale":"en"},"11925":{"id":"/en/docs/development-testing-156","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, Python 3.12, torch 2.8.0 and the latest release","locale":"en"},"11926":{"id":"/en/docs/development-testing-157","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"The tests in scope against the oldest torch Mizuoto supports and the newest, to catch torch's API drift","locale":"en"},"11927":{"id":"/en/docs/development-testing-158","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`web`","locale":"en"},"11928":{"id":"/en/docs/development-testing-159","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, Python 3.11, bun","locale":"en"},"11929":{"id":"/en/docs/development-testing-160","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`dev.py web-install`, `dev.py test-web`, `dev.py typegen-check`","locale":"en"},"11930":{"id":"/en/docs/development-testing-161","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`site`","locale":"en"},"11931":{"id":"/en/docs/development-testing-162","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, bun","locale":"en"},"11932":{"id":"/en/docs/development-testing-163","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`bun install --frozen-lockfile`, `bun run check`, `bun run test`, `bun run build` in `site/`","locale":"en"},"11933":{"id":"/en/docs/development-testing-164","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`passed` (\"CI passed\")","locale":"en"},"11934":{"id":"/en/docs/development-testing-165","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu","locale":"en"},"11935":{"id":"/en/docs/development-testing-166","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Fails when a job above failed or was cancelled, passes when they passed or were skipped: the one check to require in branch protection","locale":"en"},"11936":{"id":"/en/docs/development-testing-167","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"A newer run of the same branch cancels the older one. A push to `main` that changes a version file starts the release workflow, which runs `ci.yml` as its checks for what the push changed; CI's own run of that push skips every job (`scope` sees the version file), so the checks run once. Tags start only the release workflow, whose checks are everything. Pushing the docs site to GitHub Pages is `site.yml`'s, not CI's (see Release).","locale":"en"},"11937":{"id":"/en/docs/development-testing-168","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`python scripts/dev.py check` runs all of it locally (on your platform and Python only, with the gated packages installed, on Mizuoto at your checkout). The contract suite and the parity harness need models (and, for parity, the reference environments) weighing tens of gigabytes, so they stay out of CI; the release workflow has its own wheel smoke test (see Release).","locale":"en"},"11938":{"id":"/en/docs/development-testing-169","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"CI has only a CPU build of torch. The GPU paths (CUDA graphs, the optional attention backends, weight streaming's asynchronous prefetch) are tested there for their logic; how they behave on a GPU has to be checked on a machine with one, with the contract suite and the parity harness.","locale":"en"},"11939":{"id":"/en/docs/development-training","page_id":"/en/docs/development-training","type":"page","content":"Trainers","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-training","locale":"en"},"11940":{"id":"/en/docs/development-training-0","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training","content":"How training methods are declared in a manifest, how datasets are added, prepared and checked, how a method's stages run one by one as child processes of Mizuoto's own interpreter, how fingerprints decide what is stale, how trainers are written, and what exports register.","locale":"en"},"11941":{"id":"/en/docs/development-training-1","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#training-methods-in-the-manifest","content":"Training methods in the manifest","locale":"en"},"11942":{"id":"/en/docs/development-training-2","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#datasets","content":"Datasets","locale":"en"},"11943":{"id":"/en/docs/development-training-3","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#experiments-fingerprints-and-stale-stages","content":"Experiments, fingerprints and stale stages","locale":"en"},"11944":{"id":"/en/docs/development-training-4","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#the-train-job","content":"The train job","locale":"en"},"11945":{"id":"/en/docs/development-training-5","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#why-a-child-process","content":"Why a child process","locale":"en"},"11946":{"id":"/en/docs/development-training-6","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#trainer-and-stagecontext","content":"Trainer and StageContext","locale":"en"},"11947":{"id":"/en/docs/development-training-7","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#memory","content":"Memory","locale":"en"},"11948":{"id":"/en/docs/development-training-8","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#exports","content":"Exports","locale":"en"},"11949":{"id":"/en/docs/development-training-9","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#omnivoices-trainer-as-an-example","content":"OmniVoice's trainer, as an example","locale":"en"},"11950":{"id":"/en/docs/development-training-10","page_id":"/en/docs/development-training","type":"heading","tags":[],"url":"/en/docs/development-training#adding-a-trainer","content":"Adding a trainer","locale":"en"},"11951":{"id":"/en/docs/development-training-11","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training","content":"Every trainable engine trains natively, in Mizuoto's own environment, on the same modules it runs inference with. Each trainer reproduces its upstream recipe: given the same seed on the CPU, its losses, learning rates and saved weights equal byte for byte those of the upstream scripts (as Mizuoto 0.1 ran them; for VoxCPM, upstream's own script). Training needs no environment and no extra of its own: trainers use the modules and dependencies inference uses, without transformers, accelerate, peft, Lightning, Hydra, datasets or webdataset. The host side is `mizuoto/core/training/service.py` (`TrainingService`); the engine side is `mizuoto/training/` (`Trainer`, `StageContext`, `stage.py`) plus each engine's trainer module. Using the Train screen is in Train.","locale":"en"},"11952":{"id":"/en/docs/development-training-12","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"A training method is `[training.<id>]` in the engine's manifest (`TrainingMethod`). OmniVoice's LoRA:","locale":"en"},"11953":{"id":"/en/docs/development-training-13","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"Field","locale":"en"},"11954":{"id":"/en/docs/development-training-14","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"Meaning","locale":"en"},"11955":{"id":"/en/docs/development-training-15","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`stages`","locale":"en"},"11956":{"id":"/en/docs/development-training-16","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"Declared statically, each with `id`, `title`, `help` and `uses` (the hyperparameters it reads; omitted: all). The UI and the fingerprints know the stages without running anything","locale":"en"},"11957":{"id":"/en/docs/development-training-17","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`hyperparams`","locale":"en"},"11958":{"id":"/en/docs/development-training-18","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`OptionSpec`s; `group = \"basic\"` shows first, `variants` limits one to some variants","locale":"en"},"11959":{"id":"/en/docs/development-training-19","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`export`","locale":"en"},"11960":{"id":"/en/docs/development-training-20","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`voice_weights` (a voice's own weights, GPT-SoVITS) or `model` (a new user model)","locale":"en"},"11961":{"id":"/en/docs/development-training-21","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`variants`","locale":"en"},"11962":{"id":"/en/docs/development-training-22","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"Starts only from models of these variants","locale":"en"},"11963":{"id":"/en/docs/development-training-23","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`min_seconds`","locale":"en"},"11964":{"id":"/en/docs/development-training-24","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"The least audio the dataset must hold","locale":"en"},"11965":{"id":"/en/docs/development-training-25","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"`assets`","locale":"en"},"11966":{"id":"/en/docs/development-training-26","page_id":"/en/docs/development-training","tags":[],"type":"text","url":"/en/docs/development-training#training-methods-in-the-manifest","content":"Training-only shared assets per variant (GPT-SoVITS's pretrained discriminators); `\"*\"` for every variant","locale":"e