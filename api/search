en"},"17023":{"id":"/en/docs/installation-96","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"The database: jobs, results, cached transcripts and more","locale":"en"},"17024":{"id":"/en/docs/installation-97","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"`models/`","locale":"en"},"17025":{"id":"/en/docs/installation-98","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"Downloaded models; `models/_assets/` holds files several models of an engine share","locale":"en"},"17026":{"id":"/en/docs/installation-99","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"`voices/`","locale":"en"},"17027":{"id":"/en/docs/installation-100","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"The voice library, one folder per voice","locale":"en"},"17028":{"id":"/en/docs/installation-101","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"`outputs/`","locale":"en"},"17029":{"id":"/en/docs/installation-102","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"Synthesized results","locale":"en"},"17030":{"id":"/en/docs/installation-103","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"`projects/`, `datasets/`, `experiments/`","locale":"en"},"17031":{"id":"/en/docs/installation-104","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"Projects, training datasets and training experiments","locale":"en"},"17032":{"id":"/en/docs/installation-105","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"`cache/`","locale":"en"},"17033":{"id":"/en/docs/installation-106","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"Caches: reference clips, prepared voices and more","locale":"en"},"17034":{"id":"/en/docs/installation-107","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"`jobs/`, `logs/`","locale":"en"},"17035":{"id":"/en/docs/installation-108","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"Job logs and server logs","locale":"en"},"17036":{"id":"/en/docs/installation-109","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"`trash/`","locale":"en"},"17037":{"id":"/en/docs/installation-110","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"Deleted voices, projects, datasets and experiments","locale":"en"},"17038":{"id":"/en/docs/installation-111","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#where-the-data-lives","content":"The models, voices, results and cache folders can be moved under **Settings › Storage** (for example `models/` to a larger disk).","locale":"en"},"17039":{"id":"/en/docs/installation-112","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#updating","content":"Install the new version the same way, for example `pip install --upgrade mizuoto` (with `mizuoto-fishspeech mizuoto-indextts` if you use them, so pip picks the versions that work with the new Mizuoto); from source, `git pull`, run the install command again and rebuild the UI. With Docker, rebuild the image; the `/data` volume stays.","locale":"en"},"17040":{"id":"/en/docs/installation-113","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#updating","content":"Restart the server. Prepared voices are rebuilt once, automatically, the next time they are used.","locale":"en"},"17041":{"id":"/en/docs/installation-114","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#updating","content":"A remote host needs the same Mizuoto version as this machine: update both.","locale":"en"},"17042":{"id":"/en/docs/installation-115","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstalling","content":"Uninstall Mizuoto: `pip uninstall mizuoto mizuoto-fishspeech mizuoto-indextts` (torch is yours to keep or remove), or delete the virtual environment.","locale":"en"},"17043":{"id":"/en/docs/installation-116","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstalling","content":"If you need none of the data, delete the data folder. **Careful**: it holds your voice library, results, projects and training data. With Docker: `docker volume rm mizuoto-data`.","locale":"en"},"17044":{"id":"/en/docs/quick-start","page_id":"/en/docs/quick-start","type":"page","content":"Quick start","breadcrumbs":["Mizuoto Documentation","Getting started"],"tags":[],"url":"/en/docs/quick-start","locale":"en"},"17045":{"id":"/en/docs/quick-start-0","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"From nothing to the first spoken sentence: install, start, check the settings, Speak with the dummy engine, then a real engine.","locale":"en"},"17046":{"id":"/en/docs/quick-start-1","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#install-mizuoto","content":"Install Mizuoto","locale":"en"},"17047":{"id":"/en/docs/quick-start-2","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#start-the-web-ui","content":"Start the web UI","locale":"en"},"17048":{"id":"/en/docs/quick-start-3","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#check-the-settings","content":"Check the settings","locale":"en"},"17049":{"id":"/en/docs/quick-start-4","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"Speak with the dummy engine","locale":"en"},"17050":{"id":"/en/docs/quick-start-5","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#switch-to-a-real-engine","content":"Switch to a real engine","locale":"en"},"17051":{"id":"/en/docs/quick-start-6","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#the-same-from-the-command-line","content":"The same from the command line","locale":"en"},"17052":{"id":"/en/docs/quick-start-7","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#next","content":"Next","locale":"en"},"17053":{"id":"/en/docs/quick-start-8","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"This page takes the shortest path. Installation and First run have the details of each step.","locale":"en"},"17054":{"id":"/en/docs/quick-start-9","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#install-mizuoto","content":"You need Python 3.10–3.14. Install torch 2.8 or newer first, in the build for your hardware, then Mizuoto from PyPI:","locale":"en"},"17055":{"id":"/en/docs/quick-start-10","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#install-mizuoto","content":"The torch builds for AMD, Intel, Apple silicon and the CPU, installing from source and Docker are in Installation.","locale":"en"},"17056":{"id":"/en/docs/quick-start-11","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#start-the-web-ui","content":"When the server is ready the terminal prints `SERVER_READY url=http://127.0.0.1:7869`, and a browser opens that address a moment later. The default port is **7869**, and only this machine can connect by default. Press Ctrl+C to stop the server.","locale":"en"},"17057":{"id":"/en/docs/quick-start-12","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#check-the-settings","content":"The UI opens on **Speak**; nothing has to be set up before you try it. Two settings are worth a look before downloading a real model:","locale":"en"},"17058":{"id":"/en/docs/quick-start-13","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#check-the-settings","content":"**Settings › Downloads › Download source**: where models come from (**Hugging Face**, **hf-mirror.com**, **ModelScope**; the last two are often faster in mainland China).","locale":"en"},"17059":{"id":"/en/docs/quick-start-14","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#check-the-settings","content":"**Settings › Compute**: this computer's GPUs and the torch build in use, with the command to install the right build when it does not fit (the same check as `mizuoto doctor`).","locale":"en"},"17060":{"id":"/en/docs/quick-start-15","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#check-the-settings","content":"To download now, see step 5 below or First run.","locale":"en"},"17061":{"id":"/en/docs/quick-start-16","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"The dummy engine ships with Mizuoto: nothing to download, and it needs no torch. It speaks in tones instead of words, but goes through exactly the same steps as a real engine.","locale":"en"},"17062":{"id":"/en/docs/quick-start-17","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"Open **Speak** in the navigation (the UI starts there).","locale":"en"},"17063":{"id":"/en/docs/quick-start-18","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"Under **Model**, choose **Dummy voice** (marked **demo**).","locale":"en"},"17064":{"id":"/en/docs/quick-start-19","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"Under **Voice**, choose **Preset speaker**, and `alto` as the **Speaker**.","locale":"en"},"17065":{"id":"/en/docs/quick-start-20","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"Type anything under **Text**.","locale":"en"},"17066":{"id":"/en/docs/quick-start-21","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"Click **Speak** at the bottom of the page (or press Ctrl+Enter in the text box).","locale":"en"},"17067":{"id":"/en/docs/quick-start-22","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#speak-with-the-dummy-engine","content":"A job card appears at the bottom of the page; when it is done the result is listed under **Results**. Click its play button.","locale":"en"},"17068":{"id":"/en/docs/quick-start-23","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#switch-to-a-real-engine","content":"Open the **Model** picker and choose a real model, for example **Qwen3-TTS 1.7B CustomVoice**. Models that are not ready carry badges such as **Not downloaded** or **Not available**, but can still be chosen.","locale":"en"},"17069":{"id":"/en/docs/quick-start-24","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#switch-to-a-real-engine","content":"The **Speak** button at the bottom is replaced by the one step the model still needs, here **Download Qwen3-TTS 1.7B CustomVoice (size)**. Click it and wait for the progress bar. (When torch is missing, it shows the command that installs it instead.)","locale":"en"},"17070":{"id":"/en/docs/quick-start-25","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#switch-to-a-real-engine","content":"When the download is done the **Speak** button is back. Pick a **Preset speaker**, optionally write an instruction under **Style** › **How to say it** (such as \"Cheerfully, a little faster\"), and click **Speak**.","locale":"en"},"17071":{"id":"/en/docs/quick-start-26","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#switch-to-a-real-engine","content":"Downloads are jobs: you can leave the page and follow them under **Jobs** at the top right. The first synthesis loads the model; the next ones are much faster.","locale":"en"},"17072":{"id":"/en/docs/quick-start-27","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next","content":"Clone your own voice: Voices.","locale":"en"},"17073":{"id":"/en/docs/quick-start-28","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next","content":"What each option of Speak does: Speak.","locale":"en"},"17074":{"id":"/en/docs/quick-start-29","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next","content":"Read a whole book or a dialogue with several voices: Projects.","locale":"en"},"17075":{"id":"/en/docs/quick-start-30","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next","content":"An NVIDIA GPU that is not used, or slow downloads: First run and the FAQ.","locale":"en"}},"count":17075},"sorting":{"language":"multilingual","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":9952,"2":10599,"3":14525,"4":16554,"5":13575,"6":14722,"7"