-projects#command-line","content":"Change the project's settings","locale":"en"},"15239":{"id":"/en/docs/guide-projects-156","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project render <project> [-c chapter-id] [--line line-id] [--force]`","locale":"en"},"15240":{"id":"/en/docs/guide-projects-157","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Render the lines without a current take; `--force` renders current ones too","locale":"en"},"15241":{"id":"/en/docs/guide-projects-158","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project export <project> [-o file] [-c chapter-id] [-f format] [--srt file] [--allow-missing]`","locale":"en"},"15242":{"id":"/en/docs/guide-projects-159","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Export; `--srt` writes `.srt` or `.vtt` subtitles","locale":"en"},"15243":{"id":"/en/docs/guide-projects-160","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project show <project>`","locale":"en"},"15244":{"id":"/en/docs/guide-projects-161","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"The cast and each line's state (with chapter and line ids)","locale":"en"},"15245":{"id":"/en/docs/guide-projects-162","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project script <project>`","locale":"en"},"15246":{"id":"/en/docs/guide-projects-163","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Print the project as a script that imports back","locale":"en"},"15247":{"id":"/en/docs/guid