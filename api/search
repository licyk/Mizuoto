ced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"A download failed from every source","locale":"en"},"8182":{"id":"/en/docs/advanced-api-163","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"`remote_unavailable`","locale":"en"},"8183":{"id":"/en/docs/advanced-api-164","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"502","locale":"en"},"8184":{"id":"/en/docs/advanced-api-165","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"14","locale":"en"},"8185":{"id":"/en/docs/advanced-api-166","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"A remote host cannot be reached, refused the token or speaks another protocol","locale":"en"},"8186":{"id":"/en/docs/advanced-api-167","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"`cancelled`","locale":"en"},"8187":{"id":"/en/docs/advanced-api-168","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"499","locale":"en"},"8188":{"id":"/en/docs/advanced-api-169","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"130","locale":"en"},"8189":{"id":"/en/docs/advanced-api-170","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"Cancelled","locale":"en"},"8190":{"id":"/en/docs/advanced-api-171","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"Access control has three refusals of its own: `bad_host` (400), `bad_origin` (403) and `auth_required` (401).","locale":"en"},"8191":{"id":"/en/docs/advanced-api-172","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Each request passes three checks (`mizuoto/api/security.py`):","locale":"en"},"8192":{"id":"/en/docs/advanced-api-173","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"**The Host header.** While the server is bound to a loopback address (`127.0.0.1` by default), `Host` must be `localhost`, `127.0.0.1`, `::1`, the bound address, or a name the embedding application added with `extra_hosts` / `allow_host()`; anything else is 400 `bad_host`. This blocks DNS rebinding. Bound to a non-loopback address (such as `0.0.0.0`), the server does not check `Host`.","locale":"en"},"8193":{"id":"/en/docs/advanced-api-174","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"**The origin.** A state-changing request (anything but `GET`, `HEAD` and `OPTIONS`) or a WebSocket that carries an `Origin` must come from the page's own origin or one listed in `server.allowed_origins`, else 403 `bad_origin`; without an `Origin`, a `Sec-Fetch-Site` that says cross-site is refused too. curl, Python and other non-browser clients send neither header and are not affected. A non-empty `server.allowed_origins` also turns on CORS for those origins.","locale":"en"},"8194":{"id":"/en/docs/advanced-api-175","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"**The access token.** With `server.access_token` set, every request under `/api/`, `/ws/`, `/v1/`, `/openapi.json` and `/docs` must carry it, else 401 `auth_required`. The only exception is `GET /api/v1/app/health`. Give the token in any of these ways:","locale":"en"},"8195":{"id":"/en/docs/advanced-api-176","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Way","locale":"en"},"8196":{"id":"/en/docs/advanced-api-177","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Example","locale":"en"},"8197":{"id":"/en/docs/advanced-api-178","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Bearer header","locale":"en"},"8198":{"id":"/en/docs/advanced-api-179","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`Authorization: Bearer <token>`","locale":"en"},"8199":{"id":"/en/docs/advanced-api-180","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Cookie","locale":"en"},"8200":{"id":"/en/docs/advanced-api-181","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`mizuoto_token=<token>`","locale":"en"},"8201":{"id":"/en/docs/advanced-api-182","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Query parameter","locale":"en"},"8202":{"id":"/en/docs/advanced-api-183","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`?token=<token>` (for a browser WebSocket, which cannot add headers)","locale":"en"},"8203":{"id":"/en/docs/advanced-api-184","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"socket.io connection","locale":"en"},"8204":{"id":"/en/docs/advanced-api-185","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`auth={\"token\": \"<token>\"}`","locale":"en"},"8205":{"id":"/en/docs/advanced-api-186","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"On a 401 the web UI shows the **Access token** dialog and asks for it once.","locale":"en"},"8206":{"id":"/en/docs/advanced-api-187","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Bound with `--host 0.0.0.0`, the server logs that other machines can reach it, but it does not require a token. The API can delete files, download models and read audio on the server: set an access token, or put the server behind a firewall, a VPN or a reverse proxy with authentication.","locale":"en"},"8207":{"id":"/en/docs/advanced-api-188","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"These routes read or write anywhere on the server's disk, so they answer only a **browser on the server machine** (a loopback client that addressed a loopback host name); anything else gets 403 `not_local`. A request forwarded through a tunnel or a reverse proxy on the same machine does not count as local.","locale":"en"},"8208":{"id":"/en/docs/advanced-api-189","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Route","locale":"en"},"8209":{"id":"/en/docs/advanced-api-190","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Purpose","locale":"en"},"8210":{"id":"/en/docs/advanced-api-191","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`GET /audio/browse`, `POST /audio/files/paths`","locale":"en"},"8211":{"id":"/en/docs/advanced-api-192","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Browse and register audio files on the server","locale":"en"},"8212":{"id":"/en/docs/advanced-api-193","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /models/identify`, `POST /models/import`","locale":"en"},"8213":{"id":"/en/docs/advanced-api-194","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Identify and import a model folder on the server","locale":"en"},"8214":{"id":"/en/docs/advanced-api-195","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /voices/{id}/weights`","locale":"en"},"8215":{"id":"/en/docs/advanced-api-196","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Add a voice's fine-tuned weights from server paths","locale":"en"},"8216":{"id":"/en/docs/advanced-api-197","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /datasets/{id}/import`","locale":"en"},"8217":{"id":"/en/docs/advanced-api-198","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Import a folder on the server into a dataset","locale":"en"},"8218":{"id":"/en/docs/advanced-api-199","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /outputs/{id}/reveal`","locale":"en"},"8219":{"id":"/en/docs/advanced-api-200","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Show a result in the file manager","locale":"en"},"8220":{"id":"/en/docs/advanced-api-201","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /engines/{id}/ops/{op}`","locale":"en"},"8221":{"id":"/en/docs/advanced-api-202","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Engine-specific operations (their payload may name server files)","locale":"en"},"8222":{"id":"/en/docs/advanced-api-203","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Browsed and registered paths must also lie inside `paths.browse_roots` (empty: the home folder, the data folder and every drive or volume). Remote clients upload instead: `PUT /audio/files`, or weights role by role with `PUT /voices/{id}/weights/{engine}/{role}`.","locale":"en"},"8223":{"id":"/en/docs/advanced-api-204","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Long operations (synthesis, downloads, training, project renders…) return a job rather than waiting for it:","locale":"en"},"8224":{"id":"/en/docs/advanced-api-205","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`state` goes through `queued`, `waiting` (for a GPU, the engine or another resource; `waiting_for` says which) and `running`, and ends `completed`, `failed`, `cancelled` or `interrupted` (the server stopped while it ran). A finished job has its `result`; a failed one has an `error` with `code`, `message` and `detail`.","locale":"en"},"8225":{"id":"/en/docs/advanced-api-206","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Operation","locale":"en"},"8226":{"id":"/en/docs/advanced-api-207","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Route","locale":"en"},"8227":{"id":"/en/docs/advanced-api-208","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Read","locale":"en"},"8228":{"id":"/en/docs/advanced-api-209","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`GET /api/v1/jobs/{id}`; a list: `GET /api/v1/jobs?state=active`","locale":"en"},"8229":{"id":"/en/docs/advanced-api-210","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Log","locale":"en"},"8230":{"id":"/en/docs/advanced-api-211","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`GET /api/v1/jobs/{id}/log?offset=0` (returns `lines` and `next_offset`, where the next read starts)","locale":"en"},"8231":{"id":"/en/docs/advanced-api-212","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Cancel","locale":"en"},"8232":{"id":"/en/docs/advanced-api-213","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`POST /api/v1/jobs/{id}/cancel`","locale":"en"},"8233":{"id":"/en/docs/advanced-api-214","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Retry","locale":"en"},"8234":{"id":"/en/docs/advanced-api-215","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`POST /api/v1/jobs/{id}/retry` (failed, cancelled or interrupted jobs)","locale":"en"},"8235":{"id":"/en/docs/advanced-api-216","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Run without queueing","locale":"en"},"8236":{"id":"/en/docs/advanced-api-217","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`POST /api/v1/jobs/{id}/run-anyway` (a job waiting for the GPU, when the memory suffices)","locale":"en"},"8237":{"id":"/en/docs/advanced-api-218","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"A synthesis can wait for its result: `POST /api/v1/tts/speak?wait=true&timeout=600` answers with the finished job; `result.output_id` (and `result.output_ids` for a batch) is the result's id. When the job is still running after `timeout` seconds (600 by default, at most 3600) the answer is 504 `timeout` with the job in `detail.job_id`; it goes on, and you read it as usual.","locale":"en"},"8238":{"id":"/en/docs/advanced-api-219","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Download the audio with `GET /api/v1/outputs/{id}/content`; `GET /api/v1/outputs/{id}` returns its parameters, duration, sample rate and timings.","locale":"en"},"8239":{"id":"/en/docs/advanced-api-220","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Instead of polling, follow `job_updated` among the events.","locale":"en"},"8240":{"id":"/en/docs/advanced-api-221","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"The body is a `SpeakRequest`. Its main fields (`/docs` has all of them):","locale":"en"},"8241":{"id":"/en/docs/advanced-api-222","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"Field","locale":"en"},"8242":{"id":"/en/docs/advanced-api-223","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"Meaning","locale":"en"},"8243":{"id":"/en/docs/advanced-api-224","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`model`","locale":"en"},"8244":{"id":"/en/docs/advanced-api-225","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`<engine>/<model>`, such as `cosyvoice/cosyvoice3-0.5b`","locale":"en"},"8245":{"id":"/en/docs/advanced-api-226","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`text` / `texts`","locale":"en"},"8246":{"id":"/en/docs/advanced-api-227","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"The text; `texts` is a batch, one result per text (models that take batches)","locale":"en"},"8247":{"id":"/en/docs/advanced-api-228","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`language`","locale":"en"},"8248":{"id":"/en/docs/advanced-api-229","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`zh`, `en`… or `auto`","locale":"en"},"8249":{"id":"/en/docs/advanced-api-230","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`voice`","locale":"en"},"8250":{"id":"/en/docs/advanced-api-231","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"A library voice's id or slug","locale":"en"},"8251":{"id":"/en/docs/advanced-api-232","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`voice_spec`","locale":"en"},"8252":{"id":"/en/docs/advanced-api-233","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"A voice given with the request, in one way only: `references` (`[{\"audio_id\" or \"path\", \"transcript\"}]`), `preset`, `description` / `attributes` (a `consent` field is ignored)","locale":"en"},"8253":{"id":"/en/docs/advanced-api-234","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`style`","locale":"en"},"8254":{"id":"/en/docs/advanced-api-235","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`instruct` (an instruction), `emotion` (`audio_id` / `path`, `vector`, `text`, `strength`)","locale":"en"},"8255":{"id":"/en/docs/advanced-api-236","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`params`","locale":"en"},"8256":{"id":"/en/docs/advanced-api-237","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"Common parameters: `temperature`, `top_p`, `top_k`, `speed`, `seed`, `segment_silence_ms`…","locale":"en"},"8257":{"id":"/en/docs/advanced-api-238","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`engine_options`","locale":"en"},"8258":{"id":"/en/docs/advanced-api-239","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"Engine-specific options","locale":"en"},"8259":{"id":"/en/docs/advanced-api-240","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`output`","locale":"en"},"8260":{"id":"/en/docs/advanced-api-241","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`format` (`wav`, `flac`, `mp3`, `ogg`, `m4a`), `sample_rate`, `normalize`, `name`","locale":"en"},"8261":{"id":"/en/docs/advanced-api-242","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`segmentation`","locale":"en"},"8262":{"id":"/en/docs/advanced-api-243","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`engine` (default) or `mizuoto`: who splits long text","locale":"en"},"8263":{"id":"/en/docs/advanced-api-244","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`strict`","locale":"en"},"8264":{"id":"/en/docs/advanced-api-245","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"Refuse parameters the model does not take; unset: `tts.strict_params`","locale":"en"},"8265":{"id":"/en/docs/advanced-api-246","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"With neither `voice` nor `voice_spec`, the model speaks in its own voice (if it has one). To check a request without running it, `POST /api/v1/tts/plan` returns the segments, the parameters that apply and the warnings. A top-level field the request does not have is ignored, so that a client sending a newer version's field keeps working, and named in the warnings (\"Ignored fields the request does not have: …\"): engine options go in `engine_options`, and `options` there would be ignored. A conversion or an edit logs such fields.","locale":"en"},"8266":{"id":"/en/docs/advanced-api-247","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#upload-a-clip-and-clone-it","content":"The body of `PUT /api/v1/audio/files` is the file itself (not multipart); the `name` query parameter names it. The `id` it returns is a reference's `audio_id`:","locale":"en"},"8267":{"id":"/en/docs/advanced-api-248","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#upload-a-clip-and-clone-it","content":"Without a `transcript`, speech recognition fills it in when `tts.auto_transcribe` is on and the recognition model is downloaded; otherwise the model must clone without one. To keep the voice, add it to the library (`POST /api/v1/voices`) and name it with `\"voice\": \"<id>\"`.","locale":"en"},"8268":{"id":"/en/docs/advanced-api-249","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"The server pushes events over socket.io at `/ws` (socket.io path `/ws/socket.io`). Traffic is server to client only: every operation goes through REST, REST is the truth, and events only tell you when to refresh.","locale":"en"},"8269":{"id":"/en/docs/advanced-api-250","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"Event","locale":"en"},"8270":{"id":"/en/docs/advanced-api-251","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"Payload","locale":"en"},"8271":{"id":"/en/docs/advanced-api-252","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`job_updated`","locale":"en"},"8272":{"id":"/en/docs/advanced-api-253","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`job`: the job's state, progress and download speed","locale":"en"},"8273":{"id":"/en/docs/advanced-api-254","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`job_log`","locale":"en"},"8274":{"id":"/en/docs/advanced-api-255","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`job_id`, `offset`, `lines` (at most 50; read the rest over REST)","locale":"en"},"8275":{"id":"/en/docs/advanced-api-256","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`jobs_cleared`","locale":"en"},"8276":{"id":"/en/docs/advanced-api-257","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`ids`","locale":"en"},"8277":{"id":"/en/docs/advanced-api-258","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`outputs_added` / `outputs_removed`","locale":"en"},"8278":{"id":"/en/docs/advanced-api-259","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`ids` (and `job_id` when added)","locale":"en"},"8279":{"id":"/en/docs/advanced-api-260","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`voices_changed`, `presets_changed`, `models_changed`, `datasets_changed`, `projects_changed`","locale":"en"},"8280":{"id":"/en/docs/advanced-api-261","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`ids`","locale":"en"},"8281":{"id":"/en/docs/advanced-api-262","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`experiments_changed`","locale":"en"},"8282":{"id":"/en/docs/advanced-api-263","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`names` (`<engine>/<name>`)","locale":"en"},"8283":{"id":"/en/docs/advanced-api-264","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`train_metrics`","locale":"en"},"8284":{"id":"/en/docs/advanced-api-265","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`experiment`, `stage`, `points` (training losses)","locale":"en"},"8285":{"id":"/en/docs/advanced-api-266","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`engines_changed`","locale":"en"},"8286":{"id":"/en/docs/advanced-api-267","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`engines`","locale":"en"},"8287":{"id":"/en/docs/advanced-api-268","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`runtime_changed`","locale":"en"},"8288":{"id":"/en/docs/advanced-api-269","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`runtime`: the torch version, the loaded models and the engines' state (as `GET /runtime`)","locale":"en"},"8289":{"id":"/en/docs/advanced-api-270","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`compute_changed`","locale":"en"},"8290":{"id":"/en/docs/advanced-api-271","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`usage`: devices and memory","locale":"en"},"8291":{"id":"/en/docs/advanced-api-272","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`settings_changed`","locale":"en"},"8292":{"id":"/en/docs/advanced-api-273","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#events","content":"`keys`: the settings that changed","locale":"en"},"8293":{"id":"/en/docs/advanced-api-274","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"Hear the audio as it is made. The protocol:","locale":"en"},"8294":{"id":"/en/docs/advanced-api-275","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"The client sends one JSON text message: a `SpeakRequest`.","locale":"en"},"8295":{"id":"/en/docs/advanced-api-276","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"The server answers `{\"type\": \"queued\", \"job_id\": …}`.","locale":"en"},"8296":{"id":"/en/docs/advanced-api-277","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"When generation starts: `{\"type\": \"start\", \"job_id\": …, \"sample_rate\": 24000, \"granularity\": \"token\" | \"segment\" | \"emulated\"}`.","locale":"en"},"8297":{"id":"/en/docs/advanced-api-278","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"Then binary messages: mono 16-bit little-endian PCM at the `start` rate, with `{\"type\": \"segment\", \"index\": n}` before each segment.","locale":"en"},"8298":{"id":"/en/docs/advanced-api-279","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"Finally `{\"type\": \"end\", \"job_id\": …, \"output_ids\": […], \"output_id\": …}` or `{\"type\": \"error\", \"code\", \"message\", \"detail\"}`.","locale":"en"},"8299":{"id":"/en/docs/advanced-api-280","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"A binary message is always audio; everything else is JSON text. The whole audio is still stored as a result (`output_id`). The client may send `{\"type\": \"cancel\"}` at any time.","locale":"en"},"8300":{"id":"/en/docs/advanced-api-281","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"`granularity` says how fine the audio arrives: `token` as the model emits tokens (CosyVoice, VoxCPM, Qwen3-TTS), `segment` once per segment, `emulated` when the model does not stream and Mizuoto splits the text to emulate it.","locale":"en"},"8301":{"id":"/en/docs/advanced-api-282","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#websocket-apiv1ttsstream","content":"**Streaming text**: with a model that has **Streaming text** (CosyVoice 2 and 3), set `\"text_stream\": true`; `text` is only the beginning. Send the rest as `{\"type\": \"text\", \"text\": \"…\"}` messages and `{\"type\": \"flush\"}` after the last. Leaving before the flush cancels the job.","locale":"en"},"8302":{"id":"/en/docs/advanced-api-283","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"Where a WebSocket is awkward, add `stream=true` to the same request: the response is the audio as it is made (chunked transfer):","locale":"en"},"8303":{"id":"/en/docs/advanced-api-284","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"Parameter","locale":"en"},"8304":{"id":"/en/docs/advanced-api-285","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"Response","locale":"en"},"8305":{"id":"/en/docs/advanced-api-286","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"`stream_format=wav` (default)","locale":"en"},"8306":{"id":"/en/docs/advanced-api-287","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"A WAV of unknown length (PCM16 right after the header)","locale":"en"},"8307":{"id":"/en/docs/advanced-api-288","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"`stream_format=pcm`","locale":"en"},"8308":{"id":"/en/docs/advanced-api-289","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"Mono 16-bit little-endian PCM, no header","locale":"en"},"8309":{"id":"/en/docs/advanced-api-290","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#http-post-ttsspeakstreamtrue","content":"The `X-Mizuoto-Sample-Rate` header is the rate and `X-Mizuoto-Job` the job (the result is still stored). Streaming text is not available this way.","locale":"en"},"8310":{"id":"/en/docs/advanced-api-291","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Clients written for OpenAI's speech API work with Mizuoto. The two routes are under `/v1` (not under `/api`; at `<prefix>/v1` with `--api-prefix`) and need the access token too:","locale":"en"},"8311":{"id":"/en/docs/advanced-api-292","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Route","locale":"en"},"8312":{"id":"/en/docs/advanced-api-293","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Meaning","locale":"en"},"8313":{"id":"/en/docs/advanced-api-294","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`POST /v1/audio/speech`","locale":"en"},"8314":{"id":"/en/docs/advanced-api-295","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Speak `input` and answer with the audio","locale":"en"},"8315":{"id":"/en/docs/advanced-api-296","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`GET /v1/models`","locale":"en"},"8316":{"id":"/en/docs/advanced-api-297","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"The installed speech models (not speech recognition), and the aliases in `tts.model_aliases`","locale":"en"},"8317":{"id":"/en/docs/advanced-api-298","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"How the fields map:","locale":"en"},"8318":{"id":"/en/docs/advanced-api-299","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Field","locale":"en"},"8319":{"id":"/en/docs/advanced-api-300","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"In Mizuoto","locale":"en"},"8320":{"id":"/en/docs/advanced-api-301","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`model`","locale":"en"},"8321":{"id":"/en/docs/advanced-api-302","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"A Mizuoto model id; or an alias from `tts.model_aliases`; otherwise `tts.default_model`; with none of them, 404","locale":"en"},"8322":{"id":"/en/docs/advanced-api-303","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`voice`","locale":"en"},"8323":{"id":"/en/docs/advanced-api-304","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"A library voice (id or slug); or a preset speaker of the model; or one of OpenAI's names (`alloy`, `ash`, `ballad`, `cedar`, `coral`, `echo`, `fable`, `marin`, `nova`, `onyx`, `sage`, `shimmer`, `verse`), which fall back to the model's own voice, or its first preset speaker when it has no voice of its own. Any other name is 404","locale":"en"},"8324":{"id":"/en/docs/advanced-api-305","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`instructions`","locale":"en"},"8325":{"id":"/en/docs/advanced-api-306","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Used only when the model has **Instructions**; ignored otherwise","locale":"en"},"8326":{"id":"/en/docs/advanced-api-307","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`speed`","locale":"en"},"8327":{"id":"/en/docs/advanced-api-308","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"0.25–4; dropped when the model takes no speed","locale":"en"},"8328":{"id":"/en/docs/advanced-api-309","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`response_format`","locale":"en"},"8329":{"id":"/en/docs/advanced-api-310","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`mp3` (default), `opus` (made as ogg), `aac` (made as m4a), `flac`, `wav`, `pcm` (24 kHz mono 16-bit little-endian, no header)","locale":"en"},"8330":{"id":"/en/docs/advanced-api-311","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`stream_format`","locale":"en"},"8331":{"id":"/en/docs/advanced-api-312","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"`audio` with `wav` or `pcm` streams the audio as it is made; `sse` is not supported","locale":"en"},"8332":{"id":"/en/docs/advanced-api-313","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Parameters are lenient here: one the model does not take is dropped rather than refused. Errors take OpenAI's shape, `{\"error\": {\"message\", \"type\", \"param\", \"code\"}}`, with Mizuoto's error code as `code`. A successful answer carries `X-Mizuoto-Job` and `X-Mizuoto-Model` headers.","locale":"en"},"8333":{"id":"/en/docs/advanced-api-314","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#openai-compatible-api","content":"Give the usual names aliases first:","locale":"en"},"8334":{"id":"/en/docs/advanced-api-315","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#next","content":"Using Mizuoto from Python: call the core services without HTTP, or embed the server in your own program.","locale":"en"},"8335":{"id":"/en/docs/advanced-api-316","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#next","content":"Command line: the same operations in a terminal.","locale":"en"},"8336":{"id":"/en/docs/advanced-api-317","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#next","content":"Remote hosts: run engines on another machine.","locale":"en"},"8337":{"id":"/en/docs/advanced-docker","page_id":"/en/docs/advanced-docker","type":"page","content":"Docker","breadcrumbs":["Mi