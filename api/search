ormance#where-the-time-goes-on-the-cpu","content":"language model 75.6, vae 1.3","locale":"en"},"11115":{"id":"/en/docs/development-performance-89","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#where-the-time-goes-on-the-cpu","content":"VoxCPM v15-clone-en","locale":"en"},"11116":{"id":"/en/docs/development-performance-90","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#where-the-time-goes-on-the-cpu","content":"5.60","locale":"en"},"11117":{"id":"/en/docs/development-performance-91","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#where-the-time-goes-on-the-cpu","content":"21.82","locale":"en"},"11118":{"id":"/en/docs/development-performance-92","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#where-the-time-goes-on-the-cpu","content":"language model 20.7, vae 1.1","locale":"en"},"11119":{"id":"/en/docs/development-performance-93","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#where-the-time-goes-on-the-cpu","content":"**Matrix products dominate** (`F.linear`/`addmm`: 50–90 % of the time). The autoregressive LMs run one token at a time against fp32 weights, so they are bound by memory bandwidth (Qwen3-TTS's 1.7B talker reads about 6.8 GB a frame at about 36 GB/s). Faster kernels, lower precision or other thread counts would change the sums.","locale":"en"},"11120":{"id":"/en/docs/development-performance-94","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#where-the-time-goes-on-the-cpu","content":"**VoxCPM 2 spent 40 of its 77 s in attention**: each step attended over the whole 8192-position static cache under a mask, though a few hundred positions were filled.","locale":"en"},"11121":{"id":"/en/docs/development-performance-95","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#where-the-time-goes-on-the-cpu","content":"**Allocation**: every layer allocates and frees tensors of a few to tens of megabytes, and with glibc's defaults each is mapped fresh and its pages zeroed by the kernel.","locale":"en"},"11122":{"id":"/en/docs/development-performance-96","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#cpu-round-1-cpu-settings-and-exact-clean-ups","content":"Change","locale":"en"},"11123":{"id":"/en/docs/development-performance-97","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#cpu-round-1-cpu-settings-and-exact-clean-ups","content":"Why it is exact","locale":"en"},"11124":{"id":"/en/docs/development-performance-98","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#cpu-round-1-cpu-settings-and-exact-clean-ups","content":"`compute.cpu_allocator` and `compute.cpu_threads` (Acceleration)","locale":"en"},"11125":{"id":"/en/docs/development-performance-99","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#cpu-round-1-cpu-settings-and-exact-clean-ups","content":"where memory comes from and where threads run, not what is computed; the same thread count splits the work the same way","locale":"en"},"11126":{"id":"/en/docs/development-performance-100","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/docs/development-performance#cpu-round-1-cpu-settings-and-exact-clean-ups","content":"VoxCPM attends over the cache up to the next multiple of 256 past the current length, mask kept, instead of all 8192 positions","locale":"en"},"11127":{"id":"/en/docs/development-performance-101","page_id":"/en/docs/development-performance","tags":[],"type":"text","url":"/en/