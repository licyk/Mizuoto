#errors","content":"11","locale":"en"},"7176":{"id":"/en/docs/advanced-api-158","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"A time limit passed (for example `wait=true`)","locale":"en"},"7177":{"id":"/en/docs/advanced-api-159","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"`download_failed`","locale":"en"},"7178":{"id":"/en/docs/advanced-api-160","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"502","locale":"en"},"7179":{"id":"/en/docs/advanced-api-161","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"12","locale":"en"},"7180":{"id":"/en/docs/advanced-api-162","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"A download failed from every source","locale":"en"},"7181":{"id":"/en/docs/advanced-api-163","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"`remote_unavailable`","locale":"en"},"7182":{"id":"/en/docs/advanced-api-164","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"502","locale":"en"},"7183":{"id":"/en/docs/advanced-api-165","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"14","locale":"en"},"7184":{"id":"/en/docs/advanced-api-166","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"A remote host cannot be reached, refused the token or speaks another protocol","locale":"en"},"7185":{"id":"/en/docs/advanced-api-167","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"`cancelled`","locale":"en"},"7186":{"id":"/en/docs/advanced-api-168","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"499","locale":"en"},"7187":{"id":"/en/docs/advanced-api-169","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"130","locale":"en"},"7188":{"id":"/en/docs/advanced-api-170","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"Cancelled","locale":"en"},"7189":{"id":"/en/docs/advanced-api-171","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#errors","content":"Access control has three refusals of its own: `bad_host` (400), `bad_origin` (403) and `auth_required` (401).","locale":"en"},"7190":{"id":"/en/docs/advanced-api-172","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Each request passes three checks (`mizuoto/api/security.py`):","locale":"en"},"7191":{"id":"/en/docs/advanced-api-173","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"**The Host header.** While the server is bound to a loopback address (`127.0.0.1` by default), `Host` must be `localhost`, `127.0.0.1`, `::1`, the bound address, or a name the embedding application added with `extra_hosts` / `allow_host()`; anything else is 400 `bad_host`. This blocks DNS rebinding. Bound to a non-loopback address (such as `0.0.0.0`), the server does not check `Host`.","locale":"en"},"7192":{"id":"/en/docs/advanced-api-174","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"**The origin.** A state-changing request (anything but `GET`, `HEAD` and `OPTIONS`) or a WebSocket that carries an `Origin` must come from the page's own origin or one listed in `server.allowed_origins`, else 403 `bad_origin`; without an `Origin`, a `Sec-Fetch-Site` that says cross-site is refused too. curl, Python and other non-browser clients send neither header and are not affected. A non-empty `server.allowed_origins` also turns on CORS for those origins.","locale":"en"},"7193":{"id":"/en/docs/advanced-api-175","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"**The access token.** With `server.access_token` set, every request under `/api/`, `/ws/`, `/v1/`, `/openapi.json` and `/docs` must carry it, else 401 `auth_required`. The only exception is `GET /api/v1/app/health`. Give the token in any of these ways:","locale":"en"},"7194":{"id":"/en/docs/advanced-api-176","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Way","locale":"en"},"7195":{"id":"/en/docs/advanced-api-177","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Example","locale":"en"},"7196":{"id":"/en/docs/advanced-api-178","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Bearer header","locale":"en"},"7197":{"id":"/en/docs/advanced-api-179","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`Authorization: Bearer <token>`","locale":"en"},"7198":{"id":"/en/docs/advanced-api-180","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Cookie","locale":"en"},"7199":{"id":"/en/docs/advanced-api-181","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`mizuoto_token=<token>`","locale":"en"},"7200":{"id":"/en/docs/advanced-api-182","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Query parameter","locale":"en"},"7201":{"id":"/en/docs/advanced-api-183","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`?token=<token>` (for a browser WebSocket, which cannot add headers)","locale":"en"},"7202":{"id":"/en/docs/advanced-api-184","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"socket.io connection","locale":"en"},"7203":{"id":"/en/docs/advanced-api-185","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"`auth={\"token\": \"<token>\"}`","locale":"en"},"7204":{"id":"/en/docs/advanced-api-186","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"On a 401 the web UI shows the **Access token** dialog and asks for it once.","locale":"en"},"7205":{"id":"/en/docs/advanced-api-187","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#access-control","content":"Bound with `--host 0.0.0.0`, the server logs that other machines can reach it, but it does not require a token. The API can delete files, download models and read audio on the server: set an access token, or put the server behind a firewall, a VPN or a reverse proxy with authentication.","locale":"en"},"7206":{"id":"/en/docs/advanced-api-188","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"These routes read or write anywhere on the server's disk, so they answer only a **browser on the server machine** (a loopback client that addressed a loopback host name); anything else gets 403 `not_local`. A request forwarded through a tunnel or a reverse proxy on the same machine does not count as local.","locale":"en"},"7207":{"id":"/en/docs/advanced-api-189","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Route","locale":"en"},"7208":{"id":"/en/docs/advanced-api-190","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Purpose","locale":"en"},"7209":{"id":"/en/docs/advanced-api-191","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`GET /audio/browse`, `POST /audio/files/paths`","locale":"en"},"7210":{"id":"/en/docs/advanced-api-192","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Browse and register audio files on the server","locale":"en"},"7211":{"id":"/en/docs/advanced-api-193","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /models/identify`, `POST /models/import`","locale":"en"},"7212":{"id":"/en/docs/advanced-api-194","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Identify and import a model folder on the server","locale":"en"},"7213":{"id":"/en/docs/advanced-api-195","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /voices/{id}/weights`","locale":"en"},"7214":{"id":"/en/docs/advanced-api-196","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Add a voice's fine-tuned weights from server paths","locale":"en"},"7215":{"id":"/en/docs/advanced-api-197","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /datasets/{id}/import`","locale":"en"},"7216":{"id":"/en/docs/advanced-api-198","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Import a folder on the server into a dataset","locale":"en"},"7217":{"id":"/en/docs/advanced-api-199","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /outputs/{id}/reveal`","locale":"en"},"7218":{"id":"/en/docs/advanced-api-200","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Show a result in the file manager","locale":"en"},"7219":{"id":"/en/docs/advanced-api-201","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"`POST /engines/{id}/ops/{op}`","locale":"en"},"7220":{"id":"/en/docs/advanced-api-202","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Engine-specific operations (their payload may name server files)","locale":"en"},"7221":{"id":"/en/docs/advanced-api-203","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#routes-for-the-server-machine-only","content":"Browsed and registered paths must also lie inside `paths.browse_roots` (empty: the home folder, the data folder and every drive or volume). Remote clients upload instead: `PUT /audio/files`, or weights role by role with `PUT /voices/{id}/weights/{engine}/{role}`.","locale":"en"},"7222":{"id":"/en/docs/advanced-api-204","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Long operations (synthesis, downloads, training, project renders…) return a job rather than waiting for it:","locale":"en"},"7223":{"id":"/en/docs/advanced-api-205","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`state` goes through `queued`, `waiting` (for a GPU, the engine or another resource; `waiting_for` says which) and `running`, and ends `completed`, `failed`, `cancelled` or `interrupted` (the server stopped while it ran). A finished job has its `result`; a failed one has an `error` with `code`, `message` and `detail`.","locale":"en"},"7224":{"id":"/en/docs/advanced-api-206","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Operation","locale":"en"},"7225":{"id":"/en/docs/advanced-api-207","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Route","locale":"en"},"7226":{"id":"/en/docs/advanced-api-208","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Read","locale":"en"},"7227":{"id":"/en/docs/advanced-api-209","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`GET /api/v1/jobs/{id}`; a list: `GET /api/v1/jobs?state=active`","locale":"en"},"7228":{"id":"/en/docs/advanced-api-210","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Log","locale":"en"},"7229":{"id":"/en/docs/advanced-api-211","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`GET /api/v1/jobs/{id}/log?offset=0` (returns `lines` and `next_offset`, where the next read starts)","locale":"en"},"7230":{"id":"/en/docs/advanced-api-212","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Cancel","locale":"en"},"7231":{"id":"/en/docs/advanced-api-213","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`POST /api/v1/jobs/{id}/cancel`","locale":"en"},"7232":{"id":"/en/docs/advanced-api-214","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Retry","locale":"en"},"7233":{"id":"/en/docs/advanced-api-215","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`POST /api/v1/jobs/{id}/retry` (failed, cancelled or interrupted jobs)","locale":"en"},"7234":{"id":"/en/docs/advanced-api-216","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Run without queueing","locale":"en"},"7235":{"id":"/en/docs/advanced-api-217","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"`POST /api/v1/jobs/{id}/run-anyway` (a job waiting for the GPU, when the memory suffices)","locale":"en"},"7236":{"id":"/en/docs/advanced-api-218","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"A synthesis can wait for its result: `POST /api/v1/tts/speak?wait=true&timeout=600` answers with the finished job; `result.output_id` (and `result.output_ids` for a batch) is the result's id. When the job is still running after `timeout` seconds (600 by default, at most 3600) the answer is 504 `timeout` with the job in `detail.job_id`; it goes on, and you read it as usual.","locale":"en"},"7237":{"id":"/en/docs/advanced-api-219","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Download the audio with `GET /api/v1/outputs/{id}/content`; `GET /api/v1/outputs/{id}` returns its parameters, duration, sample rate and timings.","locale":"en"},"7238":{"id":"/en/docs/advanced-api-220","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#jobs","content":"Instead of polling, follow `job_updated` among the events.","locale":"en"},"7239":{"id":"/en/docs/advanced-api-221","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"The body is a `SpeakRequest`. Its main fields (`/docs` has all of them):","locale":"en"},"7240":{"id":"/en/docs/advanced-api-222","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"Field","locale":"en"},"7241":{"id":"/en/docs/advanced-api-223","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"Meaning","locale":"en"},"7242":{"id":"/en/docs/advanced-api-224","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`model`","locale":"en"},"7243":{"id":"/en/docs/advanced-api-225","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`<engine>/<model>`, such as `cosyvoice/cosyvoice3-0.5b`","locale":"en"},"7244":{"id":"/en/docs/advanced-api-226","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`text` / `texts`","locale":"en"},"7245":{"id":"/en/docs/advanced-api-227","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"The text; `texts` is a batch, one result per text (models that take batches)","locale":"en"},"7246":{"id":"/en/docs/advanced-api-228","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`language`","locale":"en"},"7247":{"id":"/en/docs/advanced-api-229","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`zh`, `en`… or `auto`","locale":"en"},"7248":{"id":"/en/docs/advanced-api-230","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`voice`","locale":"en"},"7249":{"id":"/en/docs/advanced-api-231","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"A library voice's id or slug","locale":"en"},"7250":{"id":"/en/docs/advanced-api-232","page_id":"/en/docs/advanced-api","tags":[],"type":"text","url":"/en/docs/advanced-api#speak-and-download","content":"`voice_spec`","locale":"en"},"7251":{"id":"/en/docs/advanced-api-233","page_id":"/en/docs/advanced-api","tags":[],"type":"text",