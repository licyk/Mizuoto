ines","content":"CosyVoice","locale":"en"},"15847":{"id":"/en/docs/engines-34","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v1_base`, `v1_sft`, `v1_instruct`, `v2`, `v3`","locale":"en"},"15848":{"id":"/en/docs/engines-35","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/cosyvoice`","locale":"en"},"15849":{"id":"/en/docs/engines-36","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical given the same voice prompt; through the whole stack 23–68 dB SNR (CAM++'s float noise)","locale":"en"},"15850":{"id":"/en/docs/engines-37","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`llm`, `llm_flow`","locale":"en"},"15851":{"id":"/en/docs/engines-38","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Fish Speech","locale":"en"},"15852":{"id":"/en/docs/engines-39","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`s2_pro`, `drama3`","locale":"en"},"15853":{"id":"/en/docs/engines-40","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`packages/native/fishspeech` (`mizuoto-fishspeech`)","locale":"en"},"15854":{"id":"/en/docs/engines-41","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical codes and audio in both stack cases; Drama 3 against upstream's modules: identical frames and audio in every case","locale":"en"},"15855":{"id":"/en/docs/engines-42","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`lora` (S2 Pro)","locale":"en"},"15856":{"id":"/en/docs/engines-43","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"IndexTTS","locale":"en"},"15857":{"id":"/en/docs/engines-44","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v1_5`, `v2`, `v2_5`","locale":"en"},"15858":{"id":"/en/docs/engines-45","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`packages/native/indextts` (`mizuoto-indextts`)","locale":"en"},"15859":{"id":"/en/docs/engines-46","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical in all 4 stack cases","locale":"en"},"15860":{"id":"/en/docs/engines-47","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"none","locale":"en"},"15861":{"id":"/en/docs/engines-48","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"GPT-SoVITS","locale":"en"},"15862":{"id":"/en/docs/engines-49","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v2`, `v2pro`, `v2proplus`, `v4`, `v5turbo`","locale":"en"},"15863":{"id":"/en/docs/engines-50","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/gptsovits`","locale":"en"},"15864":{"id":"/en/docs/engines-51","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical in all 15 stack cases","locale":"en"},"15865":{"id":"/en/docs/engines-52","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`speaker`","locale":"en"},"15866":{"id":"/en/docs/engines-53","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"VoxCPM","locale":"en"},"15867":{"id":"/en/docs/engines-54","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`v2`, `v1_5`, `v1`","locale":"en"},"15868":{"id":"/en/docs/engines-55","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/voxcpm`","locale":"en"},"15869":{"id":"/en/docs/engines-56","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical to upstream's own package in all 27 stack cases, in bf16 and fp32","locale":"en"},"15870":{"id":"/en/docs/engines-57","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`full`, `lora`","locale":"en"},"15871":{"id":"/en/docs/engines-58","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Speech recognition","locale":"en"},"15872":{"id":"/en/docs/engines-59","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`whisper`","locale":"en"},"15873":{"id":"/en/docs/engines-60","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"`mizuoto/engines/asr`","locale":"en"},"15874":{"id":"/en/docs/engines-61","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"identical transcripts on 63 clips","locale":"en"},"15875":{"id":"/en/docs/engines-62","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"none","locale":"en"},"15876":{"id":"/en/docs/engines-63","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-engines","content":"Every trainer gives upstream's losses, learning rates and saved weights byte for byte on the CPU when both are seeded alike, and each implementation loads the other's exports (and, but for CosyVoice's voice prompt, speaks them identically). The contract suite (the real models through the whole stack) passes for every engine on the CPU: Qwen3-TTS 24 tests, F5-TTS 12, OmniVoice 12, CosyVoice 18, Fish Speech 6, IndexTTS 18, GPT-SoVITS 24, VoxCPM 18.","locale":"en"},"15877":{"id":"/en/docs/engines-64","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"For seven engines the reference is **Mizuoto 0.1** (git tag `v1-engine-workers`). 0.1 ran each upstream project's own code, in an environment of its own, behind a small adapter; \"identical to 0.1\" therefore means identical to upstream as Mizuoto drove it, adapter choices included (how text is segmented, the order of chunks, how parameters map). Where 0.1's adapter and upstream differed, 0.1's behaviour is the one kept: F5-TTS generates a long text's chunks in order, GPT-SoVITS scales its pauses as the adapter did.","locale":"en"},"15878":{"id":"/en/docs/engines-65","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"Two engines have another reference:","locale":"en"},"15879":{"id":"/en/docs/engines-66","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"**VoxCPM** came after 0.1. Its reference is upstream's own package (the commit the manifest pins), run behind an adapter in the same Mizuoto stack, with the library versions upstream locks.","locale":"en"},"15880":{"id":"/en/docs/engines-67","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-reference","content":"**CosyVoice** is compared with upstream running on torch 2.8, not on the torch 2.3.1 it was released with: upstream on 2.3.1 and upstream on 2.8 disagree with each other (sampling diverges; voice conversion matches to 62 dB), and Mizuoto needs torch 2.8 or newer.","locale":"en"},"15881":{"id":"/en/docs/engines-68","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#the-conditions","content":"CPU, fp32 (VoxCPM also bf16, its default), the same seed, the same torch release and the same thread count (CPU kernels split their sums by it). The CPU is where the claim is made because any difference in a logit can flip a sampling draw or a beam choice, after which everything diverges; on a GPU in reduced precision, kernels change with shapes and upstream does not even agree with itself (a batch against single requests). On the CPU in fp32 the computation is deterministic, so a port that does exactly what upstream does gives exactly upstream's bits.","locale":"en"},"15882":{"id":"/en/docs/engines-69","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Tier","locale":"en"},"15883":{"id":"/en/docs/engines-70","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"What is compared","locale":"en"},"15884":{"id":"/en/docs/engines-71","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Passes when","locale":"en"},"15885":{"id":"/en/docs/engines-72","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T0 operation","locale":"en"},"15886":{"id":"/en/docs/engines-73","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"DSP, samplers, tokenizers, normalisers, g2p","locale":"en"},"15887":{"id":"/en/docs/engines-74","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"identical: `torch.equal`, the same ids, the same strings","locale":"en"},"15888":{"id":"/en/docs/engines-75","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T1 module","locale":"en"},"15889":{"id":"/en/docs/engines-76","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"each module with the real weights on captured inputs","locale":"en"},"15890":{"id":"/en/docs/engines-77","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"max abs error ≤ 1e-5 × max(1, ‖ref‖∞), cosine ≥ 0.99999","locale":"en"},"15891":{"id":"/en/docs/engines-78","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T2 stage","locale":"en"},"15892":{"id":"/en/docs/engines-79","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"teacher-forced logits; discrete outputs from captured inputs (speech-tokenizer codes, VQ codes)","locale":"en"},"15893":{"id":"/en/docs/engines-80","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"argmax agreement 100 %; discrete agreement ≥ 99.9 % with every flip explained","locale":"en"},"15894":{"id":"/en/docs/engines-81","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"T3 end to end","locale":"en"},"15895":{"id":"/en/docs/engines-82","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"a whole seeded request through Mizuoto's stack","locale":"en"},"15896":{"id":"/en/docs/engines-83","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"identical tokens; audio identical, or max abs error ≤ 1e-4","locale":"en"},"15897":{"id":"/en/docs/engines-84","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Every engine above is identical at T3, with no error at all, except CosyVoice when each side makes its own voice prompt. Four opt-in paths are held to less: `compute.compile` (within 1e-4, except CosyVoice, whose vocoder amplifies float differences), Qwen3-TTS's `fused_projections` (identical on the CPU, not on a GPU) OmniVoice's `packed_guidance` (identical on the CPU in the parity cases; another take of the request on a GPU) and VoxCPM's `attention_span` (identical on the CPU, another take on a GPU).","locale":"en"},"15898":{"id":"/en/docs/engines-85","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"Behaviour is compared along with the audio: the parameters applied and the warnings, the voice mode chosen, the segments, the streamed chunks' lengths, the sample rate and the error codes of invalid requests.","locale":"en"},"15899":{"id":"/en/docs/engines-86","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"**Training** is identical when, seeded alike, every step's losses, learning rates and other metrics, and the saved weights, equal upstream's. Upstream rarely seeds everything (0.1 never did), so the reference is upstream with its generators seeded the way the native training stage seeds them.","locale":"en"},"15900":{"id":"/en/docs/engines-87","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#tiers","content":"**On a GPU** there is no sample-level comparison with upstream. What a GPU checks is that Mizuoto's own speed paths change nothing: CUDA graphs and the decoding loops that wait for the device once per step give the same tokens and audio as the plain eager code on the same GPU.","locale":"en"},"15901":{"id":"/en/docs/engines-88","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**The parity harness** (`scripts/parity/`) runs cases through a whole Mizuoto stack with either implementation and compares the runs: `stack.py run <cases> --impl reference|native` (VoxCPM: `--impl upstream|native`), `compare.py <engine>`, and `train.py run|compare` for the trainers. The cases are `scripts/parity/cases/<engine>.jsonl` (74 in all); the environments, clips, fixtures and reports live outside the repository in `MIZUOTO_PARITY_DIR`. The reference is first compared with a repeat of itself: a case that does not repeat cannot judge the port. Its commands are in Testing.","locale":"en"},"15902":{"id":"/en/docs/engines-89","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**Component checks**: `scripts/parity/check_tokenizer.py` (the BPE against transformers' tokenizer), `scripts/parity/dsp_fixtures.py` (the DSP against torchaudio, librosa, Whisper and soxr, kept as `tests/fixtures/dsp/*.npz`), `scripts/parity/check_rng.py` (explicit generators against the seeded default stream), and per-engine module scripts such as `voxcpm_modules.py`.","locale":"en"},"15903":{"id":"/en/docs/engines-90","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**In CI**: `tests/engines_native/` runs every engine and trainer on a tiny random model of its own architecture, also with its weights streamed, half streamed and not streamed on a simulated device, which must give the same output; `tests/runtime/test_dsp.py` checks the DSP against its fixtures.","locale":"en"},"15904":{"id":"/en/docs/engines-91","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#how-it-is-checked","content":"**The contract suite** (`python scripts/dev.py test-engines`) drives the installed real models through planning, jobs and the runtime: every voice mode audible and intelligible (WER under 0.35 by speech recognition), seeds that repeat, segments, cancelling, and no residue in the process.","locale":"en"},"15905":{"id":"/en/docs/engines-92","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Upstream's computation, in its order and shapes.** Batching changes floating-point sums, so a port keeps upstream's tensor shapes even where a simpler form would do (three embeddings looked up in one call, a cache grown by concatenation, SDPA called with the same arguments transformers passed).","locale":"en"},"15906":{"id":"/en/docs/engines-93","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Randomness from the request.** Every draw comes from `ctx.generator_for(device)` or `ctx.rng`, never from torch's global generator. A fresh `torch.Generator` seeded with *s* gives the same stream as the default generator after `torch.manual_seed(s)`, on the CPU and on CUDA (`check_rng.py`), so drawing upstream's draws in upstream's order reproduces upstream's seeded run. Where upstream draws while it builds a model (default initialisations that consume the global generator), the port replays those draws on a private generator when their values matter (CosyVoice 3's vocoder noise, the trainers' initialisations) or jumps the generator over them (Fish Speech's trainer).","locale":"en"},"15907":{"id":"/en/docs/engines-94","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**No process-wide state.** No environment variables, working folder, `sys.path`, `torch.backends` flags, global seeds or logging configuration are changed; `tests/test_architecture.py` forbids it and the contract suite checks a digest of the process state before and after requests (the `mizuoto.snapshot` operation).","locale":"en"},"15908":{"id":"/en/docs/engines-95","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Libraries' numerics, reproduced.** `mizuoto.nn.dsp` is bit-exact with what upstream called: torchaudio (2.3.1 and 2.8.0), librosa (0.10, 0.11, 1.0), openai-whisper, soxr as `librosa.resample` calls it, Matcha-TTS's mel, the ffmpeg program's resampler and soundfile's WAV. `mizuoto.text.tokenize.bpe` gives transformers' ids for the Qwen2-family tokenizers; normalisers apply the original FSTs with kaldifst; ONNX weights are read from the protobuf without onnx.","locale":"en"},"15909":{"id":"/en/docs/engines-96","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Strict checkpoints.** A missing or unexpected key is an error; upstream sometimes kept random weights for missing keys.","locale":"en"},"15910":{"id":"/en/docs/engines-97","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"**Loading outside inference mode**, requests inside it (below).","locale":"en"},"15911":{"id":"/en/docs/engines-98","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#rules-every-engine-keeps","content":"Both were found while comparing E2-TTS: `F.linear` on a strided (non-contiguous) 3-D input takes another CPU kernel, with other rounding, when its weight requires grad, or when the weight is an *inference tensor* (made inside `torch.inference_mode()`), even under `no_grad`. Upstream's weights are ordinary parameters that require grad. So native engines leave parameters as `nn.Module` makes them (no `requires_grad_(False)`), and models are loaded outside inference mode; requests still run inside it.","locale":"en"},"15912":{"id":"/en/docs/engines-99","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Module","locale":"en"},"15913":{"id":"/en/docs/engines-100","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"What it is","locale":"en"},"15914":{"id":"/en/docs/engines-101","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Engines","locale":"en"},"15915":{"id":"/en/docs/engines-102","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`runtime/lm/qwen.py`, `runtime/lm/cache.py`","locale":"en"},"15916":{"id":"/en/docs/engines-103","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"The Qwen2/Qwen3 decoder with transformers' numerics (`hf_sdpa`, `mask_for`), `DynamicCache` and the optional preallocated `BufferCache`","locale":"en"},"15917":{"id":"/en/docs/engines-104","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen3-TTS, OmniVoice, CosyVoice 2/3, IndexTTS's emotion model;