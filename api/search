927":{"id":"/en/docs/engines-114","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/transformer/`","locale":"en"},"15928":{"id":"/en/docs/engines-115","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5's DiT (`dit.py`), E2's UNetT, wenet's Conformer, Seed-VC's DiT, VITS, BERT","locale":"en"},"15929":{"id":"/en/docs/engines-116","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5-TTS, CosyVoice, GPT-SoVITS, IndexTTS","locale":"en"},"15930":{"id":"/en/docs/engines-117","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/flow/`","locale":"en"},"15931":{"id":"/en/docs/engines-118","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5's CFM with torchdiffeq's fixed grids, Matcha's U-Net, coupling flows","locale":"en"},"15932":{"id":"/en/docs/engines-119","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5-TTS, CosyVoice, GPT-SoVITS","locale":"en"},"15933":{"id":"/en/docs/engines-120","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/vocoders/`","locale":"en"},"15934":{"id":"/en/docs/engines-121","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Vocos, HiFT v1–v3, BigVGAN v1/v2, HiFi-GAN","locale":"en"},"15935":{"id":"/en/docs/engines-122","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"F5-TTS, IndexTTS, CosyVoice, GPT-SoVITS","locale":"en"},"15936":{"id":"/en/docs/engines-123","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/codecs/`","locale":"en"},"15937":{"id":"/en/docs/engines-124","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"DAC, the s3tokenizer speech tokenizers built from their ONNX files, RepCodec","locale":"en"},"15938":{"id":"/en/docs/engines-125","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"OmniVoice, CosyVoice, IndexTTS","locale":"en"},"15939":{"id":"/en/docs/engines-126","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/ssl/`, `nn/speaker/`","locale":"en"},"15940":{"id":"/en/docs/engines-127","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"HuBERT, w2v-BERT 2.0; CAM++ (as CosyVoice's ONNX graph has it, and as 3D-Speaker's code), ECAPA, MelStyle","locale":"en"},"15941":{"id":"/en/docs/engines-128","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"OmniVoice, GPT-SoVITS, IndexTTS, CosyVoice","locale":"en"},"15942":{"id":"/en/docs/engines-129","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`nn/dsp/`","locale":"en"},"15943":{"id":"/en/docs/engines-130","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Mel filterbanks, kaldi fbank, resamplers, WAV and FLAC, the tiled decoding used as a memory fallback","locale":"en"},"15944":{"id":"/en/docs/engines-131","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"all","locale":"en"},"15945":{"id":"/en/docs/engines-132","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"`text/tokenize/`, `text/normalize/`","locale":"en"},"15946":{"id":"/en/docs/engines-133","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen2-family BPE, Whisper's tiktoken vocabulary, wetext's normaliser over kaldifst","locale":"en"},"15947":{"id":"/en/docs/engines-134","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"Qwen3-TTS, OmniVoice, Fish Speech, CosyVoice, IndexTTS, VoxCPM","locale":"en"},"15948":{"id":"/en/docs/engines-135","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#shared-building-blocks","content":"How the runtime places these models in memory, streams their weights and retries after running out of memory is in Runtime; the settings that turn on the speed paths are in Performance.","locale":"en"},"15949":{"id":"/en/docs/engines-136","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#licence-gated-engines","content":"Fish Speech and IndexTTS are ports of code whose licences (the Fish Audio Research License and, for Drama 3, the Fish Audio Community License; the bilibili Model Use License) also cover the port. They are therefore separate distributions, `mizuoto-fishspeech` and `mizuoto-indextts`, each shipping its licence, installed into the same environment and registered under the entry-point group `mizuoto.engines`. Their manifests ship with `mizuoto`, so the catalogue and the licence text are there before the distribution is installed. They follow the same rules as the built-in engines and import nothing from another engine.","locale":"en"},"15950":{"id":"/en/docs/engines-137","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#limitations","content":"Exactness is established on the CPU. GPU runs are checked for identical results between Mizuoto's own fast and plain paths, not sample for sample against upstream.","locale":"en"},"15951":{"id":"/en/docs/engines-138","page_id":"/en/docs/engines","tags":[],"type":"text","url":"/en/docs/engines#limitations","content":"CUDA graphs run on NVIDIA GPUs only. Every engine declares AMD (ROCm), Intel (XPU) and Apple (MPS) GPUs, but none has been run on that hardware yet.","locale":"en"},"15952":{"id":"/en/docs/first-run","page_id":"/en/docs/first-run","type":"page","content":"First run","breadcrumbs":["Mizuoto Documentation","Getting started"],"tags":[],"url":"/en/docs/first-run","locale":"en"},"15953":{"id":"/en/docs/first-run-0","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run","content":"Where you start, checking torch and the engines, downloading models, licence-gated engines, and the first real synthesis.","locale":"en"},"15954":{"id":"/en/docs/first-run-1","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#where-you-start","content":"Where you start","locale":"en"},"15955":{"id":"/en/docs/first-run-2","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#torch-and-the-engines","content":"Torch and the engines","locale":"en"},"15956":{"id":"/en/docs/first-run-3","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#speech-recognition","content":"Speech recognition","locale":"en"},"15957":{"id":"/en/docs/first-run-4","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#downloading-models","content":"Downloading models","locale":"en"},"15958":{"id":"/en/docs/first-run-5","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#licence-gated-engines","content":"Licence-gated engines","locale":"en"},"15959":{"id":"/en/docs/first-run-6","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#the-first-synthesis","content":"The first synthesis","locale":"en"},"15960":{"id":"/en/docs/first-run-7","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run","content":"With Mizuoto installed and `mizuoto webui` running, this page takes you through the first use: where to start, checking torch and the engines, what a model download does, the licence-gated engines, and finally the first synthesis. Each step is given for the web UI and the command line.","locale":"en"},"15961":{"id":"/en/docs/first-run-8","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"The UI opens on **Speak**. Nothing has to be set up first: the dummy engine works right away (it speaks in tones), so you can look around before downloading anything. Three places matter for a real engine:","locale":"en"},"15962":{"id":"/en/docs/first-run-9","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"Where","locale":"en"},"15963":{"id":"/en/docs/first-run-10","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"What to do there","locale":"en"},"15964":{"id":"/en/docs/first-run-11","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"**Settings › Downloads**","locale":"en"},"15965":{"id":"/en/docs/first-run-12","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"Choose the **Download source**: **Hugging Face**, **hf-mirror.com** or **ModelScope** (the last two are often faster in mainland China), or **Custom**","locale":"en"},"15966":{"id":"/en/docs/first-run-13","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"**Settings › Compute**","locale":"en"},"15967":{"id":"/en/docs/first-run-14","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"This machine's devices, each GPU's memory, and the torch in use with its build, such as `torch 2.8.0 (cu128)`. When torch is missing or its build does not suit this computer, it names the right build and shows the command that installs it (`mizuoto doctor` says the same)","locale":"en"},"15968":{"id":"/en/docs/first-run-15","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"**Models**","locale":"en"},"15969":{"id":"/en/docs/first-run-16","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"Every catalogue model with its engine, size, GPU memory and state, and a **Download** button; see Downloading models","locale":"en"},"15970":{"id":"/en/docs/first-run-17","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"On **Speak**, a model that is not downloaded yet replaces the **Speak** button with the one that downloads it. Downloads are jobs, so you can leave the page at any time.","locale":"en"},"15971":{"id":"/en/docs/first-run-18","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#where-you-start","content":"The models of Fish Speech and IndexTTS cannot be downloaded until their licences are accepted. See Licence-gated engines below.","locale":"en"},"15972":{"id":"/en/docs/first-run-19","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"Every engine is part of Mizuoto and runs in the server's own process: there is nothing to install per engine. An engine is **Available** when torch is installed (the dummy engine needs none) and its implementation is there: built in, or for Fish Speech and IndexTTS their own distribution (`mizuoto-fishspeech`, `mizuoto-indextts`). Otherwise its card under **Models › Engines** says **Not available** and what it needs, and the model picker marks its models **Not available**.","locale":"en"},"15973":{"id":"/en/docs/first-run-20","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"To fix it, install what is missing into Mizuoto's Python, then restart Mizuoto:","locale":"en"},"15974":{"id":"/en/docs/first-run-21","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"torch: the build `mizuoto doctor` names, such as `pip install \"torch>=2.8\" --index-url https://download.pytorch.org/whl/cu128` (the commands for each platform are in Installation).","locale":"en"},"15975":{"id":"/en/docs/first-run-22","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"A licence-gated engine: its distribution, such as `pip install mizuoto-indextts`.","locale":"en"},"15976":{"id":"/en/docs/first-run-23","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"On **Speak**, a model whose engine is not available replaces the button at the bottom with the command that installs what it needs. The command line:","locale":"en"},"15977":{"id":"/en/docs/first-run-24","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#torch-and-the-engines","content":"Some languages need an optional extra (GPT-SoVITS's Japanese and Korean, IndexTTS-2.5's Japanese); `mizuoto doctor` lists the missing ones with their install command, see Optional extras.","locale":"en"},"15978":{"id":"/en/docs/first-run-25","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#speech-recognition","content":"To clone a voice, models usually need the reference clip's transcript. With the speech recognition model downloaded, missing transcripts are filled in:","locale":"en"},"15979":{"id":"/en/docs/first-run-26","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#speech-recognition","content":"In the UI it is the engine marked **Used by Mizuoto itself** under **Models › Engines**; its model is under **Models › Models**.","locale":"en"},"15980":{"id":"/en/docs/first-run-27","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"Under **Models › Models** the models are grouped by engine, one row each with its size, GPU memory and state: **Not downloaded**, **Downloading**, **Partly downloaded**, **Installed** or **Damaged**. Click **Download**; while it runs the row shows the amount done, the speed and the time left.","locale":"en"},"15981":{"id":"/en/docs/first-run-28","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"Files are downloaded into `.part` files and resume after an interruption; each finished file is checked against its size and SHA-256.","locale":"en"},"15982":{"id":"/en/docs/first-run-29","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"When a source lacks a file or serves it wrong, the next source is tried (the one in the settings first, then Hugging Face, hf-mirror and ModelScope).","locale":"en"},"15983":{"id":"/en/docs/first-run-30","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"Files several models of an engine share (GPT-SoVITS's encoders, for example) are downloaded with the first model that needs them; the **Shared files** tab lists them.","locale":"en"},"15984":{"id":"/en/docs/first-run-31","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"On **Speak**, after choosing a model, the button at the bottom offers **Download** *model* *(size)*.","locale":"en"},"15985":{"id":"/en/docs/first-run-32","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#downloading-models","content":"The command line:","locale":"en"},"15986":{"id":"/en/docs/first-run-33","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"The licences of Fish Speech (Fish Audio Research License) and IndexTTS (bilibili Model Use License) restrict their use. Each is a distribution of its own (`mizuoto-fishspeech`, `mizuoto-indextts`, see Installation), and downloading its models and shared files and speaking both need the licence accepted first.","locale":"en"},"15987":{"id":"/en/docs/first-run-34","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"Open **Models › Engines** and click **Accept the licence** on the engine's card (or, on **Speak** with one of its models chosen, **Accept the** *engine* **licence** at the bottom).","locale":"en"},"15988":{"id":"/en/docs/first-run-35","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"The dialog shows the licence's full text and a link to the original. Read it, then check **I have read and accept this licence**.","locale":"en"},"15989":{"id":"/en/docs/first-run-36","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"Click **Accept the licence**. The card shows **Licence accepted** and its models can be downloaded.","locale":"en"},"15990":{"id":"/en/docs/first-run-37","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"The command line:","locale":"en"},"15991":{"id":"/en/docs/first-run-38","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"You accept a specific version of the licence; a new version must be accepted again. Also:","locale":"en"},"15992":{"id":"/en/docs/first-run-39","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"IndexTTS results show the licence's notice beneath them: cloning a voice without its owner's permission is forbidden by the IndexTTS disclaimer.","locale":"en"},"15993":{"id":"/en/docs/first-run-40","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"Fish Speech results show \"Built with Fish Audio\" beneath them, and cannot be used as training data for other engines.","locale":"en"},"15994":{"id":"/en/docs/first-run-41","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#licence-gated-engines","content":"F5-TTS needs no acceptance, but its pretrained weights (CC-BY-NC-4.0) are for non-commercial use; its results carry that licence's tag.","locale":"en"},"15995":{"id":"/en/docs/first-run-42","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#the-first-synthesis","content":"Once the model is downloaded, open **Speak**, choose it and a voice, type some text and click **Speak**. Speak explains every option.","locale":"en"},"15996":{"id":"/en/docs/first-run-43","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#the-first-synthesis","content":"The first synthesis loads the model into the server's process, which takes a while; then the model stays in memory until it has been idle for the time set under **Settings › Compute**. When the GPU has less free memory than the model needs, Mizuoto fails at once with **The GPU is not available or ran out of memory**, and **What to do** says how to fix it, such as another device or freeing GPU memory.","locale":"en"},"15997":{"id":"/en/docs/guide-history","page_id":"/en/docs/guide-history","type":"page","content":"History","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-history","locale":"en"},"15998":{"id":"/en/docs/guide-history-0","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history","content":"The History screen: every result, to search, filter by model, mark as favourite, run again, download and delete.","locale":"en"},"15999":{"id":"/en/docs/guide-history-1","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#finding-results","content":"Finding results","locale":"en"},"16000":{"id":"/en/docs/guide-history-2","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#each-result","content":"Each result","locale":"en"},"16001":{"id":"/en/docs/guide-history-3","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#where-the-files-are","content":"Where the files are","locale":"en"},"16002":{"id":"/en/docs/guide-history-4","page_id":"/en/docs/guide-history","type":"heading","tags":[],"url":"/en/docs/guide-history#command-line","content":"Command line","locale":"en"},"16003":{"id":"/en/docs/guide-history-5","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history","content":"**History** lists every result, newest first: from Speak, the tries on voice pages, design candidates, conversions and edits from Tools, training previews, and the files projects export.","locale":"en"},"16004":{"id":"/en/docs/guide-history-6","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history","content":"The takes of a project's lines are **not** listed here; they are managed on the project's page (see Projects). Files **exported** from a project or a chapter are listed.","locale":"en"},"16005":{"id":"/en/docs/guide-history-7","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"Three filters at the top, which combine:","locale":"en"},"16006":{"id":"/en/docs/guide-history-8","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"**Search the text**: the result's text or name;","locale":"en"},"16007":{"id":"/en/docs/guide-history-9","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"**Model**: **All models**, or one model;","locale":"en"},"16008":{"id":"/en/docs/guide-history-10","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"**Favourites**: favourites only.","locale":"en"},"16009":{"id":"/en/docs/guide-history-11","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#finding-results","content":"The list loads 50 at a time; at the bottom, **Load more** loads the next.","locale":"en"},"16010":{"id":"/en/docs/guide-history-12","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Each shows its text (or name), length, waveform (click or drag to seek), model, time taken, real-time factor (RTF) and seed, with any warnings and licence notices (such as Fish Speech's \"Built with Fish Audio\"). Its menu:","locale":"en"},"16011":{"id":"/en/docs/guide-history-13","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Action","locale":"en"},"16012":{"id":"/en/docs/guide-history-14","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"What it does","locale":"en"},"16013":{"id":"/en/docs/guide-history-15","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Favourite** / **Not a favourite**","locale":"en"},"16014":{"id":"/en/docs/guide-history-16","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Mark it, for the **Favourites** filter","locale":"en"},"16015":{"id":"/en/docs/guide-history-17","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Download**","locale":"en"},"16016":{"id":"/en/docs/guide-history-18","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Download the file","locale":"en"},"16017":{"id":"/en/docs/guide-history-19","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Show in folder**","locale":"en"},"16018":{"id":"/en/docs/guide-history-20","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Open its folder on the server (only in a browser on the server machine)","locale":"en"},"16019":{"id":"/en/docs/guide-history-21","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Analyse**","locale":"en"},"16020":{"id":"/en/docs/guide-history-22","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Its spectrogram (a voice's high-frequency cut-off, noise, clicks) and pitch curve (octave jumps, monotone stretches), with its format, median pitch and how much of it is voiced; computed on the server once, then cached","locale":"en"},"16021":{"id":"/en/docs/guide-history-23","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Use as a reference clip**","locale":"en"},"16022":{"id":"/en/docs/guide-history-24","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Open Speak with this result as **A clip**, its text as the transcript","locale":"en"},"16023":{"id":"/en/docs/guide-history-25","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Keep as a voice**","locale":"en"},"16024":{"id":"/en/docs/guide-history-26","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Type the **Name of the new voice** to put it in the library","locale":"en"},"16025":{"id":"/en/docs/guide-history-27","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Run again with these settings**","locale":"en"},"16026":{"id":"/en/docs/guide-history-28","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Open Speak with the model, voice, text and parameters that made it (the same seed when one was set); for results of a synthesis","locale":"en"},"16027":{"id":"/en/docs/guide-history-29","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"**Delete**","locale":"en"},"16028":{"id":"/en/docs/guide-history-30","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"Delete the result and its file","locale":"en"},"16029":{"id":"/en/docs/guide-history-31","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#each-result","content":"With more than one result listed, **Download all** downloads them together.","locale":"en"},"16030":{"id":"/en/docs/guide-history-32","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#where-the-files-are","content":"Result files are in `outputs/` in the data folder (change it under **Settings › Storage › Results**); where each came from (model, parameters, timings, licence tags) is recorded in the database.","locale":"en"},"16031":{"id":"/en/docs/guide-history-33","page_id":"/en/docs/guide-history","tags":[],"type":"text","url":"/en/docs/guide-history#where-the-files-are","content":"The data folder can be moved, renamed or copied: start Mizuoto with the new location (`MIZUOTO_DATA_DIR`, or `mizuoto webui --data-dir`) and every result plays from there. A result whose file is gone shows **File missing**; `mizuoto output check` lists such results, and `--prune-missing` removes them.","locale":"en"},"16032":{"id":"/en/docs/guide-models","page_id":"/en/docs/guide-models","type":"page","content":"Models","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-models","locale":"en"},"16033":{"id":"/en/docs/guide-models-0","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models","content":"The Models screen: download, verify, delete and import catalogue models; engine cards (availability, device, precision, enabled, options, checks, licence); and shared files.","locale":"en"},"16034":{"id":"/en/docs/guide-models-1","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#models","content":"Models","locale":"en"},"16035":{"id":"/en/docs/guide-models-2","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#import-a-model-folder","content":"Import a model folder","locale":"en"},"16036":{"id":"/en/docs/guide-models-3","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#engines","content":"Engines","locale":"en"},"16037":{"id":"/en/docs/guide-models-4","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#device-precision-enabled","content":"Device, precision, enabled","locale":"en"},"16038":{"id":"/en/docs/guide-models-5","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#options","content":"Options","locale":"en"},"16039":{"id":"/en/docs/guide-models-6","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#check-this-machine","content":"Check this machine","locale":"en"},"16040":{"id":"/en/docs/guide-models-7","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#licence","content":"Licence","locale":"en"},"16041":{"id":"/en/docs/guide-models-8","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#shared-files","content":"Shared files","locale":"en"},"16042":{"id":"/en/docs/guide-models-9","page_id":"/en/docs/guide-models","type":"heading","tags":[],"url":"/en/docs/guide-models#command-line","content":"Command line","locale":"en"},"16043":{"id":"/en/docs/guide-models-10","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models","content":"**Models** has three tabs: **Models** (each engine's catalogue), **Engines** (each engine's availability and settings) and **Shared files** (files several models of an engine share).","locale":"en"},"16044":{"id":"/en/docs/guide-models-11","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Models are grouped by engine: speech engines first, then helpers such as speech recognition, the dummy engine last. When an engine is not available, its group says what it needs: *engine* **needs** *torch* **to use these models (mizuoto doctor).**","locale":"en"},"16045":{"id":"/en/docs/guide-models-12","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"One row per model, with its name, variant, size, GPU memory (**N GB of GPU memory**) and description, and its state:","locale":"en"},"16046":{"id":"/en/docs/guide-models-13","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"State","locale":"en"},"16047":{"id":"/en/docs/guide-models-14","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Meaning","locale":"en"},"16048":{"id":"/en/docs/guide-models-15","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Not downloaded**","locale":"en"},"16049":{"id":"/en/docs/guide-models-16","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Not downloaded yet","locale":"en"},"16050":{"id":"/en/docs/guide-models-17","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Downloading**","locale":"en"},"16051":{"id":"/en/docs/guide-models-18","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Being downloaded; shows the amount done, the speed and the time left","locale":"en"},"16052":{"id":"/en/docs/guide-models-19","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Partly downloaded**","locale":"en"},"16053":{"id":"/en/docs/guide-models-20","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"A folder that was not finished, or a shared file it needs is missing","locale":"en"},"16054":{"id":"/en/docs/guide-models-21","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Installed**","locale":"en"},"16055":{"id":"/en/docs/guide-models-22","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"Downloaded, every file checked","locale":"en"},"16056":{"id":"/en/docs/guide-models-23","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Damaged**","locale":"en"},"16057":{"id":"/en/docs/guide-models-24","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"A file's size differs, or a verification failed","locale":"en"},"16058":{"id":"/en/docs/guide-models-25","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Built in**","locale":"en"},"16059":{"id":"/en/docs/guide-models-26","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"The dummy engine's model; nothing to download","locale":"en"},"16060":{"id":"/en/docs/guide-models-27","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"What you can do:","locale":"en"},"16061":{"id":"/en/docs/guide-models-28","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Download** fetches the missing files. Downloads resume, every file is checked against its size and SHA-256, and when a source lacks a file the next source is tried (see Download sources). Shared files it needs come along.","locale":"en"},"16062":{"id":"/en/docs/guide-models-29","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"**Verify** computes the SHA-256 of every file of an installed model again. It says **All N files are intact**, or lists **Damaged:** *files*. Delete a damaged model and download it again.","locale":"en"},"16063":{"id":"/en/docs/guide-models-30","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#models","content":"The delete button deletes the model's files (asking **Delete** *model*? **It can be downloaded again.**).","locale":"en"},"16064":{"id":"/en/docs/guide-models-31","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"When you already have a model's files (an earlier download, a copy from elsewhere, a fine-tune), click **Import a model folder** and choose a folder on the server. The button shows only in a browser on the server machine.","locale":"en"},"16065":{"id":"/en/docs/guide-models-32","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"Mizuoto works out the engine and variant from the files:","locale":"en"},"16066":{"id":"/en/docs/guide-models-33","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"when the file sizes match a catalogue model, it checks their SHA-256 and imports the folder as that model;","locale":"en"},"16067":{"id":"/en/docs/guide-models-34","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"otherwise it imports it as a user model, `engine/folder-name`.","locale":"en"},"16068":{"id":"/en/docs/guide-models-35","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#import-a-model-folder","content":"The command line can name it, or move rather than copy: `mizuoto model import <folder> [--name name] [--move]`.","locale":"en"},"16069":{"id":"/en/docs/guide-models-36","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#engines","content":"One card per engine:","locale":"en"},"16070":{"id":"/en/docs/guide-models-37","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#engines","content":"Under the title, the number of models and the licence's name (speech recognition says **Used by Mizuoto itself**); at the right **Available** or **Not available**, and **On** *host* when the engine runs on a remote host.","locale":"en"},"16071":{"id":"/en/docs/guide-models-38","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#engines","content":"A line about the engine. When it is not available, what it needs: **Needs** *torch* (or *mizuoto-indextts*…)**, which is not installed: mizuoto doctor says how to install it.** Every engine is part of Mizuoto except the licence-gated ones, which are packages of their own (see First run).","locale":"en"},"16072":{"id":"/en/docs/guide-models-39","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"**Device**: **Automatic**, the devices of this machine the engine supports (such as `cuda:0`, `cpu`), and the devices of each remote host you added where the engine is available (shown as \"host · device\"). With a remote device the engine runs on that machine, the card shows **On** *host*, and its packages are managed there (see Remote hosts).","locale":"en"},"16073":{"id":"/en/docs/guide-models-40","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"**Precision**: **Automatic**, `bf16`, `fp16` or `fp32`.","locale":"en"},"16074":{"id":"/en/docs/guide-models-41","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"**Enabled**: when off, the engine's models cannot be used; Speak then offers an **Enable** button at the bottom.","locale":"en"},"16075":{"id":"/en/docs/guide-models-42","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#device-precision-enabled","content":"Changing these unloads the engine's models; the next use loads them with the new settings.","locale":"en"},"16076":{"id":"/en/docs/guide-models-43","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"When an engine has load options, its card has **Options**:","locale":"en"},"16077":{"id":"/en/docs/guide-models-44","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"Engine","locale":"en"},"16078":{"id":"/en/docs/guide-models-45","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"Options","locale":"en"},"16079":{"id":"/en/docs/guide-models-46","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"CosyVoice","locale":"en"},"16080":{"id":"/en/docs/guide-models-47","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`fp16`: half precision on the GPU, faster and slightly different; `fused_projections` (2 and 3): a fast mode, 1–5 % faster on a GPU, maybe no longer bit-identical","locale":"en"},"16081":{"id":"/en/docs/guide-models-48","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"IndexTTS 2 / 2.5","locale":"en"},"16082":{"id":"/en/docs/guide-models-49","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`use_qwen_emo` (the emotion model for described emotions, about 1.2 GB), `use_torch_compile`","locale":"en"},"16083":{"id":"/en/docs/guide-models-50","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"F5-TTS","locale":"en"},"16084":{"id":"/en/docs/guide-models-51","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`ode_method` (`euler` or `midpoint`)","locale":"en"},"16085":{"id":"/en/docs/guide-models-52","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"Qwen3-TTS","locale":"en"},"16086":{"id":"/en/docs/guide-models-53","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`fused_projections`: a fast mode, a few percent faster on a GPU, no longer bit-identical","locale":"en"},"16087":{"id":"/en/docs/guide-models-54","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"VoxCPM","locale":"en"},"16088":{"id":"/en/docs/guide-models-55","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"`attention_span`: a fast mode, 1.4–1.7× faster on a GPU, no longer bit-identical there","locale":"en"},"16089":{"id":"/en/docs/guide-models-56","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#options","content":"**Changes apply when the model loads next (its models are unloaded now).** The setting **Compile models (torch.compile)** under **Settings › Compute** speeds up several engines at once. More in Performance.","locale":"en"},"16090":{"id":"/en/docs/guide-models-57","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#check-this-machine","content":"Expand **Check this machine** for the engine's checks on this machine: torch and its build against the GPU, whether the engine is available, and the optional extras it can use (such as GPT-SoVITS's Japanese front end), with a command to fix each problem. The command line: `mizuoto doctor <engine>`.","locale":"en"},"16091":{"id":"/en/docs/guide-models-58","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#licence","content":"Licence-gated engines (Fish Speech, IndexTTS) have an **Accept the licence** button that opens the full licence; once accepted the card shows **Licence accepted**. See First run.","locale":"en"},"16092":{"id":"/en/docs/guide-models-59","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#shared-files","content":"**Files several models of an engine share, downloaded once with the first model that needs them.** For example GPT-SoVITS's encoders, G2PW, the NLTK data, the Open JTalk dictionary and the discriminators used for training; IndexTTS-2's w2v-BERT, semantic codec, CAM++ and BigVGAN; and CosyVoice's text normalisation grammars.","locale":"en"},"16093":{"id":"/en/docs/guide-models-60","page_id":"/en/docs/guide-models","tags":[],"type":"text","url":"/en/docs/guide-models#shared-files","content":"Each row shows the name, size, description and **used by** *models*. Each can be downloaded or deleted on its own. A model missing a shared file it needs shows as **Partly downloaded**. Shared files are kept in `models/_assets/<engine>/` in the data folder.","locale":"en"},"16094":{"id":"/en/docs/guide-projects","page_id":"/en/docs/guide-projects","type":"page","content":"Projects","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-projects","locale":"en"},"16095":{"id":"/en/docs/guide-projects-0","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"The Projects screen: a cast of voices reads a book, a script or a dialogue line by line; importing scripts, editing lines, rendering, takes and exporting audio with subtitles.","locale":"en"},"16096":{"id":"/en/docs/guide-projects-1","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#the-list","content":"The list","locale":"en"},"16097":{"id":"/en/docs/guide-projects-2","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#a-new-project","content":"A new project","locale":"en"},"16098":{"id":"/en/docs/guide-projects-3","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#the-script-format","content":"The script format","locale":"en"},"16099":{"id":"/en/docs/guide-projects-4","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#importing-a-script","content":"Importing a script","locale":"en"},"16100":{"id":"/en/docs/guide-projects-5","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#editing-the-script","content":"Editing the script","locale":"en"},"16101":{"id":"/en/docs/guide-projects-6","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#chapters","content":"Chapters","locale":"en"},"16102":{"id":"/en/docs/guide-projects-7","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#lines","content":"Lines","locale":"en"},"16103":{"id":"/en/docs/guide-projects-8","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#line-states","content":"Line states","locale":"en"},"16104":{"id":"/en/docs/guide-projects-9","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#cast","content":"Cast","locale":"en"},"16105":{"id":"/en/docs/guide-projects-10","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#rendering","content":"Rendering","locale":"en"},"16106":{"id":"/en/docs/guide-projects-11","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#takes","content":"Takes","locale":"en"},"16107":{"id":"/en/docs/guide-projects-12","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#export","content":"Export","locale":"en"},"16108":{"id":"/en/docs/guide-projects-13","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#deleting","content":"Deleting","locale":"en"},"16109":{"id":"/en/docs/guide-projects-14","page_id":"/en/docs/guide-projects","type":"heading","tags":[],"url":"/en/docs/guide-projects#command-line","content":"Command line","locale":"en"},"16110":{"id":"/en/docs/guide-projects-15","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"**Projects** are for long-form reading: a book, a script or a dialogue with several voices. A project has two parts:","locale":"en"},"16111":{"id":"/en/docs/guide-projects-16","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"**The script**: chapters, each a list of lines. Each line has its text and the speaker who says it, and may have its own style instruction.","locale":"en"},"16112":{"id":"/en/docs/guide-projects-17","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"**The cast**: each speaker has its own model, voice (a library voice, a preset speaker or the model's own voice), language, way of speaking and parameters. **The first speaker is the narrator**: lines without a speaker are theirs. A speaker without a model uses the project's.","locale":"en"},"16113":{"id":"/en/docs/guide-projects-18","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"Each line is rendered on its own, and each rendering is a **take**. After you change a line's text, speaker or settings, only that line needs rendering again; at the end the lines are joined, with the pauses you set, into one file with subtitles. Speakers may use models of different engines.","locale":"en"},"16114":{"id":"/en/docs/guide-projects-19","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects","content":"A project is saved in `projects/<name>/project.json` in the data folder.","locale":"en"},"16115":{"id":"/en/docs/guide-projects-20","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-list","content":"Open **Projects** in the navigation. Each card shows the project's name, rendered lines out of all lines (red when some failed), its description, **N chapter(s) · N line(s)**, **N speaker(s)**, the length of what is rendered and a bar coloured by the lines' states. Click a card to open the project.","locale":"en"},"16116":{"id":"/en/docs/guide-projects-21","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Click **New project**.","locale":"en"},"16117":{"id":"/en/docs/guide-projects-22","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Type the **Project name**.","locale":"en"},"16118":{"id":"/en/docs/guide-projects-23","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Choose the **Model**: the project's model, used by the narrator and by every speaker that names none.","locale":"en"},"16119":{"id":"/en/docs/guide-projects-24","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Optionally paste a script under **Script** (see the next section) and choose **Make a line of each**: **line of text** or **sentence**.","locale":"en"},"16120":{"id":"/en/docs/guide-projects-25","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"Click **Create**.","locale":"en"},"16121":{"id":"/en/docs/guide-projects-26","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#a-new-project","content":"A new project starts with one speaker, **Narrator**.","locale":"en"},"16122":{"id":"/en/docs/guide-projects-27","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"An imported script is plain text, with these rules (the hint under the box says the same):","locale":"en"},"16123":{"id":"/en/docs/guide-projects-28","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"You write","locale":"en"},"16124":{"id":"/en/docs/guide-projects-29","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"It means","locale":"en"},"16125":{"id":"/en/docs/guide-projects-30","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"`# Title`","locale":"en"},"16126":{"id":"/en/docs/guide-projects-31","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A new chapter, titled with the text after `#`","locale":"en"},"16127":{"id":"/en/docs/guide-projects-32","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"`Name: text` (`:` or `：`), or `[Name]: text`","locale":"en"},"16128":{"id":"/en/docs/guide-projects-33","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A line of that speaker (see the rules below)","locale":"en"},"16129":{"id":"/en/docs/guide-projects-34","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"Any other line","locale":"en"},"16130":{"id":"/en/docs/guide-projects-35","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A line of the narrator","locale":"en"},"16131":{"id":"/en/docs/guide-projects-36","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A blank line","locale":"en"},"16132":{"id":"/en/docs/guide-projects-37","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"The end of a paragraph (the pause after a paragraph is longer when exported)","locale":"en"},"16133":{"id":"/en/docs/guide-projects-38","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"A `Name:` prefix counts as a speaker only when one of these holds; otherwise the whole line, prefix included, is the narrator's:","locale":"en"},"16134":{"id":"/en/docs/guide-projects-39","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"the name is already in the cast;","locale":"en"},"16135":{"id":"/en/docs/guide-projects-40","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"the same name begins two or more lines;","locale":"en"},"16136":{"id":"/en/docs/guide-projects-41","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"the script is a dialogue (some name meets one of the two rules above) and the prefix **looks like a name**: it starts with a letter and has at most three words, such as `Dr. Watson` or `林黛玉`.","locale":"en"},"16137":{"id":"/en/docs/guide-projects-42","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"So in a script that is not a dialogue (no name recurs), an occasional \"Note: the power is off tomorrow\" does not become a speaker; but in a dialogue, any prefix that looks like a name does. A dialogue in which every name occurs only once is not recognised; add speakers with those names under **Cast** first, then import.","locale":"en"},"16138":{"id":"/en/docs/guide-projects-43","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"New names join the cast. They have no model or voice yet (they use the project's model); choose their voices under **Cast** after importing.","locale":"en"},"16139":{"id":"/en/docs/guide-projects-44","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"Lines before the first `#` go into one chapter: titled after the project when the project has no chapters yet, else untitled.","locale":"en"},"16140":{"id":"/en/docs/guide-projects-45","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"**Make a line of each**: with **line of text** each line of the script is one line; with **sentence** each is split further into its sentences.","locale":"en"},"16141":{"id":"/en/docs/guide-projects-46","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"An example:","locale":"en"},"16142":{"id":"/en/docs/guide-projects-47","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#the-script-format","content":"It imports as one chapter of six lines: \"Anna\" and \"Old man\" each begin two lines and become two new speakers; the other lines are the narrator's; the first line, the dialogue and the last line are three paragraphs.","locale":"en"},"16143":{"id":"/en/docs/guide-projects-48","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Click **Import a script** at the bottom of the project's page (or in the middle of an empty project), paste the script, choose how to split it and **Add it**:","locale":"en"},"16144":{"id":"/en/docs/guide-projects-49","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Choice","locale":"en"},"16145":{"id":"/en/docs/guide-projects-50","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"What it does","locale":"en"},"16146":{"id":"/en/docs/guide-projects-51","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"**as new chapters**","locale":"en"},"16147":{"id":"/en/docs/guide-projects-52","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Appends the script's chapters to the end of the project","locale":"en"},"16148":{"id":"/en/docs/guide-projects-53","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"**to this chapter**","locale":"en"},"16149":{"id":"/en/docs/guide-projects-54","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Appends every line to the chapter that is open, without making chapters (`#` headings are left out)","locale":"en"},"16150":{"id":"/en/docs/guide-projects-55","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"**instead of the script**","locale":"en"},"16151":{"id":"/en/docs/guide-projects-56","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Replaces every chapter with the script's; the old lines' takes are deleted","locale":"en"},"16152":{"id":"/en/docs/guide-projects-57","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#importing-a-script","content":"Click **Import**.","locale":"en"},"16153":{"id":"/en/docs/guide-projects-58","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#editing-the-script","content":"A project's page has three tabs: **Script**, **Cast** and **Export**. The top shows its name, the save state (**Saving…**, **Saved**, **Unsaved changes**) and rendered lines out of all, with their length.","locale":"en"},"16154":{"id":"/en/docs/guide-projects-59","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#editing-the-script","content":"Every change is saved a moment after you stop typing, and when you leave the page; there is nothing to save by hand.","locale":"en"},"16155":{"id":"/en/docs/guide-projects-60","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#chapters","content":"**Chapters** on the left lists the chapters, each with its rendered lines out of all; click one to open it. **Add a chapter** makes a new one. Above the lines are the **Chapter title** and a menu with **Move up**, **Move down** and **Delete the chapter** (its lines' takes are deleted too).","locale":"en"},"16156":{"id":"/en/docs/guide-projects-61","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"One row per line, from left to right:","locale":"en"},"16157":{"id":"/en/docs/guide-projects-62","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"a state dot (hover for the state's name; see the next section);","locale":"en"},"16158":{"id":"/en/docs/guide-projects-63","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Speaker**: who says the line; choosing the first speaker (the narrator) means no speaker;","locale":"en"},"16159":{"id":"/en/docs/guide-projects-64","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Text**: Ctrl+Enter in it inserts a line below;","locale":"en"},"16160":{"id":"/en/docs/guide-projects-65","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"a play button for the line's take in use;","locale":"en"},"16161":{"id":"/en/docs/guide-projects-66","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Render this line again**: renders a new take of this line now, even when it is current;","locale":"en"},"16162":{"id":"/en/docs/guide-projects-67","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"a menu:","locale":"en"},"16163":{"id":"/en/docs/guide-projects-68","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Item","locale":"en"},"16164":{"id":"/en/docs/guide-projects-69","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"What it does","locale":"en"},"16165":{"id":"/en/docs/guide-projects-70","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Insert a line below**","locale":"en"},"16166":{"id":"/en/docs/guide-projects-71","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"The new line keeps this line's speaker","locale":"en"},"16167":{"id":"/en/docs/guide-projects-72","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**End the paragraph here** / **Continue the paragraph**","locale":"en"},"16168":{"id":"/en/docs/guide-projects-73","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Where a paragraph ends, for the pauses when exported","locale":"en"},"16169":{"id":"/en/docs/guide-projects-74","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Add a style instruction**","locale":"en"},"16170":{"id":"/en/docs/guide-projects-75","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Shows **Style for this line**, used for this line instead of its speaker's **How it speaks**","locale":"en"},"16171":{"id":"/en/docs/guide-projects-76","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Move up** / **Move down**","locale":"en"},"16172":{"id":"/en/docs/guide-projects-77","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Reorder","locale":"en"},"16173":{"id":"/en/docs/guide-projects-78","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Try in Speak**","locale":"en"},"16174":{"id":"/en/docs/guide-projects-79","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Loads the line's whole request (model, voice, text, parameters) into Speak, to try things out","locale":"en"},"16175":{"id":"/en/docs/guide-projects-80","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Take N (s s)**","locale":"en"},"16176":{"id":"/en/docs/guide-projects-81","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"The line's takes, the one in use marked ✓; click one to use it","locale":"en"},"16177":{"id":"/en/docs/guide-projects-82","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Delete**","locale":"en"},"16178":{"id":"/en/docs/guide-projects-83","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"Deletes the line and its takes","locale":"en"},"16179":{"id":"/en/docs/guide-projects-84","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#lines","content":"**Add a line** at the end of the chapter appends a line. A line that failed shows why beneath it.","locale":"en"},"16180":{"id":"/en/docs/guide-projects-85","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"State","locale":"en"},"16181":{"id":"/en/docs/guide-projects-86","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"Meaning","locale":"en"},"16182":{"id":"/en/docs/guide-projects-87","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Rendered**","locale":"en"},"16183":{"id":"/en/docs/guide-projects-88","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"It has a take, made from its current text and settings","locale":"en"},"16184":{"id":"/en/docs/guide-projects-89","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Changed since its take**","locale":"en"},"16185":{"id":"/en/docs/guide-projects-90","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"It has a take, but its text, speaker, the speaker's model, voice or parameters changed since, or the library voice it uses was changed","locale":"en"},"16186":{"id":"/en/docs/guide-projects-91","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Not rendered**","locale":"en"},"16187":{"id":"/en/docs/guide-projects-92","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"No take yet","locale":"en"},"16188":{"id":"/en/docs/guide-projects-93","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Failed**","locale":"en"},"16189":{"id":"/en/docs/guide-projects-94","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"The last rendering failed; the reason shows beneath the line","locale":"en"},"16190":{"id":"/en/docs/guide-projects-95","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Rendering**","locale":"en"},"16191":{"id":"/en/docs/guide-projects-96","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"Being rendered","locale":"en"},"16192":{"id":"/en/docs/guide-projects-97","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"**Empty**","locale":"en"},"16193":{"id":"/en/docs/guide-projects-98","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#line-states","content":"No text; skipped when rendering and exporting","locale":"en"},"16194":{"id":"/en/docs/guide-projects-99","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"At the top of **Cast**, the **Project** part holds the project's **Model**, **Project name** and **Description**. Below it, one card per speaker:","locale":"en"},"16195":{"id":"/en/docs/guide-projects-100","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Speaker name**; the first speaker carries the **Narrator** badge; beside it the speaker's number of lines and a remove button. A removed speaker's lines go to the narrator.","locale":"en"},"16196":{"id":"/en/docs/guide-projects-101","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Model**: without one, its label reads **Model (the project's: …)**; with one, **Use the project's** goes back.","locale":"en"},"16197":{"id":"/en/docs/guide-projects-102","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"The voice: **Library voice**, **Preset speaker** or **Its own voice**, as the model supports. The library picker shows how this model can use each voice, as in Speak.","locale":"en"},"16198":{"id":"/en/docs/guide-projects-103","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Language**: **The project's language**, or one of the model's languages.","locale":"en"},"16199":{"id":"/en/docs/guide-projects-104","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**How it speaks**: a style instruction for each of this speaker's lines (only when the model takes instructions).","locale":"en"},"16200":{"id":"/en/docs/guide-projects-105","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Parameters**: the same panel as in Speak; it shows **N set** when you changed some.","locale":"en"},"16201":{"id":"/en/docs/guide-projects-106","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"A speaker's settings stay when its model (or the project's) changes, so choosing the first model again brings them back. Each line's request carries only the style instruction, parameters and engine options its model takes; the rest are kept but not used. A kept instruction the model does not follow (or not with this voice) says so under the field, and **Add a style instruction** is not offered for that speaker's lines. A preset speaker or a language the new model lacks is marked on the card: those decide what is said, so the lines fail until you choose again.","locale":"en"},"16202":{"id":"/en/docs/guide-projects-107","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"**Add a speaker** adds one. The project's own language is set under **Project** on the same tab (**Language**; **Each model decides** leaves it to each model), or with `mizuoto project set --lang`.","locale":"en"},"16203":{"id":"/en/docs/guide-projects-108","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#cast","content":"When a speaker's model, voice, language, way of speaking or parameters change, every rendered line of that speaker becomes **Changed since its take**. **Level each take** under Export is a rendering setting too: changing it makes every line stale.","locale":"en"},"16204":{"id":"/en/docs/guide-projects-109","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"Two buttons at the bottom of the page:","locale":"en"},"16205":{"id":"/en/docs/guide-projects-110","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"**Render chapter (N)**: renders every line of the open chapter that is not **Rendered** (not rendered, changed or failed).","locale":"en"},"16206":{"id":"/en/docs/guide-projects-111","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"**Render all (N)**: the same for the whole project.","locale":"en"},"16207":{"id":"/en/docs/guide-projects-112","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"Rendering is one **Render a project** job with a step per chapter. It submits an ordinary speak job per line and keeps up to 8 of them queued, so that **Settings › Speech › Run waiting requests together** can run lines with the same model, voice and settings, differing only in their text, as one batch (on engines that take batches, such as Qwen3-TTS, GPT-SoVITS and OmniVoice). Those speak jobs do not announce themselves one by one; the render announces itself once when it ends.","locale":"en"},"16208":{"id":"/en/docs/guide-projects-113","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"A failed line does not stop the others: it is marked **Failed** with the reason, and the rest go on.","locale":"en"},"16209":{"id":"/en/docs/guide-projects-114","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"Cancelling the render cancels the speak jobs it submitted.","locale":"en"},"16210":{"id":"/en/docs/guide-projects-115","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#rendering","content":"You can keep editing while it renders; a changed line is judged stale or not by its new contents.","locale":"en"},"16211":{"id":"/en/docs/guide-projects-116","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#takes","content":"Each rendering of a line adds a take and uses it at once. Up to 5 takes are kept per line; older ones not in use are deleted. **Take N** in the line's menu goes back to an earlier one.","locale":"en"},"16212":{"id":"/en/docs/guide-projects-117","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#takes","content":"Takes are FLAC results and are not listed in History. Deleting a line, a chapter or the project deletes their takes.","locale":"en"},"16213":{"id":"/en/docs/guide-projects-118","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"The **Export** tab:","locale":"en"},"16214":{"id":"/en/docs/guide-projects-119","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Setting","locale":"en"},"16215":{"id":"/en/docs/guide-projects-120","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Default","locale":"en"},"16216":{"id":"/en/docs/guide-projects-121","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"What it does","locale":"en"},"16217":{"id":"/en/docs/guide-projects-122","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Pause after a line (ms)**","locale":"en"},"16218":{"id":"/en/docs/guide-projects-123","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"350","locale":"en"},"16219":{"id":"/en/docs/guide-projects-124","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Silence between two lines of a paragraph","locale":"en"},"16220":{"id":"/en/docs/guide-projects-125","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Pause after a paragraph (ms)**","locale":"en"},"16221":{"id":"/en/docs/guide-projects-126","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"800","locale":"en"},"16222":{"id":"/en/docs/guide-projects-127","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Silence after a line that ends a paragraph","locale":"en"},"16223":{"id":"/en/docs/guide-projects-128","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Pause between chapters (ms)**","locale":"en"},"16224":{"id":"/en/docs/guide-projects-129","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"2000","locale":"en"},"16225":{"id":"/en/docs/guide-projects-130","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Silence between chapters when several are exported together","locale":"en"},"16226":{"id":"/en/docs/guide-projects-131","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Format**","locale":"en"},"16227":{"id":"/en/docs/guide-projects-132","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"WAV","locale":"en"},"16228":{"id":"/en/docs/guide-projects-133","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"WAV, FLAC, MP3, OGG, M4A","locale":"en"},"16229":{"id":"/en/docs/guide-projects-134","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Sample rate**","locale":"en"},"16230":{"id":"/en/docs/guide-projects-135","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"24000","locale":"en"},"16231":{"id":"/en/docs/guide-projects-136","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"Every take is resampled to it (speakers' models may differ in rate)","locale":"en"},"16232":{"id":"/en/docs/guide-projects-137","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**Level each take**","locale":"en"},"16233":{"id":"/en/docs/guide-projects-138","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**By loudness**","locale":"en"},"16234":{"id":"/en/docs/guide-projects-139","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#export","content":"**By loudness**, **By peak** or **As made**; applied when each line is rendered","locale":"en"},"16235":{"id":"/en/docs/guide-projects-140","page_id":"/en/docs/guide-pro