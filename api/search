project as a script that imports back","locale":"en"},"16259":{"id":"/en/docs/guide-projects-164","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project list`","locale":"en"},"16260":{"id":"/en/docs/guide-projects-165","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"List the projects","locale":"en"},"16261":{"id":"/en/docs/guide-projects-166","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"`mizuoto project delete <project>`","locale":"en"},"16262":{"id":"/en/docs/guide-projects-167","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"Move it to the trash","locale":"en"},"16263":{"id":"/en/docs/guide-projects-168","page_id":"/en/docs/guide-projects","tags":[],"type":"text","url":"/en/docs/guide-projects#command-line","content":"For example:","locale":"en"},"16264":{"id":"/en/docs/guide-settings","page_id":"/en/docs/guide-settings","type":"page","content":"Settings","breadcrumbs":["Mizuoto Documentation","Guides"],"tags":[],"url":"/en/docs/guide-settings","locale":"en"},"16265":{"id":"/en/docs/guide-settings-0","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings","content":"The parts of Settings: General, Compute, Remote hosts, Speech, Training, Downloads, Storage, Appearance and About.","locale":"en"},"16266":{"id":"/en/docs/guide-settings-1","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#general","content":"General","locale":"en"},"16267":{"id":"/en/docs/guide-settings-2","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#compute","content":"Compute","locale":"en"},"16268":{"id":"/en/docs/guide-settings-3","page_id":"/en/docs/guide-settings","type":"heading","tags":[