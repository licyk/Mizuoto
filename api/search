itecture-77","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`compute`","locale":"en"},"11758":{"id":"/en/docs/development-architecture-78","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`ComputeService`","locale":"en"},"11759":{"id":"/en/docs/development-architecture-79","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Device probe (nvidia-smi and friends, no torch), memory holders, release (after running out of memory: every GPU)","locale":"en"},"11760":{"id":"/en/docs/development-architecture-80","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`jobs`","locale":"en"},"11761":{"id":"/en/docs/development-architecture-81","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`JobService`","locale":"en"},"11762":{"id":"/en/docs/development-architecture-82","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Queue, named resources, persisted requests, retry, job workers","locale":"en"},"11763":{"id":"/en/docs/development-architecture-83","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`engines`","locale":"en"},"11764":{"id":"/en/docs/development-architecture-84","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`EngineRegistry`","locale":"en"},"11765":{"id":"/en/docs/development-architecture-85","page_id