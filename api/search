":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Datasets, experiments and the train job","locale":"en"},"11218":{"id":"/en/docs/development-architecture-116","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`projects`","locale":"en"},"11219":{"id":"/en/docs/development-architecture-117","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`ProjectService`","locale":"en"},"11220":{"id":"/en/docs/development-architecture-118","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Long-form projects: cast, chapters, lines and takes","locale":"en"},"11221":{"id":"/en/docs/development-architecture-119","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`remote`","locale":"en"},"11222":{"id":"/en/docs/development-architecture-120","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`RemoteService`","locale":"en"},"11223":{"id":"/en/docs/development-architecture-121","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Remote hosts running `mizuoto agent`","locale":"en"},"11224":{"id":"/en/docs/development-architecture-122","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Cross references (`runtime.remote`, `runtime.model_options = models.load_options`, `models.before_remove = runtime.unload_model`, `engines.inference`, `voices.tts`…) are attached after construction, which keeps the constructors free of cycles. Last, a settings listener is registered: any change to `engines.<id>.*` unloads that engine's models (`runtime.unload_engine`; the next request loads them with the new settings), a change to `remote.hosts.*` ends the sessions with the old host, and `settings_changed` and `engines_changed` are published.","locale":"en"},"11225":{"id":"/en/docs/development-architecture-123","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"The server (`mizuoto webui`)","locale":"en"},"11226":{"id":"/en/docs/development-architecture-124","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"The command line and Python","locale":"en"},"11227":{"id":"/en/docs/development-architecture-125","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Entry","locale":"en"},"11228":{"id":"/en/docs/development-architecture-126","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`build_services(start_background=True)`, kept on `app.state.services`; routes get it through `ServicesDep`","locale":"en"},"11229":{"id":"/en/docs/development-architecture-127","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"The `open_services()` context manager (the CLI's through `cli/output.py`), built once per command and closed after","locale":"en"},"11230":{"id":"/en/docs/development-architecture-128","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Background","locale":"en"},"11231":{"id":"/en/docs/development-architecture-129","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`jobs.start()` (the scheduler thread), `runtime.start()` (the idle reaper and throttled `runtime_changed` events)","locale":"en"},"11232":{"id":"/en/docs/development-architecture-130","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"None","locale":"en"},"11233":{"id":"/en/docs/development-architecture-131","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Jobs","locale":"en"},"11234":{"id":"/en/docs/development-architecture-132","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`jobs.submit()` queues; the scheduler runs by resources","locale":"en"},"11235":{"id":"/en/docs/development-architecture-133","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`jobs.run_now()` runs in the foreground on the calling thread, Ctrl+C cancels; models are unloaded in `Services.close()`","locale":"en"},"11236":{"id":"/en/docs/development-architecture-134","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Tests build fully isolated services with `environ=` (instead of `os.environ`), `data_dir=` and `settings_overrides=` (`make_services` in `tests/conftest.py`). The dummy engine runs in the test's own process, as every engine does.","locale":"en"},"11237":{"id":"/en/docs/development-architecture-135","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"Clicking **Speak** in the web UI:","locale":"en"},"11238":{"id":"/en/docs/development-architecture-136","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"Step by step:","locale":"en"},"11239":{"id":"/en/docs/development-architecture-137","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"**Plan before the queue.** `TtsService.plan()` checks the model's state, whether the engine is enabled and available, the licence, text, language, voice mode, references, parameters and device against the manifest, all before any job exists (GPU memory is not estimated: a model always tries to load); an error comes back at once with its code.","locale":"en"},"11240":{"id":"/en/docs/development-architecture-138","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"**The job.** `speak` holds `engine:<engine>:<device>` (capacity 1: a loaded engine serves one request at a time) and `gpu:<device>` when the device is not the CPU. The request is stored as JSON, so **retry** re-plans it after a restart.","locale":"en"},"11241":{"id":"/en/docs/development-architecture-139","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"**The model.** `RuntimeService.loaded(ModelRef(id, engine, variant, path), device, dtype, options, request)` returns the model's `EngineHandle`: a `LocalHandle` for this process, a `RemoteEngineHandle` for a device named `<host>/<device>`. It loads the model first unless it is loaded, after unloading others beyond `compute.max_resident_models`.","locale":"en"},"11242":{"id":"/en/docs/development-architecture-140","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"**The voice.** With a reference, `prepare_voice` writes the engine's voice state (prompt codes, embeddings) into the voice cache once per key, and later requests pass the files as `VoiceSpec.cache`.","locale":"en"},"11243":{"id":"/en/docs/development-architecture-141","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"**Synthesis.** `synthesize(task, request)` is a generator of `AudioChunk`s (float32 mono numpy samples, a sample rate, a segment index). The job drains it chunk by chunk (and hands each chunk to a `StreamSink` when the client streams); closing the generator stops the engine. One `SynthesisTask` per segment, or one batched task.","locale":"en"},"11244":{"id":"/en/docs/development-architecture-142","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"**The output.** The segments are joined with the segment pause, normalised, resampled to the output rate, encoded (PyAV) and recorded as an `Output` with the applied parameters, timings (load, first chunk, total, RTF) and licence tags.","locale":"en"},"11245":{"id":"/en/docs/development-architecture-143","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"**REST is the truth; the socket only pushes.** `SocketBridge` (`mizuoto/api/sockets.py`) subscribes to the `EventBus`, hands each event from the job thread to the event loop with `call_soon_threadsafe`, and emits it under its event name. Events carry snapshots, never live objects.","locale":"en"},"11246":{"id":"/en/docs/development-architecture-144","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-path-of-a-request","content":"The same path has a few more entrances, all ending in `TtsService`'s one planning and one job: streamed output (a `StreamSink`: the WebSocket `/api/v1/tts/stream`, `POST /tts/speak?stream=true`, `mizuoto speak --stream`), streamed text input (a `TextFeed`, for variants with `stream_text_input`), voice conversion and speech editing (the `convert` and `edit` jobs), and the OpenAI-compatible `POST /v1/audio/speech` (`TtsService.from_openai` maps the model, voice, `instructions`, `speed` and format onto a `SpeakRequest`). The protocols and examples are in HTTP API.","locale":"en"},"11247":{"id":"/en/docs/development-architecture-145","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"Everything the core knows about model code is in `mizuoto/core/inference/`:","locale":"en"},"11248":{"id":"/en/docs/development-architecture-146","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"Module","locale":"en"},"11249":{"id":"/en/docs/development-architecture-147","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"Role","locale":"en"},"11250":{"id":"/en/docs/development-architecture-148","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`tasks.py`","locale":"en"},"11251":{"id":"/en/docs/development-architecture-149","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"The task types engines take and give (`SynthesisTask`, `VoiceSpec`, `LoadSpec`, `AudioChunk`, `Description`, `OptionSpec`…), standard-library dataclasses re-exported by `runtime.engine`; the core builds them at module level without loading the runtime","locale":"en"},"11252":{"id":"/en/docs/development-architecture-150","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`service.py`","locale":"en"},"11253":{"id":"/en/docs/development-architecture-151","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`InferenceService`: what is installed. An engine is available when torch imports and its implementation is registered (the built-in `BUILTIN`, or the `mizuoto.engines` entry points); otherwise `missing(engine)` names what is not (`torch`, `mizuoto-fishspeech`, `mizuoto-indextts`). Extras and trainers' needs are probed with `importlib.util.find_spec`, without importing torch. The native runtime is built when the first model loads","locale":"en"},"11254":{"id":"/en/docs/development-architecture-152","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`runtime.py`","locale":"en"},"11255":{"id":"/en/docs/development-architecture-153","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`RuntimeService`: one engine per (engine, device); `loaded(ModelRef, device, dtype, options, request)` gives a model's `EngineHandle`; at most `compute.max_resident_models` models resident, the idle reaper, release after running out of memory, clearing a device before training, the doctor","locale":"en"},"11256":{"id":"/en/docs/development-architecture-154","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`engine.py`, `local.py`","locale":"en"},"11257":{"id":"/en/docs/development-architecture-155","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`EngineHandle` and `EngineRequest` (cancel event, timeout, streamed-text queue, progress callback; it comes back with `applied`, `warnings`, `timings`); `LocalEngine` / `LocalHandle` call the engine in this process. For a device named `<host>/<device>` a `RemoteEngine` session from `core/remote` takes its place, called the same way","locale":"en"},"11258":{"id":"/en/docs/development-architecture-156","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"`models.py`","locale":"en"},"11259":{"id":"/en/docs/development-architecture-157","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"Report models: `RuntimeStatus`, `LoadedModelInfo`, `DoctorReport`…","locale":"en"},"11260":{"id":"/en/docs/development-architecture-158","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"A handle's methods are `prepare_voice`, `synthesize` / `convert` / `edit` (generators: the engine runs only inside `next()`, each step with the request context bound and `torch.inference_mode()` entered) and `call(op, payload)` (ASR's `transcribe`, Fish Speech's `codec_*`, `mizuoto.snapshot`). Loading runs outside inference mode. The details are in Runtime.","locale":"en"},"11261":{"id":"/en/docs/development-architecture-159","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-engine-registry-and-manifests","content":"An engine has two parts: a **manifest** (`mizuoto/core/engines/manifests/<id>.toml`, package data shipped in the wheel) and an **implementation** (a subclass of `mizuoto.runtime.engine.Engine`).","locale":"en"},"11262":{"id":"/en/docs/development-architecture-160","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-engine-registry-and-manifests","content":"The manifest holds the variants and capabilities, the common parameters' mapping, engine options and load options, the model catalogue (each model's pinned repository revision; file sizes and SHA-256 in `manifests/files/*.files.json`), shared assets (`[[assets]]`), the licence and the training methods (`[training.<method>]`). From manifests alone the host lists engines, validates requests and renders parameter forms, without importing torch.","locale":"en"},"11263":{"id":"/en/docs/development-architecture-161","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-engine-registry-and-manifests","content":"`EngineRegistry` (`core/engines/registry.py`) loads and validates the manifests, keeps licence acceptance, and reports each engine `available` / `missing` through `InferenceService`. `params.py` checks common parameters (`None` means the engine's own default; Mizuoto never imposes one), `languages.py` canonicalises language codes, `licences.py` holds the licence texts.","locale":"en"},"11264":{"id":"/en/docs/development-architecture-162","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-engine-registry-and-manifests","content":"The implementations' registry is in `runtime/engine.py`: built-in engines are listed in `BUILTIN` (`id → module:Class`), other distributions register through the entry-point group `mizuoto.engines`. Entry points are read once per process, so installing an engine package means restarting Mizuoto.","locale":"en"},"11265":{"id":"/en/docs/development-architecture-163","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-engine-registry-and-manifests","content":"An engine's `OPTION_SCHEMA` must equal its manifest's `[options]`, and `Engine.DEVICES` its manifest's `devices` (`tests/core/test_engines.py` checks both); the engine's `detect_variant()` (files only, no torch) gives the same variant as `core/models/detect.py`, which the host uses when importing a model.","locale":"en"},"11266":{"id":"/en/docs/development-architecture-164","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-engine-registry-and-manifests","content":"How to write an engine is in Adding an engine.","locale":"en"},"11267":{"id":"/en/docs/development-architecture-165","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#models-shared-assets-and-licences","content":"**Models.** Catalogue models download into `models/<engine>/<model>/`; `model.json` is written last and lists the files. The state is `missing`, `partial` (a folder without `model.json`, or a shared asset it needs is missing), `installed`, `corrupt` (a size differs or verification failed) or `downloading`. A `model_download` job (resource `io`) fetches with `downloads.concurrency` threads into `<file>.part`, resumes with Range, checks size and SHA-256, and tries the sources in order (`downloads.source` first, then Hugging Face, hf-mirror, ModelScope; the mirror first with `downloads.repository = \"mizuoto-model\"`); a file one source lacks comes from the next. `import_model` identifies the engine and variant from the files, verifies SHA-256 when the sizes match a catalogue model, and otherwise registers a user model `<engine>/<name>`.","locale":"en"},"11268":{"id":"/en/docs/development-architecture-166","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#models-shared-assets-and-licences","content":"**Shared assets** (a manifest's `[[assets]]`) are files several models of one engine share, kept in `models/_assets/<engine>/<name>/` with `asset.json`; they download with the first model that needs them, or alone. Archive parts are verified and unpacked in place. Engines get them as `LoadSpec.options[\"assets\"]` (id → folder).","locale":"en"},"11269":{"id":"/en/docs/development-architecture-167","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#models-shared-assets-and-licences","content":"**Licences.** A `licence.gated` engine (Fish Speech, IndexTTS) needs `engines.<id>.accepted_licence == \"<licence id>@<version>\"` before its models and assets download and before it speaks; the full text ships with the package (`manifests/licences/`). `requires_consent` makes cloning need a consent statement, `trains_others = false` keeps its outputs out of other engines' training data, and `notice` is shown under results. Every output carries licence tags.","locale":"en"},"11270":{"id":"/en/docs/development-architecture-168","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#voices","content":"A voice is `voices/<slug>/voice.json` plus `references/<sha256>.flac` (mono, at the clip's own rate). The folders are the truth and the list is a scan; delete goes to the trash. The kinds are `reference`, `designed` (a design result, its clip the primary reference), `preset` (one model's preset speaker) and `trained`.","locale":"en"},"11271":{"id":"/en/docs/development-architecture-169","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#voices","content":"`fit_voice(voice, model, variant)` answers whether and how a model can use a voice: the mode (`preset`, `design`, `clone`, `clone_no_transcript`), what it still needs (`transcribe`, `trim`), warnings, or why it cannot. Synthesis and the UI's voice picker both use it.","locale":"en"},"11272":{"id":"/en/docs/development-architecture-170","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#voices","content":"**Voice caches.** After loading the model, the job calls `prepare_voice` once per key into `voices/<slug>/cache/<engine>/<model>/<key>/` and records `cache.json`; one-off references go to `cache/voices/…`. The key hashes (model, model revision, the references' SHA-256 and transcripts, voice mode, Mizuoto's version, and for a licence-gated engine its distribution's version), so upgrading Mizuoto or that distribution rebuilds the caches once.","locale":"en"},"11273":{"id":"/en/docs/development-architecture-171","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#voices","content":"**A voice's own weights** (`Voice.weights[engine]`): an engine whose manifest has `[weights]` roles (GPT-SoVITS's `gpt` and `sovits`) can carry a fine-tune of the voice, kept in `weights/<engine>/` and exported and imported with the voice; its version comes from the files, and it is used when it equals the variant's `weights_version`.","locale":"en"},"11274":{"id":"/en/docs/development-architecture-172","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#voices","content":"A missing transcript is transcribed first when `tts.auto_transcribe` is on and ASR is ready (cached by audio SHA-256 and model in the `transcripts` table, and saved into the voice); otherwise the model's `clone_no_transcript` is used, or the request fails with `capability_not_supported` and the install command.","locale":"en"},"11275":{"id":"/en/docs/development-architecture-173","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#remote-hosts","content":"An engine whose device is `<host>/<device>` runs on that host's `mizuoto agent`. The agent is a whole Mizuoto: its own data folder, models and engines, in its own process.","locale":"en"},"11276":{"id":"/en/docs/development-architecture-174","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#remote-hosts","content":"The protocol version is `AGENT_PROTOCOL = 2`. At `hello` the token is compared with `hmac.compare_digest` and the protocol checked; a host and an agent of different protocols refuse each other with an upgrade hint.","locale":"en"},"11277":{"id":"/en/docs/development-architecture-175","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#remote-hosts","content":"One TCP connection (optionally TLS) is a session for one (engine, device): `open`, `load`, `prepare_voice`, `synthesize`, `convert`, `edit`, `call`, `unload`, `status` one after another; `cancel` and `text` at any time. Frames are length-prefixed JSON or binary (`core/remote/frames.py`, standard library only).","locale":"en"},"11278":{"id":"/en/docs/development-architecture-176","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#remote-hosts","content":"Files a request names (references, voice caches, weights) cross once by SHA-256 (`have` / `put`, 8 MB parts); the agent keeps them in `cache/remote/files` and prunes those unused for 30 days. The folder a `prepare_voice` writes comes back file by file. The agent beats every 5 s.","locale":"en"},"11279":{"id":"/en/docs/development-architecture-177","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#remote-hosts","content":"Model states and engine availability are the agent's (reports cached 15 s); training refuses a remote engine.","locale":"en"},"11280":{"id":"/en/docs/development-architecture-178","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#remote-hosts","content":"Usage is in Remote hosts; the client side in Runtime.","locale":"en"},"11281":{"id":"/en/docs/development-architecture-179","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#settings","content":"`SettingsService` owns `settings.toml` (in the data folder, or in `MIZUOTO_CONFIG_DIR` / `config_dir`). The model is in `mizuoto/core/settings/models.py`, with the sections `server`, `paths`, `compute`, `downloads`, `tts`, `engines.<id>`, `training`, `outputs` and `remote`.","locale":"en"},"11282":{"id":"/en/docs/development-architecture-180","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#settings","content":"Environment variables with the `MIZUOTO_` prefix and `__` between levels override the file, e.g. `MIZUOTO_SERVER__PORT=8000`. `MIZUOTO_DATA_DIR` and `MIZUOTO_CONFIG_DIR` are the exceptions: they choose folders.","locale":"en"},"11283":{"id":"/en/docs/development-architecture-181","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#settings","content":"A host application can pin values with `settings_overrides`.","locale":"en"},"11284":{"id":"/en/docs/development-architecture-182","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#settings","content":"The file is checked for outside changes every second; every change, wherever it came from, reaches the `on_keys_change` listeners as dotted keys (`changed_keys`).","locale":"en"},"11285":{"id":"/en/docs/development-architecture-183","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#settings","content":"Keys the model does not know are ignored when the file is read.","locale":"en"},"11286":{"id":"/en/docs/development-architecture-184","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#settings","content":"What each setting means is in Configuration.","locale":"en"},"11287":{"id":"/en/docs/development-architecture-185","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"The data folder defaults to `mizuoto` in the platform's user data folder (`~/.local/share/mizuoto` on Linux, under `%APPDATA%` on Windows, under `~/Library/Application Support` on macOS); `MIZUOTO_DATA_DIR` puts it elsewhere. It holds `models/` (with `_assets/`), `voices/`, `outputs/`, `datasets/`, `experiments/`, `projects/`, `cache/` (with `scratch/<engine>/`, the requests' scratch folders), `uploads/`, `logs/`, `jobs/` (job logs), `server.json` (the running server's address and process id) and `mizuoto.db`. Most folders can be moved with `paths.*`.","locale":"en"},"11288":{"id":"/en/docs/development-architecture-186","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"Installed models, voices, datasets, experiments and projects are folders with JSON sidecars (`model.json`, `voice.json`, `dataset.json`, `experiment.json`, `project.json`), not rows: nothing queries them, and a folder scan cannot drift from the files. The database (`mizuoto/core/db/database.py`: one shared connection, WAL mode, `PRAGMA user_version` counting the migrations run, migrations append-only) keeps what is queried: jobs (with their request JSON and owning process id), outputs (with applied parameters, timings and licence tags), audio files, transcripts, presets and client state.","locale":"en"},"11289":{"id":"/en/docs/development-architecture-187","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"What is on disk carries over an upgrade like this:","locale":"en"},"11290":{"id":"/en/docs/development-architecture-188","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"Model folders and the catalogue's file manifests, voices (folders, references, weights), outputs, datasets, experiments, projects and presets stay valid as they are. Only the files a manifest lists are verified, so old files a manifest dropped do no harm.","locale":"en"},"11291":{"id":"/en/docs/development-architecture-189","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"`settings.toml` keeps its keys; one that a version renames or removes is ignored. The database only gains migrations.","locale":"en"},"11292":{"id":"/en/docs/development-architecture-190","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"Voice caches are keyed by Mizuoto's version (and a gated engine's distribution's) and rebuilt on first use after an upgrade.","locale":"en"},"11293":{"id":"/en/docs/development-architecture-191","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"A host and its remote agents must speak the same protocol version and refuse each other otherwise.","locale":"en"},"11294":{"id":"/en/docs/development-architecture-192","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"A job records its process; opening the data folder marks only jobs whose process is gone `interrupted`, so a second command does not interrupt a render in progress.","locale":"en"},"11295":{"id":"/en/docs/development-architecture-193","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#recorded-file-paths","content":"The data folder can be moved, renamed, copied or opened through a link, and the database must follow it. `outputs.path` and `audio_files.path` therefore record a file inside the data folder relative to it (`outputs/2026-10/a.wav`, with `/` on every platform), and a file elsewhere (a server path, an outputs folder set outside the data folder) absolute. `mizuoto/core/storage.py` owns that rule (`StorageService.store` / `resolve`, over `to_stored` / `from_stored` in `core/files.py`); records handed out (`Output.path`, `AudioFile.path`) are absolute, as the file is on disk now, with `missing` set when it is gone.","locale":"en"},"11296":{"id":"/en/docs/development-architecture-194","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#recorded-file-paths","content":"**Opened somewhere new**: the `meta` table (migration 3) keeps the folder last opened (`data_dir`). When it differs, or is not there (a database from before relative paths, which kept absolute paths everywhere), `StorageService.reconcile` rewrites every record of a file inside the folder as relative, once, in one `BEGIN IMMEDIATE` transaction, so processes opening the folder together do it once.","locale":"en"},"11297":{"id":"/en/docs/development-architecture-195","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#recorded-file-paths","content":"**Found again**: a file not where its record says is looked for by the last parts of its recorded path under the data folder, the outputs folder and the cache folder (`relocations`, which reads either platform's separators, so a database written on Windows works in a Linux container). A candidate counts only with the recorded size, and with the recorded SHA-256 for audio files; the record is then rewritten. For a record that points outside the data folder, a copy inside it wins over the original: a copied data folder must never read, or delete, the files of the folder it was copied from (it did, when every path was absolute).","locale":"en"},"11298":{"id":"/en/docs/development-architecture-196","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#recorded-file-paths","content":"**Missing**: a file found nowhere is `not_found` with `detail.reason` `file_missing` (`codes.FILE_MISSING`; `detail.recorded`, `detail.path`), never skipped: a zip of outputs refuses it, or with `skip_missing` (the UI's **Download all**) lists it in `MISSING.txt`; deleting its output removes the record and trashes nothing. `mizuoto output check` (`POST /outputs/check`, `StorageService.check`) lists every record, rewrites them (`--fix`), points records under a moved external folder elsewhere (`--rebase OLD NEW`) and deletes the records of missing files (`--prune-missing`).","locale":"en"},"11299":{"id":"/en/docs/development-architecture-197","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#recorded-file-paths","content":"Relative `paths.*` folders are inside the data folder, not the working directory.","locale":"en"},"11300":{"id":"/en/docs/development-architecture-198","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#recorded-file-paths","content":"A database whose schema is newer than the running version is logged (an older Mizuoto shows relative records of a newer one as missing; nothing is deleted).","locale":"en"},"11301":{"id":"/en/docs/development-architecture-199","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#events","content":"Each event in `mizuoto/core/events/models.py` is a `Record` with an `__event_name__`: `job_updated`, `job_log`, `jobs_cleared`, `outputs_added` / `outputs_removed`, `voices_changed`, `models_changed`, `presets_changed`, `engines_changed`, `runtime_changed` (the loaded models and the engines' states, as `RuntimeStatus`), `compute_changed`, `settings_changed`, `datasets_changed`, `projects_changed`, `experiments_changed`, `train_metrics`. `EventBase.get_events()` collects every subclass; `mizuoto/api/openapi.py` writes them into the OpenAPI schema, from which the UI types its socket.","locale":"en"},"11302":{"id":"/en/docs/development-architecture-200","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#events","content":"`LocalEventBus.publish()` calls each handler synchronously on the publishing thread; a subscriber that must run elsewhere (an asyncio loop) hands the event over itself. `RuntimeService` publishes `runtime_changed` at most every 0.5 s.","locale":"en"},"11303":{"id":"/en/docs/development-architecture-201","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Every long operation is a job. Services register a factory with `jobs.register(kind, factory)` when they are built; the factory turns a request (plain JSON) into a `JobSpec`:","locale":"en"},"11304":{"id":"/en/docs/development-architecture-202","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"The registered kinds are `speak`, `voice_prepare`, `convert`, `edit`, `engine_op`, `transcribe`, `model_download`, `asset_download`, `dataset_prepare`, `train`, `project_render` and `project_export`.","locale":"en"},"11305":{"id":"/en/docs/development-architecture-203","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Resources have names and capacities. The scheduler runs a job only when every resource it needs has room; otherwise the job is `waiting`, with `waiting_for` naming the full one:","locale":"en"},"11306":{"id":"/en/docs/development-architecture-204","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Resource","locale":"en"},"11307":{"id":"/en/docs/development-architecture-205","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Capacity","locale":"en"},"11308":{"id":"/en/docs/development-architecture-206","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Used by","locale":"en"},"11309":{"id":"/en/docs/development-architecture-207","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`cpu`","locale":"en"},"11310":{"id":"/en/docs/development-architecture-208","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Half the cores","locale":"en"},"11311":{"id":"/en/docs/development-architecture-209","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"The default; dataset preparation; a training run on the CPU","locale":"en"},"11312":{"id":"/en/docs/development-architecture-210","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`io`","locale":"en"},"11313":{"id":"/en/docs/development-architecture-211","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"4","locale":"en"},"11314":{"id":"/en/docs/development-architecture-212","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Model and asset downloads","locale":"en"},"11315":{"id":"/en/docs/development-architecture-213","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`gpu:<device>`","locale":"en"},"11316":{"id":"/en/docs/development-architecture-214","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`compute.gpu_jobs`","locale":"en"},"11317":{"id":"/en/docs/development-architecture-215","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Inference and training on that device; a job waiting for it can be **run anyway** (`run_anyway`)","locale":"en"},"11318":{"id":"/en/docs/development-architecture-216","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`inference`","locale":"en"},"11319":{"id":"/en/docs/development-architecture-217","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`compute.inference_jobs`","locale":"en"},"11320":{"id":"/en/docs/development-architecture-218","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Every synthesis job (`speak`, `convert`, `edit`), on any engine and device; a micro-batch is one job","locale":"en"},"11321":{"id":"/en/docs/development-architecture-219","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`engine:<engine>:<device>`","locale":"en"},"11322":{"id":"/en/docs/development-architecture-220","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"1","locale":"en"},"11323":{"id":"/en/docs/development-architecture-221","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"A loaded engine serves one request at a time; a training run holds it too","locale":"en"},"11324":{"id":"/en/docs/development-architecture-222","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`project:<id>`","locale":"en"},"11325":{"id":"/en/docs/development-architecture-223","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"1","locale":"en"},"11326":{"id":"/en/docs/development-architecture-224","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"A project's render (which submits ordinary speak jobs)","locale":"en"},"11327":{"id":"/en/docs/development-architecture-225","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#jobs-and-named-resources","content":"`JobContext` is what a running job reports through and checks for cancellation: `progress`, `step`, `message`, `log`, `transfer` (download speed over a 5 s window), `check_cancel`, `cancel_event` (passed to the engine as `EngineRequest.cancel`), `run_worker(WorkerTarget, …)` (a job worker, such as a training stage, whose JSON-lines events it reads; any output line resets the watchdog), and `adopt` / `complete` / `fail` / `release` for micro-batching. A job records its process id; opening the data folder marks only jobs whose process is gone `interrupted`.","locale":"en"},"11328":{"id":"/en/docs/development-architecture-226","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#micro-batching","content":"With `tts.micro_batch` on, `TtsService._batch_group()` gives a speak job a `JobSpec.group` when the variant has the `batch` capability with `max_batch > 1`, the request has one segment, no seed (a batch draws its random numbers differently) and does not stream. The group is a hash of everything but the text. Just before calling the engine, the running job calls `JobContext.adopt(max_batch - 1)`, which takes the oldest queued jobs of its group, and sends one `SynthesisTask` whose `texts` hold every text; the engine yields text *i*'s chunks with `segment = i`, the job stores one output per job and ends the adopted ones with `complete()` / `fail()`. If the batched call fails, they are `release()`d to the queue and each runs on its own.","locale":"en"},"11329":{"id":"/en/docs/development-architecture-227","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`mizuoto/core/errors.py` holds every error type. Each class carries `code`, `http_status` and `exit_code`, and both front ends translate mechanically: the API turns any `MizuotoError` into `{\"code\", \"message\", \"detail\"}` (`mizuoto/api/errors.py`); the CLI turns it into its exit code and logs `detail[\"hint\"]` as a second line (`cli/factory.report_error`). The code strings are in `mizuoto/core/codes.py` (standard library only), so engines and training stages raise `EngineError(message, detail, code=codes.…)` without pydantic, and the core rebuilds the class with `error_from_code()`.","locale":"en"},"11330":{"id":"/en/docs/development-architecture-228","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"Exception","locale":"en"},"11331":{"id":"/en/docs/development-architecture-229","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`code`","locale":"en"},"11332":{"id":"/en/docs/development-architecture-230","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"HTTP","locale":"en"},"11333":{"id":"/en/docs/development-architecture-231","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"Exit","locale":"en"},"11334":{"id":"/en/docs/development-architecture-232","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`MizuotoError` (base)","locale":"en"},"11335":{"id":"/en/docs/development-architecture-233","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`internal_error`","locale":"en"},"11336":{"id":"/en/docs/development-architecture-234","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"500","locale":"en"},"11337":{"id":"/en/docs/development-architecture-235","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"1","locale":"en"},"11338":{"id":"/en/docs/development-architecture-236","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`NotFoundError`","locale":"en"},"11339":{"id":"/en/docs/development-architecture-237","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`not_found`","locale":"en"},"11340":{"id":"/en/docs/development-architecture-238","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"404","locale":"en"},"11341":{"id":"/en/docs/development-architecture-239","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"2","locale":"en"},"11342":{"id":"/en/docs/development-architecture-240","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`ConflictError` / `BusyError`","locale":"en"},"11343":{"id":"/en/docs/development-architecture-241","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`conflict` / `busy`","locale":"en"},"11344":{"id":"/en/docs/development-architecture-242","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"409","locale":"en"},"11345":{"id":"/en/docs/development-architecture-243","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"3","locale":"en"},"11346":{"id":"/en/docs/development-architecture-244","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`InvalidPathError`","locale":"en"},"11347":{"id":"/en/docs/development-architecture-245","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`invalid_path`","locale":"en"},"11348":{"id":"/en/docs/development-architecture-246","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en