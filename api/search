ng files and the like are open only to a browser on the server's own machine","locale":"en"},"11936":{"id":"/en/docs/development-architecture-274","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"403","locale":"en"},"11937":{"id":"/en/docs/development-architecture-275","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"4","locale":"en"},"11938":{"id":"/en/docs/development-architecture-276","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`ModelMissingError`","locale":"en"},"11939":{"id":"/en/docs/development-architecture-277","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`model_missing`","locale":"en"},"11940":{"id":"/en/docs/development-architecture-278","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"409","locale":"en"},"11941":{"id":"/en/docs/development-architecture-279","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"7","locale":"en"},"11942":{"id":"/en/docs/development-architecture-280","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`EnvMissingError`","locale":"en"},"11943":{"id":"/en/docs/development-architecture-281","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`engine_not_installed`: a package the engine needs (torch, a gated engine's distribution) is missing","locale":"en"},"11944":{"id":"/en/d