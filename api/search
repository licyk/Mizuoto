t":"`WorkerError` / `EngineError`","locale":"en"},"11590":{"id":"/en/docs/development-api-70","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`worker_failed` / `engine_error`","locale":"en"},"11591":{"id":"/en/docs/development-api-71","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"502 / 500","locale":"en"},"11592":{"id":"/en/docs/development-api-72","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"10","locale":"en"},"11593":{"id":"/en/docs/development-api-73","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`OperationTimeoutError`","locale":"en"},"11594":{"id":"/en/docs/development-api-74","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`timeout`","locale":"en"},"11595":{"id":"/en/docs/development-api-75","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"504","locale":"en"},"11596":{"id":"/en/docs/development-api-76","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"11","locale":"en"},"11597":{"id":"/en/docs/development-api-77","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`DownloadError` / `InstallError`","locale":"en"},"11598":{"id":"/en/docs/development-api-78","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`download_failed` / `install_failed`","locale":"en"},"11599":{"id":"/en/docs/development-api-79","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"502 / 500","locale":"en"},"11600":{"id":"/en/docs/development-api-80","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"12 / 13","locale":"en"},"11601":{"id":"/en/docs/development-api-81","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`RemoteError`","locale":"en"},"11602":{"id":"/en/docs/development-api-82","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`remote_unavailable`","locale":"en"},"11603":{"id":"/en/docs/development-api-83","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"502","locale":"en"},"11604":{"id":"/en/docs/development-api-84","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"14","locale":"en"},"11605":{"id":"/en/docs/development-api-85","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`CancelledError`","locale":"en"},"11606":{"id":"/en/docs/development-api-86","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"`cancelled`","locale":"en"},"11607":{"id":"/en/docs/development-api-87","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"499","locale":"en"},"11608":{"id":"/en/docs/development-api-88","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"130","locale":"en"},"11609":{"id":"/en/docs/development-api-89","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#errors--http-errorspy","content":"The code strings live in `mizuoto/core/codes.py` (standard library only), so engines and training stages raise them without pydantic; `error_from_code()` rebuilds the class from a code.","locale":"en"},"11610":{"id":"/en/docs/development-api-90","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#writing-a-route","content":"From `routers/projects.py`:","locale":"en"},"11611":{"id":"/en/docs/development-api-91","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#writing-a-route","content":"Conventions:","locale":"en"},"11612":{"id":"/en/docs/development-api-92","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#writing-a-route","content":"**One operation, one core method.** The route body parses, calls and returns; bodies and results are the core's `Record` models, so the API's JSON equals the CLI's `--json`.","locale":"en"},"11613":{"id":"/en/docs/development-api-93","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#writing-a-route","content":"**Every route has an `operation_id`**, the operation's name in OpenAPI.","locale":"en"},"11614":{"id":"/en/docs/development-api-94","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#writing-a-route","content":"**Plain `def`**: routes that touch the disk and the database run in the thread pool. Only uploads that read the raw body (`uploads.spool()` streams it to a temporary file, never parsing multipart) and WebSockets are `async def`.","locale":"en"},"11615":{"id":"/en/docs/development-api-95","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#writing-a-route","content":"**Long operations return a `Job`.** `POST /tts/speak?wait=true` waits with `JobService.wait` and raises `OperationTimeoutError` after `timeout` (504, `detail.job_id` names the job, which goes on).","locale":"en"},"11616":{"id":"/en/docs/development-api-96","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#writing-a-route","content":"**Audio files** go through `files.audio_response()`: `FileResponse` answers `Range`, so long files can be seeked. Streamed synthesis is in `streaming.py` (chunked WAV or bare PCM, the rate in `X-Mizuoto-Sample-Rate`, the job id in `X-Mizuoto-Job`).","locale":"en"},"11617":{"id":"/en/docs/development-api-97","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"The models live in the server's process, so the API is how other programs (and `mizuoto runtime`) see and free them. `routers/runtime.py`:","locale":"en"},"11618":{"id":"/en/docs/development-api-98","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"Route","locale":"en"},"11619":{"id":"/en/docs/development-api-99","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"Core method","locale":"en"},"11620":{"id":"/en/docs/development-api-100","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"Returns","locale":"en"},"11621":{"id":"/en/docs/development-api-101","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`GET /api/v1/runtime`","locale":"en"},"11622":{"id":"/en/docs/development-api-102","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`runtime.status()`","locale":"en"},"11623":{"id":"/en/docs/development-api-103","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`RuntimeStatus`: the installed torch's version, the loaded models (engine, device, bytes, last use, busy, remote host) and the engines' states","locale":"en"},"11624":{"id":"/en/docs/development-api-104","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`POST /api/v1/runtime/unload`","locale":"en"},"11625":{"id":"/en/docs/development-api-105","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`runtime.unload(body.model)`","locale":"en"},"11626":{"id":"/en/docs/development-api-106","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`RuntimeStatus` after unloading the model named in `UnloadRequest.model`, or every model not in use when it is `null`","locale":"en"},"11627":{"id":"/en/docs/development-api-107","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`GET /api/v1/runtime/doctor`","locale":"en"},"11628":{"id":"/en/docs/development-api-108","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`runtime.doctor()`","locale":"en"},"11629":{"id":"/en/docs/development-api-109","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`DoctorReport`: the torch build against the hardware, the recommended build and its install command, a finding per engine, extra and trainer, and the size of the old `<data>/envs`","locale":"en"},"11630":{"id":"/en/docs/development-api-110","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-runtime-routes","content":"`GET /api/v1/engines/{id}/doctor` is the same report for one engine. An engine's detail (`EngineStatus`) carries `available` and `missing` (`torch`, `mizuoto-fishspeech`…), not an environment, and `GET /api/v1/app/meta` carries `torch`, the installed version or `null`. `POST /api/v1/compute/release` (**Free GPU memory**) unloads every idle engine's models. Their response models are in `mizuoto/core/inference/models.py`.","locale":"en"},"11631":{"id":"/en/docs/development-api-111","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#openapi-with-events","content":"Socket events are not HTTP routes, so FastAPI would leave them out of the schema. `MizuotoAPI` in `openapi.py` overrides `openapi()`: it walks `EventBase.get_events()` (every subclass in `mizuoto/core/events/models.py` with an `__event_name__`), adds each model to `components.schemas`, and adds a `ServerEvents` object mapping event names to models:","locale":"en"},"11632":{"id":"/en/docs/development-api-112","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#openapi-with-events","content":"The events today: `settings_changed`, `job_updated`, `job_log`, `jobs_cleared`, `outputs_added`, `outputs_removed`, `runtime_changed`, `compute_changed`, `engines_changed`, `voices_changed`, `datasets_changed`, `projects_changed`, `experiments_changed`, `train_metrics`, `presets_changed`, `models_changed`. Each carries a snapshot, never a live object: the bridge serialises it later on the event loop while job threads keep writing. The bridge subscribes to the EventBus (called from threads, it crosses into the loop with `call_soon_threadsafe`) and emits each event under its name.","locale":"en"},"11633":{"id":"/en/docs/development-api-113","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#openapi-with-events","content":"The socket only pushes changes. The client patches or invalidates the queries an event affects and refetches what is on screen after a reconnect; every state must be readable over REST.","locale":"en"},"11634":{"id":"/en/docs/development-api-114","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#types-for-the-web-ui","content":"`scripts/generate_openapi.py` builds the services and the app (`serve_ui=False`) in a temporary data folder and prints `app.openapi()` without starting a server. `python scripts/dev.py typegen` feeds it to `openapi-typescript`, which writes `mizuoto/webui/src/api/schema.d.ts`:","locale":"en"},"11635":{"id":"/en/docs/development-api-115","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#types-for-the-web-ui","content":"`--default-non-nullable false` keeps defaulted fields of request bodies optional; `Record` sets `json_schema_serialization_defaults_required`, so in responses those fields are required and the types match what the server sends.","locale":"en"},"11636":{"id":"/en/docs/development-api-116","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#types-for-the-web-ui","content":"Models used both as a request body and in a response (`SpeakRequest`, returned by an output's re-run; a project's `Chapter`, `Line`, `Speaker`; `CommonParams`, `VoiceInput`, `EmotionInput`, `OutputSpec`…) appear twice in the schema, as `-Input` and `-Output`. The UI sends `S['SpeakRequest-Input']` and reads `S['SpeakRequest-Output']`; `webui/src/api/types.ts` aliases the common ones.","locale":"en"},"11637":{"id":"/en/docs/development-api-117","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-route","content":"**The core method.** Write it in `mizuoto/core/<area>/service.py`, taking and returning `Record` models (`mizuoto/core/<area>/models.py`); raise only the classes in `core/errors.py`. If it changes something the UI shows, publish an event (a new event is a new `EventBase` subclass in `core/events/models.py`; the schema picks it up).","locale":"en"},"11638":{"id":"/en/docs/development-api-118","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-route","content":"**The route.** Add a function with an `operation_id` to the module in `mizuoto/api/routers/`; a new resource gets a new module, added to `ROUTERS` in `app.py`. Operations that read server paths add `dependencies=[LocalDep]`.","locale":"en"},"11639":{"id":"/en/docs/development-api-119","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-route","content":"**The types.** Run `python scripts/dev.py typegen` and commit `schema.d.ts`.","locale":"en"},"11640":{"id":"/en/docs/development-api-120","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-route","content":"**The test.** Test it in `tests/api/test_api.py` with `TestClient` against the dummy engine; state-changing requests carry `headers={\"origin\": \"http://localhost\"}` (`ORIGIN` in that file).","locale":"en"},"11641":{"id":"/en/docs/development-api-121","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`mizuoto/cli/` uses Typer:","locale":"en"},"11642":{"id":"/en/docs/development-api-122","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"File","locale":"en"},"11643":{"id":"/en/docs/development-api-123","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"Role","locale":"en"},"11644":{"id":"/en/docs/development-api-124","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`app.py`","locale":"en"},"11645":{"id":"/en/docs/development-api-125","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`get_app()` registers every command (and nothing else does); `main()` handles errors and exit codes uniformly","locale":"en"},"11646":{"id":"/en/docs/development-api-126","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`commands/*.py`","locale":"en"},"11647":{"id":"/en/docs/development-api-127","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"Each command is a plain function, its parameters declared with `Annotated[..., typer.Option(...)]`","locale":"en"},"11648":{"id":"/en/docs/development-api-128","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`factory.py`","locale":"en"},"11649":{"id":"/en/docs/development-api-129","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`typer_factory()` (groups list commands alphabetically, `AlphabeticalMixedGroup`), `DebugTyperCommand` (adds `--debug` to every command and group and turns domain errors into exit codes), `report_error()`; the private `typer._click` imports are confined here","locale":"en"},"11650":{"id":"/en/docs/development-api-130","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`output.py`","locale":"en"},"11651":{"id":"/en/docs/development-api-131","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`open_services()` (services built once per command, no background threads), `print_json()`, `print_table()`","locale":"en"},"11652":{"id":"/en/docs/development-api-132","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`progress.py`","locale":"en"},"11653":{"id":"/en/docs/development-api-133","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`job_progress(services)`: subscribes to the same EventBus and draws job progress as a Rich bar on stderr; `finish(job)`","locale":"en"},"11654":{"id":"/en/docs/development-api-134","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"The usual shape of a command (`commands/projects.py`):","locale":"en"},"11655":{"id":"/en/docs/development-api-135","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"`print_json()` uses `model_dump(mode=\"json\")`, as the API serialises. The command line starts no scheduler: commands that make jobs call the core method with `wait=True` (`jobs.run_now` inside: in the foreground, on the calling thread, cancelled by Ctrl+C), wrapped in `job_progress`.","locale":"en"},"11656":{"id":"/en/docs/development-api-136","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#the-command-line","content":"Errors: `DebugTyperCommand.invoke` catches `MizuotoError`; `report_error()` prints the message, and the fixing command when `detail[\"hint\"]` has one, then exits with the error's `exit_code`. Heavy modules (core models, uvicorn) are imported inside functions: `tests/test_architecture.py` checks that importing `mizuoto.cli.app` loads neither torch nor fastapi.","locale":"en"},"11657":{"id":"/en/docs/development-api-137","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-command","content":"Write a fully annotated plain function in `mizuoto/cli/commands/<group>.py`, with `--json`, calling the same core method as the API route.","locale":"en"},"11658":{"id":"/en/docs/development-api-138","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-command","content":"Register it in `get_app()` in `mizuoto/cli/app.py`, with its name and help there:","locale":"en"},"11659":{"id":"/en/docs/development-api-139","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-command","content":"Add it to `EXPECTED_TREE` in `tests/cli/test_cli.py`. `test_command_tree` compares the whole tree, so a missing or extra command fails:","locale":"en"},"11660":{"id":"/en/docs/development-api-140","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-a-command","content":"One name cannot be both a command and a group, so the environment variable listing is `mizuoto env vars`, not `mizuoto env`.","locale":"en"},"11661":{"id":"/en/docs/development-architecture","page_id":"/en/docs/development-architecture","type":"page","content":"Architecture","breadcrumbs":["Mizuoto Documentation","Development"],"tags":[],"url":"/en/docs/development-architecture","locale":"en"},"11662":{"id":"/en/docs/development-architecture-0","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture","content":"Mizuoto's layout and module boundaries, the layer rules its tests enforce, how the services are built, the path of one synthesis request, the door to model code, the engine registry, models and voices, remote hosts, the data folder and compatibility, and the settings, events, jobs and errors every layer shares.","locale":"en"},"11663":{"id":"/en/docs/development-architecture-1","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#layout","content":"Layout","locale":"en"},"11664":{"id":"/en/docs/development-architecture-2","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#the-layer-rules-and-their-tests","content":"The layer rules and their tests","locale":"en"},"11665":{"id":"/en/docs/development-architecture-3","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#one-operation-one-core-method","content":"One operation, one core method","locale":"en"},"11666":{"id":"/en/docs/development-architecture-4","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#assembly-build_services","content":"Assembly: `build_services()`","locale":"en"},"11667":{"id":"/en/docs/development-architecture-5","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#the-path-of-a-request","content":"The path of a request","locale":"en"},"11668":{"id":"/en/docs/development-architecture-6","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#the-door-to-model-code-coreinference","content":"The door to model code: `core/inference`","locale":"en"},"11669":{"id":"/en/docs/development-architecture-7","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#the-engine-registry-and-manifests","content":"The engine registry and manifests","locale":"en"},"11670":{"id":"/en/docs/development-architecture-8","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#models-shared-assets-and-licences","content":"Models, shared assets and licences","locale":"en"},"11671":{"id":"/en/docs/development-architecture-9","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#voices","content":"Voices","locale":"en"},"11672":{"id":"/en/docs/development-architecture-10","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#remote-hosts","content":"Remote hosts","locale":"en"},"11673":{"id":"/en/docs/development-architecture-11","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#settings","content":"Settings","locale":"en"},"11674":{"id":"/en/docs/development-architecture-12","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#the-data-folder-and-compatibility","content":"The data folder and compatibility","locale":"en"},"11675":{"id":"/en/docs/development-architecture-13","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#recorded-file-paths","content":"Recorded file paths","locale":"en"},"11676":{"id":"/en/docs/development-architecture-14","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#events","content":"Events","locale":"en"},"11677":{"id":"/en/docs/development-architecture-15","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#jobs-and-named-resources","content":"Jobs and named resources","locale":"en"},"11678":{"id":"/en/docs/development-architecture-16","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#micro-batching","content":"Micro-batching","locale":"en"},"11679":{"id":"/en/docs/development-architecture-17","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#errors-and-exit-codes","content":"Errors and exit codes","locale":"en"},"11680":{"id":"/en/docs/development-architecture-18","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture","content":"This page gives the whole picture: the packages and what each may import, the layer rules `tests/test_architecture.py` enforces, how `build_services()` assembles the services, the path of one synthesis request from the browser to an engine and back, the core's one door to model code, how engines, models, voices and remote hosts are organised, how the data folder carries over between versions, and the shared infrastructure: settings, events, jobs, errors. What happens inside the runtime is in Runtime; routes and commands are in API and CLI.","locale":"en"},"11681":{"id":"/en/docs/development-architecture-19","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layer-rules-and-their-tests","content":"`tests/test_architecture.py` walks every module's absolute imports with `ast` and checks them against these tables; the standard library is always allowed.","locale":"en"},"11682":{"id":"/en/docs/development-architecture-20","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layer-rules-and-their-tests","content":"Layer","locale":"en"},"11683":{"id":"/en/docs/development-architecture-21","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layer-rules-and-their-tests","content":"First-party modules it may import","locale":"en"},"11684":{"id":"/en/docs/development-architecture-22","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layer-rules-and-their-tests","content":"Third-party modules it may import","locale":"en"},"11685":{"id":"/en/docs/development-architecture-23","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layer-rules-and-their-tests","content":"`mizuoto/core`","locale":"en"},"11686":{"id":"/en/docs/development-architecture-24","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layer-rules-and-their-tests","content":"`mizuoto.core`, `mizuoto.version`, `mizuoto.logger`; `mizuoto.runtime`, `mizuoto.nn`, `mizuoto.engines`, `mizuoto.training` **inside functions only**","locale":"en"},"11687":{"id":"/en/docs/development-architecture-25","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/develop